<% content_for(:header) do %>
<%- @wx_config.sort.each do |key, value|%>
    <meta content="<%= value %>" name="<%= key%>" >
  <% end if @wx_config.present? %>
  <%= stylesheet_link_tag "onepage-scroll", media: "all", "data-turbolinks-track" => true %>
  <%= javascript_include_tag "http://res.wx.qq.com/open/js/jweixin-1.0.0.js", "data-turbolinks-track" => true %>
  <%= javascript_include_tag "angular", "data-turbolinks-track" => true %>
  <%= javascript_include_tag "ddt/thirdparty", "data-turbolinks-track" => true %>
  <%= javascript_include_tag "ddt/business-s", "data-turbolinks-track" => true %>
<% end %>

<div class="main">
  <%- @one_pages.each_with_index do |one_page, index| %>
    <section style="background: url(<%= one_page.image.medium.url%>); background-size: 100% auto; background-repeat: no-repeat;">
      <% if one_page.abstract.present? %>
        <div class="one-page-abstract <%= one_page.alignment%>"><%= one_page.abstract%> </div>
      <% end %>

          <%- if index + 1 < @one_pages.count %>
            <div class="one-page-nav">
              <i class="fa fa-chevron-up"></i>
            </div>
          <% else %>
            <div class="one-page-nav">
              <a class="one-page-button" id="home-page-button" href="/weixin/shops/<%= @current_shop.slug%>">开始进入</a>
            </div>
          <% end %>
    </section>
  <% end %>
</div>
<script type="text/javascript">
  $(document).ready(function(){

    $(".main").onePageScroll({
         sectionContainer: "section", // sectionContainer accepts any kind of selector in case you don't want to use section
         easing: "ease-in-out", // Easing options accepts the CSS3 easing animation such "ease", "linear", "ease-in", "ease-out", "ease-in-out", or even cubic bezier value such as "cubic-bezier(0.175, 0.885, 0.420, 1.310)"
         animationTime: 1000, // AnimationTime let you define how long each section takes to animate
         pagination: true, // You can either show or hide the pagination. Toggle true for show, false for hide.
         updateURL: false, // Toggle this true if you want the URL to be updated automatically when the user scroll to each page.
         beforeMove: function(index) {
         }, // This option accepts a callback function. The function will be called before the page moves.
         afterMove: function(index) {

         }, // This option accepts a callback function. The function will be called after the page moves.
         loop: false, // You can have the page loop back to the top/bottom when the user navigates at up/down on the first/last page.
         direction: 'horizontal'
      });
    $('#home-page-button').attr('href', UrlParser.change_parameter(window.location.href, 'act', false) );
  });
</script>
