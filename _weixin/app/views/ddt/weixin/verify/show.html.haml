:css
  body{background: white;}
  .view{width: 90%;height: 400px;margin: 5% auto;padding-top: 20%;}
  .hint{color: #888888; font-size: 15px; height: 50px; padding-bottom: 20px; text-align: center;}
  a,a:visited,a:active{color: white;}
  .btn{ width:100%; height:35px; line-height:35px; border-radius:5px; border: solid 1px #ccc;background-color: #28a267; text-align: center}

  .hint{height: 100px;padding-bottom: 70px;}
  .succ{color: green;}
  .fail{color: red;}
%body
  .view
    - if action_name == "show"
      .hint
        .img-div
          %img{ src: "/images/ddt/check.png", width: "80px", height: "80px"}
        %h3
          扫描成功
          %br
          = @message || "点击按钮进行授权"
      - if @message
        %a{ href: @user_vip_info_url}
          .btn
            立即申请会员
      - else
        %a{ href: verify_common_shop_verify_vip_info_qr_code_scene_path(@current_shop, @qr_code_scene)}
          .btn
            授权我的会员信息
    - else
      .hint
        %h3
          -if @success
            .succ 用户信息授权成功 :)
          -else
            .fail 用户信息授权失败
