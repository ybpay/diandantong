.bind-order-content
  - if flash[:notice].present?
    .alert= flash[:notice]
  - if @order.current_vip != @current_user.vip_info
    .title 该订单已被绑定
  - else
    .order-total
      = @order.total_in_currency
    .order-infos
      .order-info
        .order-info-label 门店
        .order-info-value= @order.branch.name
      .order-info
        .order-info-label 订单状态
        .order-info-value= @order.state_name
      .order-info
        .order-info-label 订单编号
        .order-info-value= @order.number
    .order-infos
      .vip-card-pay-info{ style: "display: none; "}
        .order-info
          .order-info-label 会员余额
          .order-info-value.red= @current_user.vip_info.card_wallet.amount
        .order-info
          .order-info-label 支付密码
          .order-info-value
            = form_for :bind_order, url: bind_weixin_shop_bind_order_path(@current_shop, @order), method: :post, html: { class: 'bind-order-form' } do |f|
              = f.hidden_field :pay_method, value: :vip_card_pay
              = f.password_field :password
      - if @order.is_paid?
        .order-info
          .order-info-label 支付状态
          .order-info-value 已支付
      - else
        - if @all_pay_methods.include?(:alipay) && @current_shop.current_alipay_method.present?
          = link_to "支付宝支付", bind_weixin_shop_bind_order_path(@current_shop, @order, bind_order: { pay_method: :alipay}), class: "pay-method-btn", method: :post
        - if @all_pay_methods.include?(:wechatpay) && @current_shop.current_wechatpay_method.present?
          = link_to "微信支付", bind_weixin_shop_bind_order_path(@current_shop, @order, bind_order: { pay_method: :wechatpay}), class: "pay-method-btn", method: :post
        - if @all_pay_methods.include?(:vip_card_pay) && @current_user.vip?
          .pay-method-btn{ onclick: "$('.vip-card-pay-info').toggle();$('.submit-btn').toggle();$(this).toggleClass('active');"} 会员卡支付
      = link_to "确认支付", '#', class: 'link-btn submit-btn', onclick: "$('.bind-order-form').submit();", style: "display:none;"
      = link_to "订单详情",  root_path + @order.weixin_show_path, class: 'link-btn'
