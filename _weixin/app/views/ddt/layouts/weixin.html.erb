<!DOCTYPE html>
<html ng-app="ddt_main">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
  <meta content="telephone=no" name="format-detection" />
  <link rel="shortcut icon" href="data:image/x-icon;," type="image/x-icon">
  <%- @wx_config.sort.each do |key, value|%>
    <meta content="<%= value %>" name="<%= key%>" >
  <% end if @wx_config.present? %>
  <base href="<%=weixin_shop_url(@current_shop)%>">
  <meta content="<%= @shop_json||'{}' %>" name="shop_json"/>
  <meta content="<%= @search_words_json||'{}' %>" name="search_words_json"/>
  <meta content="<%= @user_json||'{}' %>" name="user_json"/>
  <meta content="<%= Rails.env %>" name="env"/>
  <meta content="<%= Ddt::WeixinApi.oauth_userinfo_url(Ddt::WeixinConfig.gonghao.app_id, weixin_shop_url(@current_shop, _ng_path: '/user/profile', force_fetch: true))%>" name="oauth_user_info_url">
  <meta content="<%= Rails.application.config.action_controller.asset_host %>" name="cdn_cache_domain">
  <meta name="wechat_account_be_verified" content="<%=@current_shop.primary_wechat_account.try(:account_verified?) %>">
  <title><%= @current_shop.name %></title>
  <% if @current_shop.enable_foreign %>
    <script type="text/javascript" charset='utf-8' src='http://maps.googleapis.com/maps/api/js?key=<%= Ddt::GlobalSetting::GMAP_KEY%>&libraries=places&sensor=true'></script>
  <% else %>
    <script type="text/javascript" src="http://map.qq.com/api/js?v=2.exp&key=D6XBZ-7O2R5-P5HI6-QSCGE-33WGJ-DDFG4&libraries=convertor" charset='utf-8'></script>
  <% end %>
  <%= javascript_include_tag "http://res.wx.qq.com/open/js/jweixin-1.0.0.js" %>
  <% if params[:_shake_around] %>
    <%= javascript_include_tag "http://zb.weixin.qq.com/nearbycgi/addcontact/BeaconAddContactJsBridge.js" %>
  <% end %>
  <%= stylesheet_link_tag "weui", media: "all"%>

  <%= stylesheet_link_tag "ddt/main", media: "all"%><!-- FIXME -->
  <%= javascript_include_tag "angular", crossorigin: "anonymous" %>
  <%= javascript_include_tag "ddt/thirdparty", crossorigin: "anonymous" %>
  <%= javascript_include_tag "ddt/business-s", crossorigin: "anonymous" %>
  <%= javascript_include_tag "ddt/business-main", crossorigin: "anonymous" %>

  <%= csrf_meta_tags %>
  <%= yield(:header) %>
</head>
<body>

  <%= content_for?(:content) ? yield(:content) : yield %>
  <%= render 'modal_and_toast' %>

  <div ng-confirm-dialog ng-title="请确认已到店" ng-confirm="scanQrCode('请对准桌子上的二维码进行扫描')" ng-cancel="toggle_show_eat_in_hall_select()" ng-show="show_eat_in_hall_select" ng-confirm-text="扫码下单" ng-cancel-text="待会下单">
    <p></p>
    <p>如果您已经到店，请点击 '扫码下单' 并扫描桌子上的二维码进行店内下单。</p>
  </div>


  <% if params[:_shake_around] %>
    <script type="text/javascript">
      BeaconAddContactJsBridge.ready(function(){
      //判断是否关注
        BeaconAddContactJsBridge.invoke('checkAddContactStatus',{} ,function(apiResult){
          if(apiResult.err_code == 0){
            var status = apiResult.data;
            if(status == 1){
              //alert('已关注');
            }else{
              //alert('未关注');
              //跳转到关注页
              BeaconAddContactJsBridge.invoke('jumpAddContact');
            }
          }else{
            alert(apiResult.err_msg)
          }
        });
      });
    </script>
  <% end %>
</body>
</html>
