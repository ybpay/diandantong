# PostgreSQL 18 configuration
# Requires: gem install pg
#
# Connection pooling:
#   pool: number of connections per process (default: 5)
#
# For dual-write migration mode, set both primary and mysql_replica sections.

default: &default
  adapter: postgresql
  encoding: unicode
  pool: 25
  host: localhost
  port: 5432
  # schema_search_path: public

development:
  <<: *default
  database: ddt_dev
  username: postgres
  password: postgres
  min_messages: warning

test:
  <<: *default
  database: ddt_test
  username: postgres
  password: postgres

production:
  <<: *default
  database: ddt_prod
  username: ddt_app
  password: <%= ENV['DDT_DATABASE_PASSWORD'] %>
  pool: 50

# Impression data is now merged into the primary database.
# The impression tables (impressions) are stored in the same database.
# For migration from the old separate impression database, use the
# migration script at tools/pg_migration/migrate_impressions.rb
