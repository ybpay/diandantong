# Docker-specific database.yml
# Copy to config/database.yml when running with docker-compose

defaults: &defaults
  adapter: mysql2
  charset: utf8mb4
  encoding: utf8mb4
  collation: utf8mb4_unicode_ci
  username: root
  password: <%= ENV['MYSQL_ROOT_PASSWORD'] || 'root' %>
  host: <%= ENV['MYSQL_HOST'] || 'mysql' %>
  port: <%= ENV['MYSQL_PORT'] || '3306' %>

development:
  <<: *defaults
  database: <%= ENV['MYSQL_DATABASE'] || 'ddt_dev' %>

test:
  adapter: sqlite3
  database: db/test.sqlite3
  pool: 5
  timeout: 5000

production:
  <<: *defaults
  database: <%= ENV['MYSQL_DATABASE'] || 'ddt_dev' %>
