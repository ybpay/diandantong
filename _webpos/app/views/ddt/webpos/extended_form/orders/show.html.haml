.extended-form-order
  - if @order.is_eat_in_hall?
    .table-number= @order.table_name_with_zone
  .line
    .line-label 优惠方式:
    .adjustments
      - if @order.vip_discount.present? && @order.vip_discount < 1
        .adjustment
          .adjustment-label VIP会员折扣
          .adjustment-value= "#{@order.vip_discount * 10}折"
      - @order.adjustments.active.each do |adjustment|
        .adjustment
          .adjustment-label= adjustment.label
          .adjustment-value= adjustment.amount
    .line-label 合计金额:
    .total= @order.total_in_currency
  .line
    .line-label 支付方式:
    .pay-items
      - @order.pay_items.each do |pay_item|
        .pay-item
          .pay-item-label= pay_item.pay_method_name
          .pay-item-value= pay_item.amount_in_currency
    .qrcode
  - if @order.pay_item_total > 0
    .pay-total
      = "实际支付: #{@order.pay_item_total_in_currency}"
