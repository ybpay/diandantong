!!!
%html{:"ng-app"=>"webpos"}
  %head
    = render 'ddt/layouts/webpos/header'
    = stylesheet_link_tag 'ddt/webpos', id: 'stylesheet-link-tag', media: "all", data: {turbolinks: {track: true}}
    %style#table_css{:type=>"text/css"}

  %body
    %div{style: "height: 100%;", :"wp-view"=>''}
      %div{style: 'text-align: center; margin-top: 200px;'}
        %h1 载入中...
    %div{ :'wp-include' => '', src: "partial('modals')" }
    %div{ :'wp-include' => '', src: "partial('_directives/wp-keypad-number')" }
    %div{ :'wp-include' => '', src: "partial('_directives/wp-keypad-text')" }
    %div{ :'wp-include' => '', src: "partial('qrcode')" }
    %div{ :'wp-include' => '', src: "partial('scan')" }
    %div{ :'wp-include' => '', src: "partial('item_notes')" }
    %div{ :'wp-include' => '', src: "partial('gift_reasons')" }
    %div{ :'wp-include' => '', src: "partial('_modals/auth')" }
    %div{ :'wp-include' => '', src: "partial('_modals/change_weight')" }
    %div#sound.hide{ "data-host" => asset_root_url }
    %div#ddb-loading
      %i.fa.fa-spinner.fa-spin
      .caption 数据加载中...
    // flash
    %script
      var flash_listener = new Object();
      flash_listener.onInit = function(){ this.position = 0; };
      flash_listener.onUpdate = function(){};
    %object#my-flash{type:"application/x-shockwave-flash", data: "/audios/player_mp3_js.swf", width:"0", height:"0", style: "display:block;"}
      %param{name:"movie", value:"/audios/player_mp3_js.swf"}
      %param{name:"AllowScriptAccess", value:"always"}
      %param{name:"FlashVars", value:"listener=flash_listener&amp;interval=500"}
    
    / %script{src: "http://map.qq.com/api/js?v=2.exp&key=D6XBZ-7O2R5-P5HI6-QSCGE-33WGJ-DDFG4&libraries=convertor", charset: 'utf-8'}
    = javascript_include_tag "thirdparty/_base", "data-turbolinks-track" => true
    = javascript_include_tag "thirdparty/_webpos", "data-turbolinks-track" => true
    = javascript_include_tag "thirdparty/_surface", "data-turbolinks-track" => true
    = javascript_include_tag "ddt/common", "data-turbolinks-track" => true
    = javascript_include_tag "ddt/webpos", "data-turbolinks-track" => true
