<div class="master-part" wp-scroll-zone>
  <div>
    <div class="nav">
      <div class="wp-subject"></div>
      <wp-btn ng-click="by_pending()"
              ng-class="{'active': toggle_key == 'by_pending'}">
        待烹饪
        <span class="point-number" ng-show="counts['pending']">{{counts['pending']}}</span>
      </wp-btn>
      <wp-btn ng-click="by_confirmed()"
              ng-class="{'active': toggle_key == 'by_confirmed'}">
        烹饪中
        <span class="point-number" ng-show="counts['confirmed']">{{counts['confirmed']}}</span>
      </wp-btn>
      <wp-btn ng-click="by_completed()"
              ng-class="{'active': toggle_key == 'by_completed'}">
        已烹饪
      </wp-btn>
      <wp-btn ng-click="by_canceled()"
              ng-class="{'active': toggle_key == 'by_canceled'}">
        已取消
      </wp-btn>
      <wp-btn ng-click="cooks_modal.open()" class="pull-right">
        <span ng-hide="active_cook">厨师过滤</span>
        <span ng-show="active_cook">{{active_cook.name}}</span>
      </wp-btn>
      <wp-btn ng-click="tables_modal.open()" class="pull-right">
        <span ng-hide="active_table">桌台过滤</span>
        <span ng-show="active_table">{{active_table.name_with_zone}}</span>
      </wp-btn>
      <wp-btn ng-click="categories_modal.open()" class="pull-right">
        <span ng-hide="active_category">分类过滤</span>
        <span ng-show="active_category">{{active_category.name_with_parent}}</span>
      </wp-btn>
      <div class="space"></div>
    </div>

    <div class="space"></div>

    <div class="products">
      <div class="wp-table">
        <wp-table-row>
          <!-- <div class="wp-table-col col-1">订单号</div> -->
          <div class="wp-table-col col-1">台桌</div>
          <div class="wp-table-col col-1">菜名</div>
          <div class="wp-table-col col-1">状态</div>
          <div class="wp-table-col col-1">等待时间</div>
          <div class="wp-table-col col-1">品注/备注</div>
          <div class="wp-table-col col-2">操作</div>
        </wp-table-row>

        <wp-table-row ng-repeat="litp in litps | orderBy:'-is_warning_int'" ng-hide="litp.hide" ng-class="{'active': litp.is_warning }">
          <div class="wp-table-col col-1" ng-hide="litp.order_table_name_with_zone">{{::litp.order_number.slice(-4)}}</div>
          <div class="wp-table-col col-1" ng-show="litp.order_table_name_with_zone">{{::litp.order_table_name_with_zone}}</div>
          <div class="wp-table-col col-1">
            {{litp.name}}
          </div>
          <div class="wp-table-col col-1" ng-class="{'pending': 'red', 'confirmed': 'green'}[litp.state]">{{litp.state_name}}</div>
          <div class="wp-table-col col-1">{{litp.wait_time}}</div>
          <div class="wp-table-col col-1">{{::litp.note}} {{::litp.order_note}}</div>
          <div class="wp-table-col col-2">
            <wp-btn-sm ng-click="confirm(litp)" ng-show="can_confirm(litp)">确认烹饪</wp-btn-sm>
            <wp-btn-sm ng-click="complete(litp)" ng-show="can_complete(litp)">烹饪完成</wp-btn-sm>
          </div>
        </wp-table-row>
      </div>
      <div class="wp-no-record" ng-hide="litps.length > 0">当前尚没有记录</div>
      <wp-paginate page-model="page_litps"></wp-paginate>
    </div>
  </div>
</div>
<wp-footer-menu branch-id="branch_id"></wp-footer-menu>

<div class="op-part" wp-scroll-zone>
  <div class="message" style="min-height:200px;">
    <div class="wp-subject">消息区</div>
    <wp-btn ui-sref="shop.branch_setting({ branch_id: branch_id })">菜品超时设置</wp-btn>
    <wp-table-row ng-repeat="msg in notifications"
                  ng-class="{'new': msg.is_new}"
                  ng-click="msg.is_new = false;"
                  >
      <div class="wp-table-col">{{msg.content}}</div>
    </wp-table-row>
  </div>
</div>

<wp-modal wp-show="cooks_modal.show">
  <div class="wp-modal-header">厨师过滤</div>
  <div class="wp-modal-content">
    <wp-btn ng-click="cooks_modal.select_cook(null)" ng-show="active_cook">取消过滤</wp-btn>
    <wp-btn ng-click="cooks_modal.select_cook(cook)"
            ng-repeat="cook in cooks"
            ng-class="{'active': cook == active_cook}">
    {{cook.name}}</wp-btn>
  </div>
</wp-modal>

<wp-modal wp-show="tables_modal.show">
  <div class="wp-modal-header">桌台过滤</div>
  <div class="wp-modal-content">
    <wp-btn ng-click="tables_modal.select_table(null)" ng-show="active_table">取消过滤</wp-btn>
    <wp-btn ng-click="tables_modal.select_table(table)"
            ng-repeat="table in tables_modal.tables"
            ng-class="{'active': table == active_table}">
    {{table.name_with_zone}}</wp-btn>
  </div>
</wp-modal>

<wp-modal wp-show="categories_modal.show">
  <div class="wp-modal-header">分类过滤</div>
  <div class="wp-modal-content">
    <wp-btn ng-click="categories_modal.select_category(null)" ng-show="active_category">取消过滤</wp-btn>
    <wp-btn ng-click="categories_modal.select_category(category)"
            ng-repeat="category in categories_modal.categories"
            ng-class="{'active': category == active_category}">
    {{category.name_with_parent}}</wp-btn>
  </div>
</wp-modal>