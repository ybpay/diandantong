<wp-modal wp-show="change_weight_modal.show">
  <div class="wp-modal-header">修改重量</div>
  <div class="wp-modal-content">
    <div class="wp-form-group">
      <div class="wp-form-label">{{change_weight_modal.itemable.name}}</div>
      <wp-input class="change-weight" input-model="change_weight_modal.weight" input-type="number" input-size="normal"></wp-input>
    </div>
    <div class="wp-modal-actions">
      <wp-btn ng-click="change_weight_modal.submit()" class="default-action">确定</wp-btn>
      <wp-btn ng-click="change_weight_modal.close()">取消</wp-btn>
    </div>
  </div>
</wp-modal>
