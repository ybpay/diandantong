  <wp-modal wp-show="trace_waiter_modal.show">
    <div class="wp-modal-header">记录点菜员</div>
    <div class="wp-modal-content">
      <div ng-repeat="waiter in trace_waiter_modal.waiters">
          <wp-btn ng-class="{active: trace_waiter_modal.waiter_id == waiter.id}" ng-click="trace_waiter_modal.click(waiter.id)">{{waiter.name}}</wp-btn>
      </div>
      <div class="clearfix"></div>
      <div class="wp-form-group">
        <div class="wp-form-action right">
          <wp-btn ng-click="trace_waiter_modal.submit()"
                  class="default-action"
                  ng-class="{'disabled': !trace_waiter_modal.can_submit()}">确定</wp-btn>
          <wp-btn ng-click="trace_waiter_modal.close()">返回</wp-btn>
        </div>
      </div>
    </div>
  </wp-modal>
