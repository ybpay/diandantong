<div ng-include src="partial('header')" include-replace></div>
<div ng-include src="partial('shops/footer')" include-replace></div>
<div class="navigation-toolbar" ng-class="{'active':navigation_msg}">{{navigation_msg}}</div>

<div id="shop-show-page" class="main-view" wp-scroll-zone>
  <div class="branches">
    <div class="clearfix"></div>
    <div class="branch-btn" ng-repeat="branch in branches" ng-click="go_branch(branch)">
      <div class="shop-name">{{::shop.name}}</div>
      <div class="branch-name">{{::branch.name}}</div>
      <div class="dot"></div>
    </div>
    <div class="space"></div>
  </div>
</div>
