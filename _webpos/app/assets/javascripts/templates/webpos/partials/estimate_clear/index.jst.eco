<!-- 按分类查找产品，并设置估清或上架 -->
<!--
    分类列表（单行）
    ================================
    产品列表（多行）
-->

<div ng-include src="partial('header')" include-replace></div>
<div wp-footbar branch-id='{{branch.id}}' ng-if="branch"></div>

<div class="branch-show-page main-view" ng-if="branch.on_shift">
    <div ng-include src="partial('_cells/product_choose')" include-replace></div>
    <div class="op-part estimate-clear-list" wp-scroll-zone>
        <div class="wp-subject">已估清商品列表<span class="red">(点击去除估清)</span></div>
        <div class="wp-table">
            <wp-table-row>
                <div class="wp-table-col col-1">序号</div>
                <div class="wp-table-col col-5">名称</div>
                <div class="wp-table-col col-2">库存量</div>
            </wp-table-row>
            <wp-table-row ng-repeat="variant in variants"
                          ng-click="remove(variant)"
                          class="transition">
                <div class="wp-table-col col-1">{{$index+1}}</div>
                <div class="wp-table-col col-5">{{variant.name}}</div>
                <div class="wp-table-col col-2">
                  {{variant.stock_quantity}}
                  <span ng-show="variant.estimate_clear_reciprocal"> [数量沽清]</span>
                </div>
            </wp-table-row>
        </div>
    </div>
</div>

<wp-modal wp-show="estimate_clear_modal.show">
  <div class="wp-modal-header">估清类型选择</div>
  <div class="wp-modal-content">
    <wp-btn ng-click="estimate_clear_modal.change_type('direct')" class="hover" ng-class="{active: estimate_clear_modal.type == 'direct'}">直接估清</wp-btn>
    <wp-btn ng-click="estimate_clear_modal.change_type('add_reciprocal')" class="hover" ng-class="{active: estimate_clear_modal.type == 'add_reciprocal'}">数量估清</wp-btn>
    <div class="wp-form-group" ng-show="estimate_clear_modal.type == 'add_reciprocal'">
      <div class="wp-form-label">请填写估清前可卖数量</div>
      <wp-input input-model="estimate_clear_modal.stock_quantity" input-type="number" input-size="normal"></wp-input>
      <div class="wp-form-label right">(目前库存量:{{estimate_clear_modal.variant.stock_quantity}})</div>
    </div>
    <wp-btn ng-click="estimate_clear_modal.change_type('remove_reciprocal')" class="hover" ng-class="{active: estimate_clear_modal.type == 'remove_reciprocal'}" ng-show="estimate_clear_modal.reciprocal">去除数量估清</wp-btn>
    <div class="clearfix"></div>
    <div class="wp-modal-actions">
      <wp-btn ng-click="estimate_clear_modal.submit()">确定</wp-btn>
      <wp-btn ng-click="estimate_clear_modal.close()">取消</wp-btn>
    </div>
  </div>
</wp-modal>
