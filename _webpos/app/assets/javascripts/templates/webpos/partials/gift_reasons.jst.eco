<wp-modal wp-show="gift_reasons_modal.show">
  <div class="wp-modal-header">赠菜理由</div>
  <div class="wp-modal-content">
    <div class="wp-form-group">
      <div class="wp-form-label">赠菜理由</div>
      <wp-btn ng-repeat="gift_reason in gift_reasons_modal.gift_reasons"
              ng-click="gift_reasons_modal.select(gift_reason)"
              ng-class="{active: gift_reason.name == gift_reasons_modal.active_gift_reason}">
        {{::gift_reason.name}}
      </wp-btn>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label"></div>
      <div class="wp-form-action">
        <wp-btn ng-click="gift_reasons_modal.submit()" class="default-action">确认</wp-btn>
        <wp-btn ng-click="gift_reasons_modal.close()" class="cancel-action">取消</wp-btn>
      </div>
    </div>
  </div>
</wp-modal>
