<div class="account-info" ng-show="account">
      <div class="wp-account" ng-show="account.id">
        <wp-table-row>         
          <div class="wp-table-col col-1">电话</div>
          <div class="wp-table-col col-7">用户ID</div>
          <div class="wp-table-col col-3">Email</div>
          <div class="wp-table-col col-3">商铺ID</div>
          <div class="wp-table-col col-3">账户ID</div>
        </wp-table-row>
        <wp-table-row>
          <div class="wp-table-col col-1">{{account.phone}}</div>
          <div class="wp-table-col col-7">{{account.id}}</div>
          <div class="wp-table-col col-3">{{account.email}}</div>
          <div class="wp-table-col col-3">{{account.shop_id}}</div>
          <div class="wp-table-col col-3">{{account.id}}</div>
        </wp-table-row>        
      </div>
</div>