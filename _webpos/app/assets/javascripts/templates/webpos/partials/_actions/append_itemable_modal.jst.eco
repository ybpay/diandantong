<wp-modal wp-show="append_itemable_modal.show">
  <div class="wp-modal-header">加菜确认</div>
  <div class="wp-modal-content">
    <div class="wp-append-itemable-content">
      <div style="float:left">
        <div class="wp-form-group" ng-repeat="itemable in append_itemables_l">
          <div class="wp-form-label"></div>
          <div class="wp-form-input" style="font-size: 15px;line-height:20px;height: 30px;">
            {{itemable.name}}
            <span ng-if="itemable.note">[{{itemable.note}}]</span>
            <span ng-if="itemable.gift" class="red">(赠)</span>
            * {{itemable.quantity}}
          </div>
        </div>
      </div>
      <div style="float:left">
        <div class="wp-form-group" ng-repeat="itemable in append_itemables_r">
          <div class="wp-form-label"></div>
          <div class="wp-form-input" style="font-size: 15px;line-height:20px;height: 30px;">
            {{itemable.name}}
            <span ng-if="itemable.note">[{{itemable.note}}]</span>
            <span ng-if="itemable.gift" class="red">(赠)</span>
            * {{itemable.quantity}}
          </div>
        </div>
      </div>
    </div>
    <div style="clear:both"></div>
    <div class="wp-form-group">
      <div class="wp-form-label"></div>
      <div class="wp-form-action">
        <wp-btn ng-click="append_itemable_modal.submit()"
                ng-class="{'disabled': !append_itemable_modal.can_submit()}"
                class="default-action">确定</wp-btn>
        <wp-btn ng-click="append_itemable_modal.cancel()">取消</wp-btn>

      </div>
    </div>
  </div>
</wp-modal>
