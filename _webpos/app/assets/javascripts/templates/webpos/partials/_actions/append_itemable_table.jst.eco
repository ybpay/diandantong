<div class="wp-append-itemable-list">
  <div class="wp-subject">加菜列表</div>
  <div class="wp-table">
    <wp-table-row>
      <div class="wp-table-col col-1">序号</div>
      <div class="wp-table-col col-7">名称</div>
      <div class="wp-table-col col-3">数量</div>
      <div class="wp-table-col col-3">单价</div>
    </wp-table-row>
    <wp-table-row ng-repeat-start="itemable in append_itemables | orderBy:'index':true"
                  ng-click="change_active_append_itemable(itemable)"
                  ng-class="{'active': itemable.active }">
      <div class="wp-table-col col-1">{{append_itemables.length-$index}}</div>
      <div class="wp-table-col col-7">
        {{itemable.name}}
        <span ng-show="itemable.note">[{{itemable.note}}]</span>
        <span ng-show="itemable.gift" class="red">(赠)</span>
      </div>
      <div class="wp-table-col col-3">{{itemable.quantity}} </div>
      <div class="wp-table-col col-3">
        {{itemable.price|currency:''}}
      </div>
    </wp-table-row>
    <div ng-repeat-end class="append-actions" ng-if="itemable.active">
      <div class="append-actions-wrapper">
        <div class="cart-action-btn" ng-click="add_append_itemable(itemable)">
          <i class="fa fa-plus fa-2x red"></i>
        </div>
        <div class="cart-action-btn" ng-click="remove_append_itemable(itemable)">
          <i class="fa fa-minus fa-2x red"></i>
        </div>
        <wp-btn-sm class="fillet" ng-click="edit_line_item(itemable)" ng-show="true">
          修改
        </wp-btn-sm>
        <wp-btn-sm ng-click="change_append_itemable_note(itemable)">
          品注
        </wp-btn-sm>
        <wp-btn-sm ng-click="change_append_itemable_gift(itemable)"
                   ng-class="{active: itemable.gift}">
          赠菜
        </wp-btn-sm>
      </div>
    </div>
  </div>
  <div class="actions">
    <div class="clearfix"></div>
    <wp-btn-sm ng-class="{'disabled':!can_append_itemables()}"
               ng-click="confirm_append_itemables()"
               class="hover">加菜提交</wp-btn-sm>
    <wp-btn-sm ng-click="clear_append_itemables()"
               class="hover">清空</wp-btn-sm>
  </div>
  <div class="wp-form-group">
    <div class="wp-form-label wp-form-label-xs">备注</div>
    <wp-input input-model="append.note" input-type="text" input-size="normal"></wp-input>
  </div>
</div>
