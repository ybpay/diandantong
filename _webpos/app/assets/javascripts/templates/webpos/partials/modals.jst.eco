<div class="wp-modals">
  <wp-confirm-modal
                    style="z-index: 3000"
                    wp-show="confirm_modal.show"
                    wp-lock-mask="confirm_modal.lock_mask"
                    wp-confirm-info="{{confirm_modal.info}}"
                    wp-ok-text="{{confirm_modal.ok_text}}"
                    wp-cancel-text="{{confirm_modal.cancel_text}}"
                    wp-ok="confirm_modal.ok();"
                    wp-cancel="confirm_modal.cancel();">
  </wp-confirm-modal>
</div>

<wp-alert wp-show="alert_toast.show" wp-alert-info="{{alert_toast.info}}">
</wp-alert>
