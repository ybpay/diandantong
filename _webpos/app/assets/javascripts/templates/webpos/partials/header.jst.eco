<div class="wp-header">
  <div class="header-brand" ng-click="go('/');" ng-hide="branch">{{ shop.name }}</div>
  <div class="header-brand" ng-click="go_branch(branch);" ng-show="branch">{{ branch.name }}</div>
  <div class="header-main">
    <div class="header-action" ng-click="back()" title="后退" ng-class="{disabled: isLoading()}"><i class="fa fa-arrow-left"></i></div>
    <div class="header-action" ng-click="reload()" title="刷新"><i class="fa fa-refresh"></i></div>
    <div class="header-action" title="在线模式"><i class="fa fa-lightbulb-o red"></i></div>
    <!-- <wp-btn-sm ng-show="branch && branch.on_shift"
               ng-click="go('/branches/' + branch_id + '/notification')">
      消息
      <span class="point-number" ng-show="notification_length()">{{notification_length()}}</span>
    </wp-btn-sm> -->
    <wp-btn-sm ng-show="branch && can('branch', 'branch', 'open_shift')"
               ng-class="{disabled: !open_shift_modal.can_open()}"
               ng-click="open_shift_modal.open()">
      开班
    </wp-btn-sm>
    <wp-btn-sm ng-show="branch && can('branch', 'branch', 'close_shift')"
               ng-class="{disabled: !close_shift_modal.can_open()}"
               wp-click="close_shift_modal.open()">
      交班
    </wp-btn-sm>
    <div class="account-name">
      <i class="fa fa-user"></i> {{ account.name || '未登录' }}
    </div>
    <div class="system-time">{{system_time | date: 'yyyy/MM/dd HH:mm:ss'}}</div>
  </div>
  <div class="header-right">
    <div class="action">
        <wp-link href="{{shop.domain||'http://cy.diandantong.com'}}" target="_blank">
            <i class="fa fa-tachometer"></i>
        </wp-link>
    </div>
    <div class="action" ng-click="open_cashbox();" ng-show="is_cef && can('branch', 'order', 'settle')" title="弹钱箱"><i class="fa fa-inbox"></i></div>
    <div class="action" ng-click="toggle_jvk();" ng-class="{active: enable_jvk}" title="虚拟键盘"><i class="fa fa-keyboard-o"></i></div>
    <div class="action" ng-click="go_notification()">
      <i class="fa fa-bell"></i>
      <div class="number" ng-show="notification_length()">{{notification_length()}}</div>
    </div>
    <div class="action" ng-click="go('/settings')"><i class="fa fa-cog"></i></div>
    <div class="action" ng-click="sign_out()"><i class="fa fa-sign-out"></i></div>
  </div>
</div>
<div class="alert-messages">
    <span ng-repeat="alert_message in alert_messages" ng-click="click_alert_message(alert_message)">
    <label ng-click="click_alert_message(alert_message)">
      <i class="fa fa-volume-up"></i>&nbsp;{{alert_message.label}}
    </label>
  </span>
</div>

<wp-modal wp-show="open_shift_modal.prompt">
  <div class="wp-modal-header">注意</div>
  <div class="wp-modal-content">
    <div class="wp-form-group">
      <div class="wp-form-label">你今天已开过{{open_shift_modal.open_shift_num}}次班，是否继续开班？</div>
    </div>
    <div class="wp-form-group">
    <div class="wp-form-label"></div>
      <div class="wp-form-action">
        <wp-btn wp-click="open_shift_modal.ok()">确定</wp-btn>
        <wp-btn ng-click="open_shift_modal.close()">取消</wp-btn>
      </div>
    </div>
  </div>
</wp-modal>

<wp-modal wp-show="open_shift_modal.show">
  <div class="wp-modal-header">开班</div>
  <div class="wp-modal-content">
    <div class="wp-form-group">
      <div class="wp-form-label">放入现金</div>
      <wp-input input-model="open_shift_modal.pre_cash_amount" input-type="number" input-size="normal" input-restrict="^[0-9]{0,6}(\.[0-9]{0,2})?$" input-focus="open_shift_modal.show"></wp-input>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label"></div>
      <div class="wp-form-action">
        <wp-btn wp-click="open_shift_modal.submit()">开班</wp-btn>
        <wp-btn ng-click="open_shift_modal.close()">取消</wp-btn>
      </div>
    </div>
  </div>
</wp-modal>

<wp-modal wp-show="close_shift_modal.show">
  <div class="wp-modal-header">交班</div>
  <div class="wp-modal-actions">
    <wp-btn ng-click="close_shift_modal.sdu_upload_orders()" ng-show="branch.enable_sdu && !branch.auto_upload_after_shift">上传订单数据</wp-btn>
    <wp-btn ng-click="close_shift_modal.sdu_query_orders()" ng-show="branch.enable_sdu && !branch.auto_upload_after_shift">查询上传数据</wp-btn>
    <wp-btn ng-click="close_shift_modal.print()">打印交班记录</wp-btn>
    <wp-btn ng-click="close_shift_modal.print_recharge()">打印充值记录</wp-btn>
    <wp-btn ng-click="close_shift_modal.submit()" ng-class="{'disabled': !close_shift_modal.can_submit()}">确定交班</wp-btn>
    <wp-btn ng-click="close_shift_modal.close()">取消</wp-btn>
  </div>
  <div class="wp-modal-content close-shift-modal-content">
    <div class="bill-preview" ng-bind-html="close_shift_modal.shift.print_text_html | unsafe">
    </div>
    <div class="bill-preview" ng-bind-html="close_shift_modal.shift.recharge_print_text_html | unsafe">
    </div>
    <!-- <div class="wp-form-group">
      <div class="wp-form-label">开班人:</div>
      <div class="wp-form-input">{{::branch.shift_account_name}}</div>
      <div class="wp-form-label">当班人:</div>
      <div class="wp-form-input">{{::account.name}}</div>
      <div class="wp-form-label">当班时间:</div>
      <div class="wp-form-input">{{::close_shift_modal.shift.created_at|date:'MM-dd HH:mm'}} ~ {{::close_shift_modal.shift.current_time | date:'MM-dd HH:mm'}}</div>
    </div>
    <div class="wp-table center">
      <wp-table-row>
        <div class="wp-table-col col-3">科目代码</div>
        <div class="wp-table-col col-3">支付方式</div>
        <div class="wp-table-col col-3">支付金额</div>
      </wp-table-row>
      <wp-table-row ng-repeat="item in close_shift_modal.shift.shift_items">
        <div class="wp-table-col col-3">{{::item.pay_method_code}}</div>
        <div class="wp-table-col col-3">{{::item.pay_method_name}}</div>
        <div class="wp-table-col col-3">
          {{::item.amount}}
          <div ng-show="item.cash_amount">实收 {{::item.cash_amount}}</div>
          <div ng-show="item.extra_amount">附属 {{::item.extra_amount}}</div>
        </div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">合计金额</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.total_amount}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">实收金额</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.total_actual_amount}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">非实收</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.total_discount_amount}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">未结算</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.unpaid_amount}}</div>
      </wp-table-row>
      <wp-table-row ng-show="close_shift_modal.shift.recharge_amount">
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">会员卡充值金额</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.recharge_amount}}</div>
      </wp-table-row>
      <wp-table-row ng-show="close_shift_modal.shift.exchange_amount">
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">会员卡兑换金额</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.exchange_amount}}</div>
      </wp-table-row>
      <wp-table-row ng-show="close_shift_modal.shift.pre_cash_amount">
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">放入现金</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.pre_cash_amount}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">人数</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.total_customter_count}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">来自微信</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.order_from_wechat_count}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">来自收银端</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.order_from_webpos_count}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">来自APP</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.order_from_app_count}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">堂点单数</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.total_eat_in_hall_order_count}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">人均消费</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.per_capita_consumption}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">单均消费</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.per_eat_in_hall_order_consumption}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">退菜数量</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.subtract_item_count}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">退菜金额</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.total_subtract_item_amount}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">折扣金额</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.discount_amount}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-3">&nbsp;</div>
        <div class="wp-table-col col-3">抹零</div>
        <div class="wp-table-col col-3">{{close_shift_modal.shift.moling_amount}}</div>
      </wp-table-row>
    </div> -->
  <div>
</wp-modal>

