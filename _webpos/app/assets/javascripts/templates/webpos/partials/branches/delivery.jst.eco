<div ng-include src="partial('header')" include-replace></div>
<div wp-footbar branch-id='{{branch.id}}' ng-if="branch"></div>

<div class="branch-show-page main-view">
  <div ng-include src="partial('_cells/product_choose')" include-replace></div>
  <div ng-include src="partial('_modals/edit_line_item')" include-replace></div>
  <div class="op-part" wp-scroll-zone>
    <div class="actions">
      <wp-btn ng-show="cart.line_items.length"
                  ng-click="clear()">清空</wp-btn>
      <wp-btn ng-click="address_modal.open();">下单信息</wp-btn>
      <wp-btn ng-class="{'disabled':!can_submit()}"
              ng-click="submit()">落单</wp-btn>
      <wp-btn ng-click="batch_change_note()">批量品注</wp-btn>
    </div>
    <div class="wp-subject">外卖点菜</div>
    <div class="cart-line-item-index">
      <table class="wp-table-sm" ng-show="cart.line_items.length">
        <thead>
          <th width="10%">序号</th>
          <th width="50%">名称</th>
          <th width="15%">数量</th>
          <th width="25%">单价</th>
        </thead>
        <tbody>
          <tr ng-repeat-start="line_item in cart.line_items"
              ng-click="change_active_line_item(line_item)"
              ng-class="{active:line_item.active, odd: $index % 2 == 0}"
              class="transition">
            <td>{{$index+1}}</td>
            <td>
              {{line_item.name}}
              <span ng-show="line_item.note">[{{line_item.note}}]</span>
              <span class="red" ng-if="line_item.gift">(赠)</span>
            </td>
            <td>{{line_item.quantity}}</td>
            <td>{{line_item.price |currency:''}}</td>
          </tr>
          <tr ng-repeat-end class="actions" ng-if="line_item.active">
            <td colspan="4">
              <div class="cart-action-btn" ng-click="add_itemable(line_item)">
                <i class="fa fa-plus fa-2x red"></i>
              </div>
              <div class="cart-action-btn" ng-click="remove_itemable(line_item)">
                <i class="fa fa-minus fa-2x red"></i>
              </div>
              <wp-btn-sm class="fillet" ng-click="edit_line_item(line_item)" ng-show="true">
                修改
              </wp-btn-sm>
              <wp-btn-sm class="fillet" ng-click="change_note(line_item)">
                品注
              </wp-btn-sm>
              <wp-btn-sm class="fillet" ng-click="change_gift(line_item)"
                         ng-class="{active: line_item.gift}">
                赠菜
              </wp-btn-sm>
            </td>
          </tr>
          <tr ng-if="delivery_fee">
            <td></td>
            <td>配送费</td>
            <td></td>
            <td>{{delivery_fee|currency:shop.currency}}</td>
          </tr>
        </tbody>
      </table>
      <div class="table-order-total" ng-show="cart.line_items.length">合计: {{order_total()|currency:shop.currency}}</div>
    </div>
    <div class="wp-subject">下单信息</div>
    <div class="detail-info">
      <div class="detail-info-item">
        <div class="info-name">电话</div>
        <div class="info-value">{{shipment.phone}}</div>
      </div>
      <div class="detail-info-item">
        <div class="info-name">姓名</div>
        <div class="info-value">{{shipment.name}}</div>
      </div>
      <div class="detail-info-item">
        <div class="info-name">地址</div>
        <div class="info-value">{{shipment.building}}-{{shipment.room_no}}</div>
      </div>
      <div class="detail-info-item">
        <div class="info-name">配送区域</div>
        <div class="info-value">{{shipment.delivery_zone.zone_name}}</div>
      </div>
      <div class="detail-info-item">
        <div class="info-name">配送日期</div>
        <div class="info-value">{{shipment.delivery_date.display}}</div>
      </div>
      <div class="detail-info-item">
        <div class="info-name">配送时间</div>
        <div class="info-value">{{shipment.delivery_time.display}}</div>
      </div>
      <div class="detail-info-item">
        <div class="info-name">配送员</div>
        <div class="info-value">{{shipment.delivery_man.name}}</div>
      </div>
      <div class="detail-info-item" ng-repeat="element in form_elements">
        <div class="info-name">{{element.label}}</div>
        <div class="info-value">{{element.record.content}}</div>
      </div>
      <div class="detail-info-item">
        <div class="info-name">备注</div>
        <div class="info-value">{{shipment.note}}</div>
      </div>
    </div>
  </div>
</div>
<wp-modal wp-show="address_modal.show">

  <!-- main -->
  <div ng-show="address_modal.k == 'main'">
    <div class="wp-modal-header">请填写外卖信息</div>
    <div class="wp-modal-content">
      <div class="wp-form-group">
        <div class="wp-form-label">电话</div>
        <wp-input input-model="shipment.phone" input-type="text" input-size="large" ></wp-input>
      </div>
      <div class="wp-form-group">
        <div class="wp-form-label"></div>
        <wp-btn ng-repeat="address in addresses_collection" ng-click="select_address(address)">
          {{::address.phone}}-{{::address.name}}-{{::address.building}}-{{::address.room_no}}
        </wp-btn>
      </div>
      <div class="wp-form-group">
        <div class="wp-form-label">姓名</div>
        <wp-input input-model="shipment.name" input-type="text" input-size="large"></wp-input>
      </div>
      <div class="wp-form-group">
        <div class="wp-form-label">小区</div>
      <!--
        <wp-input ng-if="shop.enable_foreign" input-model="shipment.building" input-type="text" input-size="large" placeholder="输入小区/大厦/学校等"></wp-input>
        <wp-btn-sm ng-if="!shop.enable_foreign && !is_building_valid()" ng-click="address_modal.toggle('posi')">选择地址</wp-btn-sm>
        <wp-btn-sm ng-if="!shop.enable_foreign && is_building_valid()" ng-click="address_modal.toggle('posi')">更改地址</wp-btn-sm>
        <div class="wp-form-label" ng-if="!shop.enable_foreign && is_building_valid()">{{shipment.building}}</div>
      -->
        <wp-input input-model="shipment.building" input-type="text" input-size="large"></wp-input>
      </div>
      <div class="wp-form-group">
        <div class="wp-form-label">门牌号</div>
        <wp-input input-model="shipment.room_no" input-type="text" input-size="large"></wp-input>
      </div>
      <div class="wp-form-group" ng-if="can_show_delivery_zone()">
        <div class="wp-form-label">配送区域</div>
        <div class="wp-form-select">
          <select class="wp-form-select-small" ng-model="shipment.delivery_zone" ng-options="delivery_zone as delivery_zone.zone_name for delivery_zone in delivery_zones"></select>
        </div>
      </div>
      <div class="wp-form-group" ng-if="can_show_delivery_date()">
        <div class="wp-form-label">配送时间</div>
        <div class="wp-form-select">
          <select class="wp-form-select-small" ng-change="change_delivery_date()" ng-model="shipment.delivery_date" ng-options="delivery_date as delivery_date.display for delivery_date in delivery_dates"></select>
          <select class="wp-form-select-small" ng-if="can_show_delivery_time()" ng-model="shipment.delivery_time" ng-options="delivery_time as delivery_time.display for delivery_time in delivery_times"></select>
        </div>
      </div>
      <div class="wp-form-group" ng-if="can_show_delivery_man()">
        <div class="wp-form-label">配送员</div>
        <div class="wp-form-select">
          <select class="wp-form-select-small" ng-model="shipment.delivery_man" ng-options="delivery_man as delivery_man.name for delivery_man in delivery_mans"></select>
        </div>
      </div>
      <div class="wp-form-group" ng-repeat="element in form_elements">
        <div class="wp-form-label">{{element.label}}</div>
        <div class="wp-form-select" ng-if="element.type == 'Ddt::FormElementSelect'">
          <select class="wp-form-select-small" ng-model="element.record.content" ng-options="option.option_id as option.html for option in element.options"></select>
        </div>
        <wp-input ng-if="element.type == 'Ddt::FormElementText'" input-model="element.record.content" input-type="text" input-size="large"></wp-input>
      </div>
      <div class="wp-form-group">
        <div class="wp-form-label">备注</div>
        <wp-input input-model="shipment.note" input-type="text" input-size="large"></wp-input>
      </div>
      <div class="wp-form-group">
        <div class="wp-form-label"></div>
        <div class="wp-form-action">
          <wp-btn ng-click="address_modal.show = false;">确定</wp-btn>
          <div class="space"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- posi -->
  <div ng-show="address_modal.k == 'posi'">
    <div class="wp-modal-header">请搜索选择地址</div>
    <div class="wp-modal-content">
      <div class="wp-form-group" ng-if="shipment.name && shipment.phone">
        <div class="wp-form-label">顾客</div>
        <div class="wp-form-label">{{shipment.name}}-{{shipment.phone}}</div>
      </div>
      
      <div class="wp-form-group">
        <div class="wp-form-label">搜索</div>
        <wp-input input-model="address_modal.keyworld" input-type="text" input-size="middle" placeholder="输入小区/大厦/学校"></wp-input>
      </div>
      <div class="wp-table">
        <wp-table-row ng-repeat="address in address_modal.addresses"
                      ng-click="address_modal.select_address(address)"
                      ng-class="{'active': address == address_modal.selected }">
          <div class="wp-table-col col-12">{{address.name}} —— {{address.address}}</div>
        </wp-table-row>
      <div class="wp-form-group">
        <div class="wp-form-label"></div>
        <div class="wp-form-action">
          <wp-btn ng-click="address_modal.finish_search()">确定</wp-btn>
          <div class="space"></div>
        </div>
      </div>
    </div>
  </div>
</wp-modal>
