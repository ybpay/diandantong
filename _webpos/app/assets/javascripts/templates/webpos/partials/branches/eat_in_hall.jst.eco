<div wp-include src="partial('header')"></div>
<div wp-footbar branch-id='{{branch.id}}' ng-if="branch"></div>
<div class="navigation-toolbar" ng-class="{'active':navigation_msg}">{{navigation_msg}}</div>

<div class="branch-show-page main-view" ng-hide="is_cashier() && !branch.on_shift">
  <div wp-include src="partial('_cells/table_choose')" ng-if="show_tables()"></div>
  <div wp-include src="partial('_cells/product_choose')" ng-if="show_products()"></div>
  <div wp-include src="partial('_cells/order_choose')" ng-if="show_reservation_orders()"></div>
  <div wp-include src="partial('_cells/subtractable_choose')" ng-if="show_subtractables()"></div>
  <div wp-include src="partial('_cells/moveable_choose')" ng-if="show_moveables()"></div>
  <div wp-include src="partial('_cells/table')"></div>
</div>
