<div wp-include src="partial('header')"></div>
<div wp-footbar branch-id='{{branch.id}}' ng-if="branch"></div>

<div class="branch-show-page main-view">
  <div wp-include src="partial('_cells/product_choose')"></div>
  <div wp-include src="partial('_modals/edit_line_item')"></div>
  <div class="op-part" ng-hide="order_id" wp-scroll-zone>
    <div class="actions">
      <wp-btn ng-click="food_number_modal.show = true">录入牌号</wp-btn>
      <wp-btn ng-show="cart.line_items.length"
                  ng-click="clear()">清空</wp-btn>
      <wp-btn ng-class="{'disabled':!can_submit()}"
              ng-click="submit()">下单付款</wp-btn>
    </div>
    <div class="wp-subject">当前牌号</div>
    <div>
      <div class="h2" ng-hide="food_number_modal.food_number">系统自动生成</div>
      <div class="h2" ng-show="food_number_modal.food_number">{{food_number_modal.food_number}}</div>
    </div>
    <div class="wp-subject">快餐点菜</div>
    <div class="cart-line-item-index">
      <table class="wp-table-sm" ng-show="cart.line_items.length">
        <thead>
          <th width="10%">序号</th>
          <th width="50%">名称</th>
          <th width="15%">数量</th>
          <th width="25%">单价</th>
        </thead>
        <tbody>
          <tr wp-repeat-start="line_item in cart.line_items | orderBy:'index':true"
              dom-reuse="fix"
              ng-click="change_active_line_item(line_item)"
              ng-class="{active:line_item.active, odd: $index % 2 == 0}"
              class="transition">
            <td>{{$index+1}}</td>
            <td>
              {{line_item.name}}
              <span ng-show="line_item.note">[{{line_item.note}}]</span>
              <span class="red" ng-show="line_item.gift">(赠)</span>
            </td>
            <td>{{line_item.quantity}}</td>
            <td>{{line_item.price |currency:''}}</td>
          </tr>
          <tr wp-repeat-end class="actions" ng-show="line_item.active">
            <td colspan="4">
              <div class="cart-action-btn" ng-click="add_itemable(line_item)">
                <i class="fa fa-plus fa-2x red"></i>
              </div>
              <div class="cart-action-btn" ng-click="remove_itemable(line_item)">
                <i class="fa fa-minus fa-2x red"></i>
              </div>
              <wp-btn-sm class="fillet" ng-click="edit_line_item(line_item)" ng-show="true">
                修改
              </wp-btn-sm>
              <wp-btn-sm class="fillet" ng-click="change_note(line_item)">
                品注
              </wp-btn-sm>
              <wp-btn-sm class="fillet" ng-click="change_gift(line_item)"
                         ng-class="{active: line_item.gift}">
                赠菜
              </wp-btn-sm>
            </td>
          </tr>
        </tbody>
      </table>
      <div class="table-order-total" ng-show="cart.line_items.length">合计: {{cart.total|currency:shop.currency}}</div>
      <div class="wp-form-group">
        <div class="wp-form-label wp-form-label-xs">备注</div>
        <wp-input input-model="note" input-type="text" input-size="normal"></wp-input>
      </div>
    </div>
  </div>

  <wp-modal wp-show="food_number_modal.show">
    <div class="wp-modal-header">请录入牌号</div>
    <div class="wp-modal-content">
      <div class="wp-form-group">
        <div class="wp-form-label wp-form-label-xs">牌号</div>
        <wp-input input-model="food_number_modal.food_number" input-type="number" input-size="normal" input-focus="food_number_modal.show"></wp-input>
      </div>

      <div class="wp-form-group">
        <div class="wp-form-label"></div>
        <div class="wp-form-action">
          <wp-btn ng-click="food_number_modal.confirm()" ng-class="{'disabled': !food_number_modal.can_confirm()}">确认</wp-btn>
          <wp-btn ng-click="food_number_modal.cancel()">取消</wp-btn>
        </div>
      </div>
    </div>

  <wp-modal>
</div>

<div wp-include src="partial('_actions/fastfood_extended_form')"></div>