<div ng-include src="partial('header')" include-replace></div>
<div wp-footbar branch-id='{{branch.id}}' ng-if="branch"></div>

<div class="branch-reservation-page main-view">
  <div class="master-part">
    <div class="menu-part" wp-scroll-zone>
      <div>
        <div class="menu" ng-repeat="date in reservation_dates"
                ng-click="change_active_date(date)"
                ng-class="{active: active_date == date }"
                ng-if="branch.use_reservation_setting">
          {{::date.first_label}} {{ ::date.second_label }}
        </div>
        <div class="menu" ng-if="!branch.use_reservation_setting">
          未启用预订
        </div>
      </div>
    </div>
    <div class="master-part-with-menu" wp-scroll-zone ng-if="branch.use_reservation_setting">
      <div>
        <div ng-repeat="table_zone in table_zones">
          <wp-btn-sm class="fillet" ng-repeat="time_point in table_zone.reservation_time_points"
                      ng-click="change_active_time_point(time_point)"
                      ng-class="{ 'active': active_time_point == time_point, 'disabled': is_disabled(time_point)}">
            {{ ::table_zone.name }}
            {{ ::time_point.time_point }}
            剩余{{ time_point.remain_table_counts[active_date.position] }}
          </wp-btn-sm>
          <div class="space"></div>
        </div>
        <div class="space"></div>
        <div class="clearfix"></div>
        <div class="tables">
          <wp-btn-md class="product-btn" ng-repeat="table in active_time_point.tables"
                  ng-class="{ 'active': table == active_table, 'disabled': !table.can_reservation }"
                  ng-click="select_table(table)">
            <div class="product-name">{{::table.name}}</div>
            <div class="product-price">
              <span ng-show="table.capacity">{{::table.capacity}}人桌</span>
              <span ng-hide="table.can_reservation"> 已预订</span>
            </div>
          </wp-btn-md>
          <div class="space"></div>
        </div>
      </div>
    </div>
  </div>
  <div class="op-part" ng-show="branch.use_reservation_setting" wp-scroll-zone>
    <div>
      <div class="wp-modal-content" ng-show="active_table">
        <div class="wp-form-group">
          <div class="wp-form-label wp-form-label-xs">预订时间</div>
          <div class="wp-form-input red">{{active_date.first_label}} {{active_date.second_label}} {{active_time_point.time_point}}</div>
        </div>
        <div class="wp-form-group">
          <div class="wp-form-label wp-form-label-xs">预订桌台</div>
          <div class="wp-form-input red">{{active_table.name_with_zone}}</div>
        </div>
        <div ng-hide="active_table.reservation_info">
          <div class="wp-form-group">
            <div class="wp-form-label wp-form-label-xs">姓名</div>
            <wp-input input-model="reservation_info.name" input-type="text"></wp-input>
          </div>
          <div class="wp-form-group">
            <div class="wp-form-label wp-form-label-xs">性别</div>
            <wp-btn-sm ng-repeat="gender in gender_collection"
                      ng-click="reservation_info.gender = gender.value"
                      ng-class="{active: reservation_info.gender == gender.value}">
              {{::gender.label}}
            </wp-btn-sm>
          </div>
          <div class="wp-form-group">
            <div class="wp-form-label wp-form-label-xs">电话</div>
            <wp-input input-model="reservation_info.phone" input-type="text"></wp-input>
          </div>
          <div class="wp-form-group">
            <div class="wp-form-label wp-form-label-xs">备注</div>
            <wp-input input-model="reservation_info.note" input-type="text"></wp-input>
          </div>
          <div class="wp-form-group">
            <div class="wp-form-action">
              <wp-btn ng-click="submit()" ng-class="{'disabled': !can_submit()}">
                预订
              </wp-btn>
              <div class="space"></div>
            </div>
          </div>
        </div>
        <div ng-show="active_table.reservation_info">
          <div class="wp-form-group">
            <div class="wp-form-label wp-form-label-xs">姓名</div>
            <wp-input input-model="active_table.reservation_info.name" input-type="text"></wp-input>
          </div>
          <div class="wp-form-group">
            <div class="wp-form-label wp-form-label-xs">性别</div>
            <wp-btn-sm ng-repeat="gender in gender_collection"
                      ng-click="active_table.reservation_info.gender = gender.value"
                      ng-class="{active: active_table.reservation_info.gender == gender.value}">
              {{::gender.label}}
            </wp-btn-sm>
          </div>
          <div class="wp-form-group">
            <div class="wp-form-label wp-form-label-xs">电话</div>
            <wp-input input-model="active_table.reservation_info.phone" input-type="text"></wp-input>
          </div>
          <div class="wp-form-group">
            <div class="wp-form-label wp-form-label-xs">备注</div>
            <wp-input input-model="active_table.reservation_info.note" input-type="text"></wp-input>
          </div>
          <div class="wp-form-group">
            <div class="wp-form-action">
              <wp-btn ng-click="submit()">
                更改
              </wp-btn>
              <div class="space"></div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>