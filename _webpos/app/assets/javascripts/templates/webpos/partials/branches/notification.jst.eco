<div ng-include src="partial('header')" include-replace></div>
<div wp-footbar branch-id='{{branch.id}}' ng-if="branch"></div>

<div class="main-view">
  <div class="main-part" wp-scroll-zone>
    <div class="wp-subject">消息列表</div>
    <div class="wp-table">
      <wp-table-row>
        <div class="wp-table-col col-1">序号</div>
        <div class="wp-table-col col-3">标题</div>
        <div class="wp-table-col col-3">内容</div>
        <div class="wp-table-col col-3">时间</div>
        <div class="wp-table-col col-1"></div>
      </wp-table-row>
      <wp-table-row ng-repeat="notification in notifications">
        <div class="wp-table-col col-1">{{$index+1}}</div>
        <div class="wp-table-col col-3">{{notification.title}}</div>
        <div class="wp-table-col col-3">{{notification.content}}</div>
        <div class="wp-table-col col-3">{{notification.created_at|date:'yyyy年MM月dd日 HH:mm'}}</div>
        <div class="wp-table-col col-1"><wp-btn-xs ng-click="remove(notification)">清除</wp-btn-xs></div>
      </wp-table-row>
    </div>
    <wp-btn-md ng-show="notifications.length > 0" ng-click="clear()">清空</wp-btn-md>
    <wp-btn-md ng-show="!enable_play_sound" ng-click="toggle_play_sound()">开启消息音</wp-btn-md>
    <wp-btn-md ng-show="enable_play_sound" ng-click="toggle_play_sound()">关闭消息音</wp-btn-md>
    <wp-btn-md ng-show="!enable_waiter_message" ng-click="set_enable_waiter_message(true)">开启呼叫服务弹窗</wp-btn-md>
    <wp-btn-md ng-show="enable_waiter_message" ng-click="set_enable_waiter_message(false)">关闭呼叫服务弹窗</wp-btn-md>
  </div>
</div>
