<div ng-include src="partial('header')" include-replace></div>
<div ng-include src="partial('shops/footer')" include-replace></div>
 <div class="main-view">
  <div class="main-part">
    <div class="menu-part" wp-scroll-zone>
      <div>
        <div class="menu" ng-repeat="setting in settings"
            ng-class="{active: setting == active_setting}"
            ng-show="setting.show"
            ng-click="change_active_setting(setting)">
          {{::setting.name}}
        </div>
      </div>
    </div>
    <div class="master-part-with-menu">
      <div ng-if="active_setting.key == 'hotkey'" wp-scroll-zone>
        <div>
          <div class="setting-title">快捷键设置</div>
          <div class="wp-form-group" ng-repeat="setting in hotkey_setting.hotkey.settings">
            <div style="display: block;">
              <br /><div>{{::setting.name}}：</div>
              <wp-btn-sm
                ng-click="hotkey_setting.change_key(setting.index, key)"
                ng-class="{'active': hotkey_setting.hotkey[setting.index] == key}"
                ng-repeat="key in setting.select_options">
                {{::key}}
              </wp-btn-sm>
            </div>
          </div>
        </div>
      </div>
      <div ng-if="active_setting.key == 'cash_box'">
        <div class="setting-title">钱箱设置</div>
        <div class="wp-form-group">
          <div class="wp-form-label">现金结算时弹出钱箱</div>
          <wp-btn ng-click="cash_box_setting.change_setting(true)"
                  ng-class="{active: cash_box_setting.auto_open_cash_box }">弹出</wp-btn>
          <wp-btn ng-click="cash_box_setting.change_setting(false)"
                  ng-class="{active: !cash_box_setting.auto_open_cash_box }">不弹</wp-btn>
        </div>
      </div>

      <div ng-if="active_setting.key == 'printer' && new_cef_version">
        <div class="setting-title">当前打印机设置</div>
        <div class="wp-form-group">
          <div class="wp-form-label">打印机类型</div>
          <div class="wp-form-btns">
            <wp-btn-sm ng-repeat="printer_type in printer_setting.printer_types"
                       ng-class="{active: printer_type.value == printer_setting.printer_type}"
                       ng-click="printer_setting.change_printer_type(printer_type.value)">
              {{::printer_type.name}}
            </wp-btn-sm>
          </div>
        </div>
        <div class="wp-form-group" ng-show="printer_setting.printer_type == 'driven'">
          <div class="wp-form-label">打印机</div>
          <div class="wp-form-btns">
            <wp-btn-sm ng-repeat="printer_name in printer_setting.printer_names"
                       ng-class="{active: printer_name == printer_setting.printer_name}"
                       ng-click="printer_setting.change_printer_name(printer_name)">
              {{::printer_name}}
            </wp-btn-sm>
          </div>
        </div>
        <div class="wp-form-group" ng-show="printer_setting.printer_type == 'net'">
          <div class="wp-form-label">网口IP</div>
          <wp-input input-model="printer_setting.printer_net_port" input-type="text" input-size="normal"></wp-input>
        </div>
        <div class="wp-form-group" ng-show="printer_setting.printer_type == 'com'">
          <div class="wp-form-label">串口端口</div>
          <div class="wp-form-btns">
            <wp-btn-sm ng-repeat="printer_com_port in printer_setting.printer_com_ports"
                       ng-class="{active: printer_com_port == printer_setting.printer_com_port}"
                       ng-click="printer_setting.change_printer_com_port(printer_com_port)">
              {{::printer_com_port}}
            </wp-btn-sm>
          </div>
        </div>
        <div class="wp-form-group" ng-show="printer_setting.printer_type == 'com'">
          <div class="wp-form-label">串口波特率</div>
          <div class="wp-form-btns">
            <wp-btn-sm ng-repeat="printer_baud_rate in printer_setting.printer_baud_rates"
                       ng-class="{active: printer_baud_rate == printer_setting.printer_baud_rate}"
                       ng-click="printer_setting.change_printer_baud_rate(printer_baud_rate)">
              {{::printer_baud_rate}}
            </wp-btn-sm>
          </div>
        </div>
        <div class="wp-form-group" ng-show="printer_setting.printer_type == 'lpt'">
          <div class="wp-form-label">并口端口</div>
          <div class="wp-form-btns">
            <wp-btn-sm ng-repeat="printer_lpt_port in printer_setting.printer_lpt_ports"
                       ng-class="{active: printer_lpt_port == printer_setting.printer_lpt_port}"
                       ng-click="printer_setting.change_printer_lpt_port(printer_lpt_port)">
              {{::printer_lpt_port}}
            </wp-btn-sm>
          </div>
        </div>
        <div class="wp-form-group">
          <div class="wp-form-label">纸带类型</div>
          <div class="wp-form-btns">
            <wp-btn-sm ng-repeat="printer_width in printer_setting.printer_widths"
                       ng-class="{active: printer_width.value == printer_setting.printer_width}"
                       ng-click="printer_setting.change_printer_width(printer_width.value)">
              {{::printer_width.name}}
            </wp-btn-sm>
          </div>
        </div>
        <div class="wp-form-group">
          <div class="wp-form-label">打印份数</div>
          <div class="wp-form-btns">
            <wp-btn-sm ng-repeat="printer_times in printer_setting.printer_times_collection"
                       ng-class="{active: printer_times == printer_setting.printer_times}"
                       ng-click="printer_setting.change_printer_times(printer_times)">
              {{::printer_times}}
            </wp-btn-sm>
          </div>
        </div>
        <div class="wp-form-group">
          <div class="wp-form-label"></div>
          <div class="wp-form-btns">
            <wp-btn ng-click="printer_setting.test()">测试打印</wp-btn>
          </div>
        </div>
        <div class="wp-form-group">
          <div class="wp-form-label"></div>
          <div class="wp-form-action">
            <wp-btn ng-click="printer_setting.submit()">确认</wp-btn>
          </div>
        </div>
      </div>
      <div ng-if="active_setting.key == 'printer' && !new_cef_version">
        <div class="setting-title">当前打印机设置 (请升级到新版收银系统)</div>
      </div>
      <div ng-if="active_setting.key == 'customer_display'">
        <div class="setting-title">数字客显设置</div>
        <div class="wp-form-group">
          <div class="wp-form-label">端口名称</div>
          <div class="wp-form-btns">
            <wp-btn-sm ng-repeat="port_name in customer_display_setting.port_names"
                       ng-class="{active: port_name == customer_display_setting.port_name}"
                       ng-click="customer_display_setting.change_port_name(port_name)">
              {{::port_name}}
            </wp-btn-sm>
          </div>
        </div>
        <div class="wp-form-group">
          <div class="wp-form-label">通信波特率</div>
          <div class="wp-form-btns">
            <wp-btn-sm ng-repeat="baud_rate in customer_display_setting.baud_rates"
                       ng-class="{active: baud_rate == customer_display_setting.baud_rate}"
                       ng-click="customer_display_setting.change_baud_rate(baud_rate)">
              {{::baud_rate}}
            </wp-btn-sm>
          </div>
        </div>
        <div class="wp-form-group">
          <div class="wp-form-label"></div>
          <div class="wp-form-action">
            <wp-btn ng-click="customer_display_setting.test()">测试显示'合计：121.50'</wp-btn>
          </div>
        </div>
        <div class="wp-form-group">
          <div class="wp-form-label"></div>
          <div class="wp-form-action">
            <wp-btn ng-click="customer_display_setting.submit()">确认</wp-btn>
          </div>
        </div>
      </div>
      <div ng-if="active_setting.key == 'voice'">
        <div class="setting-title">语音设置</div>
        <div class="wp-form-group">
          <div class="wp-form-label">声音</div>
          <div class="wp-form-btns">
            <wp-btn-sm ng-repeat="vcn in voice_setting.vcns"
                       ng-class="{active: vcn.value == voice_setting.vcn}"
                       ng-click="voice_setting.change_vcn(vcn)">
              {{::vcn.name}}
            </wp-btn-sm>
          </div>
        </div>
        <div class="wp-form-group">
          <div class="wp-form-label">语速</div>
          <div class="wp-form-btns">
            <wp-btn-sm ng-repeat="spd in voice_setting.spds"
                       ng-class="{active: spd == voice_setting.spd}"
                       ng-click="voice_setting.change_spd(spd)">
              {{::spd}}
            </wp-btn-sm>
          </div>
        </div>
        <div class="wp-form-group">
          <div class="wp-form-label">音量</div>
          <div class="wp-form-btns">
            <wp-btn-sm ng-repeat="vol in voice_setting.vols"
                       ng-class="{active: vol == voice_setting.vol}"
                       ng-click="voice_setting.change_vol(vol)">
              {{::vol}}
            </wp-btn-sm>
          </div>
        </div>
        <div class="wp-form-group">
          <div class="wp-form-label">自动播放引导语音</div>
          <div class="wp-form-btns">
            <wp-btn-sm ng-class="{active: enable_auto_voice}"
                       ng-click="set_enable_auto_voice(true)">
              开启
            </wp-btn-sm>
            <wp-btn-sm ng-class="{active: !enable_auto_voice}"
                       ng-click="set_enable_auto_voice(false)">
              关闭
            </wp-btn-sm>
          </div>
        </div>
        <div class="wp-form-group">
          <div class="wp-form-label"></div>
          <div class="wp-form-action">
            <wp-btn-sm ng-click="voice_setting.test()">
              测试发音
            </wp-btn-sm>
          </div>
        </div>
      </div>
      <div ng-if="active_setting.key == 'card'">
        <div class="setting-title">读卡器设置</div>
        <div class="wp-form-group">
          <div class="wp-form-label">重置卡片</div>
          <wp-btn-sm ng-click="card_setting.clear_card()">
            重置
          </wp-btn-sm>
        </div>
      </div>
      <div ng-if="active_setting.key == 'queue_form'">
        <div class="setting-title">排号客显设置</div>
        <div ng-if="can_set_video">
          <div class="wp-form-group">
            <div class="wp-form-label">显示模式</div>
            <div class="wp-form-btns">
              <wp-btn-sm ng-class="{active: queue_form_setting.mode == 'images'}"
                         ng-click="queue_form_setting.mode = 'images'">
                图片轮播
              </wp-btn-sm>
              <wp-btn-sm ng-class="{active: queue_form_setting.mode == 'videos'}"
                         ng-click="queue_form_setting.mode = 'videos'">
                视频轮播
              </wp-btn-sm>
            </div>
          </div>
          <div ng-show="queue_form_setting.mode == 'images'">
            <div class="wp-form-group">
              <div class="wp-form-label">图片轮播</div>
              <wp-input input-model="queue_form_setting.images_path" input-type="text" input-size="normal"></wp-input>
            </div>
            <div class="wp-form-group">
              <div class="wp-form-label">标题字体大小</div>
              <wp-input input-model="queue_form_setting.title_size" input-type="number" input-size="normal" input-restrict="^[0-9]{0,5}$"></wp-input>
            </div>
            <div class="wp-form-group">
              <div class="wp-form-label">桌型字体大小</div>
              <wp-input input-model="queue_form_setting.name_size" input-type="number" input-size="normal" input-restrict="^[0-9]{0,5}$"></wp-input>
            </div>
            <div class="wp-form-group">
              <div class="wp-form-label">号码字体大小</div>
              <wp-input input-model="queue_form_setting.head_size" input-type="number" input-size="normal"  input-restrict="^[0-9]{0,5}$"></wp-input>
            </div>
          </div>
          <div ng-show="queue_form_setting.mode == 'videos'">
            <div class="wp-form-group">
              <div class="wp-form-label">视频轮播</div>
              <wp-input input-model="queue_form_setting.videos_path" input-type="text" input-size="normal"></wp-input>
            </div>
            <div class="wp-form-group">
              <div class="wp-form-label">视频音量</div>
              <wp-input input-model="queue_form_setting.video_volume" input-type="number" input-size="normal" input-restrict="^[0-9]{0,3}$"></wp-input>
            </div>
          </div>
        </div>
        <div ng-if="!can_set_video">
          <div class="wp-form-group">
            <div class="wp-form-label">图片轮播</div>
            <wp-input input-model="queue_form_setting.images_path" input-type="text" input-size="normal"></wp-input>
          </div>
          <div class="wp-form-group">
            <div class="wp-form-label">标题字体大小</div>
            <wp-input input-model="queue_form_setting.title_size" input-type="number" input-size="normal" input-restrict="^[0-9]{0,5}$"></wp-input>
          </div>
          <div class="wp-form-group">
            <div class="wp-form-label">桌型字体大小</div>
            <wp-input input-model="queue_form_setting.name_size" input-type="number" input-size="normal" input-restrict="^[0-9]{0,5}$"></wp-input>
          </div>
          <div class="wp-form-group">
            <div class="wp-form-label">号码字体大小</div>
            <wp-input input-model="queue_form_setting.head_size" input-type="number" input-size="normal"  input-restrict="^[0-9]{0,5}$"></wp-input>
          </div>
        </div>
        <div class="wp-form-group">
          <div class="wp-form-label"></div>
          <div class="wp-form-action">
            <wp-btn ng-click="queue_form_setting.submit()">确认</wp-btn>
          </div>
        </div>
      </div>

      <div ng-if="active_setting.key == 'fastfood_form'">
        <div class="setting-title">快餐客显设置</div>
        <div>
          <div class="wp-form-group">
            <div class="wp-form-label">图片轮播</div>
            <wp-input input-model="fastfood_form_setting.images_path" input-type="text" input-size="normal"></wp-input>
          </div>
          <div class="wp-form-group">
            <div class="wp-form-label">间隔(秒)</div>
            <wp-input input-model="fastfood_form_setting.images_interval" input-type="number" input-size="normal" input-restrict="^[0-9]{0,5}$"></wp-input>
          </div>
        </div>

        <div class="wp-form-group">
          <div class="wp-form-label"></div>
          <div class="wp-form-action">
            <wp-btn ng-click="fastfood_form_setting.submit()">确认</wp-btn>
          </div>
        </div>
      </div>

      <!-- <div ng-if="active_setting.key == 'extended_form'">
        <div class="setting-title">收银客显设置</div>
        <div class="wp-form-group">
          <div class="wp-form-label"></div>
          <wp-btn ng-click="extended_form_setting.change_enable(true)"
                  ng-class="{active: extended_form_setting.enable }">启用</wp-btn>
          <wp-btn ng-click="extended_form_setting.change_enable(false)"
                  ng-class="{active: !extended_form_setting.enable }">禁用</wp-btn>
        </div>
      </div> -->
    </div>
  </div>

</div>
