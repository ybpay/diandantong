<div class="master-part" ng-controller="tableChooseCell">
  <div class="menu-part" wp-scroll-zone>
    <div>
      <div class="menu" ng-click="change_table_list('all');reset_table();"
              ng-class="{active: table_list_type == 'all' }">
          全部桌台
      </div>
      <div class="menu" ng-repeat="table_zone in table_zones track by table_zone.id"
          ng-class="{active: table_zone == active_table_zone}"
          ng-click="change_table_list('table_zone', table_zone);reset_table();">
        {{::table_zone.name}}
      </div>
      <div class="menu" ng-show="table_zones.length > 0"
              ng-click="table_filter_modal.show = true;reset_table();"
              ng-class="{active: table_list_type == 'table_state'}">
          过滤桌台
      </div>
      
    </div>
  </div>

  <div class="table-state-summary">

    <div class="item" ng-class="{'active': table_list_type == 'table_state' && active_table_state == 'ordered'}" ng-click="change_table_list('table_state', 'ordered');reset_table();">
      用餐中({{count_by_state(['ordered'])}})
    </div>
    <div class="item" ng-class="{'active': table_list_type == 'table_state_inq' }" ng-click="change_table_list('table_state_inq', ['opened', 'ordered', 'check_outing', 'paid']);reset_table();">
      占用中({{count_by_state(['opened', 'ordered', 'check_outing', 'paid'])}})
    </div>
    <div class="item" ng-class="{'active': table_list_type == 'table_state' && active_table_state == 'opened'}" ng-click="change_table_list('table_state', 'opened');reset_table();">
      已开台({{count_by_state('opened')}})
    </div>
    <div class="item" ng-class="{'active': table_list_type == 'table_state' && active_table_state == 'idle'}" ng-click="change_table_list('table_state', 'idle');reset_table();">
      已空闲({{count_by_state(['idle'])}})
    </div>
  </div>
  <div class="master-part-with-menu" wp-scroll-zone scroll-btns>
    <div class="table-index">
      <div class="wp-subject">
        <span ng-show="active_table">
          当前操作的桌台是：
          <span class="table-table-name">{{active_table.name_with_zone}}</span>, {{navigation_msg}}
        </span>
        <span ng-hide="active_table">
          <span>选择桌台</span>
        </span>
        <wp-input class="table_filter_key" input-model="table_filter_key" input-type="text" input-size="normal"></wp-input>
        <div class="wp-input-label" ng-click="clear_table_filter_key()">清空</div>
      </div>

      <div class="wp-no-record" ng-hide="display_tables().length > 0">
        <span ng-show="active_table_zone">该区域没有桌台</span>
        <span ng-show="active_table_state">没有{{state_name}}桌台</span>
      </div>
      <div class="wp-table-btn"
           wp-repeat="table in display_tables() track by table.id"
           dom-reuse="fix"
           ng-click="choose_table(table)"
           ng-class="table_classes(table)">
        <div class="table-name-wrapper">
          <span class="from-wechat" ng-show="table.is_from_wechat"></span>
          <div class="table-name">
            {{table.name}}
          </div>
        </div>
        <div class="table-state">
          <span>{{table.workflow_state_name}}</span>
          <span class="amount">{{table.order_amount|currency:shop.currency:0}}</span>
        </div>
      </div>
    </div>
  </div>
  <wp-modal wp-show="table_filter_modal.show">
    <div class="wp-modal-header">状态过滤</div>
    <div class="wp-modal-content">
      <div class="wp-form-group">
        <div class="wp-form-label">过滤方式</div>
        <wp-btn ng-click="change_table_list('table_state_inq', ['opened', 'ordered', 'check_outing', 'paid'])">
          占用中
        </wp-btn>
        <wp-btn ng-click="change_table_list('table_state', 'idle')">
          已空闲
        </wp-btn>
        <wp-btn ng-click="change_table_list('table_state', 'opened')">
          已开台
        </wp-btn>
        <wp-btn ng-click="change_table_list('table_state', 'ordered')">
          用餐中
        </wp-btn>
        <wp-btn ng-click="change_table_list('table_state', 'check_outing')">
          结账中
        </wp-btn>
        <wp-btn ng-click="change_table_list('table_state', 'paid')">
          已支付
        </wp-btn>
        <div class="space"></div>
      </div>
      <div class="wp-form-group">
        <div class="wp-form-action">
          <div class="wp-form-label"></div>
          <wp-btn ng-click="table_filter_modal.show=false">取消过滤</wp-btn>
        </div>
      </div>
    </div>
  </wp-modal>
</div>
