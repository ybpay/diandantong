<div class="master-part product-choose-cell" ng-controller="subtractableChooseCell" wp-scroll-zone>
  <div class="wp-subject">可退菜品</div>

  <div class="table-cart-line-item-index">
    <div class="wp-subject">{{table.name_with_zone}} {{table.workflow_state_name}}</div>
    <div class="wp-table" ng-show="line_items.length">
      <wp-table-row>
        <div class="wp-table-col col-1">序号</div>
        <div class="wp-table-col col-7">名称</div>
        <div class="wp-table-col col-3">数量</div>
        <div class="wp-table-col col-3">退菜数量</div>
        <div class="wp-table-col col-3">单价</div>
      </wp-table-row>
      <wp-table-row ng-repeat-start="line_item in line_items"
                    ng-click="change_active_line_item(line_item)"
                    ng-class="{'active':line_item == active_line_item}">
        <div class="wp-table-col col-1">{{$index+1}}</div>
        <div class="wp-table-col col-7">
          {{line_item.name}}
          <span ng-if="line_item.gift" class="red">(赠)</span>
          <span ng-show="line_item.note">[{{line_item.note}}]</span>
        </div>
        <div class="wp-table-col col-3">{{line_item.active_quantity}}</div>
        <div class="wp-table-col col-3 red">
          <span ng-show="line_item.subtract_quantity > 0">{{line_item.subtract_quantity}}</span>
        </div>
        <div class="wp-table-col col-3">{{line_item.price|currency:''}}</div>
      </wp-table-row>
      <div ng-repeat-end class="delete-actions" ng-if="line_item == active_line_item">
        <div class="delete-actions-wrapper">
          <wp-btn-sm ng-click="add(active_line_item)">
            <i class="fa fa-plus fa-2x" ng-class="{red: can_plus(active_line_item), gray: !can_plus(active_line_item)}"></i>
          </wp-btn-sm>
          <wp-btn-sm ng-click="remove(active_line_item)">
            <i class="fa fa-minus fa-2x" ng-class="{red: can_minus(active_line_item), gray: !can_minus(active_line_item)}"></i>
          </wp-btn-sm>
          <wp-btn-sm ng-click="confirm_subtractables()" ng-show="can_subtract()" class="active">
            <span>确定退菜</span>
          </wp-btn-sm>
        </dvi>
      </div>
    </div>

  </div>
</div>
<wp-modal wp-show="subtract_modal.show">
  <div class="wp-modal-header">退菜确认</div>
  <div class="wp-modal-content">
    <div class="wp-form-group">
      <div class="wp-form-label">确认菜品</div>
      <div class="wp-form-input"></div>
    </div>
    <div class="clear:both"></div>
    <div class="delete-itemables">
      <div class='left-part'>
        <div ng-repeat="itemable in subtractables_l" class="delete-info">
          {{itemable.name}} * {{itemable.quantity}}
        </div>
      </div>
      <div class='right-part'>
        <div ng-repeat="itemable in subtractables_r" class="delete-info">
          {{itemable.name}} * {{itemable.quantity}}
        </div>
      </div>
    </div>

    <br />
    <div style="clear:both"></div>
    <div class="wp-form-group">
      <div class="wp-form-label">退菜原因</div>
      <div class="wp-form-input"></div>
    </div>

    <div class='delete-reasons'>
      <wp-btn-sm ng-repeat="reason in subtract_modal.reasons"
                   ng-click="subtract_modal.choose_reason(reason)"
                   ng-class="{'active': subtract_modal.reason == reason}">{{::reason}}</wp-btn-sm>
    </div>

    <div style="clear:both"></div>
    <br />
    <div class="wp-form-group">
      <div class="wp-form-label"></div>
      <div class="wp-form-action">
        <wp-btn ng-click="subtract_modal.submit()"
                class="default-action"
                ng-class="{'disabled': !subtract_modal.can_submit()}">确定</wp-btn>
        <wp-btn ng-click="subtract_modal.cancel()" class="cancel-action">取消</wp-btn>
      </div>
    </div>
  </div>
</wp-modal>
