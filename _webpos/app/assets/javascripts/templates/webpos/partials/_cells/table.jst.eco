<div class="op-part" ng-controller="tableCell" >
  <div class="table-op-index" ng-show="table && action=='init'">
    <wp-btn ng-show="is_idle() && can('branch','table','open')"
            ng-click="open_table()">开台</wp-btn>
    <div ng-show="is_opened()">
      <wp-btn ng-show="can('branch','eat_in_hall_order', 'create')" ng-click="go_cart()">点菜</wp-btn>
    </div>
    <div ng-show="is_ordered()">
      <wp-btn ng-show="is_order_pending() && can('branch', 'order', 'confirm')"
              ng-click="confirm_order()"
              class="active">确认</wp-btn>
      <wp-btn ng-show="can('branch','order','append')"
              ng-click="toggle_action('append_itemable')"
              ng-class="{'active':action=='append_itemable'}">
              加菜
              <span class="hotkey">[ {{key_of_append}} ]</span>
      </wp-btn>
      <wp-btn ng-click="subtract_itemable()"
              ng-class="{'active':action=='subtract_itemable'}">
              退菜
              <span class="hotkey">[ {{key_of_subtract}} ]</span>
            </wp-btn>
      <wp-btn ng-show="can('branch','eat_in_hall_order','change_table')"
              ng-click="toggle_action('change_table')"
              ng-class="{'active':action=='change_table'}">换台</wp-btn>
      <wp-btn ng-show="can('branch','eat_in_hall_order','merge_table')"
              ng-click="toggle_action('merge_table')"
              ng-class="{'active':action=='merge_table'}">并台</wp-btn>
    </div>
    <wp-btn ng-show="can('branch','table','clear') && !is_idle() && can_clear_table()"
            ng-click="clear_table(table)">清台</wp-btn>
    <wp-btn ng-click="discount_plan.modal.open()"
              ng-show="discount_plan.show_select_btn()">
              折扣方案
              <span class="hotkey">[ {{discount_plan.hotkey}} ]</span>
            </wp-btn>
    <wp-btn ng-click="discount_plan.cancel()"
              ng-show="discount_plan.show_cancel_btn()">
              撤销方案
              <span class="hotkey">[ {{discount_plan.hotkey}} ]</span>
            </wp-btn>
    <wp-btn ng-click="print_product_bill()"
              ng-show="can_print_product_bill()">
              拉划菜单
              <span class="hotkey">[ {{key_of_print_product}} ]</span>
            </wp-btn>
    <wp-btn ng-click="print_last_append_product_bill()"
              ng-show="can_print_last_append_product_bill()">拉加菜单</wp-btn>
    <wp-btn ng-click="print_consume_bill()"
              ng-show="can_print_consume_bill()">
              拉消费单
              <span class="hotkey">[ {{key_of_print_consume}} ]</span>
            </wp-btn>
    <wp-btn ng-click="cancel_check_out()"
              ng-show="is_check_outing()">重置结帐</wp-btn>
    <wp-btn ng-click="allow_selfpay()"
              ng-show="can_allow_selfpay()">允许自结</wp-btn>
    <wp-btn ng-click="advance_modal.open()">更多</wp-btn>
    <div class="clearfix"></div>
    <div ng-show="is_ordered() || is_check_outing()">
      <wp-btn id="settle-btn" class="primary" ng-show="can_go_settle() || is_role('worker')" ng-click="go_settle()"
              ng-class="{'disabled':!can_go_settle()}">结算
      </wp-btn>
    </div>
    <div class="space"></div>
  </div>
  <div class="table-op-index" ng-show="table && action !='init'">
    <wp-btn ng-class="{'disabled':!can_append_itemables()}"
           ng-click="confirm_append_itemables()"
           ng-show="action == 'append_itemable'"
           class="hover">加菜提交</wp-btn>
    <wp-btn ng-click="clear_append_itemables()"
            ng-show="action == 'append_itemable'">清空</wp-btn>
    <wp-btn ng-click="toggle_action('init')">取消</wp-btn>
    <wp-btn ng-click="batch_change_append_itemable_note()" ng-show="action == 'append_itemable'">批量品注</wp-btn>
    <div class="space"></div>
  </div>
  <div class='table-view' wp-scroll-zone scroll-btns>
    <div ng-show="table && action == 'append_itemable'">
      <div wp-include="partial('_actions/append_itemable_table')"></div>
    </div>
    <div class="table-cart-line-item-index" ng-show="table">
      <div class="table-table-name">{{table.name_with_zone}}</div>
      <div class="table-table-name-desc" ng-show="table.last_opened_at">人数{{table.guest_num}}位 开台{{table_opened_time_str}}分钟 点菜员:{{table.order.waiter_name}}</div>
      <table class="wp-table-sm" ng-show="table.order">
        <thead>
          <th width="10%">序号</th>
          <th width="50%">名称</th>
          <th width="15%">数量</th>
          <th width="25%">单价</th>
        </thead>
        <tbody>
          <tr wp-repeat-start="line_item in table.order.line_items | reverse"
              dom-reuse='fix'
              ng-click="change_line_item(line_item);"
              ng-class="{active: current_line_item == line_item, odd: $index % 2 == 0}">
            <td>{{table.order.line_items.length-$index}}</td>
            <td>
              <span class="blue" ng-show="line_item.is_from_move">[转]</span>
              <span class="blue" ng-show="line_item.is_append">[加]</span>
              {{line_item.name}}
              <span ng-show="line_item.note">[{{line_item.note}}]</span>
              <span class="red" ng-show="line_item.gift">(赠)</span>
              <br />
              <span class="create-time">{{time_since_from(line_item.created_at)}}分钟</span>
            </td>
            <td>{{line_item.active_quantity}}</td>
            <td>
              {{line_item.price |currency:''}}
              <span class="original-price"
                    ng-show="line_item.price !== line_item.original_price"
                    ng-class="{'change-price': line_item.is_change_price}"
                    >{{line_item.original_price|currency:''}}
              </span>
            </td>
          </tr>
          <tr wp-repeat-end ng-show="current_line_item == line_item && action == 'init'">
            <td ng-show="can_change_price() && line_item.enable_change_price">
              <wp-btn-sm ng-click="change_price()">单品改价</wp-btn-sm>
            </td>
            <td ng-show="can_hasten()">
              <wp-btn-sm ng-click="hasten_line_item()">催菜/叫起</wp-btn-sm>
            </td>
            <td ng-show="can_change_line_item_weight()">
              <wp-btn-sm ng-click="change_line_item_weight()">改重量</wp-btn-sm>
            </td>
          </tr>
          <tr wp-repeat="adjustment in table.order.adjustments"
              dom-reuse="fix"
          >
            <td></td>
            <td>{{adjustment.label}}</td>
            <td></td>
            <td>{{adjustment.amount_in_currency}}</td>
          </tr>
          <tr ng-show="table.is_from_wechat && table.order && table.order.note">
            <td>备注</td>
            <td colspan="3">{{table.order.note}}</td>
          </tr>
        </tbody>
      </table>
      <div class="table-order-total" ng-show="table.order">合计: {{table.order.total|currency:shop.currency}}</div>
    </div>
  </div>

  <wp-modal wp-show="guest_num_modal.show" class="wp-modal-md">
    <div class="wp-modal-header">请选择用餐人数</div>
    <div class="wp-modal-content">
      <div class="wp-form-group">
        <!-- <div class="wp-form-label">用餐人数</div> -->
        <wp-btn-sm ng-click="guest_num_modal.pre_page()" ng-show="guest_num_modal.page != 1">
          <i class="fa fa-chevron-left"></i>
        </wp-btn-sm>
        <wp-btn-sm ng-repeat="guest_num in guest_num_modal.guest_nums()"
               ng-class="{active: guest_num_modal.guest_num == guest_num}"
               ng-click="guest_num_modal.guest_num = guest_num">
          {{::guest_num}}
        </wp-btn-sm>
        <wp-btn-sm ng-click="guest_num_modal.next_page()">
          <i class="fa fa-chevron-right"></i>
        </wp-btn-sm>
        <!-- <wp-input input-model="guest_num_modal.guest_num" input-type="number" input-size="middle" input-focus="guest_num_modal.show" auto-clear="true" placeholder="8"></wp-input> -->
      </div>
    </div>
    <div class="wp-modal-actions">
      <wp-btn ng-click="guest_num_modal.submit(true)"
              ng-class="{'disabled': !guest_num_modal.can_submit()}"
              ng-hide="guest_num_modal.is_update">开台点菜</wp-btn>
      <wp-btn ng-click="guest_num_modal.submit(false)"
              ng-class="{'disabled': !guest_num_modal.can_submit()}"
              ng-hide="guest_num_modal.is_update">开台</wp-btn>
      <wp-btn ng-click="guest_num_modal.update_guest_num()"
              ng-class="{'disabled': !guest_num_modal.can_submit()}"
              ng-show="guest_num_modal.is_update">确认修改</wp-btn>
      <wp-btn ng-click="guest_num_modal.cancel()">取消</wp-btn>
    </div>
  </wp-modal>

  <div wp-include="partial('_actions/append_itemable_modal')"></div>

  <wp-modal wp-show="change_price_modal.show">
    <div class="wp-modal-header">单品改价</div>
    <div class="wp-modal-content">
      <div class="wp-form-group">
        <div class="wp-form-label">商品</div>
        <div class="wp-form-input">{{current_line_item.name}}</div>
      </div>
      <div class="wp-form-group">
        <div class="wp-form-label">原价</div>
        <div class="wp-form-input">{{current_line_item.original_price}}</div>
      </div>
      <div class="wp-form-group">
        <div class="wp-form-label">改价</div>
        <wp-input input-model="change_price_modal.new_price" input-type="number" input-size="middle" input-focus="change_price_modal.show"></wp-input>
      </div>
      <div class="wp-form-group">
        <div class="wp-form-label"></div>
        <div class="wp-form-action">
          <wp-btn ng-click="change_price_modal.submit()"
                  ng-class="{'disabled': !change_price_modal.can_submit()}">确定</wp-btn>
          <wp-btn ng-click="change_price_modal.close()">取消</wp-btn>

        </div>
      </div>
    </div>
  </wp-modal>

  <wp-modal wp-show="advance_modal.show">
    <div class="wp-modal-header">更多</div>
    <div class="wp-modal-content">
      <wp-btn ng-click="advance_modal.close();choose_reprint_targets()"
              ng-show="can('branch', 'order', 'reprint') && table.order">小票补打</wp-btn>
      <wp-btn ng-show="can_update_guest_num()"
                ng-click="advance_modal.close();update_guest_num();"
                >更改就餐人数</wp-btn>
      <div ng-show="is_ordered()">
        <wp-btn ng-show="can_hasten()"
                ng-click="advance_modal.close();hasten_order()"
                >催单</wp-btn>
        <wp-btn ng-click="move_itemable()"
              ng-class="{'active':action=='move_itemable'}">
              转菜
            </wp-btn>
        <wp-btn ng-show="can_bind_reservation_order()"
                ng-click="advance_modal.close();toggle_action('bind_reservation_order')"
                ng-class="{'active':action=='bind_reservation_order'}">绑定预订订单</wp-btn>
        <wp-btn ng-show="can('branch','order','cancel') && table"
                ng-click="advance_modal.close();cancel_order()">取消订单</wp-btn>
        <wp-btn ng-show="can_trace_waiter()"
                ng-click="advance_modal.close();trace_waiter_modal.open()">点菜员</wp-btn>
        <wp-btn ng-click="go_history_order()"
                ng-show="can_go_history_order()">历史订单</wp-btn>
        <wp-btn ng-click="force_clear()"
                ng-show="can_force_clear()">强制清台</wp-btn>
      </div>
      <div class="clearfix"></div>
      <div class="wp-form-group">
        <div class="wp-form-action right">
          <wp-btn ng-click="advance_modal.close()">返回</wp-btn>
        </div>
      </div>
    </div>
  </wp-modal>
  <div wp-include src="partial('_modals/edit_line_item')" include-replace></div>
  <div wp-include src="partial('_modals/trace_waiter_modal')" include-replace></div>
  <div wp-include src="partial('_modals/reprint')" include-replace></div>
  <div wp-include src="partial('_modals/cancel_order')" include-replace></div>
  <div wp-include src="partial('_modals/discount_plan')" include-replace></div>
</div>
