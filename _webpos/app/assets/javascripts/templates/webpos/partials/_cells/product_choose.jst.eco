<div class="master-part product-choose-cell" ng-controller="productChooseCell">
  <div class="menu-part" wp-scroll-zone>
    <div>
      <div class="menu" ng-repeat="choose_way in choose_ways"
              ng-click="change_active_choose_way(choose_way)"
              ng-class="{active: active_choose_way == choose_way }">
        {{::choose_way.label}}
      </div>
    </div>
  </div>
  <div class="table-state-summary">
      <div class="item" ng-click="syncProducts()">
        同步菜品
      </div>
  </div>
  <div class="master-part-with-menu" wp-scroll-zone scroll-btns>
    <div ng-show="active_choose_way.value == 'variant'">
      <wp-alpha-search-input input-model="search_key" class="search_key"></wp-alpha-search-input>
      <div class="clearfix"></div>
      <div ng-hide="search_key">
        <div>
          <wp-btn-sm  wp-repeat="category in categories track by category.id"
                      dom-reuse="static"
                      dom-cache="categories_dom_cache"
                      dom-cache-prefix="category"
                      class="fillet category-btn category-btn-{{category.id}}"
                      onclick="$(this).data('$apply')(function($scope, $elem){$scope.change_active_category($elem.data('category'))})">
            {{::category.name}}
          </wp-btn-sm>
        </div>
        <div class="clearfix"></div>
        <div>
          <wp-btn-sm  class="fillet" ng-class="{'active':active_sub_category==null}"
                      ng-click="change_active_sub_category(null)"
                      ng-show="is_show_default_sub_category(active_category)">
            默认
          </wp-btn-sm>
          <wp-btn-sm  class="fillet" wp-repeat="sub in active_category.subs"
                      ng-class="{'active':sub==active_sub_category}"
                      ng-click="change_active_sub_category(sub)">
                      {{::sub.name}}
          </wp-btn-sm>
        </div>
        <div class="clearfix"></div>
      </div>
      <div class="products">
          <wp-btn-md class="product-btn"
                     wp-repeat="product in products track by product.id"
                     dom-reuse="fix"
                     ng-class="{'disabled': show_disabled(product)}"
                     ng-click="change_active_product(product)"
                     class="hover">
              <div class="product-name">{{product.name}}</div>
              <div class="product-price" ng-show="!estimate_clear_page.show_stock_quantity">{{product.price|currency:shop.currency}}</div>
              <div class="product-stock-quantity" ng-show="estimate_clear_page.show_stock_quantity">库存: {{ product.stock_quantity || estimate_clear_page.stock_quantity_str(product.variants[0])}}</div>
          </wp-btn-md>
          <!--</div>-->
          <wp-btn-md  ng-if="show_load_next_page()"
                      ng-click="load_next_page()">
              下一页
          </wp-btn-md>
          <div class="space"></div>
      </div>
    </div>
    <div ng-show="active_choose_way.value == 'combo'">
      <div class="combos-wapper">
        <div>
          <wp-btn-sm  class="fillet"
                      wp-repeat="combo in combos track by combo.id"
                      ng-class="{'active': combo == active_combo}"
                      ng-click="change_active_combo(combo)">
            {{::combo.name}}
          </wp-btn-sm>
        </div>
        <div class="clearfix"></div>
        <div class="combo-items-wapper">
          <div class="combo-item"
               wp-repeat="combo_item in active_combo.combo_items track by combo_item.id"
               dom-reuse="all">
            <div class="wp-subject" ng-click="toggle_combo_item_hide_variants(combo_item)"
                 ng-class="{fold: combo_item.quantity == combo_item.select_count}">
              <i class="fa fa-caret-down" ng-show="combo_item.hide_variants"></i>
              <i class="fa fa-caret-right" ng-hide="combo_item.hide_variants"></i>
              {{combo_item.name}}({{combo_item.quantity || 0}}/{{combo_item.select_count}})
              {{get_content_of_combo_item(combo_item)}}
            </div>
            <wp-btn-md class="product-btn"
                       wp-repeat="variant in combo_item.variants track by variant.id"
                        dom-reuse="fix"
                        ng-click="add_combo_item_variant(combo_item, variant)"
                        ng-class="{'active': variant.quantity > 0}"
                        ng-hide="combo_item.hide_variants">
              <div class="product-name">{{variant.name}}</div>
              <!-- <div class="product-price">{{::variant.price|currency:shop.currency}}</div> -->
            </wp-btn-md>
            <div class="space"></div>
          </div>
          <div class="combo-action">
            <wp-btn-md  ng-class="{'disabled': !can_add_combo_package(active_combo)}"
                        ng-show="active_combo"
                        ng-click="add_combo_package(active_combo)">添加套餐</wp-btn-md>
          </div>
        </div>
      </div>
    </div>
  </div>
  <wp-modal wp-show="active_product">
    <div class="wp-modal-header">{{active_product.name}} 规格选择</div>
    <div class="wp-modal-content">
      <wp-btn-md  wp-repeat="variant in active_product.variants"
                  ng-click="choose_variant(variant)"
                  ng-show="active_product"
                  class="hover"
                  ng-class="{'disabled': variant.estimate_clear}">
        <span ng-show="variant.sku">{{::variant.sku}}</span>
        <br ng-show="variant.sku"/>
        <span>{{::variant.name}}</span>
        <br/>
        <span ng-hide="estimate_clear_page.show_stock_quantity">{{::variant.price|currency:shop.currency}}</span>
        <span class="product-stock-quantity red" ng-show="estimate_clear_page.show_stock_quantity">库存:  {{estimate_clear_page.stock_quantity_str(variant)}}</span>
      </wp-btn-md>
    </div>
  </wp-modal>
  <div wp-include src="partial('_directives/wp-keypad-alpha')"></div>
</div>
