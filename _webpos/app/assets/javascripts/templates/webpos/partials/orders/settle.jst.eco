<div wp-include src="partial('header')"></div>
<div wp-footbar branch-id='{{branch.id}}' ng-if="branch"></div>
<div class="order-settle-page main-view">
  <div class="master-left-part">
    <div class="wp-subject">订单结算</div>
    <div class="settle-promotions">
      <div class="sp sp-1" ng-class="{active: active_menu_key == 'hysb'}">
        <div class="sp-title" ng-click="toggle_menu_key('hysb')">会员识别
          <span class="hotkey">[ {{key_of_hysb}} ]</span>
        </div>
        <div class="sp-content" ng-show="active_menu_key == 'hysb'" wp-scroll-zone>
          <div class="sp-content-item">
            <div class="sp-item-title">实体卡识别</div>
            <div class="sp-item-action">
              <wp-btn-sm ng-click="vip_modal.read_card()">读卡</wp-btn-sm>
            </div>
            <div class="sp-item-desc">请将会员卡放入感应区</div>
          </div>
          <div class="sp-content-item">
            <div class="sp-item-title">微信会员识别</div>
            <div class="sp-item-action">
              <wp-btn-sm ng-click="vip_modal.read_qrcode()">扫码</wp-btn-sm>
            </div>
            <div class="sp-item-desc">顾客微信扫码</div>
          </div>
          <div class="sp-content-item">
            <div class="sp-item-title">会员支付码</div>
            <div class="sp-item-action">
              <wp-btn-sm ng-click="vip_modal.scan_code()">扫码</wp-btn-sm>
            </div>
            <div class="sp-item-desc">扫顾客的会员支付码</div>
          </div>
          <div class="sp-content-item" ng-show="can('shop','user','show') && branch.enable_query_for_settle">
            <div class="sp-item-title">会员搜索</div>
            <div class="sp-item-action">
              <wp-btn-sm ng-click="vip_modal.search_open()">搜索</wp-btn-sm>
            </div>
            <div class="sp-item-desc">姓名/手机/会员号</div>
          </div>
          <div class="sp-content-item">
            <!-- <div class="sp-item-info">会员编号：<span>{{vip_modal.vip_info.vip_no}}</span></div> -->
            <!-- <div class="sp-item-info">会员编号：<span>{{vip_modal.vip_info.vip_level_name}}</span></div> -->
            <!-- <div class="sp-item-info">手机：<span>{{vip_modal.vip_info.phone}}</span></div> -->
            <div class="sp-item-info">会员：<span>{{vip_modal.vip_info.name}} {{vip_modal.vip_info.vip_level_name}}</span></div>
            <div class="sp-item-info">余额：<span>{{vip_modal.vip_info.card_wallet.display_amount}}</span></div>
            <div class="sp-item-info">积分：<span>{{vip_modal.vip_info.credits_wallet.display_amount}}</span></div>
          </div>
        </div>
      </div>
      <div class="sp sp-2" ng-class="{active: active_menu_key == 'yhq'}">
        <div class="sp-title" ng-click="toggle_menu_key('yhq')">优惠券
          <span class="hotkey">[ {{key_of_yhq}} ]</span>
        </div>
        <div class="sp-content" ng-if="active_menu_key == 'yhq'" wp-scroll-zone>
          <div ng-hide="order.coupon">
            <div class="sp-content-item">
              <div class="sp-item-title-c">优惠券兑换码</div>
              <div class="sp-item-action">
                <wp-btn-sm ng-click="coupon_modal.search_coupon()">查询</wp-btn-sm>
              </div>
              <div class="clearfix"></div>
              <div class="wp-form-group">
                <wp-input class="yhq" input-model="coupon_modal.code" input-type="number" input-size="normal"></wp-input>
              </div>
            </div>
            <div class="sp-content-item">
              <div class="sp-item-title-c">扫码验券</div>
              <div class="sp-item-action">
                <wp-btn-sm ng-click="coupon_modal.scan_code()">扫码</wp-btn-sm>
              </div>
            </div>
            <div class="sp-content-item">
              <div class="sp-item-info">名称: <span>{{coupon_modal.coupon.name}}</span></div>
              <div class="sp-item-info">描述: <span>{{coupon_modal.coupon.description}}</span></div>
            </div>
            <div class="sp-content-item">
              <div class="sp-item-action-c">
                <wp-btn-sm class="fillet" ng-click="coupon_modal.submit()" ng-class="{disabled: !coupon_modal.can_submit()}">确认</wp-btn-sm>
              </div>
            </div>
          </div>
          <div ng-show="order.coupon">
            <div class="sp-content-item">
              <div class="sp-content-item">
                <div class="sp-item-info">名称: <span>{{order.coupon.name}}</span></div>
                <div class="sp-item-info">描述: <span>{{order.coupon.description}}</span></div>
              </div>
              <div class="sp-item-action-c">
                <wp-btn-sm class="fillet" ng-click="rollback_coupon()">撤销优惠券</wp-btn-sm>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="sp sp-3" ng-class="{active: active_menu_key == 'qxdz'}">
        <div class="sp-title" ng-click="toggle_menu_key('qxdz')">权限打折
          <span class="hotkey">[ {{key_of_qxdz}} ]</span>
        </div>
        <div class="sp-content" ng-if="active_menu_key == 'qxdz'" wp-scroll-zone>
          <div class="sp-content-item">
            <div class="clearfix"></div>
            <div class="sp-item-title-c">折扣(1~99)</div>
            <div class="sp-item-action">
              <div class="wp-form-group">
                <wp-input class="qxdz" input-model="discount_modal.discount_percent" input-type="number" input-size="small" input-restrict="^[0-9]{0,2}$"></wp-input>
              </div>
            </div>
            <div class="clearfix"></div>
          </div>
          <div class="sp-content-item">
            <div class="clearfix"></div>
            <div class="sp-item-title-c">禁用折扣金额</div>
            <div class="sp-item-action">
              <div class="wp-form-group">
                <wp-input class="qxdz" input-model="discount_modal.disable_discount_amount" input-type="number" input-size="small" input-restrict="^[0-9]{0,2}$"></wp-input>
              </div>
            </div>
            <div class="clearfix"></div>
          </div>
          <div class="sp-content-item">
            <div class="sp-item-info">打折前: <span>{{order.total}}</span></div>
            <div class="sp-item-info">可折扣金额: <span>{{order.item_total_for_discount}}</span></div>
            <div class="sp-item-info">打折后: <span>{{total_after_privilege}}</span></div>
          </div>
          <div class="sp-content-item">
            <div class="sp-item-action-c">
              <wp-btn-sm class="fillet" ng-click="discount_modal.submit()" ng-class="{disabled: !discount_modal.can_submit()}">确认</wp-btn-sm>
            </div>
          </div>
        </div>
      </div>
      <div class="sp sp-4" ng-class="{active: active_menu_key == 'qxjm'}">
        <div class="sp-title" ng-click="toggle_menu_key('qxjm')">权限减免
          <span class="hotkey">[ {{key_of_qxjm}} ]</span>
        </div>
        <div class="sp-content" ng-if="active_menu_key == 'qxjm'" wp-scroll-zone>
          <div class="sp-content-item">
            <div class="clearfix"></div>
            <div class="sp-item-title-c">减免</div>
            <div class="sp-item-action">
              <div class="wp-form-group">
                <wp-input class="qxjm" input-model="reduction_modal.reduce_amount" input-type="number" input-size="small"></wp-input>
              </div>
            </div>
            <div class="clearfix"></div>
          </div>
          <div class="sp-content-item">
            <div class="sp-item-info">减免前: <span>{{order.total}}</span></div>
            <div class="sp-item-info">减免后: <span>{{total_after_privilege}}</span></div>
          </div>
          <div class="sp-content-item">
            <div class="sp-item-action-c">
              <wp-btn-sm class="fillet" ng-click="reduction_modal.submit()" ng-class="{disabled: !reduction_modal.can_submit()}">确认</wp-btn-sm>
            </div>
          </div>
        </div>
      </div>
      <div class="sp sp-5" ng-class="{active: active_menu_key == 'qxmd'}">
        <div class="sp-title" ng-click="toggle_menu_key('qxmd')">权限免单
        </div>
        <div class="sp-content" ng-if="active_menu_key == 'qxmd'" wp-scroll-zone>
          <div class="sp-content-item">
            <div class="sp-item-action-c">
              <wp-btn-sm class="fillet" ng-click="privilege_free()">确认免单</wp-btn-sm>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="master-center-part" wp-scroll-zone>
    <div class="wp-os-action-wrapper">
      <div class="wp-subject">
        <span>支付方式</span>
        <wp-input class="pay-method-filter-key" input-model="pay_method_filter_key" input-type="text" input-size="normal"></wp-input>
      </div>
      <div class="wp-os-pay-methods">
        <div class="wp-os-pre-page"
             ng-click="pay_method_pre_page()"
             ng-show="true"><i class="fa fa-chevron-left"></i></div>
        <div class="wp-os-next-page"
             ng-click="pay_method_next_page()"
             ng-show="true"><i class="fa fa-chevron-right"></i></div>
        <wp-btn ng-repeat="pay_method in show_builtin_pay_methods()"
                ng-click="select_pay_method_name(pay_method.name_sym)"
                ng-show="show_index($index)"
                ng-class="key_color(pay_method.name_abbr)">
          <span ng-show="pay_method.code">{{::pay_method.code}}<br/></span>
          <span>{{::pay_method.name}}</span>
        </wp-btn>
        <wp-btn ng-repeat="pay_method in show_custom_pay_methods()"
                ng-click="select_pay_method(pay_method)"
                ng-show="show_custom_index($index)"
                ng-class="key_color(pay_method.name_abbr)">
          <span ng-show="pay_method.code">{{::pay_method.code}}<br/></span>
          <span>{{::pay_method.name}}</span>
        </wp-btn>
        <div class="clearfix"></div>
      </div>
      <div class="wp-table without-border center">
        <wp-table-row ng-show="order_type == 'recharge'">
          <div class="wp-table-col col-4">会员：</div>
          <div class="wp-table-col col-4">
            {{order.vip_info.name}}
          </div>
        </wp-table-row>
        <wp-table-row ng-show="order.vip_info && !order.vip_info.is_default && order_type != 'recharge'">
          <div class="wp-table-col col-4">会员折扣：</div>
          <div class="wp-table-col col-4">
            <span ng-show="order.vip_info">
              {{order.vip_info.name}}&nbsp;&nbsp;
              {{order.vip_info.discount * 10}}折
            </span>
            <span ng-hide="order.vip_info">无</span>
          </div>
          <div class="wp-table-col col-4">
            <wp-btn-sm ng-show="order.vip_info" ng-click="unbind_vip_info()" >解除绑定</wp-btn-sm>
            <wp-btn-sm ng-show="can_credits_deduction()" ng-click="credits_deduction_modal.toggle_show()" >积分抵扣</wp-btn-sm>
            <wp-btn-sm ng-show="can_cancel_credits_deduction()" ng-click="cancel_credits_deduction()" >取消积分抵扣</wp-btn-sm>
            <wp-btn-sm ng-show="can_fast_vip_card_pay()" ng-click="fast_vip_card_pay()" >会员支付</wp-btn-sm>
          </div>
        </wp-table-row>
        <wp-table-row ng-show="order.privilege_discount">
          <div class="wp-table-col col-4">权限折扣：</div>
          <div class="wp-table-col col-4">
            <span ng-show="order.privilege_discount">{{order.privilege_discount}}</span>
            <span ng-hide="order.privilege_discount">无</span>
          </div>
          <div class="wp-table-col col-4">
            <wp-btn-xs ng-show="order.privilege_discount" ng-click="cancel_privilege_discount()" class="warning">清除</wp-btn-xs>
          </div>
        </wp-table-row>
        <wp-table-row ng-show="order.privilege_reduction">
          <div class="wp-table-col col-4">权限减免：</div>
          <div class="wp-table-col col-4">
            <span ng-show="order.privilege_reduction">{{order.privilege_reduction}}</span>
            <span ng-hide="order.privilege_reduction">无</span>
          </div>
          <div class="wp-table-col col-4">
            <wp-btn-xs ng-show="order.privilege_reduction" ng-click="cancel_privilege_reduction()" class="warning">清除</wp-btn-xs>
          </div>
        </wp-table-row>
        <wp-table-row ng-show="order.privilege_free">
          <div class="wp-table-col col-4">权限免单：</div>
          <div class="wp-table-col col-4">
            <span ng-show="order.privilege_free">是</span>
            <span ng-hide="order.privilege_free">否</span>
          </div>
          <div class="wp-table-col col-4">
            <wp-btn-xs ng-show="order.privilege_free" ng-click="cancel_privilege_free()" class="warning">清除</wp-btn-xs>
          </div>
        </wp-table-row>
        <wp-table-row ng-show="order.discount_plan">
          <div class="wp-table-col col-4">折扣方案</div>
          <div class="wp-table-col col-4">
            <span>{{order.discount_plan}}</span>
          </div>
          <div class="wp-table-col col-4">
            <wp-btn-xs ng-click="discount_plan.cancel()" class="warning">清除</wp-btn-xs>
          </div>
        </wp-table-row>
        <wp-table-row ng-repeat="ad in order.promotion_adjustments">
          <div class="wp-table-col col-4">{{ad.label}}</div>
          <div class="wp-table-col col-4"><span>{{ad.amount}}</span></div>
          <div class="wp-table-col col-4">
            <wp-btn-xs ng-click="remove_promotion_adjustment(ad)" class="warning">取消</wp-btn-xs>
          </div>
        </wp-table-row>
        <wp-table-row ng-repeat="dp in order.disabled_promotions">
          <div class="wp-table-col col-4">{{dp.name}}</div>
          <div class="wp-table-col col-4">已禁用</div>
          <div class="wp-table-col col-4">
            <wp-btn-xs ng-click="recover_promotion_adjustment(dp)" class="warning">恢复</wp-btn-xs>
          </div>
        </wp-table-row>
      </div>
      <div class="wp-table without-border center wp-order-total">
        <wp-table-row>
          <div class="wp-table-col col-4 total">合计:</div>
          <div class="wp-table-col col-4 total">{{order.total}}</div>
          <div class="wp-table-col col-4" ng-hide="order_type == 'recharge'">
            <wp-btn-sm ng-click="moling()">抹零</wp-btn-sm>
            <wp-btn-sm ng-click="cancel_moling()" ng-show="order.has_moling">撤销</wp-btn-sm>
          </div>
        </wp-table-row>
      </div>
      <div class="wp-table without-border center wp-os-pay-items">
        <wp-table-row ng-repeat="pay_item in pay_items" ng-hide="order.pay_items.length">
          <div class="wp-table-col col-4">{{::pay_item.name}}：</div>
          <div class="wp-table-col col-4">{{::pay_item.amount}}</div>
          <div class="wp-table-col col-4">
            <wp-btn-sm ng-click="pay_items.splice($index, 1)" class="warning">清除</wp-btn-sm>
          </div>
        </wp-table-row>
        <wp-table-row ng-hide="order.pay_items.length || pay_items.length == 0">
          <div class="wp-table-col col-4">支付项目合计:</div>
          <div class="wp-table-col col-4">{{pay_items_total()}}</div>
          <div class="wp-table-col col-4">&nbsp;</div>
        </wp-table-row>
        <wp-table-row ng-repeat="pay_item in order.pay_items" ng-show="order.pay_items.length">
          <div class="wp-table-col col-3">{{::pay_item.name}}：</div>
          <div class="wp-table-col col-4">{{::pay_item.amount}}</div>
          <div class="wp-table-col col-5">
            <!-- label -->
            <wp-btn-sm ng-show="pay_item.state != 'unpaid'"
                    ng-class="{'green':pay_item.state=='paid','red':pay_item.state=='refunded', 'blue':pay_item.state == 'closed'}">{{pay_item.state_name}}</wp-btn-sm>

            <!-- unpaid options -->
            <div ng-if="pay_item.state == 'unpaid'">
                <div ng-if="!pay_item.pay_platform">
                    <wp-btn-sm ng-click="change_pay_item_to_paid(pay_item)">确认</wp-btn-sm>
                </div>
                <div ng-if="pay_item.pay_platform">
                    <wp-btn-sm ng-click="pay_item_get_pay_online(pay_item)"
                               ng-if="pay_item.online ">扫码</wp-btn-sm>
                    <wp-btn-sm ng-click="pay_item_pay_by_seller_scan(pay_item)"
                               ng-if="!pay_item.online ">扫码</wp-btn-sm>
                    <wp-btn-sm ng-click="refresh_pay_item_state(pay_item)">刷新</wp-btn-sm>
                    <wp-btn-sm ng-click="close_pay_item(pay_item)">撤消</wp-btn-sm>
                </div>
            </div>

            <!-- paid options -->
            <div ng-if="pay_item.state == 'paid'">
              <span ng-if="'pay_on_face' == pay_item.name_sym">
                  <span ng-show="pay_item.paid_amount">收取: {{pay_item.paid_amount}}</span>
                  <span ng-show="pay_item.change">，找零: {{pay_item.change}}</span>
              </span>
              <wp-btn-sm ng-click="refund(pay_item)" ng-show="can_refund(pay_item)">退款</wp-btn-sm>
            </div>
          </div>
        </wp-table-row>
      </div>

      <div class="wp-os-actions">
        <wp-btn class="wp-os-submit-btn"
                ng-click="settle()"
                ng-class="{'disabled': !can_settle(), 'primary': can_settle()}"
                ng-hide="order.pay_items.length">结算</wp-btn>
        <wp-btn class="wp-os-submit-btn primary"
                ng-click="clear_pay_items()"
                ng-show="order.pay_items.length">重新结算</wp-btn>
        <wp-btn ng-click="discount_plan.modal.open()"
                ng-show="discount_plan.show_select_btn() && order_type != 'recharge'">折扣方案</wp-btn>
      </div>
    </div>
  </div>
  <div class="op-part order-info" wp-scroll-zone>
    <div class="order-info-side" ng-show="order">
      <div class="wp-subject" ng-if="order.line_items.length > 0">订单详情</div>
      <wp-btn-sm ng-show="is_fast_food()"
            ng-click="go_modify_fast_food()">返回修改</wp-btn-sm>
      <wp-btn-sm ng-show="is_eat_in_hall()"
            ng-click="print_consume_bill()">拉消费单</wp-btn-sm>
    <div class="order-info-side" ng-show="order">
      <div class="table-table-name" ng-show="order.table_name">{{order.table_name}}</div>
      <div class="table-table-name-desc" ng-show="order.table_name">人数{{order.guest_num}}位 下单{{placed_time_str}}分钟 点菜员:{{order.waiter_name}}</div>
      <table class="wp-table-sm" ng-show="order">
        <thead>
          <th width="10%">序号</th>
          <th width="50%">名称</th>
          <th width="15%">数量</th>
          <th width="25%">价格</th>
        </thead>
        <tbody>
          <tr ng-repeat="line_item in order.line_items"
              ng-class="{odd: $index % 2 == 0}">
            <td>{{$index+1}}</td>
            <td>
              <span class="blue" ng-if="line_item.is_append">[加]</span>
              {{line_item.name}}
              <span ng-show="line_item.note">[{{line_item.note}}]</span>
              <span class="red" ng-if="line_item.gift">(赠)</span>
              <br />
              <span class="create-time">{{time_since_from(line_item.created_at)}}分钟</span>
            </td>
            <td>{{line_item.active_quantity}}</td>
            <td>
              {{line_item.price |currency:''}}
              <span class="original-price"
                    ng-show="line_item.price !== line_item.original_price"
                    ng-class="{'change-price': line_item.is_change_price}"
                    >{{line_item.original_price|currency:''}}
              </span>
            </td>
          </tr>
        </tbody>
      </table>
      <div class="table-order-total" ng-show="order.total">合计: {{order.total|currency:shop.currency}}</div>
      <div class="detail-info">
        <div class="detail-info-item" ng-repeat="info_item in order.info_items">
          <div class="info-name">{{info_item.name}}</div>
          <div class="info-value">{{info_item.value}}</div>
        </div>
      </div>
      <div class="space"></div>
    </div>
    <div class="space"></div>
  </div>
  </div>
  <wp-modal wp-show="vip_modal.search_show" wp-lock-mask="true">
    <div class="wp-modal-header">会员查询</div>
    <div class="wp-modal-content">
      <div class="wp-form-group">
        <div class="wp-form-label">输入会员姓名/手机/编号：</div>
        <wp-input input-model="vip_modal.search_key" input-type="text" input-size="normal"></wp-input>
        <wp-btn ng-click="vip_modal.search_vip_info()">查找</wp-btn>
      </div>
      <div class="wp-table" >
        <wp-table-row ng-show="vip_modal.vip_infos.length > 0">
          <div class="wp-table-col col-1">会员编号</div>
          <div class="wp-table-col col-2">姓名</div>
          <div class="wp-table-col col-2">电话</div>
          <div class="wp-table-col col-2">余额</div>
          <div class="wp-table-col col-2">积分</div>
        </wp-table-row>
        <wp-table-row ng-repeat="vip_info in vip_modal.vip_infos"
                      ng-click="vip_modal.search_select(vip_info)"
                      ng-class="{ 'active': vip_info.id == vip_modal.chosen_vip_info.id}">
          <div class="wp-table-col col-1">{{::vip_info.vip_no}}</div>
          <div class="wp-table-col col-2">{{::vip_info.name}}</div>
          <div class="wp-table-col col-2">{{::vip_info.phone}}</div>
          <div class="wp-table-col col-2">{{::vip_info.card_wallet.display_amount}}</div>
          <div class="wp-table-col col-2">{{::vip_info.credits_wallet.display_amount}}</div>
        </wp-table-row>
      </div>
      <div class="wp-modal-actions">
        <wp-btn ng-click="vip_modal.search_confirm()">确定</wp-btn>
        <wp-btn ng-click="vip_modal.search_close()">返回</wp-btn>
      </div>
    </div>
  </wp-modal>

  <wp-modal wp-show="voucher_modal.show">
    <div class="wp-modal-header">代金券兑换</div>
    <div class="wp-modal-content">
      <div class="wp-form-group">
        <div class="wp-form-label">输入代金券兑换码：</div>
        <wp-input input-model="voucher_modal.code" input-type="text" input-size="normal"></wp-input>
        <wp-btn ng-click="voucher_modal.search_voucher()">查找</wp-btn>
      </div>
      <div class="wp-form-group">
        <div class="wp-form-label">名称：</div>
        <div class="wp-form-input">{{voucher_modal.voucher.name}}</div>
      </div>
      <div class="wp-form-group">
        <div class="wp-form-label">描述：</div>
        <div class="wp-form-input">{{voucher_modal.voucher.description}}</div>
      </div>
      <div class="wp-modal-actions">
        <wp-btn ng-click="voucher_modal.submit()">确定</wp-btn>
        <wp-btn ng-click="voucher_modal.close()">取消</wp-btn>
      </div>
    </div>
  </wp-modal>

  <wp-modal wp-show="pay_item_modal.show" class="wp-modal-md pay-item-modal">
    <div class="wp-modal-header">支付项目</div>
    <div class="wp-modal-content">
      <div class="wp-form-group">
          <wp-btn-sm ng-click="add_money(500)">500</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(100)">100</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(50)">50</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(20)">20</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(10)">10</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(5)">5</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(1)">1</wp-btn-sm>
      </div>
      <div class="wp-form-group">
        <div class="wp-form-label">{{pay_item_modal.pay_item.name}}</div>
        <wp-input input-model="pay_item_modal.pay_item.amount" input-type="number" input-size="normal"></wp-input>
        <wp-btn-sm ng-click="pay_item_modal.clear()">重录</wp-btn-sm>
      </div>
      <div class="wp-form-group" ng-show="pay_item_modal.pay_item.name_sym == 'tick_for_account'">
        <div class="wp-form-label">挂账单位</div>
      </div>
      <div class="wp-form-group" ng-show="pay_item_modal.pay_item.name_sym == 'tick_for_account'">
        <wp-btn ng-click="pay_item_modal.active_tick_account = tick_account;" ng-repeat="tick_account in pay_item_modal.tick_accounts" ng-class="{'active': pay_item_modal.active_tick_account == tick_account}">{{tick_account.name}}</wp-btn>
      </div>
      <div class="wp-modal-actions">
        <wp-btn ng-click="pay_item_modal.submit()" ng-class="{'disabled':!pay_item_modal.can_submit()}">确定</wp-btn>
        <wp-btn ng-click="pay_item_modal.close()">取消</wp-btn>
      </div>
    </div>
  </wp-modal>

  <wp-modal wp-show="pay_on_face_modal.show" class="wp-modal-md">
    <div class="wp-modal-header">现金支付</div>
    <div class="wp-modal-content">
      <div class="wp-form-group">
          <wp-btn-sm ng-click="add_money(500)">500</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(100)">100</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(50)">50</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(20)">20</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(10)">10</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(5)">5</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(1)">1</wp-btn-sm>
      </div>
      <hr />
      <div class="wp-form-group">
        <div class="wp-form-label">应收</div>
        <div class="wp-form-label">{{pay_on_face_modal.pay_item.amount}}</div>
      </div>
      <div class="wp-form-group">
        <div class="wp-form-label">收取</div>
        <wp-input class="pay-on-face-modal" input-model="pay_on_face_modal.paid_amount" input-type="number" input-size="small"></wp-input>
        <wp-btn-sm ng-click="pay_on_face_modal.clear()">重录</wp-btn-sm>
      </div>
      <div class="wp-form-group">
        <div class="wp-form-label">找零</div>
        <div class="wp-form-label">{{pay_on_face_modal.change}}</div>
      </div>
      <div class="wp-modal-actions">
        <wp-btn class="default-action" ng-click="pay_on_face_modal.submit()" ng-class="{'disabled': !pay_on_face_modal.can_submit()}">确定</wp-btn>
        <wp-btn class="cancel-action" ng-click="pay_on_face_modal.close()">取消</wp-btn>
      </div>
    </div>
  </wp-modal>

  <wp-modal wp-show="pay_item_selection_modal.show" class="wp-modal-md pay-item-selection-modal">
      <div class="wp-modal-header">现金支付</div>
      <div class="wp-modal-content">
        <div class="wp-form-group">
          <wp-btn-sm ng-click="add_money(500)">500</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(100)">100</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(50)">50</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(20)">20</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(10)">10</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(5)">5</wp-btn-sm>
          <wp-btn-sm ng-click="add_money(1)">1</wp-btn-sm>
        </div>
        <hr />
        <div class="wp-modal-split">
          <div class="wp-form-group left">
            <div class="wp-form-group">
              <div class="wp-form-label">应收</div>
              <div class="wp-form-label">{{pay_item_selection_modal.pay_item.amount}}</div>
            </div>
            <div class="wp-form-group paid-amount-group">
              <div class="wp-form-label">收取</div>
              <wp-input class="pay-on-face-modal" input-model="pay_item_selection_modal.paid_amount" input-type="number" input-size="small"></wp-input>
              <!--<wp-btn-sm ng-click="pay_item_selection_modal.clear()">重录</wp-btn-sm>-->
            </div>
            <div class="wp-form-group">
              <div class="wp-form-label">找零</div>
              <div class="wp-form-label">{{pay_item_selection_modal.change}}</div>
            </div>
          </div>
          <div class="wp-form-group left pay-item-selection-group">
            <div class="wp-form-group inline" ng-show="show_pay_method_name('bank_card_pay')">
              <wp-btn-sm ng-click="pay_item_selection_modal.select_pay_method('bank_card_pay')">银行卡</wp-btn-sm>
            </div>
            <div class="wp-form-group inline" ng-show="show_pay_method_name('alipay')">
              <wp-btn-sm ng-click="pay_item_selection_modal.select_pay_method('alipay')">支付宝</wp-btn-sm>
            </div>
            <div class="wp-form-group inline" ng-show="show_pay_method_name('wechatpay')">
              <wp-btn-sm ng-click="pay_item_selection_modal.select_pay_method('wechatpay')">微信支付</wp-btn-sm>
            </div>
            <div class="wp-form-group inline" ng-show="show_pay_method_name('alipay_offline')">
              <wp-btn-sm ng-click="pay_item_selection_modal.select_pay_method('alipay_offline')">线下支付宝</wp-btn-sm>
            </div>
            <div class="wp-form-group inline" ng-show="show_pay_method_name('wechatpay_offline')">
              <wp-btn-sm ng-click="pay_item_selection_modal.select_pay_method('wechatpay_offline')">线下微信支付</wp-btn-sm>
            </div>
          </div>
          <div class="clearfix"></div>
        </div>
        <div class="wp-modal-actions">
          <wp-btn class="default-action" ng-click="pay_item_selection_modal.submit()" ng-class="{'disabled': !pay_item_selection_modal.can_submit()}">确定</wp-btn>
          <wp-btn class="cancel-action" ng-click="pay_item_selection_modal.close()">取消</wp-btn>
        </div>
      </div>
  </wp-modal>

    <wp-modal wp-show="pay_on_face_finish_modal.show" class="wp-modal-md">
      <div class="wp-modal-header">现金支付详情</div>
      <div class="wp-modal-content">
        <hr />
        <div class="wp-form-group">
          <div class="wp-form-group">
            <div class="wp-form-label">应收</div>
            <div class="wp-form-label">{{pay_on_face_finish_modal.amount}}</div>
          </div>
          <div class="wp-form-group">
            <div class="wp-form-label">收取</div>
            <div class="wp-form-label">{{pay_on_face_finish_modal.paid_amount}}</div>
          </div>
          <div class="wp-form-group">
            <div class="wp-form-label">找零</div>
            <div class="wp-form-label">{{pay_on_face_finish_modal.change}}</div>
          </div>
        </div>
        <div class="wp-form-group">

        </div>
        <div class="wp-modal-actions">
          <wp-btn class="default-action" ng-click="pay_on_face_finish_modal.close()">确定</wp-btn>
        </div>
      </div>
    </wp-modal>


    <wp-modal wp-show="pay_item_qrcode_modal.show" class="wp-modal-sm">
    <div class="wp-modal-header">扫码支付</div>
    <div class="wp-modal-actions">
      <wp-btn ng-click="pay_item_qrcode_modal.refresh_qr_code()">刷新二维码</wp-btn>
      <wp-btn ng-click="pay_item_qrcode_modal.back()">返回并刷新状态</wp-btn>
      <wp-btn ng-click="pay_item_qrcode_modal.replace_qr_code()">更换二维码</wp-btn>
    </div>
    <div class="wp-modal-content">
      <div class="wp-form-label">{{pay_item_qrcode_modal.hint}}</div>
      <div class="clearfix"></div>
      <div class="qrcode">
        <img ng-src="{{pay_item_qrcode_modal.qr_code_url}}" width="250px" height="250px"/>
      </div>
    </div>
  </wp-modal>
</div>
<wp-modal wp-show="credits_deduction_modal.show">
  <div class="wp-modal-header">积分抵扣</div>
  <div class="wp-modal-content">
    <div class="wp-form-group">
      <div class="wp-form-label">当前用户</div>
      <div class="wp-form-input">{{order.vip_info.vip_no}}-{{order.vip_info.name}}</div>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label">当前积分</div>
      <div class="wp-form-input">{{order.vip_info.credits_wallet}}<span class="webpos-hint">&nbsp;({{branch.credits_exchange_radio}}积分可抵1元)</span></div>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label">积分抵扣</div>
      <wp-input input-model="credits_deduction_modal.credits" input-type="number" input-size="small" input-focus="credits_deduction_modal.show"></wp-input>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label"></div>
      <div class="wp-form-action">
        <wp-btn ng-click="credits_deduction_modal.submit()"
                ng-class="{'disabled': !credits_deduction_modal.can_submit()}">抵扣</wp-btn>
        <wp-btn ng-click="credits_deduction_modal.toggle_show()">取消</wp-btn>
      </div>
    </div>
  </div>
</wp-modal>
<wp-modal class="discount-plan" wp-show="discount_plan.modal.show">
  <div class="wp-modal-header">选择折扣方案</div>
  <div class="wp-modal-content">
    <div class="wp-form-group">
      <div>
        <wp-btn ng-click="discount_plan.modal.select(plan)" ng-repeat="plan in discount_plan.collection">{{plan.name}}
          <span class="hotkey" ng-if="plan.hotkey">[ {{plan.hotkey}} ]</span>
        </wp-btn>
      </div>
    </div>
  </div>
</wp-modal>
<div wp-include src="partial('_modals/discount_plan')"></div>
<div wp-include src="partial('_actions/fastfood_extended_form')"></div>
