<div class="wp-footbar wp-page-footer" ng-class="{'hide-menu': !show_menus}">
  <div ng-show="show_menus">
    <div ng-show="has_multi_branches">
      <wp-menu ng-click="go('/')" icon="home">
        门店
      </wp-menu>
    </div>
    <wp-menu ng-repeat="menu in menus|filter:{folded: false}"  icon="{{menu.icon}}"
            ng-click="change_active_menu(menu)"
            ng-class="{'active': is_controller(menu.controller_name)}"
            ng-if="!menu.need_shift || branch.on_shift">
        {{ menu.name }}
    </wp-menu>
    <div class="wp-menu right-fix" ng-click="toggle_folded_menus()">
      <i class="wp-menu-icon fa fa-th-large fa-fw"></i>
      <div class="wp-menu-text">其他</div>
      <div class="wp-nest-menus" ng-class="get_nest_menu_class()" ng-show="show_folded_menus">
        <wp-menu ng-repeat="menu in menus|filter:{folded: true}"  icon="{{menu.icon}}"
            ng-click="change_active_menu(menu)"
            ng-class="{'active': is_controller(menu.controller_name)}"
            ng-if="!menu.need_shift || branch.on_shift">
          {{ menu.name }}
        </wp-menu>
        <wp-menu icon="cog"
            ng-click="menu_setting_modal.open()"
            ng-class="{'active': menu_setting_modal.show}">
          菜单设置
        </wp-menu>
      </div>
    </div>
    <div class="space"></div>
  </div>
  <wp-modal wp-show="menu_setting_modal.show">
    <div class="wp-modal-header">菜单折叠设置</div>
    <div class="wp-modal-content">
      <wp-btn ng-repeat="menu in menus"
              ng-click="toggle_menu_fold(menu);"
              ng-class="{active: !menu.folded}">
        <i class="fa fa-{{menu.icon}} fa-fw"></i>
        {{::menu.name}}
      </wp-btn>
      <div class="clearfix"></div>
      <div class="wp-modal-actions">
        <wp-btn ng-click="menu_setting_modal.close()">返回</wp-btn>
      </div>
    </div>
  </wp-modal>
  <div class="toggle-action-content">
    <div class="toggle-action" ng-click="toggle_show_menus()">
      <div class="action-line-1"></div>
      <div class="action-line-2"></div>
    </div>
  </div>
  <div class="toggle-action-shadow"></div>
</div>
