<div class="master-part vip-infos" wp-scroll-zone>
  <div class="vip-level-index">
    <div class="wp-subject">会员</div>
    <div ng-hide="table_action">
      <wp-btn  ng-click="create_vip_info()">新建会员</wp-btn>
      <wp-btn  ng-click="read_card()" ng-show="can('shop', 'user', 'show')">读卡</wp-btn>
      <wp-btn  ng-click="scan_qrcode()">扫码识别</wp-btn>
    </div>
    <div class="wp-form-group">
      <wp-input class="vip-search-field" input-model="search_key" input-type="text" input-size="large" placeholder="会员号、姓名、手机号"></wp-input>
    </div>
    <div class="space"></div>
  </div>
  <div>
    <div class="wp-subject">会员列表</div>
    <div class="wp-table" >
      <div class="wp-no-record" ng-hide="vip_infos.length > 0">当前尚没有记录</div>
      <wp-table-row ng-hide="vip_infos.length == 0">
        <div class="wp-table-col col-1">会员编号</div>
        <div class="wp-table-col col-3">姓名</div>
        <div class="wp-table-col col-3">电话</div>
      </wp-table-row>
      <wp-table-row ng-repeat="vip_info in vip_infos"
                    ng-click="choose_vip_info(vip_info, 'query')"
                    ng-class="{ 'active': vip_info.id == active_vip_info.id}">
        <div class="wp-table-col col-1">{{::vip_info.vip_no}}</div>
        <div class="wp-table-col col-3">{{vip_info.name}}</div>
        <div class="wp-table-col col-3">{{vip_info.phone}}</div>
      </wp-table-row>
    </div>
    <wp-paginate page-model="page_vip_infos"></wp-paginate>
  </div>
</div>

<div class="op-part" ui-view="detail"></div>
<wp-footer-menu branch-id="branch_id"></wp-footer-menu>

<wp-modal wp-show="vip_info_modal.show">
  <div class="wp-modal-header">新建会员</div>
  <div class="wp-modal-content">
    <div class="wp-form-group">
      <div class="wp-form-label">会员编号：</div>
      <wp-input input-model="vip_info_modal.vip.vip_no" input-type="text" input-size="normal" placeholder="不填则自动生成"></wp-input>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label">会员姓名：</div>
      <wp-input input-model="vip_info_modal.vip.name" input-type="text" input-size="normal"></wp-input>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label">手机号：</div>
      <wp-input input-model="vip_info_modal.vip.phone" input-type="text" input-size="normal"></wp-input>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label">会员级别：</div>
      <div class="wp-form-select">
        <wp-btn
          ng-repeat="vip_level in vip_levels_no_default"
          ng-class="{'active': vip_info_modal.vip.vip_level_id == vip_level.id}"
          ng-click="vip_info_modal.vip.vip_level_id = vip_level.id;">
          {{::vip_level.name}}
        </wp-btn>
      </div>
    </div>
    <div class="wp-modal-actions">
      <wp-btn ng-click="vip_info_modal.submit()" ng-class="{'disabled': !vip_info_modal.can_submit()}">确定</wp-btn>
      <wp-btn ng-click="vip_info_modal.close()">取消</wp-btn>
    </div>
  </div>
</wp-modal>
