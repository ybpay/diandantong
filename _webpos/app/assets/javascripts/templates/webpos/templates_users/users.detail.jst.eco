<div wp-scroll-zone>
  <div class="wp-subject">会员操作区</div>
  <div class="vip-info-side" ng-show="vip_info">
    <div>
      <div ng-if="!vip_info.is_default">
        <wp-btn ng-click="card_recharge(vip_info)" ng-show="show_recharge()">余额充值</wp-btn>
        <wp-btn ng-click="log_modal.open('credits')">积分日志</wp-btn>
        <wp-btn ng-click="log_modal.open('card')">余额日志</wp-btn>
        <wp-btn ng-click="update_vip_info()">更改信息</wp-btn>
        <wp-btn ng-click="credits_exchange_modal.open()" ng-show="credits_exchange_modal.can_open()">积分兑换</wp-btn>
        <wp-btn ng-click="credits_get_modal.open()" ng-show="credits_get_modal.can_open()">积分充值</wp-btn>
      </div>
      <div class="space"></div>
    </div>

    <div class="wp-table">
      <wp-table-row>
        <div class="wp-table-col col-1">姓名: </div>
        <div class="wp-table-col col-3">{{vip_info.name}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-1">电话: </div>
        <div class="wp-table-col col-3">{{vip_info.phone}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-1">会员编号: </div>
        <div class="wp-table-col col-3">{{vip_info.vip_no}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-1">会员级别: </div>
        <div class="wp-table-col col-3">{{vip_info.vip_level_name}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-1">会员折扣: </div>
        <div class="wp-table-col col-3">{{vip_info.friendly_vip_level_discount}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-1">当前余额: </div>
        <div class="wp-table-col col-3">{{vip_info.card_wallet.display_amount}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-1">当前积分: </div>
        <div class="wp-table-col col-3">{{vip_info.credits_wallet.display_amount}}</div>
      </wp-table-row>
      <wp-table-row>
        <div class="wp-table-col col-1">累积消费: </div>
        <div class="wp-table-col col-3">{{vip_info.total_amount}}</div>
      </wp-table-row>
    </div>
    <div class="wp-subject">实体卡操作区</div>
    <div>
      <wp-btn ng-click="init_card()">初始化会员卡</wp-btn>
      <wp-btn ng-click="write_card()" ng-show="vip_info && !vip_info.is_default">写卡</wp-btn>
      <wp-btn ng-click="bind_user()" ng-show="vip_info && !vip_info.is_default && !vip_info.user_id">绑定微信会员</wp-btn>
      <div class="space"></div>
      <wp-btn ng-click="clear_card()" ng-show="can('shop', 'user', 'update')">重置并清空实体卡</wp-btn>
      <wp-btn ng-click="read_card()" ng-show="env == 'development'">读卡</wp-btn>
      <div class="space"></div>
    </div>
  </div>
  <div class="space"></div>
</div>

<wp-modal wp-show="vip_info_modal.show">
  <div class="wp-modal-header">会员信息</div>
  <div class="wp-modal-content">
    <div class="wp-form-group">
      <div class="wp-form-label">会员编号：</div>
      <div class="wp-form-input">{{vip_info_modal.vip.vip_no}}</div>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label">会员姓名：</div>
      <wp-input input-model="vip_info_modal.vip.name" input-type="text" input-size="normal"></wp-input>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label">手机号：</div>
      <wp-input input-model="vip_info_modal.vip.phone" input-type="text" input-size="normal"></wp-input>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label">会员级别：</div>
      <div class="wp-form-select" ng-show="branch.can_change_vip_level_in_webpos">
        <wp-btn
          ng-repeat="vip_level in vip_levels_no_default"
          ng-class="{'active': vip_info_modal.vip.vip_level_id == vip_level.id}"
          ng-click="vip_info_modal.vip.vip_level_id = vip_level.id;">
          {{::vip_level.name}}
        </wp-btn>
      </div>
      <div class="wp-form-input" ng-hide="branch.can_change_vip_level_in_webpos">{{vip_info_modal.vip.vip_level_name}}</div>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label">生日：</div>
      <wp-input input-model="vip_info_modal.vip.birthday" input-type="date" input-size="normal"></wp-input>
    </div>
    <div class="wp-modal-actions">
      <wp-btn ng-click="vip_info_modal.submit()" ng-class="{'disabled': !vip_info_modal.can_submit()}">确定</wp-btn>
      <wp-btn ng-click="vip_info_modal.close()">取消</wp-btn>
    </div>
  </div>
</wp-modal>

<wp-modal wp-show="log_modal.show">
  <div class="wp-modal-header">{{log_modal.title}}</div>
  <div class="wp-modal-content">
    <div>
      <div class="wp-table" >
        <wp-table-row>
          <div class="wp-table-col col-3">创建时间</div>
          <div class="wp-table-col col-3">门店</div>
          <div class="wp-table-col col-3">原因</div>
          <div class="wp-table-col col-3">数额</div>
          <div class="wp-table-col col-3">操作者</div>
          <div class="wp-table-col col-3">备注</div>
          <div class="wp-table-col col-3"></div>
        </wp-table-row>
        <wp-table-row ng-repeat="wallet_log in log_modal.wallet_logs">
          <div class="wp-table-col col-3">{{::wallet_log.created_at | date:'yyyy-MM-dd HH:mm'}}</div>
          <div class="wp-table-col col-3">{{::wallet_log.branch_name}}</div>
          <div class="wp-table-col col-3">{{::wallet_log.reason}}</div>
          <div class="wp-table-col col-3">{{::wallet_log.display_amount}}</div>
          <div class="wp-table-col col-3">{{::wallet_log.operator_name}}</div>
          <div class="wp-table-col col-3">{{wallet_log.note}}</div>
          <div class="wp-table-col col-3">
            <wp-btn-sm ng-show="log_modal.can_change_note(wallet_log)" ng-click="log_modal.change_note(wallet_log)">已开票</wp-btn-sm>
          </div>
        </wp-table-row>
      </div>
      <div class="wp-no-record" ng-hide="log_modal.wallet_logs.length > 0">该会员还没有日志记录</div>
      <wp-paginate page-model="log_modal.page_wallet_logs"></wp-paginate>
    </div>
  </div>
</wp-modal>

<wp-modal wp-show="recharge_product_modal.show">
  <div class="wp-modal-header">余额充值</div>
  <div class="wp-modal-content">
    <wp-btn
      ng-repeat="rp in recharge_product_modal.recharge_products"
      ng-click="recharge_product_modal.select_recharge_product(rp);">
      {{::rp.name}}
    </wp-btn>
  </div>
</wp-modal>

<wp-modal wp-show="temp_recharge_product_modal.show">
  <div class="wp-modal-header">余额充值</div>
  <div class="wp-modal-content">
    <div class="wp-form-group">
      <div class="wp-form-label">充值金额：</div>
      <wp-input input-model="temp_recharge_product_modal.product.price" input-type="text" input-size="normal"></wp-input>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label">到账金额：</div>
      <wp-input input-model="temp_recharge_product_modal.product.recharge_amount" input-type="text" input-size="normal"></wp-input>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label">赠送积分：</div>
      <wp-input input-model="temp_recharge_product_modal.product.extra_credits" input-type="text" input-size="normal"></wp-input>
    </div>
    <div class="wp-modal-actions">
      <wp-btn ng-click="temp_recharge_product_modal.submit()" ng-class="{'disabled': !temp_recharge_product_modal.can_submit()}">确定</wp-btn>
      <wp-btn ng-click="temp_recharge_product_modal.close()">取消</wp-btn>
    </div>
  </div>
</wp-modal>

<wp-modal wp-show="credits_exchange_modal.show">
  <div class="wp-modal-header">积分兑换</div>
  <div class="wp-modal-content">
    <div class="wp-form-group">
      <div class="wp-form-label">当前积分：</div>
      <div class="wp-form-input">{{vip_info.credits_wallet.display_amount}}</div>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label">兑换积分：</div>
      <wp-input input-model="credits_exchange_modal.amount" input-type="number" input-size="normal"></wp-input>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label">备注：</div>
      <wp-input input-model="credits_exchange_modal.note" input-type="text" input-size="normal"></wp-input>
    </div>
    <div class="wp-modal-actions">
      <wp-btn ng-click="credits_exchange_modal.submit()" ng-class="{'disabled': !credits_exchange_modal.can_submit()}">确定</wp-btn>
      <wp-btn ng-click="credits_exchange_modal.close()">取消</wp-btn>
    </div>
  </div>
</wp-modal>

<wp-modal wp-show="credits_get_modal.show">
  <div class="wp-modal-header">积分充值</div>
  <div class="wp-modal-content">
    <div class="wp-form-group">
      <div class="wp-form-label">当前积分：</div>
      <div class="wp-form-input">{{vip_info.credits_wallet.display_amount}}</div>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label">充值积分：</div>
      <wp-input input-model="credits_get_modal.amount" input-type="number" input-size="normal"></wp-input>
    </div>
    <div class="wp-form-group">
      <div class="wp-form-label">备注：</div>
      <wp-input input-model="credits_get_modal.note" input-type="text" input-size="normal"></wp-input>
    </div>
    <div class="wp-modal-actions">
      <wp-btn ng-click="credits_get_modal.submit()" ng-class="{'disabled': !credits_get_modal.can_submit()}">确定</wp-btn>
      <wp-btn ng-click="credits_get_modal.close()">取消</wp-btn>
    </div>
  </div>
</wp-modal>
