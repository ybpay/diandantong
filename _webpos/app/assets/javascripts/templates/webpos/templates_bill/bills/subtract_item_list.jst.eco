<div class="main-part" wp-scroll-zone ng-show="active_menu.tag == 'subtract_item_list'">
  <div class="subtract_item_list" >
    <wp-datetime-input class="left" input-type="datetime" input-model="params.start_time" placeholder="起始时间"></wp-datetime-input>
    <wp-datetime-input class="left" input-type="datetime" input-model="params.end_time" placeholder="结束时间"></wp-datetime-input>
    <wp-btn-sm ng-click="search_subtract_item_list()">查询</wp-btn-sm>
    <wp-btn-sm ng-click="print_subtract_item_list()">打印</wp-btn-sm>
    <div class="wp-subject col-xs-12" ng-show="subtract_item_list.from_cache">以下是缓存的查询结果，查询最新数据请点击<a ng-click="search_subtract_item_list({refresh: true})">这里</a></div>
    <table class="wp-table-sm" ng-show="subtract_item_list.items">
      <thead>
        <th width="15%">订单号</th>
        <th width="10%">桌台</th>
        <th width="10">时间</th>
        <th width="20%">菜品</th>
        <th width="10%">数量</th>
        <th width="10%">金额</th>
        <th width="15%">理由</th>
        <th width="10%">退菜人</th>
      </thead>
      <tbody>
        <tr ng-repeat="item in subtract_item_list.items"
            ng-class="{odd: $index % 2 == 0}">
          <td>{{::item.order_number}}</td>
          <td>{{::item.table_name_with_zone}}</td>
          <td>{{::item.created_at}}</td>
          <td>{{::item.itemable_name}}</td>
          <td>{{::item.quantity}}</td>
          <td>{{::item.amount}}</td>
          <td>{{::item.subtract_reason}}</td>
          <td>{{::item.operator_name}}</td>
        </tr>
      </tbody>
    </table>

    <div class="col-md-12">
      <div class="wp-subject"><span class="red">合计</span></div>
      <table class="wp-table-sm">
        <tbody>
          <tr>
            <td width="65%"></td>
            <td width="10%">{{subtract_item_list.total_quantity}}</td>
            <td width="10%">{{subtract_item_list.total_amount | number:2}}</td>
            <td width="15%"></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
