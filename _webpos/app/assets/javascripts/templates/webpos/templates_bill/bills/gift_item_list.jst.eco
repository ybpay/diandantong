<div class="main-part" wp-scroll-zone ng-show="active_menu.tag == 'gift_item_list'">
    <div class="gift_item_list" >
        <wp-datetime-input class="left" input-type="datetime" input-model="params.start_time" placeholder="起始时间"></wp-datetime-input>
        <wp-datetime-input class="left" input-type="datetime" input-model="params.end_time" placeholder="结束时间"></wp-datetime-input>
        <wp-btn-sm ng-click="search_gift_item_list()">查询</wp-btn-sm>
        <wp-btn-sm ng-click="print_gift_item_list()">打印</wp-btn-sm>
        <div class="wp-subject col-xs-12" ng-show="gift_item_list.from_cache">以下是缓存的查询结果，查询最新数据请点击<a ng-click="search_gift_item_list({refresh: true})">这里</a></div>
        <table class="wp-table-sm" ng-show="gift_item_list.items">
            <thead>
            <th width="1%">订单号</th>
            <th width="1%">桌台</th>
            <th width="1%">菜品</th>
            <th width="1%">数量</th>
            <th width="1%">价格</th>
            <th width="1%">理由</th>
            <th width="1%">赠送时间</th>
            </thead>
            <tbody>
            <tr ng-repeat="item in gift_item_list.items"
                ng-class="{odd: $index % 2 == 0}">
                <td>{{::item.order_number}}</td>
                <td>{{::item.table_name}}</td>
                <td>{{::item.name}}</td>
                <td>{{::item.quantity}}</td>
                <td>{{::item.price}}</td>
                <td>{{::item.reason}}</td>
                <td>{{::item.created_at}}</td>
            </tr>
            <tr>
                <td></td>
                <td></td>
                <td></td>
                <td>{{gift_item_list.total_quantity}}</td>
                <td>{{gift_item_list.total_amount}}</td>
                <td></td>
                <td></td>
            </tr>
            </tbody>
        </table>
    </div>
</div>
