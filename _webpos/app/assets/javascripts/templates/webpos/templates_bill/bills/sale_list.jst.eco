<div class="main-part" wp-scroll-zone ng-show="active_menu.tag == 'sale_list'">
    <div class="sale_list">
        <div class="pay-item-state">
          <wp-btn-sm ng-click="change_pay_item_state(pay_item_state)"
                  ng-class="{'active': pay_item_state.value == active_pay_item_state.value}"
                  ng-repeat="pay_item_state in pay_item_state_collection track by $index">
            {{::pay_item_state.name}}
          </wp-btn-sm>
         </div>
         <div class="clearfix"></div>

        <div class='selected-objes'>
            <div class='selected-categories'>
                <div class='selected-category' ng-click="remove_category(category)" ng-repeat="category in selected_category">{{category.name}}</div>
            </div>
            <div class='selected-products'>
                <div class='selected-product' ng-click="remove_product(product)" ng-repeat="product in selected_product">{{product.name}}</div>
            </div>
        </div>



        <wp-datetime-input class="left" input-type="datetime" input-model="params.start_time" placeholder="起始时间"></wp-datetime-input>
        <wp-datetime-input class="left" input-type="datetime" input-model="params.end_time" placeholder="结束时间"></wp-datetime-input>
        <wp-btn-sm class="left" ng-click="time_interval_modal.show = true">{{current_time_interval.name}}</wp-btn-sm>

        <wp-btn-sm ng-click="search_sale_list()" ng-disabled="can_search() || searching">查询</wp-btn-sm>
        <wp-btn-sm ng-click="print_sale_list()">打印</wp-btn-sm>
        <div class="clearfix"></div>
        <div class="wp-subject col-xs-12" ng-show="sale_list.from_cache">以下是缓存的查询结果，查询最新数据请点击<a ng-click="search_sale_list({refresh: true})">这里</a></div>
        <div ng-repeat="(group,items) in sale_list.group_items" ng-show="sale_list.group_items">
            <div class="wp-subject"><span class="red">{{::group}}</span></div>
            <table class="wp-table-sm">
                <thead>
                <th width="25%">项目</th>
                <th width="10%">数量</th>
                <th width="11%">折前</th>
                <th width="11%">折扣</th>
                <th width="11%">折后</th>
                <th width="11%">非实收</th>
                <th width="11%">实收</th>
                <th width="10%">金额%</th>
                </thead>
                <tbody>
                <tr ng-repeat="item in items"
                    ng-class="{odd: $index % 2 == 0}">
                    <td>{{::item.name}}</td>
                    <td>{{::item.quantity}}</td>
                    <td>{{::item.amount | number:2}}</td>
                    <td>{{::item.adjustment_total}}</td>
                    <td>{{::(to_f(item.amount) + to_f(item.adjustment_total) ) | number:2}}</td>
                    <td>{{::item.not_actual_amount}}</td>
                    <td>{{::(to_f(item.amount) + to_f(item.adjustment_total) - to_f(item.not_actual_amount)) | number:2 }}</td>
                    <td>{{::item.percent * 100 | number:2 }}%</td>
                </tr>
                </tbody>
            </table>
        </div>
        <div>
            <div class="wp-subject"><span class="red">合计</span></div>
            <table class="wp-table-sm">
                <tbody>
                    <tr>
                        <td width="25%">抹零</td>
                        <td width="10%"></td>
                        <td width="11%"></td>
                        <td width="11%">{{to_f(sale_list.moling_amount) | number:2}}</td>
                        <td width="11%">{{to_f(sale_list.moling_amount) | number:2}}</td>
                        <td width="11%"></td>
                        <td width="11%">{{to_f(sale_list.moling_amount) | number:2}}</td>
                        <td width="10%"></td>
                    </tr>
                </tbody>
            </table>
            <table class="wp-table-sm">
                <tbody>
                    <tr>
                        <td width="25%">合计</td>
                        <td width="10%">{{sale_list.total_quantity}}</td>
                        <td width="11%">{{sale_list.total_amount | number:2}}</td>
                        <td width="11%">{{(to_f(sale_list.total_adjustment) + to_f(sale_list.moling_amount)) | number:2 }}</td>
                        <td width="11%">{{(to_f(sale_list.total_amount) + to_f(sale_list.total_adjustment) + to_f(sale_list.moling_amount)) | number:2}}</td>
                        <td width="11">{{sale_list.total_not_actual_amount}}</td>
                        <td width="11%">{{(to_f(sale_list.total_amount) + to_f(sale_list.total_adjustment) - to_f(sale_list.total_not_actual_amount) + to_f(sale_list.moling_amount))  | number:2}}</td>
                        <td width="10%"></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<wp-modal wp-show="category_modal.show">
  <div class="wp-modal-header">选择分类</div>
  <div class="wp-modal-content">
    <wp-btn-sm
      ng-repeat="category in categories"
      ng-click="modal.toggle(category)"
      ng-class="{'active': category.active}"
      >
      {{::category.name}}
    </wp-btn-sm>
    <div class="wp-modal-actions">
        <wp-btn ng-click="modal.confirm()">确认</wp-btn>
        <wp-btn ng-click="modal.toggle_product()" ng-show="modal.can_toggle_product()">我要选菜</wp-btn>
    </div>
  </div>

</wp-modal>

<wp-modal wp-show="product_modal.show">
  <div class="wp-modal-header">选择产品</div>
  <div class="wp-modal-content">
    <wp-btn
      ng-repeat="product in products"
      ng-click="modal.toggle(product)"
      ng-class="{'active': product.active}"
      >
      {{::product.name}}
    </wp-btn>
    <div class="wp-modal-actions">
      <wp-btn ng-click="modal.confirm()">确认</wp-btn>
      <wp-btn ng-click="modal.close()">取消</wp-btn>
    </div>
  </div>

</wp-modal>
