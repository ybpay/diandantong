<div class="main-part" wp-scroll-zone ng-show="active_menu.tag == 'combo_package_list'">
    <div class="combo_package_list" >
        <wp-datetime-input class="left" input-type="datetime" input-model="params.start_time" placeholder="起始时间"></wp-datetime-input>
        <wp-datetime-input class="left" input-type="datetime" input-model="params.end_time" placeholder="结束时间"></wp-datetime-input>
        <wp-btn-sm ng-click="search_combo_package_list()">查询</wp-btn-sm>
        <wp-btn-sm ng-click="print_combo_package_list()">打印</wp-btn-sm>
        <div class="space"></div>
        <div class="wp-subject col-xs-12" ng-show="combo_package_list.from_cache">以下是缓存的查询结果，查询最新数据请点击<a ng-click="search_combo_package_list({refresh: true})">这里</a></div>
        <table class="wp-table-sm" ng-show="combo_package_list.items">
            <thead>
            <th width="1%">套餐</th>
            <th width="1%">售出数量</th>
            <th width="1%">详情信息</th>
            <th width="1%">金额合计</th>
            </thead>
            <tbody>
            <tr ng-repeat="combo_package in combo_package_list.items"
                ng-class="{odd: $index % 2 == 0}">
                <td>{{::combo_package.name}}</td>
                <td>{{::combo_package.sale_quantity}}</td>
                <td>
                    <div ng-repeat="(name, quantity) in combo_package.variants">
                        <span>{{::name}}</span>: <span>{{::quantity}}</span>
                    </div>
                </td>
                <td>{{::combo_package.sale_amount}}</td>
            </tr>
            </tbody>
        </table>
        <div class="wp-subject"><span class='red'>汇总</span></div>
        <table class="wp-table-sm" ng-show="combo_package_list.items">
            <tbody>
                <tr>
                    <td width="1%">&nbsp;</td>
                    <td width="1%">{{combo_package_list.total_sale_quantity}}</td>
                    <td width="1%">&nbsp;</td>
                    <td width="1%">{{combo_package_list.total_sale_amount}}</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
