<div class="main-part" wp-scroll-zone ng-show="active_menu.tag == 'order_cancel_list'">
    <div class="order_cancel_list" >
        <wp-datetime-input class="left" input-type="datetime" input-model="params.start_time" placeholder="起始时间"></wp-datetime-input>
        <wp-datetime-input class="left" input-type="datetime" input-model="params.end_time" placeholder="结束时间"></wp-datetime-input>
        <wp-btn-sm ng-click="search_order_cancel_list()">查询</wp-btn-sm>
        <wp-btn-sm ng-click="print_order_cancel_list()">打印</wp-btn-sm>
        <div class="wp-subject col-xs-12" ng-show="order_cancel_list.from_cache">以下是缓存的查询结果，查询最新数据请点击<a ng-click="search_order_cancel_list({refresh: true})">这里</a></div>
        <table class="wp-table-sm" ng-show="order_cancel_list.items">
            <thead>
            <th width="1%">订单号</th>
            <th width="1%">订单类型</th>
            <th width="1%">桌台</th>
            <th width="1%">金额</th>
            <th width="1%">时间</th>
            <th width="1%">操作者</th>
            </thead>
            <tbody>
            <tr ng-repeat="item in order_cancel_list.items"
                ng-class="{odd: $index % 2 == 0}">
                <td>{{::item.order_number}}</td>
                <td>{{::item.order_type}}</td>
                <td>{{::item.table_name}}</td>
                <td>{{::item.order_amount}}</td>
                <td>{{::item.created_at}}</td>
                <td>{{::item.operator_name}}</td>
            </tr>
            </tbody>
        </table>
    </div>
</div>
