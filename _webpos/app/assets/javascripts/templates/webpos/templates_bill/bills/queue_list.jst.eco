<div class="main-part" wp-scroll-zone ng-show="active_menu.tag == 'queue_list'">
    <div class="queue_list">
        <wp-datetime-input class="left" input-type="datetime" input-model="params.start_time" placeholder="起始时间"></wp-datetime-input>
        <wp-datetime-input class="left" input-type="datetime" input-model="params.end_time" placeholder="结束时间"></wp-datetime-input>
        <wp-btn-sm ng-click="search_queue_list()">查询</wp-btn-sm>
        <wp-btn-sm ng-click="print_queue_list()">打印</wp-btn-sm>
        <div class="clearfix"></div>
        <div class="wp-subject col-xs-12" ng-show="queue_list.from_cache">以下是缓存的查询结果，查询最新数据请点击<a ng-click="search_queue_list({refresh: true})">这里</a></div>
        <table class="wp-table-sm" ng-show="queue_list.items">
            <thead>
            <th width="1%">队列名称</th>
            <th width="1%">总桌数</th>
            <th width="1%">排号中</th>
            <th width="1%">就餐数</th>
            <th width="1%">就餐率</th>
            <th width="1%">流失数</th>
            <th width="1%">流失率</th>
            </thead>
            <tbody>
            <tr ng-repeat="item in queue_list.items"
                ng-class="{odd: $index % 2 == 0}">
                <td>{{::item.name}}</td>
                <td>{{::item.total}}</td>
                <td>{{::item.queueing}}</td>
                <td>{{::item.accepted}}</td>
                <td>{{::item.accepted_rate | number:1}}</td>
                <td>{{::item.rejected}}</td>
                <td>{{::item.rejected_rate | number:1}}</td>
            </tr>
            </tbody>
        </table>
    </div>
</div>