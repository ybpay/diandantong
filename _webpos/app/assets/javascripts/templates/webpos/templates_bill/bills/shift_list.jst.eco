<div class="main-part" wp-scroll-zone ng-show="active_menu.tag == 'shift_list'">
    <div class="shift_list" >
        <wp-datetime-input class="left" input-type="datetime" input-model="params.start_time" placeholder="起始时间" ng-show="by_shift"></wp-datetime-input>
        <span class="left lh-50" ng-show="by_shift"> ~ </span>
        <wp-datetime-input class="left" input-type="datetime" input-model="params.end_time" placeholder="结束时间" ng-show="by_shift"></wp-datetime-input>

        <wp-datetime-input class="left" input-type="date" input-model="params.date"
        placeholder="选择日期" ng-show="by_time"></wp-datetime-input>
        <wp-datetime-input class="left" input-type="time" input-model="params.start_at"
        placeholder="起始时间" ng-show="by_time && !current_time_interval.id"></wp-datetime-input>
        <span class="left lh-50" ng-show="by_time && !current_time_interval.id"> ~ </span>
        <wp-datetime-input class="left" input-type="time" input-model="params.end_at"
        placeholder="结束时间" ng-show="by_time && !current_time_interval.id"></wp-datetime-input>
        <wp-btn-sm class="left" ng-show="by_time" ng-click="time_interval_modal.show = true">{{current_time_interval.name}}</wp-btn-sm>

        <wp-btn-sm ng-click="search_shift_list()">查询</wp-btn-sm>
        <wp-btn-sm ng-click="print_shift_list()">打印</wp-btn-sm>
        <div class="space"></div>
        <div class="wp-subject col-xs-12" ng-show="shift_list.from_cache">以下是缓存的查询结果，查询最新数据请点击<a ng-click="search_shift_list({refresh: true})">这里</a></div>
        <div>
            <div ng-repeat="item in shift_list.items">
                <div class="wp-subject" >{{item.name}}: </div>
                <table class="wp-table-sm">
                    <thead>
                    <th width="1%">科目代码</th>
                    <th width="1%">条目</th>
                    <th width="1%">数额</th>
                    </thead>
                    <tbody>
                    <tr ng-repeat="label_item in item.label_items"
                        ng-class="{odd: $index % 2 == 0}">
                        <td>&nbsp;</td>
                        <td>{{::label_item[0]}}</td>
                        <td>{{::label_item[1]}}</td>
                    </tr>
                    <tr ng-repeat="shift_item in item.shift_items"
                        ng-class="{odd: $index % 2 == 1}">
                        <td>{{::shift_item.pay_method_code}}</td>
                        <td>{{::shift_item.pay_method_name}}</td>
                        <td>{{::shift_item.amount}}</td>
                    </tr>
                    </tbody>
                </table>
                <table class="wp-table-sm">
                        <tbody>
                            <tr>
                                <td width="1%">&nbsp;</td>
                                <td width="1%">&nbsp;</td>
                                <td width="1%">
                                    <span class="red">合计金额: </span>
                                    {{item.total_amount}}<br />
                                    <span class="red">实收金额: </span>
                                    {{item.total_actual_amount}}<br />
                                </td>
                            </tr>
                        <tbody>
                </table>
            </div>
        </div>
    </div>
</div>
