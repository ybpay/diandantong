<div class="bill-center-page main-view">
    <div class="main-part">
        <div class="menu-part" wp-scroll-zone>
            <div>
                <div class="menu" ng-repeat="menu in menus"
                     ng-class="{active: menu == active_menu}"
                     ng-click="change_menu(menu)">
                    {{::menu.name}}
                </div>
            </div>
        </div>
        <div class="master-part-with-menu">
            <form-group ng-hide="active_menu.tag == 'shift_list'">
                <wp-btn ng-click="set_to_current_shift()">本班次</wp-btn>
                <wp-btn ng-click="set_to_last_shift()">上班次</wp-btn>

                <div ng-if="'sale_list' == current_tag">
                  <wp-btn ng-click="toggle_category()">菜品过滤</wp-btn>
                </div>
            </form-group>
            <form-group ng-if="'shift_list' == current_tag">
              <wp-btn ng-click="toggle_search_key('by_shift')"
                      ng-class="{'active': by_shift}">交班汇总</wp-btn>
              <wp-btn ng-click="toggle_search_key('by_time')"
                      ng-class="{'active': by_time}">分时查看</wp-btn>
            </form-group>

            <div ng-include src="partial('bills/discount_list')" include-replace></div>
            <div ng-include src="partial('bills/gift_item_list')" include-replace></div>
            <div ng-include src="partial('bills/subtract_item_list')" include-replace></div>
            <div ng-include src="partial('bills/sale_list')" include-replace></div>
            <div ng-include src="partial('bills/payment_list')" include-replace></div>
            <div ng-include src="partial('bills/shift_list')" include-replace></div>
            <div ng-include src="partial('bills/waiter_order_list')" include-replace></div>
            <div ng-include src="partial('bills/by_weight_product_list')" include-replace></div>
            <div ng-include src="partial('bills/combo_package_list')" include-replace></div>
            <div ng-include src="partial('bills/anti_settlement_list')" include-replace></div>
            <div ng-include src="partial('bills/order_cancel_list')" include-replace></div>
            <div ng-include src="partial('bills/queue_list')" include-replace></div>
        </div>
    </div>
  <wp-footer-menu branch-id="branch_id"></wp-footer-menu>
</div>
<div class="scroll-btns">
  <a class="scroll-top" ng-click="scroll_top()">
    <div class="arrow"></div>
  </a>
  <a class="scroll-bottom" ng-click="scroll_bottom()">
    <div class="arrow"></div>
  </a>
</div>
<wp-modal wp-show="time_interval_modal.show">
    <div class="wp-modal-header">时段</div>
    <div class="wp-modal-content">
        <wp-btn ng-repeat="time_interval in time_intervals" ng-click="set_time_interval(time_interval)">
            {{time_interval.name}}
        </wp-btn>
    </div>
</wp-modal>