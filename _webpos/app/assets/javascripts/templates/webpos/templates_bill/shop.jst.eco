<div class="wp-header">
  <div class="header-brand" ng-click="go('/');" ng-hide="branch">{{ shop.name }}</div>
  <div class="header-brand" ng-show="branch">{{ branch.name }}</div>
  <div class="header-main">
    <div class="header-action" ng-click="back()" title="后退" ng-class="{disabled: isLoading()}"><i class="fa fa-arrow-left"></i></div>
    <div class="header-action" ng-click="reload()" title="刷新"><i class="fa fa-refresh"></i></div>
    <div class="account-name">
      <i class="fa fa-user"></i> {{ account.name || '未登录' }}
    </div>
    <div class="system-time">{{system_time | date: 'yyyy/MM/dd HH:mm:ss'}}</div>
  </div>
  <div class="header-right">
    <!-- <div class="action" ng-click="back_to_webpos();" title="返回收银系统"><i class="fa fa-chevron-circle-left"></i></div> -->
    <div class="action" ng-click="toggle_jvk();" ng-class="{active: enable_jvk}" title="虚拟键盘"><i class="fa fa-keyboard-o"></i></div>
    <div class="action" ng-click="go_path('/webpos#/settings')"><i class="fa fa-cog"></i></div>
    <div class="action" ng-click="sign_out()"><i class="fa fa-sign-out"></i></div>
  </div>
</div>
<div class="main-view" ui-view="content"></div>

