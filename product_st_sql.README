###################################################### 营业额
SELECT DATE_FORMAT(created_at, '%Y-%m') as time, SUM(total_amount) as amount
FROM ddt_shifts
where shop_id = 1
    and state = 'closed'
    and created_at >= '2016-01-01'
    and created_at <= '2016-08-31'
    group by time;

SELECT DATE_FORMAT(created_at, '%Y-%m-%d') as time, SUM(total_amount) as amount
FROM ddt_shifts
where shop_id = 1
    and state = 'closed'
    and created_at >= '2016-05-01'
    and created_at <= '2016-05-31'
    group by time;


###################################################### Date of Shift.closed_at != Shift.created_at
# 查询跨天的 shift
SELECT id, branch_id, created_at, closed_at, total_amount from ddt_shifts
where shop_id = 1
    and state = 'closed'
    and created_at >= '2016-01-01 00:00:00'
    and created_at <= '2016-09-05 23:59:59'
    and DATE_FORMAT(created_at, '%Y-%m-%d') != DATE_FORMAT(closed_at, "%Y-%m-%d");


# 查询跨月的 shift
SELECT id, branch_id, created_at, closed_at, total_amount from ddt_shifts
where shop_id = 1
    and state = 'closed'
    and created_at >= '2016-01-01 00:00:00'
    and created_at <= '2016-09-05 23:59:59'
    and DATE_FORMAT(created_at, '%Y-%m') != DATE_FORMAT(closed_at, "%Y-%m");

