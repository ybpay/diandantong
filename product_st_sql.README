####################################################### 查询单品
SELECT
  DATE_FORMAT(o.paid_at, '%Y-%m-%d') as time,
  sum((quantity - subtract_quantity - move_quantity) * price) as original_amount,
  sum(l.adjustment_total) + sum(l.apportion_adjustment_total) as adjustment_total,
  sum((quantity - subtract_quantity - move_quantity) * price) + sum(l.adjustment_total) + sum(l.apportion_adjustment_total) as sale_amount,
  sum(l.not_actual_amount) as not_actual_amount

FROM ddt_line_items as l
  inner join ddt_orders as o on l.order_id = o.id
  where
      o.shop_id = 1
  AND o.deleted_at is null
  AND o.pay_item_state = 'paid'
  AND o.paid_at >= '2016-01-01 00:00:00'
  AND o.paid_at <= '2016-08-31 23:59:59'
  AND o.type in ('Ddt::EatInHallOrder', 'Ddt::FastfoodOrder', 'Ddt::DeliveryOrder', 'Ddt::ReservationOrder', 'Ddt::PaymentOrder', 'Ddt::GrouponOrder')
  AND l.is_subtract = 0
  AND l.gift = 0
  AND l.is_moved = 0
  AND l.itemable_type = 'Ddt::Variant'
  AND (quantity - subtract_quantity - move_quantity) > 0
  group by time;


###################################################### 查询套餐
SELECT
  DATE_FORMAT(o.paid_at, '%Y-%m-%d') as time,
  sum((quantity - subtract_quantity - move_quantity) * price) as original_amount,
  sum(l.adjustment_total) + sum(l.apportion_adjustment_total) as adjustment_total,
  sum((quantity - subtract_quantity - move_quantity) * price) + sum(l.adjustment_total) + sum(l.apportion_adjustment_total) as sale_amount,
  sum(l.not_actual_amount) as not_actual_amount

FROM ddt_line_items as l
  inner join ddt_orders as o on l.order_id = o.id
  where
      o.shop_id = 1
  AND o.deleted_at is null
  AND o.pay_item_state = 'paid'
  AND o.paid_at >= '2016-01-01 00:00:00'
  AND o.paid_at <= '2016-08-31 23:59:59'
  AND o.type in ('Ddt::EatInHallOrder', 'Ddt::FastfoodOrder', 'Ddt::DeliveryOrder', 'Ddt::ReservationOrder', 'Ddt::PaymentOrder', 'Ddt::GrouponOrder')
  AND l.is_subtract = 0
  AND l.gift = 0
  AND l.is_moved = 0
  AND l.itemable_type = 'Ddt::ComboPackage'
  AND (quantity - subtract_quantity - move_quantity) > 0
  group by time;


###################################################### 查询称重
SELECT
  DATE_FORMAT(o.paid_at, '%Y-%m-%d') as time,
  sum((quantity - subtract_quantity - move_quantity) * price) as original_amount,
  sum(l.adjustment_total) + sum(l.apportion_adjustment_total) as adjustment_total,
  sum((quantity - subtract_quantity - move_quantity) * price) + sum(l.adjustment_total) + sum(l.apportion_adjustment_total) as sale_amount,
  sum(l.not_actual_amount) as not_actual_amount

FROM ddt_line_items as l
  inner join ddt_orders as o on l.order_id = o.id
  where
      o.shop_id = 1
  AND o.deleted_at is null
  AND o.pay_item_state = 'paid'
  AND o.paid_at >= '2016-01-01 00:00:00'
  AND o.paid_at <= '2016-08-31 23:59:59'
  AND o.type in ('Ddt::EatInHallOrder', 'Ddt::FastfoodOrder', 'Ddt::DeliveryOrder', 'Ddt::ReservationOrder', 'Ddt::PaymentOrder', 'Ddt::GrouponOrder')
  AND l.is_subtract = 0
  AND l.gift = 0
  AND l.is_moved = 0
  AND l.itemable_type = 'Ddt::VariantPackage'
  AND (quantity - subtract_quantity - move_quantity) > 0
  group by time;


###################################################### 用来判断套餐是否摊到 combo_package_items 是否成功
SELECT
  DATE_FORMAT(cps.paid_at, "%Y-%m-%d") as time,
  sum(price) as amount,
  sum(adjustment_total + apportion_adjustment_total) as adjustment_amount,
  sum(not_actual_amount) as not_actual_amount
FROM ddt_combo_package_items as cpi
  inner join (
  select l.itemable_id as combo_package_id, o.paid_at from ddt_line_items as l
  inner join ddt_orders as o on l.order_id = o.id
  where
    o.shop_id = 1
  and o.deleted_at is null
  AND o.pay_item_state = 'paid'
  AND o.paid_at >= '2016-05-01 00:00:00'
  AND o.paid_at <= '2016-05-31 23:59:59'
  AND o.type in ('Ddt::EatInHallOrder', 'Ddt::FastfoodOrder', 'Ddt::DeliveryOrder', 'Ddt::ReservationOrder', 'Ddt::PaymentOrder', 'Ddt::GrouponOrder')
  AND l.is_subtract = 0
  AND l.gift = 0
  AND l.is_moved = 0
  AND l.itemable_type = 'Ddt::ComboPackage'
  AND (quantity - subtract_quantity - move_quantity) > 0) as cps on cpi.combo_package_id = cps.combo_package_id group by time;

###################################################### 订单上的抹零
SELECT sum(moling_amount) from ddt_orders
where shop_id = 1
  and deleted_at is null
  and pay_item_state = 'paid'
  and paid_at >= '2016-03-01 00:00:00'
  and paid_at <= '2016-03-31 23:59:59'
  and type in ('Ddt::EatInHallOrder', 'Ddt::FastfoodOrder', 'Ddt::DeliveryOrder', 'Ddt::ReservationOrder', 'Ddt::PaymentOrder', 'Ddt::GrouponOrder');

###################################################### 交班数据上的抹零
SELECT sum(moling_amount) from ddt_shifts
where shop_id = 1
  and state = 'closed'
  and created_at >= '2016-03-01 00:00:00'
  and created_at <= '2016-03-31 23:59:59';

