.user-source-chart
:javascript
  $(document).ready(function(){
    $('.user-source-chart').highcharts({
      chart: {
      },
      title: {
        text: "#{current_shop.name} 新会员统计"
      },
      subtitle: {
        text: "#{@start_date.strftime("%F")} ~ #{@end_date.strftime("%F")}"
      },
      xAxis: {
        tickInterval: #{@new_vip_count_statistic.tick_interval},
        categories: #{raw @new_vip_count_statistic.labels}
      },
      yAxis: {
        title: {
          text: null
        },
        plotLines: [{
          value: 0,
          width: 1,
          color: '#808080'
        }],
        min: 0,
        minTickInterval: 1
      },
      tooltip: {
        valueSuffix: ''
      },
      legend: {
        layout: 'horizontal',
        align: 'center',
        verticalAlign: 'bottom',
        borderWidth: 0
      },
      series: [{
          name: "新增会员",
          data: #{@new_vip_count_statistic.query.values.to_json}
        },{
          name: "新增关注",
          data: #{@subscription_count_statistic.query.values.to_json}
        }]
    });
  });