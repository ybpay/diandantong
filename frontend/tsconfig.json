{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@webpos/ui": ["./packages/ui/src"],
      "@webpos/composables": ["./packages/composables/src"],
      "@webpos/api": ["./packages/api/src"],
      "@webpos/stores": ["./packages/stores/src"],
      "@webpos/types": ["./packages/types/src"],
      "@diandantong/admin-api": ["./packages/admin-api/src"],
      "@diandantong/admin-stores": ["./packages/admin-stores/src"],
      "@diandantong/admin-types": ["./packages/admin-types/src"]
    }
  },
  "references": [
    { "path": "./packages/types" },
    { "path": "./packages/api" },
    { "path": "./packages/stores" },
    { "path": "./packages/composables" },
    { "path": "./packages/ui" },
    { "path": "./packages/admin-types" },
    { "path": "./packages/admin-api" },
    { "path": "./packages/admin-stores" }
  ],
  "exclude": ["node_modules", "dist"]
}
