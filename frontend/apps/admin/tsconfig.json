{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@diandantong/admin-api": ["../../packages/admin-api/src"],
      "@diandantong/admin-stores": ["../../packages/admin-stores/src"],
      "@diandantong/admin-types": ["../../packages/admin-types/src"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "env.d.ts"],
  "references": [
    { "path": "../../packages/admin-types" },
    { "path": "../../packages/admin-api" },
    { "path": "../../packages/admin-stores" }
  ]
}
