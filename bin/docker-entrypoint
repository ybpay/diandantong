#!/bin/bash -e
# Docker entrypoint for Rails app

# Wait for PostgreSQL
until pg_isready -h "${DB_HOST:-localhost}" -p "${DB_PORT:-5432}" -U "${DB_USER:-postgres}"; do
  echo "Waiting for PostgreSQL..."
  sleep 2
done

# Run migrations only when explicitly requested (e.g. pre-deploy job)
# For zero-downtime deploys, run migrations as a separate step:
#   docker compose run --rm app bundle exec rails db:migrate
if [ "${RUN_MIGRATIONS:-false}" = "true" ]; then
  bundle exec rails db:migrate
fi

# Execute the CMD
exec "$@"
