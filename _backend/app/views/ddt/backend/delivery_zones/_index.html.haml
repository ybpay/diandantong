%br
.form-group
  = link_to "新建外送区域", new_backend_shop_branch_delivery_zone_path(@current_shop, @current_branch), remote: true, class: "btn btn-xs btn-primary"

%table.table.table-striped.table-bordered
  %thead
    %tr
      %th.col-sm-1= Ddt::DeliveryZone.human_attribute_name(:zone_name)
      %th.col-sm-1= Ddt::DeliveryZone.human_attribute_name(:cost)
      %th.col-sm-2
  %tbody.delivery_zones
    - @delivery_zones.each do |delivery_zone|
      = render '/ddt/backend/delivery_zones/tr', {delivery_zone: delivery_zone}
    = no_record_hint(@delivery_zones)