.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= '微信排号二维码'
    %p
      %strong 温馨提示：
      排号二维码可到
      %a{href:backend_shop_wechat_qr_code_scenes_path(@current_shop)}
        这里
      创建
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        - unless @queue_qr_codes.present?
          您还没创建微信排号二维码
        - else
          .form-group
            = search_form_for @q, url: [:queue_qr_codes, :backend, @current_shop, :supplies], html: {class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
              = f.input_field :name_cont, placeholder: Ddt::WechatQrCodeScene.human_attribute_name(:name), class: 'form-control'
              = f.submit '搜索', class: 'btn btn-success'

  - if @queue_qr_codes.size > 0
    .row
      .col-lg-12
        .ibox
          .ibox-content
            - @queue_qr_codes.each do |queue_qr_code|
              .col-lg-3.col-md-4.col-sm-6.col-xs-12
                .contact-box
                  .col-sm-12
                    .text-center
                      %a{href: backend_shop_wechat_qr_code_scene_path(@current_shop, queue_qr_code)}
                        = image_tag queue_qr_code.url, width: '100%'
                      .m-t-xs.font-bold=queue_qr_code.name
                      .p
                        \ 扫描次数
                        = queue_qr_code.scan_times
                  .clearfix
                  = link_to '修改', edit_backend_shop_wechat_qr_code_scene_path(@current_shop, queue_qr_code), :title => '修改二维码', data: {:rel=>'tooltip'}, class: 'btn btn-w-m btn-primary btn-block'
                  - unless @current_shop.is_oem?
                    = link_to '下载', export_queue_qr_code_backend_shop_supplies_path(@current_shop, :id => queue_qr_code.id, :format => 'zip'), :method => :get, :title => '下载', class: 'btn btn-w-m btn-white btn-block'
                  = link_to '删除', [:backend, @current_shop, queue_qr_code], :method => :delete, :data => { :confirm => '确定删除?', :rel=>'tooltip' }, :title => '删除', class: 'btn btn-w-m btn-white btn-block'
            .clearfix


          %br
          .pull-right= will_paginate @queue_qr_codes , renderer: BootstrapPagination::Rails, bootstrap: 3
          %br
          .claerfix
