
.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-12
    %h3= "#{t('activerecord.models.ddt/wechat_share_record')} 列表"

    = search_form_for @q, url: backend_shop_wechat_share_records_path(@current_shop), html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
      = f.input_field :share_type_eq, collection: Ddt::WechatShareRecord.share_type_collection, prompt: Ddt::WechatShareRecord.human_attribute_name(:share_type)
      = f.input_field :user_id_or_user_phone_or_user_email_or_user_unique_user_nickname_cont, as: :string, placeholder: "用户"
      = f.input_field :title_cont, placeholder: Ddt::WechatShareRecord.human_attribute_name(:title)
      = f.submit "搜索", class: "btn btn-sm  btn-success"


.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        %table.table.table-striped.table-bordered
          %thead
            %tr
              %th.col-sm-1= sort_link(@q, :user, Ddt::WechatShareRecord.human_attribute_name(:user))
              %th.col-sm-1= sort_link(@q, :share_type, Ddt::WechatShareRecord.human_attribute_name(:share_type))
              %th.col-sm-1= sort_link(@q, :title, Ddt::WechatShareRecord.human_attribute_name(:title))
              %th.col-sm-1= sort_link(@q, :viewed_users_count, Ddt::WechatShareRecord.human_attribute_name(:viewed_users_count))
              %th.col-sm-4= sort_link(@q, :link, Ddt::WechatShareRecord.human_attribute_name(:link))
              %th.col-sm-1= sort_link(@q, :img, Ddt::WechatShareRecord.human_attribute_name(:img_url))
              %th.col-sm-1= sort_link(@q, :created_at, Ddt::WechatShareRecord.human_attribute_name(:created_at))
              %th

          %tbody
            - @wechat_share_records.each do |wechat_share_record|
              %tr
                %td= link_to wechat_share_record.user.to_label, [:backend, @current_shop, wechat_share_record.user]
                %td= wechat_share_record.share_type_name
                %td= wechat_share_record.title
                %td= raw wechat_share_record.viewed_users_count
                %td= wechat_share_record.link
                %td= image_tag wechat_share_record.img_url, width: 50
                %td= wechat_share_record.created_at
                %td
                  = link_to '详情', [:backend, @current_shop, wechat_share_record]
            = no_record_hint(@wechat_share_records)
        %br
        .pull-right= will_paginate @wechat_share_records , renderer: BootstrapPagination::Rails, bootstrap: 3
        %br
