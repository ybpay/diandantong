.order-query-form
  = form_for :business_statistic, url: [:order_origin, :backend, @current_shop, :business_statistics], method: :get, html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
    = f.input_field :branch_id, data: {"local-datas" => current_account.is_boss? ? @current_shop.branches : current_account.manage_branches, useas: "local_select", single: true,placeholder: "选择门店"},class: 'ddb-select2 col-lg-2'
    = f.input_field :start_time, as: :datetime, placeholder: "开始时间", class: 'input-medium'
    %label{style: 'font-size:20px;'} ~
    = f.input_field :end_time, as: :datetime, placeholder: "结束时间", class: 'input-medium'
    = f.submit "搜索", class: 'btn btn-sm btn-success', onClick: "$(this).closest('form').attr('action', '#{ order_origin_backend_shop_business_statistics_path(@current_shop, format: :html) }')"
    = f.submit "导出csv表格", class: 'btn btn-sm btn-info', onClick: "$(this).closest('form').attr('action', '#{ order_origin_backend_shop_business_statistics_path(@current_shop, format: :csv) }')"
%br/
- origin_collection = Ddt::BusinessStatistic::OrderOrigin.origin_collection
%table.table.table-striped.table-bordered.table-center
  %thead
    %tr
      %th
      - origin_collection[:type_names].each do |type_name|
        %th{ colspan: 2, style: 'text-align:center;'}= type_name
    %tr
      %th
      - 5.times do
        %th 订单数
        %th 订单总价
  %tbody
    - origin_collection[:track_froms].each_with_index do |track_from, index|
      %tr
        %td= origin_collection[:track_from_names][index]
        - origin_collection[:types].each do |type|
          - item = @result.detect{|item| item.track_from == track_from && item.type == type }
          %td= item.try(:sum_of_count) || 0
          %td= item.try(:sum_of_total) || 0
    %tr
      %td 总计
      - origin_collection[:types].each do |type|
        %td= @result.select{|item| item.type == type }.map(&:sum_of_count).sum
        %td= @result.select{|item| item.type == type }.map(&:sum_of_total).sum.round(2)
%br