.order-query-form
  = form_for :business_statistic, url: [:gift_product, :backend, @current_shop, :business_statistics], method: :get, html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
    = f.input_field :branch_id, data: {"local-datas" => @current_shop.branches, useas: "local_select", single: true,placeholder: "选择门店"},class: 'ddb-select2 col-lg-2'
    = f.input_field :start_time, as: :datetime, placeholder: "开始时间", class: 'input-medium'
    %label{style: 'font-size:20px;'} ~
    = f.input_field :end_time, as: :datetime, placeholder: "结束时间", class: 'input-medium'
    = f.submit "搜索", class: 'btn btn-sm btn-success', onClick: "$(this).closest('form').attr('action', '#{ gift_product_backend_shop_business_statistics_path(@current_shop, format: :html) }')"
    = f.submit "导出csv表格", class: 'btn btn-sm btn-info', onClick: "$(this).closest('form').attr('action', '#{ gift_product_backend_shop_business_statistics_path(@current_shop, format: :csv) }')"


%br/
%table.table.table-striped.table-bordered.table-center
  %thead
    %tr
      %th 单号
      %th=link_to "桌台", gift_product_backend_shop_business_statistics_path(@current_shop, business_statistic: @business_statistic.to_params.merge({sort: :table_id}))
      %th=link_to "菜品", gift_product_backend_shop_business_statistics_path(@current_shop, business_statistic: @business_statistic.to_params.merge({sort: :itemable_id}))
      %th 菜品金额
      %th 赠送数量
      %th 赠菜人
      %th 赠菜理由
      %th=link_to "赠菜时间", gift_product_backend_shop_business_statistics_path(@current_shop, business_statistic: @business_statistic.to_params.merge({sort: :created_at}))
  %tbody
    - items = @result
    - items.each do |item|
      %tr
        %td= item.number
        %td= @business_statistic.get_table(item.table_id).name rescue ''
        %td= item.name
        %td= item.original_price
        %td= item.quantity
        %td= @business_statistic.get_account(item.waiter_id).name rescue ''
        %td= item.gift_reason
        %td= item['created_at'].strftime("%Y-%m-%d %H:%M")
    %tr.warning
      %td 总计
      %td
      %td
      %td= @business_statistic.total_price(items)
      %td= @business_statistic.total_quantity(items)
      %td
      %td
      %td
