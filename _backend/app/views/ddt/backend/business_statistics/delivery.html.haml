.order-query-form
  = form_for :business_statistic, url: [:order_origin, :backend, @current_shop, :business_statistics], method: :get, html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
    = f.input_field :branch_id, data: {"local-datas" => @current_account.is_boss? ? @current_shop.branches : current_account.manage_branches, useas: "local_select", single: true,placeholder: "选择门店"},class: 'ddb-select2 col-lg-2'
    = f.input_field :start_time, as: :datetime, placeholder: "开始时间", class: 'input-medium'
    %label{style: 'font-size:20px;'} ~
    = f.input_field :end_time, as: :datetime, placeholder: "结束时间", class: 'input-medium'
    = f.submit "搜索", class: 'btn btn-sm btn-success', onClick: "$(this).closest('form').attr('action', '#{ delivery_backend_shop_business_statistics_path(@current_shop, format: :html) }')"
    = f.submit "导出csv表格", class: 'btn btn-sm btn-info', onClick: "$(this).closest('form').attr('action', '#{ delivery_backend_shop_business_statistics_path(@current_shop, format: :csv) }')"

%table.table.table-striped.table-bordered
  %thead
    %tr
      %th 配送员
      %th 订单数量
  %tbody
    - @result.each do |item|
      %tr
        %td= "#{item[:delivery_man_name]} - #{item[:delivery_man_id]}"
        %td= item[:count]
