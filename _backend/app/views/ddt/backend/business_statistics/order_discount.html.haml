.order-query-form
  = form_for :business_statistic, url: [:order_discount, :backend, @current_shop, :business_statistics], method: :get, html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
    = f.input_field :branch_id, collection: @current_shop.branches, class: 'input-medium', include_blank: true, prompt: "选择门店"
    = f.input_field :start_time, as: :datetime, placeholder: "开始时间", class: 'input-medium'
    %label{style: 'font-size:20px;'} ~
    = f.input_field :end_time, as: :datetime, placeholder: "结束时间", class: 'input-medium'
    = f.submit "搜索", class: 'btn btn-sm btn-success', onClick: "$(this).closest('form').attr('action', '#{ order_discount_backend_shop_business_statistics_path(@current_shop, format: :html) }')"
    = f.submit "导出csv表格", class: 'btn btn-sm btn-info', onClick: "$(this).closest('form').attr('action', '#{ order_discount_backend_shop_business_statistics_path(@current_shop, format: :csv) }')"


%br/
- origin_collection = Ddt::BusinessStatistic::OrderDiscount.origin_collection
%table.table.table-striped.table-bordered.table-center
  %thead
    %tr
      - origin_collection[:discount_info_names].each do |info_name|
        %th= info_name
  %tbody
    - discount_orders = @result
      - discount_orders.each do |order|
      %tr
        %td= order.number
        %td= order.adjustments.first.label
        %td= order.item_total
        %td= order.adjustment_total
        %td= order.adjustments.first.created_at
        %td= Ddt::BusinessStatistic::OrderDiscount.search_operator_name_by_order(order)
        %td= Ddt::BusinessStatistic::OrderDiscount.search_authorizer_name_by_order(order)
