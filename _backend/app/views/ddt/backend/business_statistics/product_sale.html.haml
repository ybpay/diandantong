.order-query-form
  = form_for :business_statistic, url: [:product_sale, :backend, @current_shop, :business_statistics], method: :get, html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
    = f.input_field :branch_id, data: {"local-datas" => current_account.is_boss? ? @current_shop.branches : current_account.manage_branches, useas: "local_select", single: true,placeholder: "选择门店"},class: 'ddb-select2 col-lg-2'
    = f.input_field :start_time, as: :datetime, placeholder: "开始时间", class: 'input-medium'
    %label{style: 'font-size:20px;'} ~
    = f.input_field :end_time, as: :datetime, placeholder: "结束时间", class: 'input-medium'
    = f.input_field :category_id, collection: @business_statistic.category_collection, prompt: "商品类型", include_blank: true, class: 'input-medium'
    = f.submit "搜索", class: 'btn btn-sm btn-success', onClick: "$(this).closest('form').attr('action', '#{ product_sale_backend_shop_business_statistics_path(@current_shop, format: :html) }')"
    = f.submit "导出csv表格", class: 'btn btn-sm btn-info', onClick: "$(this).closest('form').attr('action', '#{ product_sale_backend_shop_business_statistics_path(@current_shop, format: :csv) }')"
%br/
%table.table.table-striped.table-bordered
  %thead
    %tr
      %th 门店
      %th 编号
      %th 商品分类
      %th 商品名称
      %th 单位
      %th 数量排名
      %th= link_to "销售数量", product_sale_backend_shop_business_statistics_path(@current_shop, business_statistic: @business_statistic.to_params.merge({sort: :sale}))
      %th= link_to "平均单价", product_sale_backend_shop_business_statistics_path(@current_shop, business_statistic: @business_statistic.to_params.merge({sort: :average_price}))
      %th= link_to "单价", product_sale_backend_shop_business_statistics_path(@current_shop, business_statistic: @business_statistic.to_params.merge({sort: :price}))
      %th= link_to "销售额", product_sale_backend_shop_business_statistics_path(@current_shop, business_statistic: @business_statistic.to_params.merge({sort: :sum_sale}))
      %th= link_to "销售额占总比", product_sale_backend_shop_business_statistics_path(@current_shop, business_statistic: @business_statistic.to_params.merge({sort: :sale_percent}))
  %tbody
    - @result.each do |item|
      %tr
        %td= item[:branch_name]
        %td= item[:sku]
        %td= item[:category]
        %td= item[:name]
        %td= item[:unit_name]
        %td= item[:index]
        %td= item[:sale]
        %td= item[:average_price]
        %td= item[:price]
        %td= item[:sum_sale]
        %td= "#{item[:sale_percent]}%"
    %tr.warning
      %td 总计
      %td
      %td
      %td
      %td
      %td
      %td= @result.map{|item| item[:sale]}.sum.round(2)
      %td
      %td
      %td= @result.map{|item| item[:sum_sale]}.sum.round(2)
      %td 100%
%br

:javascript
  $(document).ready(function() {
    $('#business_statistic_branch_id').change(function(){
      var branch_id = $('#business_statistic_branch_id').val();
      $.ajax({
        url: "/backend/shops/#{@current_shop.id}/branches/" + branch_id + "/categories.json",
        success: function(data){
          var content = ""
          content += "<option value=''>商品类型</option>"
          content += "<option value=''></option>"
          $.each(data, function(i, c){
            content += "<option value='"+c.id+"'>"+c.name+"</option>"
          })
          $('#business_statistic_category_id').empty()
          $('#business_statistic_category_id').append($(content))
        }
      })
    })
  });

