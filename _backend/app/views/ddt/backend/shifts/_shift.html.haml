%table.table.table-striped.table-bordered
  %tbody
    %tr
      %td= "门店：#{@shift.branch.name}"
    %tr
      %td= "值班人：#{@shift.account.try(:name)}"
    %tr
      %td= "值班时间：#{@shift.created_at.strftime("%F %T")}~#{@shift.closed_at.strftime("%F %T")}"
%table.table.table-striped.table-bordered
  %thead
    %tr
      %th 科目代码
      %th 支付方式
      %th 支付金额
  %tbody
    - @shift.shift_items.each do |item|
      %tr
        %td= item.pay_method_code
        %td= item.pay_method_name
        %td
          = item.amount
          - if item.cash_amount.present?
            %div= "实收 #{item.cash_amount}"
            %div= "附属 #{item.extra_amount}"
    %tr
      %td
      %td 合计金额
      %td= @shift.total_amount
    %tr
      %td
      %td 实收金额
      %td= @shift.total_actual_amount
    %tr
      %td
      %td 会员卡充值金额
      %td= @shift.recharge_amount
    %tr
      %td
      %td 会员卡兑换金额
      %td= @shift.exchange_amount
    %tr
      %td
      %td 放入现金
      %td= @shift.pre_cash_amount
