.ibox
  .ibox-title
    %h3= "#{t('activerecord.models.ddt/groupon')} 详情"
  .ibox-content
    .col-md-6
      .model-show
        %p
          %b
            = Ddt::Groupon.human_attribute_name(:base_user)
            \:
          = base_user_label(@groupon.base_user)
        %p
          %b
            = Ddt::Groupon.human_attribute_name(:groupon_version)
            \:
          = @groupon.groupon_version.name
        %p
          %b
            = Ddt::Groupon.human_attribute_name(:coupon_no)
            \:
          = @groupon.coupon_no
        %p
          %b
            = Ddt::Groupon.human_attribute_name(:expires_at)
            \:
          = @groupon.expires_at
        %p
          %b
            = Ddt::Groupon.human_attribute_name(:applied_at)
            \:
          = @groupon.applied_at
        %p
          %b
            = Ddt::Groupon.human_attribute_name(:shop)
            \:
          = @groupon.shop.name
        %p
          %b
            = Ddt::Groupon.human_attribute_name(:branches)
            \:
          = @groupon.branch_names
        .space
      = link_to t('Back'), backend_shop_groupons_path(@current_shop), :class => "btn btn-default btn-sm"
    .clearfix
