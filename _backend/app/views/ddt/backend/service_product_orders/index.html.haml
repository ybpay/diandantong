.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/service_product_order')} 列表"
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      .ibox
        .ibox-content
          %table.table.table-striped
            %thead
              %tr
                %th.col-sm-1= Ddt::ServiceProductOrder.human_attribute_name(:out_trade_no)
                %th.col-sm-1= Ddt::ServiceProductOrder.human_attribute_name(:subject)
                %th.col-sm-1= Ddt::ServiceProductOrder.human_attribute_name(:product_type)
                %th.col-sm-1= Ddt::ServiceProductOrder.human_attribute_name(:price)
                %th.col-sm-1= Ddt::ServiceProductOrder.human_attribute_name(:created_at)
                %th.col-sm-1= Ddt::ServiceProductOrder.human_attribute_name(:workflow_state)
                %th.col-sm-1
            %tbody
              - @service_product_orders.each do |service_product_order|
                %tr
                  %td= link_to service_product_order.out_trade_no, @current_shop.present? ? [:backend, @current_shop, service_product_order] : [:backend, service_product_order]
                  %td
                    = service_product_order.subject
                    - if @current_shop.nil?
                      \(
                      = Ddt::ServiceProductOrder.human_attribute_name(:shop)
                      \:
                      = link_to service_product_order.shop.name, [:backend, service_product_order.shop]
                      \)
                  %td= service_product_order.product_type_name
                  %td= number_to_currency(service_product_order.price, unit: "¥")
                  %td= service_product_order.created_at.strftime("%Y-%m-%d %H:%M")
                  %td
                    - if service_product_order.current_state == :new
                      %span.label.label-default
                        = service_product_order.workflow_state_name
                      = link_to('付款', pay_with_alipay_backend_shop_service_product_order_path(@current_shop, service_product_order), method: 'PUT', :class => "btn btn-warning btn-sm") if @current_shop.present?
                    - elsif service_product_order.current_state == :finished
                      %span.label.label-success
                        = service_product_order.workflow_state_name
                    - else
                      %span.label.label-danger
                        = service_product_order.workflow_state_name
                  %td
                    = link_to '详情', [:backend, @current_shop, service_product_order], :class => "btn btn-xs btn-info"
              = no_record_hint(@service_product_orders)

          %br
          .pull-right= will_paginate @service_product_orders, renderer: BootstrapPagination::Rails, bootstrap: 3
          %br
