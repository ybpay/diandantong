.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox
    .ibox-title
      %h2= "#{t('activerecord.models.ddt/service_product_order')} #{@service_product_order.subject}"
    .ibox-content.header
      .row
        %p
          %b
            = Ddt::ServiceProductOrder.human_attribute_name(:out_trade_no)
            \:
          = @service_product_order.out_trade_no
        %p
          %b
            = Ddt::ServiceProductOrder.human_attribute_name(:shop)
            \:
          = link_to @service_product_order.shop.name, [:backend, @service_product_order.shop]
        %p
          %b
            = Ddt::ServiceProductOrder.human_attribute_name(:price)
            \:
          = number_to_currency(@service_product_order.price, :unit=>"¥")
        %p
          %b
            = Ddt::ServiceProductOrder.human_attribute_name(:product_type)
            \:
          = @service_product_order.product_type_name
        %p
          %b
            = Ddt::ServiceProductOrder.human_attribute_name(:quantity)
            \:
          = @service_product_order.quantity
        %p
          %b
            = Ddt::ServiceProductOrder.human_attribute_name(:price)
            \:
          = @service_product_order.price
        %p
          %b
            = Ddt::ServiceProductOrder.human_attribute_name(:created_at)
            \:
          = @service_product_order.created_at.strftime("%Y-%m-%d %H:%M:%S")
        %p
          %b
            = Ddt::ServiceProductOrder.human_attribute_name(:workflow_state)
            \:

          - if @service_product_order.current_state == :new
            %span.label.label-default
              = @service_product_order.workflow_state_name
          - elsif @service_product_order.current_state == :finished
            %span.label.label-success
              = @service_product_order.workflow_state_name
          - else
            %span.label.label-danger
              = @service_product_order.workflow_state_name
        %p
          - if @service_product_order.current_state == :new
            = link_to('付款购买', pay_with_alipay_backend_shop_service_product_order_path(@current_shop, @service_product_order), method: 'PUT', class: "btn btn-warning btn-sm") if @current_shop.present?

        = link_to "返回", @current_shop.present? ? backend_shop_service_product_orders_path(@current_shop) : backend_service_product_orders_path, :class=>"btn btn-sm"
