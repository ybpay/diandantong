<% content_for :head do %>
  <%= javascript_include_tag "ddt/login", "data-turbolinks-track" => true %>
  <%= stylesheet_link_tag "ddt/login", media: "all", "data-turbolinks-track" => true %>
<%  end %>
<div class="wrapper wrapper-content animated fadeInRight">
  <div class="row">
    <div class="col-lg-12">
      <h2>新用户注册</h2>
    </div>
  </div>
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox"> 
        <div class="ibox-title">
          <div class="reg-nav-item col-xs-4 active">
              <span class="reg-nav-num">1</span>
              <span>验证手机号</span>
          </div>
          <div class="reg-nav-item col-xs-4 step-2 %>">
              <span class="reg-nav-num">2</span>
              <span>填写帐号信息</span>
          </div>
          <div class="reg-nav-item col-xs-4 step-3 %>">
              <span class="reg-nav-num">3</span>
              <span>注册成功</span>
          </div>
        </div>

        <div class="ibox-content">
          <div id="ddb-loading" class="hidden" style="left: 30%;width:40%;">
              <div class="sk-spinner sk-spinner-cube-grid">
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
              </div>
          </div>
           
          <% if @register_form.errors.present? %>
            <% @register_form.errors.full_messages.each do |msg| %>
              <%= javascript_tag("toastr.error('#{msg}')") %>
            <% end %>
          <% end %>

          <% @agent_no = params[:agent_no] if params[:agent_no].present? %>
          <%= form_for [:backend, @register_form], url: backend_register_form_path(agent_no: @agent_no) , html: { class: "reg-form form-horizontal" } do |f| %>
            <%= f.hidden_field :shop_agent_no %>
            <div class="col-sm-6">
              <div class="reg-step-1">
                <div class="form-group">
                  <label class="col-sm-4 control-label">手机</label>
                  <div class="col-sm-8">
                    <%= f.text_field :phone,  placeholder: "手机号", class: "form-control", emptyhint: "该手机号码已经被注册"%>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-4 control-label">验证码</label>
                  <div class="col-sm-5">
                    <%= f.text_field :captcha, placeholder: "验证码", class: "form-control", emptyhint: "请填写验证码"%>
                  </div>
                  <div class="hint col-sm-3">
                    <%= link_to('获取短信验证码', send_sms_captcha_backend_register_form_path, :id => 'send_sms_captcha_link', :text => '发送短信验证码', :remote => true, class: "btn captcha-btn btn-w-m btn-default")%>
                  </div>
                </div>

                <div class="form-group">
                  <label class="control-label col-sm-offset-4">
                    <%= f.check_box :accept_term %>
                    我已阅读并接受
                    <% query_str = @agent_no ? "?agent_no=#{@agent_no}" : "" %>
                    <a href="/protocol<%= query_str %>" target="_blank">&lt;&lt;点单通使用许可协议&gt;&gt;</a>
                  </label>
                </div>

                <%= f.hidden_field :shop_address %>
                <% if @agent_no.present? %>
                  <%= f.hidden_field :shop_agent_no %>
                <% end%>

                <div class="form-group">
                  <div class="col-sm-offset-4">
                    <%= f.submit "下一步", data: { disable_with: "正在提交.."}, class: "btn btn-primary reg-next-btn step-1-btn" %>
                  </div>
                </div>
              </div>

            </div>
            <div class="clearfix"></div>
          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function(){
    var remove_hint = function(obj){
      obj.closest('.form-group').removeClass('has-error');
      obj.closest('.form-group').removeClass('has-success');
      obj.parent().children(".input-help").remove();
    }
    var set_hint = function(obj, hint){
      remove_hint(obj);
      if(hint!=""){
        obj.closest('.form-group').addClass('has-error');
        obj.parent().append('<div class="help-block m-b-none input-help">'+hint+'</div>');
      }
    }
    var set_ok = function(obj){
      remove_hint(obj);
      obj.closest('.form-group').addClass('has-success');
    }

    var countdown = function(seconds){
      var obj = $('#send_sms_captcha_link')
      if(t){clearTimeout(t);}
      if(seconds < 0){
        obj.html("发送短信验证码");
        obj.removeAttr('disabled');
        return;
      }
      obj.attr('disabled', 'true')
      obj.html("剩余 "+seconds+" 秒");
      var t = setTimeout(function(){
        countdown(--seconds)
      }, 1000)
    };

    var request_sms_captcha = function(image_captcha){
        var url = $('#send_sms_captcha_link').attr('href') + '?phone=' + $('#register_form_phone').val();
        if (image_captcha){
            url += "&image_captcha=" + image_captcha;
        }
        $.ajax({
            url: url,
            method: 'post',
            headers: {"SmsCaptchaToken": "ddt"}
            }).done(function(result){
                obj = $('#register_form_phone')
                set_ok(obj)
                set_ok($("#register_form_captcha"));
                countdown(60);
                toastr.info('验证码已经成功发送至手机，如未收到，请检查是否被屏蔽为垃圾短信');
            }).fail(function(result){
              if(result.responseJSON.notunique){
                    var obj = $('#register_form_phone')
                    set_hint(obj, result.responseJSON.errors)
              }else{
                  // 如果有 image_captcha，则请求用户输入之
                  if (result.responseJSON.image_captcha){
                      request_image_captcha(result.responseJSON)
                  }else{
                      toastr.info(result.responseJSON.errors);
                  }
              }
            });
    }

    var request_image_captcha = function(result){
        var title = "<p>" + result.errors + "</p>";
        var img = $("<image></image>");
        img.attr("src", "data:image/png;base64," + result.image_captcha);
        title += img.wrap('<div>').parent().html()
        bootbox.prompt(title, function(captcha) {
            if (captcha) {
               request_sms_captcha(captcha);
            }
        });
    }

    $('#send_sms_captcha_link').on('click', function(){
        if($(this).attr("disabled")){return false;}
        request_sms_captcha()
        return false;
    });
 
    $('.step-1-btn').on('click', function(){
      var reg_form = this.form;
      check_sms_captcha(function(){
        reg_form.submit()
      })
      return false; 
    });

    function check_sms_captcha(callback){
      var phone = $("#register_form_phone").val()
      var captcha = $("#register_form_captcha").val()
      var url = "<%=check_sms_captcha_backend_register_form_path%>";
      url += "?phone="+phone+"&captcha="+captcha;
      $.ajax({url: url}).success(function(result){
        set_ok($("#register_form_captcha"));
        callback();
      }).fail(function(result){
        set_hint($("#register_form_captcha"), result.responseJSON.errors);
      })
    }

  });
    var _hmt = _hmt || [];
    (function() {

    })();
</script>
