<% content_for :head do %>
  <!-- <%= javascript_include_tag "ddt/login", "data-turbolinks-track" => true %> -->
  <%= stylesheet_link_tag "ddt/login", media: "all", "data-turbolinks-track" => true %>
<%  end %>
<div class="wrapper wrapper-content animated fadeInRight">
  <div class="row">
    <div class="col-lg-12">
      <h2>新用户注册</h2>
    </div>
  </div>
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox"> 
        <div class="ibox-title">
          <div class="reg-nav-item col-xs-4">
              <span class="reg-nav-num">1</span>
              <span>验证手机号</span>
          </div>
          <div class="reg-nav-item col-xs-4 step-2">
              <span class="reg-nav-num">2</span>
              <span>填写帐号信息</span>
          </div>
          <div class="reg-nav-item col-xs-4 step-3 active">
              <span class="reg-nav-num">3</span>
              <span>注册成功</span>
          </div>
        </div>

        <div class="ibox-content">
          <div id="ddb-loading" class="hidden" style="left: 30%;width:40%;">
              <div class="sk-spinner sk-spinner-cube-grid">
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
              </div>
          </div>

          <% if @register_form.errors.present? %>
            <% @register_form.errors.full_messages.each do |msg| %>
              <%= javascript_tag("toastr.error('#{msg}')") %>
            <% end %>
          <% end %>

          <div class="reg-step-3">
            <div class="reg-success text-center">
              <h2>
                <span class="reg-sc-icon"><i class="fa fa-check"></i></span>
                恭喜！您已注册成功。
              </h2>
              <%= link_to "立即登陆", backend_shop_path(@register_form.shop_id), class: "btn btn-primary reg-next-btn step-3-btn" %>
            </div>
          </div>
          <div class="clearfix"></div>

        </div>
      </div>
    </div>
  </div>
</div>