
<div class="container">
  <div class="cell">
    <div class="page__hd">
        <h1 class="page__title">新用户注册</h1>
        <p class="page__desc">第一步：验证手机号</p>
    </div>
  </div>
  <% @agent_no = params[:agent_no] if params[:agent_no].present? %>
  <%= form_for [:backend, @register_form], url: backend_register_form_path(agent_no: @agent_no) do |f| %>
    <%= f.hidden_field :shop_agent_no %>
    <div class="weui-cells weui-cells_form">
        <div class="weui-cell">
            <div class="weui-cell__hd">
              <label class="weui-label">手机号</label></div>
              <div class="weui-cell__bd">
                <%= f.text_field :phone, class: 'weui-input', placeholder: '请输入手机号', pattern: '[0-9]*', type: 'tel'%>
              </div>
        </div>
        <div class="weui-cell weui-cell_vcode" id="image-captcha-cell" style="display: none;">
            <div class="weui-cell__hd">
                <label class="weui-label">图形验证码</label>
            </div>
            <div class="weui-cell__bd">
              <%= text_field_tag :register_form_image_captcha, class: 'weui-input', placeholder: '请输入图形验证码'%>
            </div>
            <div class="weui-cell__ft">
              
            </div>
        </div>
        <div class="weui-cell weui-cell_vcode">
            <div class="weui-cell__hd">
                <label class="weui-label">验证码</label>
            </div>
            <div class="weui-cell__bd">
              <%= f.text_field :captcha, class: 'weui-input', placeholder: '请输入验证码', pattern: '[0-9]*', type: 'tel'%>
            </div>
            <div class="weui-cell__ft">
              <%= link_to('短信验证码', send_sms_captcha_backend_register_form_path, :id => 'send_sms_captcha_link', :text => '发送短信验证码', :remote => true, class: "weui-vcode-btn")%>
            </div>
        </div>
        
    </div>
    <label for="register_form_accept_term" class="weui-agree">
        <%= f.check_box :accept_term, class: 'weui-agree__checkbox'%>
        <span class="weui-agree__text">
            阅读并同意<a href="javascript:void(0);">点单通使用许可协议</a>
        </span>
    </label>
    <div class="weui-btn-area">
      <%= f.submit '下一步', data: { disable_with: "正在提交.."}, class: 'weui-btn weui-btn_primary step-1-btn' %>
    </div>

  <% end %>
  <% unless @oem_brand.present? %>
    <div class="weui-msg__extra-area">
          <div class="weui-footer">
              <p class="weui-footer__links">
                  <a href="javascript:void(0);" class="weui-footer__link">点单通智慧餐饮 提供技术支持</a>
              </p>
              <p class="weui-footer__text">Copyright © 2014-2016 diandantong.com</p>
          </div>
      </div>
    <% end %>
</div>

<script type="text/javascript">
  $(document).ready(function(){
    $('#send_sms_captcha_link').on('click', function(){
      if($(this).attr("disabled")){return false;}
      request_sms_captcha()
      return false;
    });

    var countdown = function(seconds){
      var obj = $('#send_sms_captcha_link')
      if(t){clearTimeout(t);}
      if(seconds < 0){
        obj.html("重新发送");
        obj.removeAttr('disabled');
        return;
      }
      obj.attr('disabled', 'true')
      obj.html("剩余 "+seconds+" 秒");
      var t = setTimeout(function(){
        countdown(--seconds)
      }, 1000)
    };

    var request_image_captcha = function(result){
        var img = $("<image></image>");
        img.attr("src", "data:image/png;base64," + result.image_captcha);
        var innerHtml = img.wrap('<div>').parent().html();
        $('#image-captcha-cell .weui-cell__ft').html(innerHtml);
        $('#image-captcha-cell').show();
    }

    var request_sms_captcha = function(){
        var url = $('#send_sms_captcha_link').attr('href') + '?phone=' + $('#register_form_phone').val();
        if ($('#image-captcha-cell').css('display') != 'none'){
            url += "&image_captcha=" + $('#register_form_image_captcha').val();
        }
        $.ajax({
            url: url,
            method: 'post',
            headers: {"SmsCaptchaToken": "ddt"}
            }).done(function(result){
                countdown(60);
                showToast('验证码已经成功发送至手机，如未收到，请检查是否被屏蔽为垃圾短信');
                $('#image-captcha-cell').hide();
            }).fail(function(result){
              if(result.responseJSON.notunique){
                    showAlert(result.responseJSON.errors);
                    $('#image-captcha-cell').hide();
              }else{
                  // 如果有 image_captcha，则请求用户输入之
                  if (result.responseJSON.image_captcha){
                      request_image_captcha(result.responseJSON)
                  }else{
                    $('#image-captcha-cell').hide();
                    showAlert(result.responseJSON.errors);
                  }
              }
            });
    }

    $('.step-1-btn').on('click', function(){
      var reg_form = $(this).parents('form:first');
      check_sms_captcha(function(){
        reg_form.submit()
      })
      return false; 
    });

    function check_sms_captcha(callback){
      var phone = $("#register_form_phone").val()
      var captcha = $("#register_form_captcha").val()
      var url = "<%=check_sms_captcha_backend_register_form_path%>";
      url += "?phone="+phone+"&captcha="+captcha;
      $.ajax({url: url}).success(function(result){
        callback();
      }).fail(function(result){
        showAlert(result.responseJSON.errors);
      })
    }
  });
</script>

<% unless wechat_device? %>
  <script type="text/javascript">
    var _hmt = _hmt || [];
      (function() {

      })();
  </script>
<% end %>