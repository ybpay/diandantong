
<div class="container">
  <div class="cell">
    <div class="page__hd">
        <h1 class="page__title">新用户注册</h1>
        <p class="page__desc">第二步：填写帐号信息</p>
        <% if @register_form.errors.present? %>
            <% @register_form.errors.full_messages.each do |msg| %>
              <p class="error"><%= msg%></p>
            <% end %>
          <% end %>
          <% if @account.present? && @account.errors.present? %>
            <% @account.errors.full_messages.each do |msg| %>
              <p class="error"><%= msg%></p>
            <% end %>
          <% end %>
          
    </div>
  </div>
  <%= form_for @register_form, url: backend_register_form_path(access_token: @register_form.access_token, agent_no: @agent_no) do |f|%>
    <div class="weui-cells weui-cells_form">
      <div class="weui-cell">
          <div class="weui-cell__hd"><label class="weui-label">用户名</label></div>
          <div class="weui-cell__bd">
            <%= f.text_field :login_id, placeholder: "请输入用户名", class: 'weui-input' %>
          </div>
      </div>
      <div class="weui-cell">
          <div class="weui-cell__hd"><label class="weui-label">邮箱</label></div>
          <div class="weui-cell__bd">
              <%= f.text_field :email, placeholder: "请输入邮箱", class: 'weui-input' %>
          </div>
      </div>
      <div class="weui-cell">
          <div class="weui-cell__hd"><label class="weui-label">密码</label></div>
          <div class="weui-cell__bd">
              <%= f.password_field :password, placeholder: "请输入密码", class: 'weui-input' %>
          </div>
      </div>
      <div class="weui-cell">
          <div class="weui-cell__hd"><label class="weui-label">确认密码</label></div>
          <div class="weui-cell__bd">
              <%= f.password_field :password_confirmation, placeholder: "请输入确认密码", class: 'weui-input' %>
          </div>
      </div>
    </div>
    <div class="weui-btn-area">
      <%= f.submit "下一步", data: { disable_with: "正在初始化系统，预计等待10秒.."}, class: 'reg-next-btn weui-btn weui-btn_primary' %>
    </div>
  <% end %>
  <% unless @oem_brand.present? %>
    <div class="weui-msg__extra-area">
          <div class="weui-footer">
              <p class="weui-footer__links">
                  <a href="javascript:void(0);" class="weui-footer__link">点单通智慧餐饮 提供技术支持</a>
              </p>
              <p class="weui-footer__text">Copyright © 2014-2016 diandantong.com</p>
          </div>
      </div>
  <% end %>
</div>