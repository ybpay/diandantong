= simple_nested_form_for([:backend, @current_shop, @current_branch, @discount_plan], html: { class: 'form-horizontal'}, wrapper: :horizontal_form_long) do |f|
  = f.error_notification :message => error_message_in_html(@discount_plan)

  .form-inputs
    = f.input :name
    = f.input :start_at
    = f.input :end_at
    .col-sm-offset-2
      = f.input_field :enable_on_monday
      = f.label :enable_on_monday
      = f.input_field :enable_on_tuesday
      = f.label :enable_on_tuesday
      = f.input_field :enable_on_wednesday
      = f.label :enable_on_wednesday
      = f.input_field :enable_on_thursday
      = f.label :enable_on_thursday
      = f.input_field :enable_on_friday
      = f.label :enable_on_friday
      = f.input_field :enable_on_saturday
      = f.label :enable_on_saturday
      = f.input_field :enable_on_sunday
      = f.label :enable_on_sunday
    %h3 折扣条目
    .clearfix
    .hr-line-dashed

    #plan-items-section
      = f.simple_fields_for :discount_plan_items do |fitem|
        - item = fitem.object
        = fitem.input :item_type, collection: Ddt::DiscountPlanItem.item_type_collection, include_blank: false, input_html: { onchange: "item_type_change(this);"}
        .category_ids_string{ style: ("display:none;" unless item.is_category? || item.new_record?)}
          = fitem.input :category_ids_string, input_html: { data: { url: backend_shop_branch_categories_path(@current_shop, @current_branch), saved: item.categories.map(&:select_json), placeholder: "分类" }, class: 'ddb-select2'}
        .variant_ids_string{ style: ("display:none;" unless item.is_variant?)}
          = fitem.input :variant_ids_string, input_html: { data: { url: backend_shop_branch_products_path(@current_shop, @current_branch), saved: item.variants.map(&:select_json), placeholder: "单品" }, class: 'ddb-select2'}
        .combo_ids_string{ style: ("display:none;" unless item.is_combo?)}
          = fitem.input :combo_ids_string, input_html: { data: { url: backend_shop_branch_combos_path(@current_shop, @current_branch), saved: item.combos.map(&:select_json), placeholder: "套餐" }, class: 'ddb-select2'}
        = fitem.input :discount, label: "折扣"
        .col-sm-offset-4= fitem.link_to_remove t('Destroy'), class: 'btn btn-danger btn-xs'
        .clearfix
        .hr-line-dashed
    .col-sm-offset-4
      = f.link_to_add "添加折扣条目", :discount_plan_items, :class=>'btn btn-success', :data => { :target => "#plan-items-section" }, onclick: "setTimeout(init_ddb_select2, 1000);"

  .clearfix
  .hr-line-dashed
  .form-actions
    .col-sm-offset-4
      = f.button :submit, :class => "btn btn-primary"

:javascript
  function item_type_change(item){
    var item_type = $(item).val()
    var parent = $(item).parent().parent().parent()
    $(".category_ids_string", parent).hide()
    $(".variant_ids_string", parent).hide()
    $(".combo_ids_string", parent).hide()
    $("."+item_type+"_ids_string", parent).show()
  }
