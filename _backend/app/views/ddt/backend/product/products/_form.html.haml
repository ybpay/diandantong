= simple_nested_form_for([:backend, @current_shop, @current_branch, @product], html: { class: 'form-horizontal'},wrapper: :horizontal_form_long) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@product)

    .form-inputs
      .col-sm-6
        = f.input :name
      .col-sm-6
        = f.input :name_abbr, hint: '不填系统默认生成'
      .col-sm-6
        = f.input :sku, hint: '产品统一编号 SKU:（ 建议使用字母加数字，如：P01、P02）， 如不填写将影响部分报表生成及报表准确度。'
      .col-sm-6
        = f.input :unit_name
      .clearfix
      .col-sm-6
        = f.input :stock_quantity, as: :integer
      .col-sm-6
        = f.input :by_weight, as: :boolean
      .clearfix
      .col-sm-6
        = f.input :default_weight, as: :float
      .clearfix
      .col-sm-6
        .col-xs-offset-4
          = f.input_field :support_delivery
          = f.label :support_delivery
          = f.input_field :support_reservation
          = f.label :support_reservation
          = f.input_field :support_eat_in_hall
          = f.label :support_eat_in_hall
          = f.input_field :on_shelf
          = f.label :on_shelf
          (反勾选此项，可使产品暂时下架）
      .col-sm-6
        .col-xs-offset-3
          = f.input_field :sale_on_monday
          = f.label :sale_on_monday
          = f.input_field :sale_on_tuesday
          = f.label :sale_on_tuesday
          = f.input_field :sale_on_wednesday
          = f.label :sale_on_wednesday
          = f.input_field :sale_on_thursday
          = f.label :sale_on_thursday
          = f.input_field :sale_on_friday
          = f.label :sale_on_friday
          = f.input_field :sale_on_saturday
          = f.label :sale_on_saturday
          = f.input_field :sale_on_sunday
          = f.label :sale_on_sunday
      .col-sm-6
        = f.input :price, as: :decimal, required: true
      .clearfix
      .col-sm-6
        = f.input :vip_price, as: :decimal, required: true
      .col-sm-6
        = f.input :category_ids_string, input_html: { data: { url: backend_shop_branch_categories_path(@current_shop, @current_branch), saved: @product.categories.map(&:select_json), placeholder: "请选择商品分类" }, class: 'ddb-select2'}, hint: raw("可以输入分类名称搜索更多<br />#{link_to '管理商品分类', backend_shop_branch_categories_path(@current_shop, @current_branch), target: 'blank', class: 'btn btn-xs btn-info'}"), required: true
      .col-sm-6
        = f.input :option_type_ids_string, input_html: { data: { url: backend_shop_branch_option_types_path(@current_shop, @current_branch), saved: @product.option_types.as_json(only: [:id, :name]), placeholder: "请选择支持的规格类型" }, class: 'ddb-select2'}, hint: raw("输入类型名称搜索更多<br />#{link_to '管理规格类型', backend_shop_branch_option_types_path(@current_shop, @current_branch), target: 'blank', class: 'btn btn-xs btn-info'}")
      .col-sm-6
        = f.input :tag_names, input_html: { data: { useas: 'tag', url: backend_shop_branch_tags_path(@current_shop, @current_branch), :"search-conditions" => {type_eq: 'Ddt::ProductTag'}, saved: @product.saved_tags, placeholder: '为您的产品打上标签' }, class: 'ddb-select2'}, hint: '您可以输入新的标签， 使用逗号","或空格" "来分隔标签, 每个标签最多十个字符'
      .clearfix
      .col-sm-6
        = f.input :item_note_ids_string, input_html: { data: { url: backend_shop_branch_item_notes_path(@current_shop, @current_branch), single: false, saved: @product.item_notes.as_json(only: [:id, :name]), placeholder: "请选择支持的品注"}, class: 'ddb-select2'}, hint: raw("输入名称搜索更多<br />#{link_to '管理品注', backend_shop_branch_item_notes_path(@current_shop, @current_branch), target: 'blank', class: 'btn btn-xs btn-info'}")
      .col-sm-6
        = f.input :description, :as => :ckeditor, :input_html => { :ckeditor => {:toolbar => 'mini'} }

      = advanced_options do
        .col-sm-6
          = f.input :availabled_at
          = f.input :start_time
          = f.input :end_time
          = f.input :sale_quantity, as: :integer
          = f.input :nfc_code, hint: '可选范围0~9999，编号不可重复；非智盘平台不需填写'
        .col-sm-6
          = f.input :position
          = f.input :enable_discount, hint: "例如：酒水类产品不参与会员优惠与权限打折，注意：该选项不会影响促销活动，与促销活动重叠时系统以促销活动为准"
          = f.input :min_quantity_for_order
          = f.input :show_note_in_weixin
          = f.input :show_on_wechat
          = f.input :enable_change_price

    .form-actions.col-xs-offset-2
      = f.button :submit, :class => "btn btn-primary btn-sm"
