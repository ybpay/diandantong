.ibox
  .ibox-title
    %h3= "#{t('activerecord.models.ddt/product')}详情"
  .ibox-content.header
    .row
      .col-md-6.form-group
        %p
          %b
            = Ddt::Product.human_attribute_name(:name)
            \:
          = @product.name
      .col-md-6.form-group
        %p
          %b
            = Ddt::Product.human_attribute_name(:unit_name)
            \:
          = @product.unit_name
      .col-md-6.form-group
        %p
          %b
            = Ddt::Product.human_attribute_name(:availabled_at)
            \:
          = @product.availabled_at
      .col-md-6.form-group
        %p
          %b
            支持下单方式
            \:
          = %W[support_delivery support_reservation support_eat_in_hall].select{|s| @product.send(s.to_sym)}.map{|s| Ddt::Product.human_attribute_name(s.to_sym)}.join(", ")
      .col-md-6.form-group
        %p
          %b
            上架时间
            \:
          = %W[sale_on_monday sale_on_tuesday sale_on_wednesday sale_on_thursday sale_on_friday sale_on_saturday sale_on_sunday].select{|s| @product.send(s.to_sym)}.map{|s| Ddt::Product.human_attribute_name(s.to_sym)}.join(", ")
      .col-md-6.form-group
        %p
          %b
            = Ddt::Product.human_attribute_name(:price)
            \:
          = @product.price_in_currency
      .col-md-6.form-group
        %p
          %b
            = Ddt::Product.human_attribute_name(:vip_price)
            \:
          = @product.vip_price_in_currency
      .col-md-6.form-group
        %p
          %b
            = Ddt::Product.human_attribute_name(:category_ids)
            \:
          = @product.categories.map(&:name).join(", ")
      .col-md-6.form-group
        %p
          %b
            = Ddt::Product.human_attribute_name(:tag_names_string)
            \:
          = raw(tags_label(@product.tag_names_string))
      .col-md-6.form-group
        %p
          %b
            = Ddt::Product.human_attribute_name(:option_type_ids)
            \:
          = @product.option_types.map(&:name).join(", ")
      .col-md-6.form-group
        %p
          %b
            = Ddt::Product.human_attribute_name(:item_note_ids)
            \:
          = @product.item_notes.map(&:name).join(", ")
      .col-md-6.form-group
        %p
          %b
            = Ddt::BaseQrCodeScene.human_attribute_name(:scan_times)
            \:
          = @product.scan_times
      .col-md-6.form-group
        %p
          %b
            = Ddt::BaseQrCodeScene.human_attribute_name(:url)
            \:
          - if @product.qr_code_scene.present?
            = image_tag @product.qr_code_image
          - else
            = link_to '创建产品二维码', [:create_qrcode, :backend, @current_shop, @current_branch, @product], class: 'btn btn-xs btn-success', method: :put
      .col-md-6.form-group
        %b
          = Ddt::Product.human_attribute_name(:description)
          \:
        = raw @product.description
      .col-md-6.form-group
        %p
          %b
            = Ddt::Product.human_attribute_name(:nfc_code)
            \:
          = @product.nfc_code
        .clearfix
      = advanced_options do
        .col-md-6.form-group
          %b
            = Ddt::Product.human_attribute_name(:stock_quantity)
            \:
          = @product.stock_quantity
        .col-md-6.form-group
          %b
            = Ddt::Product.human_attribute_name(:sale_quantity)
            \:
          = @product.sale_quantity
        .col-md-6.form-group
          %b
            = Ddt::Product.human_attribute_name(:sku)
            \:
          = @product.sku
        - if @product.by_weight?
          .col-md-6.form-group
            %b
              = Ddt::Product.human_attribute_name(:by_weight)
              \:
            是
          .col-md-6.form-group
            %b
              = Ddt::Product.human_attribute_name(:default_weight)
              \:
            = @product.default_weight
        .col-md-6.form-group
          %b
            = Ddt::Product.human_attribute_name(:position)
            \:
          = @product.position
        .col-md-6.form-group
          %b
            = Ddt::Product.human_attribute_name(:enable_discount)
            \:
          = @product.enable_discount? ? "是" : '否'
        .col-md-6.form-group
          %b
            = Ddt::Product.human_attribute_name(:min_quantity_for_order)
            \:
          = @product.min_quantity_for_order
        .col-md-6.form-group
          %b
            = Ddt::Product.human_attribute_name(:show_note_in_weixin)
            \:
          = @product.show_note_in_weixin? ? "支持" : '不支持'
        .col-md-6.form-group
          %b
            = Ddt::Product.human_attribute_name(:show_on_wechat)
            \:
          = @product.show_on_wechat? ? "支持" : '不支持'
        .space

      - if @product.qr_code_scene.present?
        .col-md-6.form-group
        = render partial: '/ddt/backend/qrcode/qrcode_scan_relations/index', locals: {qrcode_scan_relations: @product.qr_code_scene.qrcode_scan_relations.paginate(page: params[:page], per_page: 15)}


    = link_to t('Edit'), edit_backend_shop_branch_product_path(@current_shop, @current_branch, @product), :class => "btn btn-primary btn-sm"
    \
    = link_to t('Back'), backend_shop_branch_products_path(@current_shop, @current_branch), :class => "btn btn-default btn-sm"
