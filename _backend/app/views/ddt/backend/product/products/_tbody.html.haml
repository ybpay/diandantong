%tbody.products_tbody
  - products.each do |product|
    - cache(product, expires_in: 1.days) do
      %tr
        %td= check_box_tag "product[id][]", product.id, false, id: "product_id_#{product.id}"
        %td= product.sku
        %td
          = shelf_status_label(product)
          = link_to product.name, [:backend, @current_shop, @current_branch, product]
        %td= images_label(product)
        %td= product.name_abbr
        %td= product.categories.map(&:name_with_parent).join(',')
        %td
          - product.variants.each do |variant|
            %ol
              %li
                = link_to "#{variant.name_with_options_text}  : " ,[:backend , @current_shop ,@current_branch , product , :variants]
                = link_to tag(:icon , class: "fa fa-plus-square") ,[:remove_estimate_clear, :backend , @current_shop ,@current_branch , product , variant] , :class => "btn btn-xs btn-success" , title: "加满库存", :'data-rel' => "tooltip" , :method => :post
                - add_estimate_clear_class = variant.estimate_clear? ? "btn btn-xs btn-success disabled" : "btn btn-xs btn-success"
                - add_estimate_clear_reciprocal_class = variant.estimate_clear_reciprocal? ? "btn btn-xs btn-default" : "btn btn-xs btn-success"
                = link_to tag(:icon , class: "fa fa-minus-square") ,[:add_estimate_clear, :backend , @current_shop ,@current_branch , product , variant ] , :class => add_estimate_clear_class , title: "直接估清", :'data-rel' => "tooltip" , :method => :post ,:'data-confirm' => "确定估清该子产品?"
                = link_to tag(:icon , class: "fa fa-sort-numeric-desc") ,[:ajax_estimate_clear_reciprocal, :backend , @current_shop ,@current_branch , product , variant ] , :class => add_estimate_clear_reciprocal_class , title: "数量估清", :'data-rel' => "tooltip" , :method => :post , remote: true
        %td
          = "原价: #{product.price}"
          %br
          = "会员价: #{product.vip_price}"
        %td

          = info_btn(product)
          = edit_btn(product)
          = delete_btn(product)
          = link_to '图片管理', [:backend, @current_shop, @current_branch, product, product.master, :variant_images]
          = link_to '排序', "javascript:change_position(#{product.id})"
          = form_tag(change_position_backend_shop_branch_product_path(@current_shop, @current_branch, product), id: "change-position-form-#{product.id}", method: 'PUT', remote: true, style: 'display: none') do
            = text_field_tag :position

  = no_record_hint(products)

:javascript
  function change_position(product_id){
    bootbox.prompt({
      title: "请输入该产品的位置数字",
      inputType: 'number',
      callback: function (result) {
        var form = $("#change-position-form-"+product_id);
        $(form).find('input[name="position"]').val(result)
        $(form).submit();
      }
    });
  }
  