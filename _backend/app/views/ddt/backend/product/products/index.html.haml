%h2= "#{t('activerecord.models.ddt/product')} 列表"
.form-group
  = new_btn(:product, label: "新建产品")
  = render 'import_export_button'
  = render 'batch_buttons'
= render 'import_export_tips'
.form-group
  = search_form_for @q, url:backend_shop_branch_products_path(@current_shop, @current_branch),html:{ class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
    =f.input_field :created_at_gteq, as: :date, placeholder: Ddt::Product.human_attribute_name(:created_at)
    %span ~
    =f.input_field :created_at_lteq, as: :date, placeholder: Ddt::Product.human_attribute_name(:created_at)
    =f.input_field :id_eq, placeholder: Ddt::Product.human_attribute_name(:id), class: 'form-control'
    =f.input_field :name_cont, placeholder: Ddt::Product.human_attribute_name(:name), class: 'form-control'
    =f.input_field :categories_id_eq, collection: @current_branch.categories.map{|c| [c.name, c.id]}, prompt:Ddt::Product.human_attribute_name(:categories), include_blank: true, class: 'form-control'
    =f.input_field :name_abbr_eq, placeholder: Ddt::Product.human_attribute_name(:name_abbr), class: 'form-control'
    =f.input_field :master_price_eq, placeholder: Ddt::Product.human_attribute_name(:price), class: 'form-control'
    =f.input_field :master_vip_price_eq, placeholder: Ddt::Product.human_attribute_name(:vip_price), class: 'form-control'
    =f.input_field :variants_including_master_nfc_code_eq, placeholder: Ddt::Product.human_attribute_name(:nfc_code), class: 'form-control'
    = f.submit "搜索", class: 'btn btn-sm btn-success'
.ibox-content
  .form-group
    = will_paginate @products , renderer: BootstrapPagination::Rails, bootstrap: 3
  %table.table.table-striped
    %thead
      %tr
        %th.col-sm-1
          = check_box_tag "all_products", "", false, {id: 'batch_op_select_all', data:{model:'product', token: form_authenticity_token}}
          %label{for: "all_products"} 全选
        %th.col-sm-1= sort_link(@q , :sku         , Ddt::Product.human_attribute_name(:sku))
        %th.col-sm-2= sort_link(@q , :name        , Ddt::Product.human_attribute_name(:name))
        %th.col-sm-1= Ddt::VariantImage.human_attribute_name(:attachment)
        %th.col-sm-1= Ddt::Product.human_attribute_name(:name_abbr)
        %th.col-sm-1= Ddt::Product.human_attribute_name(:categories)
        %th.col-sm-1 子产品
        %th.col-sm-2= sort_link(@q , :price       , Ddt::Product.human_attribute_name(:price))
        %th.col-sm-2

    = render 'tbody', { products: @products}
  %br
  .pull-right= will_paginate @products , renderer: BootstrapPagination::Rails, bootstrap: 3
  %br
