.btn-group
  %button.btn.btn-danger.dropdown-toggle{type: "button", data: {toggle: "dropdown"}}
    批量操作
    %i.fa.fa-caret-down
  %ul.dropdown-menu
    %li
      = link_to "复制所有产品", copy_backend_shop_branch_products_path(@current_shop, @current_branch), remote: true
    %li
      = link_to "批量复制产品", copy_backend_shop_branch_products_path(@current_shop, @current_branch), remote: true, class: "batch_op_action", method: "GET"
    %li
      = link_to "批量删除产品", batch_remove_backend_shop_branch_products_path(@current_shop, @current_branch, page: params[:page]), class: "batch_op_action", confirmtxt: "确认删除选中产品？"
    %li
      = link_to "批量产品上架", batch_on_shelf_backend_shop_branch_products_path(@current_shop, @current_branch, page: params[:page]), class: "batch_op_action"
    %li
      = link_to "批量产品下架", batch_off_shelf_backend_shop_branch_products_path(@current_shop, @current_branch, page: params[:page]), class: "batch_op_action"
    %li
      = link_to "批量产品估清", batch_estimate_clear_backend_shop_branch_products_path(@current_shop, @current_branch, page: params[:page]), class: "batch_op_action"
    %li
      = link_to "批量去除估清", batch_estimate_full_backend_shop_branch_products_path(@current_shop, @current_branch, page: params[:page]), class: "batch_op_action"
