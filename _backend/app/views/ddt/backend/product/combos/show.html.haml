.ibox
  .ibox-title
    %h3= "#{t('activerecord.models.ddt/combo')}详情"
  .ibox-content.header
    .row
      .col-sm-6
        %b
          = Ddt::Combo.human_attribute_name(:name)
          \:
        = @combo.name
      .col-sm-6
        %b
          = Ddt::Combo.human_attribute_name(:unit_name)
          \:
        = @combo.unit_name
      .col-sm-6
        %b
          = Ddt::Combo.human_attribute_name(:on_shelf)
          \:
        = @combo.on_shelf
      .col-sm-6
        %b
          = Ddt::Combo.human_attribute_name(:stock_quantity)
          \:
        = @combo.stock_quantity
      .col-sm-6
        %b
          = Ddt::Combo.human_attribute_name(:availabled_at)
          \:
        = @combo.availabled_at
      .col-sm-6
        %b
          = Ddt::Combo.human_attribute_name(:end_at)
          \:
        = @combo.end_at
      .col-sm-6
        %b
          支持下单方式
          \:
        = %W[support_delivery support_reservation support_eat_in_hall].select{|s| @combo.send(s.to_sym)}.map{|s| Ddt::Combo.human_attribute_name(s.to_sym)}.join(", ")
      .col-sm-6
        %b
          上架时间
          \:
        = %W[sale_on_monday sale_on_tuesday sale_on_wednesday sale_on_thursday sale_on_friday sale_on_saturday sale_on_sunday].select{|s| @combo.send(s.to_sym)}.map{|s| Ddt::Combo.human_attribute_name(s.to_sym)}.join(", ")
      .col-sm-6
        %b
          = Ddt::Combo.human_attribute_name(:price)
          \:
        = @combo.fixed_part_price_in_currency
      .col-sm-6
        %b
          = Ddt::Combo.human_attribute_name(:vip_price)
          \:
        = @combo.fixed_part_vip_price_in_currency
      .col-sm-6
        %b
          = Ddt::Combo.human_attribute_name(:sku)
          \:
        = @combo.sku
      .col-sm-6
        %b
          = Ddt::Combo.human_attribute_name(:enable_discount)
          \:
        = @combo.enable_discount? ? "是" : '否'
      .col-sm-6
        %b
          = Ddt::Combo.human_attribute_name(:show_on_wechat)
          \:
        = @combo.show_on_wechat? ? "是" : '否'

      .col-sm-6
        .content
          %b
            = Ddt::Combo.human_attribute_name(:description)
            \:
          = raw @combo.description
      .space

    = link_to t('Edit'), edit_backend_shop_branch_combo_path(@current_shop, @current_branch, @combo), :class => "btn btn-primary btn-sm"
    = link_to t('Back'), backend_shop_branch_combos_path(@current_shop, @current_branch), :class => "btn btn-default btn-sm"
