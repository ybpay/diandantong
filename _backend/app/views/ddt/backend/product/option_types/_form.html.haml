= simple_nested_form_for([:backend, @current_shop, @current_branch, @option_type], remote: true, html: { class: 'form-horizontal'}, wrapper: :horizontal_form_long, remote: true) do |f|
  = f.error_notification :message => error_message_in_html(@option_type)

  .form-inputs
    = f.input :name
    .col-xs-2 选项值
    .col-xs-offset-2
      = f.fields_for :option_values do |v|
        = v.input_field :name, placeholder: '选项值'
        = v.link_to_remove tag(:icon, class: 'fa fa-minus'), class: 'btn btn-danger btn-xs', title: '删除'
      = f.link_to_add tag(:icon, class: 'fa fa-plus'), :option_values, :class=>'btn btn-primary btn-xs', title: '添加选项值'
  .form-actions.col-xs-offset-2
    = f.button :submit, :class => "btn btn-primary btn-sm"
