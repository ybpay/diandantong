= simple_nested_form_for([:backend, @current_shop, @current_branch, @product, @variant], remote: true, html: { class: 'form-horizontal'}, wrapper: :horizontal_form_long, remote: true) do |f|
  = f.error_notification :message => error_message_in_html(@variant)

  .form-inputs
    - @variant.product.option_types.each do |option_type|
      = f.input :option_value_ids, collection: option_type.option_values, include_blank: false, label: option_type.name, selected: @variant.option_values.detect{|v| v.option_type == option_type }.try(:id), input_html: { name: "variant[option_value_ids][]"}
    = f.input :sku, hint: "如sku与主产品的sku一致，这里留空就行"
    = f.input :price
    = f.input :vip_price
    = f.input :stock_quantity
    = f.input :sale_quantity
    = f.input :by_weight, as: :boolean
    = f.input :estimate_clear
    = f.input :default_weight, as: :float, hint: '默认一份所对应的重量'
    = f.input :nfc_code, hint: "可选范围0~9999，编号不可重复；非智盘平台不需填写"
  .form-actions.col-xs-offset-2
    = f.button :submit, :class => "btn btn-primary btn-sm"
