.alert.alert-success 上传公共图片是指您可以在公共图片库里寻找适合您产品的图片，您自己无需上传图片，就可以使用系统积累的公共图片来充当您的套餐图片，为您节约更多的时间。
= search_form_for @q, url: [:list, :backend, @current_shop, @current_branch, @combo, :combo_images], method: :get, html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder, remote: true do |f|
  - tag = Ddt::AssetTag.find_by_id(params[:q].try('[]', :asset_tags_id_eq))
  = f.input_field :asset_tags_id_eq, data: { single: true, url: backend_asset_tags_path(), saved: tag.try(:select_json), placeholder: "标签" }, class: 'ddb-select2 input-medium'
  = f.submit "搜索", class: 'btn btn-sm btn-success'
%br/
.combo-images
  - @combo_images.each do |combo_image|
    = link_to image_tag(combo_image.attachment.rect_normal.url), add_exist_image_backend_shop_branch_combo_combo_images_path(@current_shop, @current_branch, @combo, combo_image, exist_image_id: combo_image.id), class: "combo-image", remote: true
%br/
= will_paginate @combo_images , renderer: BootstrapPagination::Rails, bootstrap: 3, link_options: { :"data-remote" => true }
%br/
