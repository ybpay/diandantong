.header
  %h3= "#{t('activerecord.models.ddt/zone')} 列表"
.model-show
  %p
    %b
      = Ddt::Zone.human_attribute_name(:name)
      \:
    = @zone.name
  %p
    %b
      = Ddt::Zone.human_attribute_name(:branches)
      \:
    = @zone.branches.map(&:name).join(", ")
  %p
    = link_to '删除此区域', [:backend, @current_shop, @zone], :method => :delete, :data => { :confirm => '确定删除?' }, :class => "btn btn-xs btn-danger"
  .space
  = render 'zone_index', zones: @zone.zones

= link_to t('Edit'), edit_backend_shop_zone_path(@current_shop, @zone), :class => "btn btn-primary btn-sm"
\
= link_to t('Back'), backend_shop_zones_path(@current_shop), :class => "btn btn-default btn-sm"