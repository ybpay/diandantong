%table.table.table-striped
  %thead
    %tr
      %th.col-sm-1= Ddt::Zone.human_attribute_name(:name)
      %th.col-sm-1
  %tbody
    - zones.each do |zone|
      %tr
        %td= zone.name
        %td
          = info_btn(zone)
          = edit_btn(zone)
          = delete_btn(zone)
    = no_record_hint(zones)
