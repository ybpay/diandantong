
.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h3= "#{t('activerecord.models.ddt/groupon_version')} 列表"

    .form-group
      = link_to "新建 #{t('activerecord.models.ddt/groupon_version')}", new_backend_shop_groupon_version_path(@current_shop), :class=>"btn btn-primary btn-sm"

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        %table.table.table-striped.table-bordered
          %thead
            %tr

              %th.col-sm-1= sort_link(@q, :name, Ddt::GrouponVersion.human_attribute_name(:name))

              %th.col-sm-1= sort_link(@q, :usable_starts_at, Ddt::GrouponVersion.human_attribute_name(:usable_starts_at))

              %th.col-sm-1= sort_link(@q, :sellable_starts_at, Ddt::GrouponVersion.human_attribute_name(:sellable_starts_at))

              %th.col-sm-1= sort_link(@q, :max_grant_limit, Ddt::GrouponVersion.human_attribute_name(:max_grant_limit))

              %th.col-sm-1= sort_link(@q, :base_coupons_count, Ddt::GrouponVersion.human_attribute_name(:base_coupons_count))

              %th.col-sm-1= sort_link(@q, :groupon_price, Ddt::GrouponVersion.human_attribute_name(:groupon_price))

              %th.col-sm-1= Ddt::GrouponVersion.human_attribute_name(:support_refund)
              %th.col-sm-1= Ddt::GrouponVersion.human_attribute_name(:refundable_days_after_send)
              %th.col-sm-1= "适用门店"
              %th.col-sm-1

          %tbody
            - @groupon_versions.each do |groupon_version|
              %tr
                %td
                  - if groupon_version.coupon_photos.any?
                    %span.fa.fa-image
                  = groupon_version.name
                %td= "#{groupon_version.usable_starts_at} ~ #{groupon_version.usable_expires_at}"
                %td= "#{groupon_version.sellable_starts_at} ~  #{groupon_version.sellable_expires_at}"
                %td= groupon_version.max_grant_limit
                %td= groupon_version.base_coupons_count
                %td= groupon_version.groupon_price
                %td= t(groupon_version.support_refund?.to_s)
                %td= groupon_version.refundable_days_after_send
                %td= groupon_version.branch_names
                %td
                  = info_btn(groupon_version)
                  = edit_btn(groupon_version)
                  = delete_btn(groupon_version)

            = no_record_hint(@groupon_versions)
        %br
        .pull-right= will_paginate @groupon_versions , renderer: BootstrapPagination::Rails, bootstrap: 3
        %br
