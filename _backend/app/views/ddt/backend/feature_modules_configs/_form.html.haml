= simple_nested_form_for([:backend, @current_shop, @feature_modules_config], html: { class: 'form-horizontal'}) do |f|
  = f.error_notification :message => error_message_in_html(@feature_modules_config)

  .form-inputs
    .col-sm-6
      = f.input :feature_module, collection: Ddt::FeatureModules.all.map{|name, entry| [entry[:label], name]}, prompt: '选择服务的模块', disabled: !current_account.is_admin?
      = f.input :created_at, disabled: true
      = f.input :expired_at, disabled: !current_account.is_admin?
      = f.input :enabled
      = f.input :disable_reason
    .clearfix
  .form-actions
    .col-sm-6
      .col-sm-offset-4
        = f.button :submit
