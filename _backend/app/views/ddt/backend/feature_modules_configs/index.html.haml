
.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/feature_modules_config')} 列表"

/ .alert.alert-success
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-sm-12
        %h3
          = "共计开通#{@feature_modules_configs.count}个模块，#{@feature_modules_configs.enabled.available.count}个模块正常可用。"
          - if @feature_modules_configs.expired_at_month.count > 0
            %strong.text-danger= @feature_modules_configs.expired_at_month.count
            个模块即将到期。
          - if @feature_modules_configs.disabled.count > 0
            %strong.text-warning= @feature_modules_configs.disabled.count
            个模块被禁用。

    .row
      .col-sm-12
        = link_to '升级服务配置', index_group_backend_shop_feature_modules_configs_path(@current_shop), class: 'btn btn-success'
        - if current_account.is_admin?
          = link_to '续费当前服务配置', new_backend_shop_shop_recharge_record_path(@current_shop), class: 'btn btn-success'
          = link_to '增加模块', new_backend_shop_feature_modules_config_path(@current_shop), class: 'btn btn-primary'

  .row
    .col-lg-12
      - @feature_modules_configs.each do |feature_modules_config|
        .col-lg-3.col-md-4.col-sm-6.col-xs-12
          .contact-box
            .col-sm-12
              - if feature_modules_config.expired?
                .label.label-danger.pull-right 已过期
              - elsif feature_modules_config.enabled?
                .label.label-success.pull-right 正常运行
              - else
                .label.label-warning.pull-right 已禁用
                .text-center= "禁用原因: #{feature_modules_config.disable_reason}"
              .text-center
                %div{style: "margin: 20px 10px; text-align:center; font-size: 80px;"}
                  %i.fa.fa-cog
                %h3.text-center= feature_modules_config.feature_modules_name
                %p{:class=>("text-danger" if feature_modules_config.expired_at_month?)}
                  = feature_modules_config.expired_at.try(:strftime, "%F %T")
                  \到期

            .clearfix
            = link_to '修改', edit_backend_shop_feature_modules_config_path(@current_shop, feature_modules_config), class: 'btn btn-w-m btn-primary btn-block'
            - if @current_account.is_admin?
              = link_to '删除', [:backend, @current_shop, feature_modules_config], :method => :delete, :data => { :confirm => '确定删除?', :rel=>'tooltip' }, :title => '删除', class: 'btn btn-w-m btn-white btn-block'


= content_for :javascript do 
  :javascript
    $(function () {

        $('.contact-box').each(function () {
            animationHover(this, 'pulse');
        });

    });
