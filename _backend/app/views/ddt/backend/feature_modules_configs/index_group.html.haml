
/ .alert.alert-success
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        %h3 当前版本可升级服务：
        %p
          \当前系统的版本为
          %strong
            = @current_shop.shop_type_name
          ,
          最大可以创建
          %strong
            = @current_shop.max_branches_limit
          家门店。

  .row
    .col-lg-12
      - feature_module_groups = Ddt::FeatureModuleGroup.all_values.select{|feature_module_group| Ddt::FeatureModuleGroup.can_upgrade_to?(@current_shop, @current_shop.max_branches_limit, feature_module_group[:name])}
      - if feature_module_groups.size > 0
        - feature_module_groups.each do |feature_module_group|
          .col-lg-3.col-md-4.col-sm-6.col-xs-12
            %a{href:  current_account.is_admin? ? new_backend_shop_shop_recharge_record_path(@current_shop, feature_module_group: feature_module_group[:name]) : 'javascript:bootbox.hideAll(); bootbox.alert("请联系当地经销商或厂商进行升级")', style: 'text-decoration: none;', :"data-rel"=> "tooltip",:"title" => " 包含如下功能服务模块：#{(feature_module_group[:modules] - [:base,:pay_base,:wechat_base]).map{|m| Ddt::FeatureModules.feature_modules_name(m)}.join(", ")}"}
              .contact-box{:style => "height: 150px; max-height: 150px; overflow-y: hidden;"}
                .col-sm-12
                  .col-sm-4
                    .text-center{style: "margin: 10px auto; text-align:center; font-size: 3em;", class: 'text-navy'}
                      %i.fa{class: feature_module_group[:icon]||'fa-cog'}
                  .col-sm-8
                    .text-muted
                      %h3.text-center= feature_module_group[:label]
                      %div.text-overflow= "包含如下功能服务模块：#{feature_module_group[:modules].map{|m| Ddt::FeatureModules.feature_modules_name(m)}.join(", ")}"

                .clearfix
      - else
        .col-xs-12
          .ibox-content
            %p 当前没有可供升级的更高服务模块

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        %h3 当前版本不支持服务：

  .row
    .col-lg-12
      - Ddt::FeatureModuleGroup.all_values.select{|feature_module_group| !Ddt::FeatureModuleGroup.can_upgrade_to?(@current_shop, @current_shop.max_branches_limit, feature_module_group[:name]) }.each do |feature_module_group|
        .col-lg-3.col-md-4.col-sm-6.col-xs-12
          %a{href: '#', style: 'text-decoration: none;', :"data-rel"=> "tooltip",:"title" => " 包含如下功能服务模块：#{(feature_module_group[:modules] - [:base,:pay_base,:wechat_base]).map{|m| Ddt::FeatureModules.feature_modules_name(m)}.join(", ")}"}
            .contact-box{:style => "height: 150px; max-height: 150px; overflow-y: hidden;"}
              .col-sm-12
                .col-sm-4
                  .text-center{style: "margin: 10px auto; text-align:center; font-size: 3em;", class: 'text-muted'}
                    %i.fa{class: feature_module_group[:icon]||'fa-cog'}
                .col-sm-8
                  .text-muted
                    %h3.text-center= feature_module_group[:label]
                    %div.text-overflow= "包含如下功能服务模块：#{feature_module_group[:modules].map{|m| Ddt::FeatureModules.feature_modules_name(m)}.join(", ")}"

              .clearfix



= content_for :javascript do
  :javascript
    $(function () {

        $('.contact-box').each(function () {
            animationHover(this, 'pulse');
        });

    });