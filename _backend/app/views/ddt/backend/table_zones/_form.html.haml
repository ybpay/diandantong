= simple_form_for([:backend, @current_shop, @current_branch, @table_zone], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@table_zone)

    .form-inputs
      .col-sm-6
        = f.input :name
      .col-sm-6
        = f.input :min_reservation_price
      .col-sm-6
        = f.input :reservation_price, hint: '仅预订订座时需要预付款的金额'
      .col-sm-6
        = f.input :reservation_price_percent, hint: '预订且点菜时需要预付的百分比 %，随点菜的总金额自动调整'
      .col-sm-6
        = f.input :tables_count_for_reservation
      .col-sm-6
        = f.input :weixin_ban_product_ids_string, input_html: {data: {url: search_backend_shop_branch_products_path(@current_shop, @current_branch), saved: @table_zone.weixin_ban_products.map(&:select_json), placeholder: "请选择菜品"}, class: 'ddb-select2'}, hint: '加入黑名单后，在该桌台类型下单，微信端无法选择这些产品。 使用场景: 自拿菜品'
      .col-sm-6
        = f.input :webpos_ban_product_ids_string, input_html: {data: {url: search_backend_shop_branch_products_path(@current_shop, @current_branch), saved: @table_zone.webpos_ban_products.map(&:select_json), placeholder: "请选择菜品"}, class: 'ddb-select2'}, hint: '加入黑名单后，在该桌台类型下单，收银端无法选择这些产品。 使用场景: 自拿菜品'
      .col-sm-6
        = f.input :ban_selfpay, as: :boolean, hint: '使用场景：不允许客户自助买单，需请求服务员买单（如寿司店，自拿菜品需服务员盘点,加菜到订单，才能自助买单'

    .form-actions.col-xs-offset-2
      = f.button :submit, :class => "btn btn-primary btn-sm"
