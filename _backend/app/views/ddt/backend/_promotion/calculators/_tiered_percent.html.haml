.base-field
  = label_tag "#{prefix}[calculator_attributes][preferred_base_percent]", I18n.t("calculators.keys.base_percent")
  = preference_field_tag("#{prefix}[calculator_attributes][preferred_base_percent]", calculator.preferred_base_percent, type: calculator.preference_type(:base_percent))
  %br/
  %span 100为10折 50为5折

= content_tag :div, nil, class: "hidden js-original-tiers", data: { :'original-tiers' => Hash[calculator.preferred_tiers.sort] }

.js-tiers
.fa.fa-plus.btn.btn-success.btn-xs.js-add-tier 增加
%script{type: "text/x-handlebars-template", id: "tier-input-name"}
  = "#{prefix}[calculator_attributes][preferred_tiers][{{base}}]"

%script{ type: "text/x-handlebars-template", id: "tier-fields-template"}
  <div class="tier"> |
    <div class="fa fa-trash remove js-remove-tier"></div> |
    <div class="tier-column"> |
      <div class="input-group"> |
        <span class="input-group-addon">¥</span> |
        <input class="js-base-input form-control" type="text" placeholder="订单价格" value={{baseField.value}}> |
      </div> |
    </div> |
    <div class="tier-column"> |
      <div class="input-group"> |
        <input class="js-value-input form-control" |
          name="{{valueField.name}}" type="text" placeholder="折扣"  value={{valueField.value}}> |
        <span class="input-group-addon">%</span> |
      </div> |
    </div> |
    <div class="clear"></div> |
  </div>