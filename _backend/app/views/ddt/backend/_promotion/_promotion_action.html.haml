.ddb-field.ddb-promotion-action{ :'data-id' => promotion_action.id }
  - type_name = promotion_action.class.name.demodulize.underscore
  - param_prefix = "#{@promotion_type}[promotion_actions_attributes][#{promotion_action.id}]"
  = hidden_field_tag "#{param_prefix}[id]", promotion_action.id
  .ddb-field-header
    .ddb-field-title
      = I18n.t("promotion.actions.#{@promotion_type_prefix}.#{type_name}")
    .ddb-field-actions
      = link_to tag(:icon, :class => "fa fa-trash-o"), [:backend, @current_shop, promotion.branch, promotion, promotion_action].compact, :class => "", :'data-confirm' => "确定删除?", :method => :delete, :remote => true, :'data-rel' => "tooltip", :title => "删除"
  .ddb-field-content
    = render :partial => "/ddt/backend/_promotion/actions/#{@promotion_type_prefix}/#{type_name}", locals: { promotion_action: promotion_action, param_prefix: param_prefix }