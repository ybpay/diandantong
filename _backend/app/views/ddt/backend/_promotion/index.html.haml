.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-10
      %h2= "#{t("activerecord.models.ddt/#{@promotion_type}")} 列表"
      %p= "#{t("activerecord.description.ddt/#{@promotion_type}")}"

  .m-b-sm
    .row
      .col-lg-12
        = new_btn(@promotion_type, label: t("activerecord.models.ddt/#{@promotion_type}"))
  .row
    .col-lg-12
      .ibox
        .ibox-content
          %table.table.table-striped
            %thead
              %tr
                %th.col-sm-6= sort_link(@q, :name,        Ddt::Promotion.human_attribute_name(:name))
                %th.col-sm-2= sort_link(@q, :starts_at,   Ddt::Promotion.human_attribute_name(:starts_at))
                %th.col-sm-2= sort_link(@q, :expires_at,  Ddt::Promotion.human_attribute_name(:expires_at))
                %th

            %tbody
              - @promotions.each do |promotion|
                %tr
                  %td= promotion.name
                  %td= promotion.starts_at
                  %td= promotion.expires_at
                  %td
                    = link_to '规则', [:backend, @current_shop, promotion.branch, promotion, :promotion_rules].compact, :'data-rel' => "tooltip", :title => '规则设置'
                    = link_to '动作', [:backend, @current_shop, promotion.branch, promotion, :promotion_actions].compact, :'data-rel' => "tooltip", :title => '动作设置'
                    = edit_btn(promotion)
                    = delete_btn(promotion)
          %br
          .pull-right= will_paginate @promotions , renderer: BootstrapPagination::Rails, bootstrap: 3
          %br
