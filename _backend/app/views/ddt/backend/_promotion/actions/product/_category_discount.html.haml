- key = :discount
- field_name = "#{param_prefix}[preferred_#{key}]"
= text_field_tag "#{param_prefix}[category_ids_string]", promotion_action.category_ids_string, :class => "ddb-select2",  data: { url: backend_shop_branch_categories_path(@current_shop, @current_branch), saved: promotion_action.categories.map(&:select_json) }, placeholder: "请选择分类"
%br/
.col-sm-3
  = label_tag field_name, '折扣'
.input-group.col-sm-3
  = text_field_tag(field_name, promotion_action.get_preference(key), type: promotion_action.preference_type(key), class: 'form-control')
  .input-group-addon %
