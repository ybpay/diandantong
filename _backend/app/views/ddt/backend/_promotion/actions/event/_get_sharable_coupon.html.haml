- field_name = "#{param_prefix}[abstract_coupon_version_id]"
.col-sm-3
  = label_tag field_name, I18n.t("promotion.actions.events.coupon_version")
.col-sm-3.input-group
  = select_tag field_name, options_from_collection_for_select(@current_shop.coupon_versions, :id, :name, selected: promotion_action.coupon_version.try(:id)), include_blank: true
.clearfix
.space
- key = :coupon_count
- field_name = "#{param_prefix}[preferred_#{key}]"
.col-sm-3
  = label_tag field_name, I18n.t("promotion.actions.events.#{key}")
.col-sm-3.input-group
  = preference_field_tag(field_name, promotion_action.get_preference(key), type: promotion_action.preference_type(key))
