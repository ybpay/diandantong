.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      %h2 促销动作
      %p
        - if @promotion_type == :order_promotion
          动作指的是一种满减优惠的结果， 当订单满足条件时，动作的设置将会生效，如免配送费、价格的调整等操作
        - elsif @promotion_type == :event_promotion
          动作指的是一种免赠优惠的结果， 当满足条件时，动作的设置将会生效，如积分的赠送、优惠券赠送等操作
    .ibox-content
      .col-sm-12.col-md-9.col-lg-6
        = form_tag [:backend, @current_shop, @promotion.branch, @promotion, :promotion_actions].compact, remote: true, class: 'form-horizontal' do
          .form-inputs
            .form-group
              = label_tag :'promotion_action[type]', '新增动作类型', class: 'col-sm-2 control-label'
              .col-sm-6
                = select_tag :'promotion_action[type]', options_for_promotion_action_types(@promotion), class: 'form-control'
              .col-sm-2
                - if options_for_promotion_action_types(@promotion).length > 0
                  = button_tag '添加此动作', class: 'btn btn-success'
        .header
          %h4 已添加促销动作
        .clearfix
        .hr-line-dashed
        = form_for [:backend, @current_shop, @promotion.branch, @promotion].compact, :method => :put, class: 'form-horizontal' do |f|
          .promotion-policy-select
          #actions.ddb-fields-list.form-inputs
            - if @promotion.actions.any?
              = render partial: 'ddt/backend/_promotion/promotion_action', collection: @promotion.actions, locals: { promotion: @promotion }
            - else
              .no-objects-found
                暂无动作
          .form-actions.col-sm-offset-4
            = button_tag '保存', class: 'btn btn-primary'
      .clearfix
