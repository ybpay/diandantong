.ddb-field-column
  - field_name = "#{param_prefix}[calculator_type]"
  .ddb-field-column-line
    = label_tag field_name, I18n.t("calculator")
    = select_tag field_name, option_for_calculator_types(promotion_action), onchange: "var adp = $(this).closest('.ddb-field-content'); $('.ddb-field-warning-info', adp).removeClass('hide'); $('.ddb-calculator-fields', adp).remove();$('.ddb-field-hint', adp).addClass('hide');"
    %br/
    %span.ddb-field-hint
      = calculator_hint(promotion_action.calculator)
  - if promotion_action.calculator.respond_to?(:preferences)
    %span.ddb-field-warning-info.hide
      = I18n.t("calculator_settings_warning")
.ddb-field-column.ddb-calculator-fields
  - unless promotion_action.new_record?
    - type_name = promotion_action.calculator.type.demodulize.underscore
    - if lookup_context.exists?(type_name, ["ddt/backend/_promotion/calculators"], true)
      - partial_name = "/ddt/backend/_promotion/calculators/#{type_name}"
    - else
      - partial_name = "/ddt/backend/_promotion/calculators/default"
    = render partial_name, calculator: promotion_action.calculator, prefix: param_prefix
    = hidden_field_tag "#{param_prefix}[calculator_attributes][id]", promotion_action.calculator.id