
.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{action_name == 'new' ? '新建' : '编辑' }#{t("activerecord.models.ddt/#{@promotion_type}")}"
    %p.text-navy
      = "新建#{t("activerecord.models.ddt/#{@promotion_type}")}成功后, 还需进行规则和动作的设置"

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      = simple_form_for([:backend, @current_shop, @promotion.branch, @promotion].compact, html: { class: 'form-horizontal'}, wrapper: :horizontal_form_long) do |f|
        = f.error_notification :message => error_message_in_html(@promotion)
        .col-sm-12.col-md-9.col-lg-6
          .form-inputs
            = f.input :name
            = f.input :keywords
            = f.input :show_on_index
            .col-sm-offset-4
              = f.input_field :enable_on_monday
              = f.label :enable_on_monday
              = f.input_field :enable_on_tuesday
              = f.label :enable_on_tuesday
              = f.input_field :enable_on_wednesday
              = f.label :enable_on_wednesday
              = f.input_field :enable_on_thursday
              = f.label :enable_on_thursday
              = f.input_field :enable_on_friday
              = f.label :enable_on_friday
              = f.input_field :enable_on_saturday
              = f.label :enable_on_saturday
              = f.input_field :enable_on_sunday
              = f.label :enable_on_sunday
            = f.input :starts_at
            = f.input :expires_at
            - if @promotion.in_shop?
              = f.input :branch_scope_policy, collection: Ddt::Promotion.branch_scope_policy_collection
              .match-branches-inputs{ style: ('display:none;' if @promotion.is_match_all_branches?)}
                = f.input :branch_ids_string, input_html: { data: { url: backend_shop_branches_path(@current_shop, multiple: true), saved: @promotion.branches.map(&:select_json), placeholder: "请选择适用门店" }, class: 'ddb-select2'}
              = f.input :usage_limit, hint: '不填写则没有名额数量限制'
              = f.input :image, as: :image_preview, hint: '推荐图片尺寸为720×270'
              = f.input :hide_header_in_weixin
            = f.input :description, :as => :text, :label_html => {class: 'col-sm-2'}, :input_html => { rows: 5 }
        .clearfix
        .col-sm-6
          .form-actions
            .col-sm-offset-4
              = f.button :submit, :class => "btn btn-primary"

:javascript
  $(document).ready(function() {
    $('##{@promotion_type}_branch_scope_policy').change(function(){
      var policy = $('##{@promotion_type}_branch_scope_policy').val()
      if(policy === 'match_all_branches'){
        $('.match-branches-inputs').hide()
      }else{
        $('.match-branches-inputs').show()
      }
    })
  });


