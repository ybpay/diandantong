.header
  %h3= "#{t('activerecord.models.ddt/exchange_code')} 列表"

.tip.alert.alert-info
  %strong
    温馨提示
  %p
    使用二维码验券功能， 请在
    = link_to "账户设置里", backend_shop_accounts_path(@current_shop), target: '_blank'
    为您的帐号绑定微信用户，再登录您绑定的微信用户，扫描用户提供的二维码进行二维码验券

.form-group
  = search_form_for @q, url: backend_shop_exchange_codes_path(@current_shop), html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
    = f.input_field :code_eq, placeholder: Ddt::ExchangeCode.human_attribute_name(:code)
    = f.submit "搜索", class: 'btn btn-sm btn-success'

%table.table.table-striped.table-bordered
  %thead
    %tr
      %th.col-sm-1= sort_link(@q, :code, Ddt::ExchangeCode.human_attribute_name(:code))
      %th.col-sm-1= sort_link(@q, :state, Ddt::ExchangeCode.human_attribute_name(:state))
      %th.col-sm-2= sort_link(@q, :created_at, Ddt::ExchangeCode.human_attribute_name(:created_at))
      %th.col-sm-4= Ddt::ExchangeCode.human_attribute_name(:exchangeable)
      %th

  %tbody
    - if @q.code_eq.present? or @current_account.is_admin? or @current_account.is_boss?
      = render partial: "table_tr", collection: @exchange_codes, as: :exchange_code
    - else
      %tr
        %td{ colspan: 5 }
          请输入兑换码查询

- if @q.code_eq.present? or @current_account.is_admin? or @current_account.is_boss?
  %br
  .pull-right= will_paginate @exchange_codes , renderer: BootstrapPagination::Rails, bootstrap: 3
  %br