- if event.present? && event.id.present?

  - if event.is_system_keyword
    系统动作：
    = Ddt::Event::system_keyword_name(event.system_keyword_with_prefix.to_sym)
  - elsif event.material.present?
    素材：
    = event.material.material_name
    = link_to tag(:icon,:class=>"fa fa-eye"), backend_shop_material_path(@current_shop,event.material), title:'查看该素材',remote: true
  %br
  %br
  = link_to '编辑', edit_backend_shop_event_path(@current_shop, event), remote: true
  = link_to '删除', [:backend, @current_shop, event], :method => :delete, :data => { :confirm => '确定删除?' }, remote: true

- else
  .form-group
    该项还未配置
    = link_to "配置", new_event_path_with_type(event_type), :class=>"btn btn-primary btn-sm", remote: true

.config_once_event_form
.clearfix
