.ibox
  .ibox-title
    %h4
      未匹配关键字时回复以下内容

  .ibox-content
    .col-md-12
      .unmatch_event_show
        - event = @unmatch_keyword_event
        = render 'config_once_event_show', {event: event, event_type: 'unmatch'}
    .clearfix


.ibox
  .ibox-title
    .form-group
    = link_to "关键词自动回复配置", new_event_path_with_type('keyword_autoreply'), :class=>"btn btn-primary btn-sm", remote: true
  .ibox-content
    .keyword_events_show
    = render 'ddt/backend/events/keyword_events_show'


