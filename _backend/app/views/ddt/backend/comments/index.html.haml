.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/comment')} 列表"

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        %table.table.table-striped.table-bordered.comments
          %thead
            %tr
              %th.col-sm-1= sort_link(@q, :user, Ddt::Comment.human_attribute_name(:user))
              %th.col-sm-1= sort_link(@q, :commentable_type, Ddt::Comment.human_attribute_name(:commentable_type))
              %th.col-sm-3= sort_link(@q, :content, Ddt::Comment.human_attribute_name(:content))
              %th.col-sm-1= sort_link(@q, :rating, Ddt::Comment.human_attribute_name(:rating))
              %th.col-sm-1= sort_link(@q, :state, Ddt::Comment.human_attribute_name(:state))
              %th.col-sm-3= Ddt::Comment.human_attribute_name(:comment)
              %th

          %tbody
            =render partial: 'tr', :collection => @comments, :as => :comment
            = no_record_hint(@comments)

        %br
        .pull-right= will_paginate @comments , renderer: BootstrapPagination::Rails, bootstrap: 3
        %br
