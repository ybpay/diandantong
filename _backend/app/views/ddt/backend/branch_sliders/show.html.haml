
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox
    .ibox-title
      %h2= "#{t('activerecord.models.ddt/branch_slider')} 详情"
    .ibox-content
      %p
        %b
          = Ddt::BranchSlider.human_attribute_name(:img)
          \:
        = image_tag @branch_slider.img.medium.url, width: 360
      %p
        %b
          = Ddt::BranchSlider.human_attribute_name(:url)
          \:
        = @branch_slider.url


      = link_to t('Edit'), edit_backend_shop_branch_slider_path(@current_shop, @branch_slider), :class => "btn btn-primary"
      \
      = link_to t('Back'), backend_shop_branch_sliders_path(@current_shop), :class => "btn btn-default"
