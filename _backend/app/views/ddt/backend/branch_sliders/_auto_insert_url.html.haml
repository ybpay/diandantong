- querys = {} unless querys.present?
.btn-group
  %button.btn.btn-success.btn-sm.dropdown-toggle{type: "button", data: {toggle: "dropdown"}}
    自动插入
    %span.caret
  %ul.dropdown-menu
    %li
      %a.clearfix.insert_article{href: "#"} 插入文章
    %li.dropdown-submenu
      %a.clearfix.main-menu-item{href: "#"} 微信页面
      %ul.dropdown-menu.dropdown-success.submenu-pull-right
        - if @current_shop.multi_branch?
          %li.dropdown-submenu
            %a.clearfix.main-menu-item.auto-insert-url{href: "#", :'data-url'=> delivery_branches_link(querys)} 外卖门店
            %ul.dropdown-menu.dropdown-success.submenu-pull-right
              = render 'ddt/backend/shops/menu', links: delivery_branches_by_tag_links(querys)
          %li.dropdown-submenu
            %a.clearfix.main-menu-item.auto-insert-url{href: "#", :'data-url'=> branches_link(querys)} 全部门店
            %ul.dropdown-menu.dropdown-success.submenu-pull-right
              = render 'ddt/backend/shops/menu', links: branches_by_tag_links(querys)

        = render 'ddt/backend/shops/menu', links: shop_links(querys).reject {|item| ['外卖门店','全部门店'].include? item[:name]}
    %li.divider
    - @current_shop.branches.each do |branch|
      %li.dropdown-submenu
        %a.clearfix.main-menu-item{href: "#"} #{branch.name} 门店网址

        %ul.dropdown-menu.dropdown-success.submenu-pull-right
          = render 'ddt/backend/shops/menu', links: branch_links(branch, querys)
:javascript
  $(function(){
    $('.insert_article').unbind();
    $('.insert_article').click(function(event){
      bootbox.alert("#{ j render '/ddt/backend/branch_sliders/insert_article', {input_field_id: input_field_id, version: version, querys: querys}}");
      return false;
    });

    $('.auto-insert-url').click(function(event) {
      event.preventDefault(event);
      $('##{input_field_id}').val($(event.target).data('url'));
      return false;
    });
    // 移除链接的默认点击行为。
    $('.main-menu-item').click(function(event) {
      return false;
    });
  });

