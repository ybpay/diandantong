.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/branch_slider')} 列表"

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        = link_to "新建 #{t('activerecord.models.ddt/branch_slider')}", new_backend_shop_branch_slider_path(@current_shop), :class=>"btn btn-primary"

  .row
    .col-lg-12
      .ibox
        .ibox-content
          = render partial: 'ddt/backend/branch_sliders/table', locals: { branch_sliders: @branch_sliders}

          %br
          .pull-right= will_paginate @branch_sliders , renderer: BootstrapPagination::Rails, bootstrap: 3
          %br
