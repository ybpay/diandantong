.form-group
  = link_to "新建 #{t('activerecord.models.ddt/one_page')}", new_backend_shop_one_page_path(@current_shop), :class=>"btn btn-primary btn-sm"

= render partial: 'ddt/backend/one_pages/table', locals: { one_pages: @one_pages}
