.header
  %h3= "#{t('activerecord.models.ddt/voucher')} 详情"
.model-show
  %p
    %b
      = Ddt::Voucher.human_attribute_name(:base_user)
      \:
    = base_user_label(@voucher.base_user)
  %p
    %b
      = Ddt::Voucher.human_attribute_name(:voucher_version)
      \:
    = @voucher.voucher_version.name
  %p
    %b
      = Ddt::Voucher.human_attribute_name(:coupon_no)
      \:
    = @voucher.coupon_no
  %p
    %b
      = Ddt::Voucher.human_attribute_name(:expires_at)
      \:
    = @voucher.expires_at
  %p
    %b
      = Ddt::Voucher.human_attribute_name(:applied_at)
      \:
    = @voucher.applied_at
  %p
    %b
      = Ddt::Voucher.human_attribute_name(:shop)
      \:
    = @voucher.shop.name
  %p
    %b
      = Ddt::Voucher.human_attribute_name(:branches)
      \:
    = @voucher.branch_names
  .space
\
= link_to t('Back'), backend_shop_vouchers_path(@current_shop), :class => "btn btn-default btn-sm"
