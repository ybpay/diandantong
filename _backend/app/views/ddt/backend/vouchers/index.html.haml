.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/voucher')} 列表"
    .form-group
      = search_form_for @q, url: [:backend, @current_shop, :vouchers], method: :get, html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
        = f.select :applying_refund_eq , options_for_select([['所有订单',nil], ['申请中',true]],@q.applying_refund_eq), {}, class: 'form-control'
        = f.submit '搜索', class: 'btn btn-success'

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        %table.table.table-striped
          %thead
            %tr
              %th.col-sm-2= sort_link(@q, :voucher_version, Ddt::Voucher.human_attribute_name(:voucher_version))
              %th.col-sm-1 面值
              %th.col-sm-1 售价
              %th.col-sm-1= sort_link(@q, :expires_at, Ddt::Voucher.human_attribute_name(:expires_at))
              %th.col-sm-1= sort_link(@q, :applied_at, Ddt::Voucher.human_attribute_name(:applied_at))
              %th.col-sm-1= sort_link(@q, :base_user, Ddt::Voucher.human_attribute_name(:base_user))
              %th.col-sm-1= sort_link(@q, :applying_refund, '退款通知')
              %th.col-sm-1= Ddt::Voucher.human_attribute_name(:refund_at)
              %th.col-sm-1 对应订单
              %th.col-sm-2

          %tbody
            - @vouchers.each do |voucher|
              %tr
                %td= voucher.voucher_version.name
                %td= voucher.voucher_version.norminal_value
                %td= voucher.voucher_version.groupon_price
                %td= voucher.expires_at
                %td= voucher.applied_at
                %td= base_user_label(voucher.base_user)
                %td
                  - if voucher.applying_refund
                    申请中
                  - elsif voucher.refund_at.present?
                    已通过
                %td= voucher.refund_at
                %td
                  = link_to(voucher.bought_from_order.number, backend_shop_order_path(@current_shop, voucher.bought_from_order), target: :_blank) rescue ''
                %td
                  = info_btn(voucher)
                  - if voucher.can_refund?
                    = link_to '退款', refund_backend_shop_voucher_path(@current_shop, voucher), class: 'btn btn-xs btn-danger', data: {confirm: '警告: 当前系统不负责资金的回退，您需要自行退还消费者相应金额. 确定退掉该代金券？'}, method: :post
            = no_record_hint(@vouchers)
        %br
        .pull-right= will_paginate @vouchers , renderer: BootstrapPagination::Rails, bootstrap: 3
        %br
