.ibox  
  .ibox-title
    %h2= "#{t("activerecord.models.#{@model_class.to_s.underscore}")} 列表"
  .ibox-content.m-b-sm.border-bottom

    .form-group
      = search_form_for @q, url: backend_shop_payments_path(@current_shop), html: {class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
        = f.input_field :order_id_eq, as: :string, placeholder: Ddt::Payment.human_attribute_name(:order_number), value: @order_number, class: "form-control"
        = f.input_field :created_at_gteq, as: :date, placeholder: Ddt::Payment.human_attribute_name(:created_at), class: "form-control"
        = f.input_field :created_at_lteq, as: :date, placeholder: Ddt::Payment.human_attribute_name(:created_at), class: "form-control"
        = f.input_field :branch_id_eq, collection: @branches, include_blank: true, prompt: Ddt::Payment.human_attribute_name(:branch), class: "form-control"
        = f.input_field :workflow_state_eq, collection: Ddt::Payment.workflow_state_collection, include_blank: true, prompt: Ddt::Payment.human_attribute_name(:workflow_state), class: "form-control"
        = f.input_field :payment_method_type_cont, collection: Ddt::PaymentMethod.method_type_collection, include_blank: true, prompt: Ddt::Payment::human_attribute_name(:payment_method), class: "form-control"


        = f.submit "搜索", class: "btn btn-sm btn-success"
  .ibox-content
    %table.table.table-striped
      %thead
        %tr
          - show_for nil, @model_class do
            - attr_tab_head :branch, sort_link: true
            - attr_tab_head :order_id
            - attr_tab_head :amount, :workflow_state, :payment_method, sort_link: true
            - attr_tab_head :out_trade_no
            - attr_tab_head :created_at, sort_link: true
            - attr_tab_head :deleted_at
          %th
      %tbody.branches_tbody
        - @payments.include_order.each do |payment|
          %tr
            - show_for payment do
              %td= payment.branch.name
              - order = payment.order
              %td=(link_to order.number, [:backend, @current_shop, order.branch, order]) rescue nil
              %td= payment.amount_in_currency
              %td= payment.workflow_state_name
              %td= payment.payment_method.try(:name)
              - attr_tab_column :out_trade_no, :created_at, :deleted_at
              %td
                = simple_info_btn payment
        = no_record_hint(@payments)
    %br
    .pull-right= will_paginate @payments , renderer: BootstrapPagination::Rails, bootstrap: 3
    %br

