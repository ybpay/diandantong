.ibox
  .ibox-title
    %h3= "编辑#{t("activerecord.models.ddt/#{@model_name}")}"
  .ibox-content
    .alert.alert-info
      %p 设置帮助：
      %p 1. 初次设置请从审核通过邮件里找 门店号 和 百付宝合作密钥。
    .col-sm-6
      = simple_form_for(@payment_method, :url => [:backend, @current_shop, :baidupay_methods], html: { class: 'form-horizontal'}) do |g|
        - g.with_options disabled: (disabled rescue nil) do |f|
          = f.error_notification :message => error_message_in_html(@payment_method)
          .form-inputs
            = f.input :name, readonly: true
            = f.input :description
            = f.input :active
            = f.input :preferred_sp_no
            = f.input :preferred_key
          .form-actions
            = f.button :submit, :class => 'btn btn-primary btn-sm'
    .clearfix
