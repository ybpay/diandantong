.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/baidupay_method')} 详情"
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      .ibox
        .ibox-content
          - show_for @payment_method do
            - show_simple_attr :name, :description
            - show_simple_attr :active do
              = @payment_method.active ? '是' : '否'
            - [:sp_no, :key].each do |it|
              - show_simple_attr "preferred_#{it}".to_sym
            .space

          = simple_edit_link(:baidupay_methods)

