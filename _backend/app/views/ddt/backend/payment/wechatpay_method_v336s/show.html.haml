.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t("activerecord.models.#{@model_class.to_s.underscore}")} 详情"
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      .ibox
        .ibox-content
          - show_for @payment_method do
            - show_simple_attr :name, :description
            - show_simple_attr :active do
              = @payment_method.active ? '是' : '否'
            - if @payment_method.active?
              - show_simple_attr :preferred_sl_mode do
                = @payment_method.active_sl_mode? ? '是' : '否'
              - if @payment_method.active_non_sl_mode?
                - %w(gonghao_open_id appid appSecret mch_id paySignKey).each do |key|
                  - show_simple_attr "preferred_#{key}"
              - else
                - %w(sub_appid sub_mch_id).each do |key|
                  - show_simple_attr "preferred_#{key}"
            .space

          = simple_edit_link(@model_class)
