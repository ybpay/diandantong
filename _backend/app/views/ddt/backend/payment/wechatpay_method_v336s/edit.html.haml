.ibox
  .ibox-title
    %h2.inline= "编辑#{t("activerecord.models.#{@model_class.to_s.underscore}")}"
    = link_to '切换到 2.7 版本', [:switch_version, :backend, @current_shop, @model_class], class: 'btn btn-primary'
    .vspace-10
  .ibox-content
    .alert.alert-info
      %p 当前微信支付版本为3.3.6，适用于2014年9月23日后申请的微信支付。
      %p 设置帮助：
      %p 1. 原始ID从微信公众账号后台（后面简称为'微信后台'）公众号设置获得
      %p 2. appid, appSecret 从微信后台开发者中心获得
      %p
        3. 在微信后台 -> 开发者中心 -> 高级接口中修改OAuth2.0网页授权的授权回调页面域名为
        = Ddt::Host::DEPLOY
      %p 4. 商户ID 从微信后台 -> 微信支付 -> 商户信息获得，对应名称为财付通商户号
      %p 5. paySignKey 为登陆财付通商户后台，进入密码安全 -> API 安全，设置API密钥。
      %p
        6. 在微信后台 -> 微信支付配置支付授权目录为
        = "http://#{Ddt::Host::DEPLOY}/weixin/shops/"
      %p
        7. 告警URL为
        = "http://#{Ddt::Host::DEPLOY}/oapi/v1/payments/warning"
      %p
        8. 反馈URL为
        = "http://#{Ddt::Host::DEPLOY}/oapi/v1/payments/feedback"

   
    = simple_form_for(@payment_method, :url => polymorphic_path([:backend, @current_shop, @model_class]), :html => { class: 'form-horizontal'}) do |g|
      - g.with_options disabled: (disabled rescue nil) do |f|
        = f.error_notification :message => error_message_in_html(@payment_method)
        .form-inputs
          .col-sm-6
            = f.input :name, readonly: true
            - [:description, :active].each do |attr|
              = f.input attr
            = f.input :preferred_sl_mode, as: :boolean, hint: '服务商模式是指由服务商代理申请的微信支付账号'
            = f.input :preferred_custom_sl_mode, as: :boolean, hint: '非系统默认服务商需要填写代理商参数'
          .col-sm-6
            - @model_class.all_preference_getters.reject{|it| [:preferred_sl_mode, :preferred_custom_sl_mode].include? it}.each do |attr|
              = f.input attr
        .form-actions
          .col-sm-6
            .col-xs-offset-4
              = f.button :submit, :class => 'btn btn-primary btn-sm'
        .clearfix

    

:javascript
  $(function(){
    function update_inputs(){
      var active_sl = $("#wechatpay_method_v336_preferred_sl_mode").prop("checked");
      var custom_sl = $("#wechatpay_method_v336_preferred_custom_sl_mode").prop("checked");
      if (active_sl){
        $("#wechatpay_method_v336_preferred_custom_sl_mode").closest(".form-group").show();
      } else {
        $("#wechatpay_method_v336_preferred_custom_sl_mode").closest(".form-group").hide();
      }

      if (active_sl){
        $(["sub_appid", "sub_mch_id", "custom_sl_mode"]).each(function(i,e){
          $("#wechatpay_method_v336_preferred_" + e).closest(".form-group").show();
        });
        if (custom_sl){
          $(["gonghao_open_id","appid","appSecret","mch_id","paySignKey"]).each(function(i,e){
            $("#wechatpay_method_v336_preferred_" + e).closest(".form-group").show();
          });
        } else {
          $(["gonghao_open_id","appid","appSecret","mch_id","paySignKey"]).each(function(i,e){
            $("#wechatpay_method_v336_preferred_" + e).closest(".form-group").hide();
          });
        }
      } else {
        $(["sub_appid", "sub_mch_id", "custom_sl_mode"]).each(function(i,e){
          $("#wechatpay_method_v336_preferred_" + e).closest(".form-group").hide();
        });
        $(["gonghao_open_id","appid","appSecret","mch_id","paySignKey"]).each(function(i,e){
          $("#wechatpay_method_v336_preferred_" + e).closest(".form-group").show();
        });
      }
    }
    update_inputs();
    $("#wechatpay_method_v336_preferred_sl_mode").on("change", update_inputs)
    $("#wechatpay_method_v336_preferred_custom_sl_mode").on("change", update_inputs)
  });

