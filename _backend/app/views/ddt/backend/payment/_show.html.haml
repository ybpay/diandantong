-#
-# 通用资源显示页
-#
- model_name = @model_name
- model_class = @model_class
- model_columns = model_columns || []
-# model_object
- back_button = true if back_button.nil?
- is_singleton = false if is_singleton.nil?
- crud_url = crud_url || {}
- crud_url[:index] = send("backend_shop_#{model_name.pluralize}_path",@current_shop) if crud_url[:index].nil? rescue nil
- crud_url[:edit] = [:edit, :backend, @current_shop, is_singleton ? model_class : model_object] if crud_url[:edit].nil? rescue nil

.header
  %h3= "#{t("activerecord.models.ddt/#{model_name}")} 详情"
.model-show
  - model_columns.each do |column|
    - column_name = column.is_a?(Array) ? column[0] : column
    %p
      %b
        = model_class.human_attribute_name(column_name)
        \:
      - if column.is_a?(Array)
        = column[1].call(model_object)
      - else
        = model_object.send(column)
  .space

= link_to t('Edit'), crud_url[:edit], :class => "btn btn-primary btn-sm"

- if back_button
  \
  = link_to t('Back'), crud_url[:index], :class => "btn btn-default btn-sm"