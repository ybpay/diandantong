= simple_form_for([:backend, @current_shop, @pay_method], html: { class: 'form-horizontal'}) do |f|
  = f.error_notification :message => error_message_in_html(@pay_method)

  .form-inputs
    .col-sm-6
      = f.input :name, disabled: @pay_method.builtin?
    .clearfix
    .col-sm-6
      = f.input :code
    .col-sm-6
      = f.input :enable
    .clearfix
    .col-sm-6
      - if 'vip_card_pay' != @pay_method.name_sym
        = f.input :percent_of_actual, hint: '100%记作100, 若非实收请填写0，若全为实收请填写100， 若部分实收请填写百分比(如: 实收占80%，则填写80 )'
      - else
        = f.input :percent_of_actual, hint: '会员卡（实收百分比参数为 100%, 系统自动将会员卡附属账户的消费计为非实收)', disabled: true
    .col-sm-6
      = f.input :enable_negative, disabled: @pay_method.cannot_change_enable_negative?
    .clearfix

    .col-sm-6
      .col-sm-offset-4
        = f.input_field :support_delivery
        = f.label :support_delivery
        = f.input_field :support_eat_in_hall
        = f.label :support_eat_in_hall
        = f.input_field :support_fastfood
        = f.label :support_fastfood
        = f.input_field :support_reservation
        = f.label :support_reservation
        = f.input_field :support_groupon
        = f.label :support_groupon
        = f.input_field :support_recharge
        = f.label :support_recharge
        = f.input_field :support_payment
        = f.label :support_payment
  .form-actions.col-sm-offset-4
    = f.button :submit, :class => "btn btn-primary btn-sm"
