%h3 付款方式设置
.alert.alert-warning
  提示：
  %span 只有系统和门店都设置支持时，付款方式才有效
= simple_form_for @current_shop, url: [:update_all, :backend, @current_shop, :pay_method_settings], method: :put do |f|
  %table.table.table-striped.table-bordered
    %thead
      %tr
        %th.col-sm-1
        %th.col-sm-1 积分抵扣
        %th.col-sm-1 余额抵扣
        %th.col-sm-1 支付宝
        %th.col-sm-1 微信支付
        %th.col-sm-1 百度钱包
        %th.col-sm-1 现金结账
        %th.col-sm-1 到店付款
        %th.col-sm-1 货到付款
        %th.col-sm-1 会员卡支付
        %th.col-sm-1 银行卡
    %tbody
      %tr
        %td 外卖
        = f.fields_for :delivery_pay_method_setting do |sf|
          %td= sf.input_field :can_credits_deduction
          %td= sf.input_field :can_card_deduction
          %td= sf.input_field :can_alipay
          %td= sf.input_field :can_wechatpay
          %td= sf.input_field :can_baidupay
          %td
          %td
          %td= sf.input_field :can_pay_on_receive
          %td= sf.input_field :can_vip_card_pay
          %td= sf.input_field :can_bank_card_pay
      %tr
        %td 堂点
        = f.fields_for :eat_in_hall_pay_method_setting do |sf|
          %td= sf.input_field :can_credits_deduction
          %td= sf.input_field :can_card_deduction
          %td= sf.input_field :can_alipay
          %td= sf.input_field :can_wechatpay
          %td= sf.input_field :can_baidupay
          %td= sf.input_field :can_pay_on_face
          %td
          %td
          %td= sf.input_field :can_vip_card_pay
          %td= sf.input_field :can_bank_card_pay
      %tr
        %td 快餐
        = f.fields_for :fastfood_pay_method_setting do |sf|
          %td= sf.input_field :can_credits_deduction
          %td= sf.input_field :can_card_deduction
          %td= sf.input_field :can_alipay
          %td= sf.input_field :can_wechatpay
          %td= sf.input_field :can_baidupay
          %td= sf.input_field :can_pay_on_face
          %td
          %td
          %td= sf.input_field :can_vip_card_pay
          %td= sf.input_field :can_bank_card_pay
      %tr
        %td 预订
        = f.fields_for :reservation_pay_method_setting do |sf|
          %td= sf.input_field :can_credits_deduction
          %td= sf.input_field :can_card_deduction
          %td= sf.input_field :can_alipay
          %td= sf.input_field :can_wechatpay
          %td= sf.input_field :can_baidupay
          %td
          %td= sf.input_field :can_pay_on_arrive
          %td
          %td= sf.input_field :can_vip_card_pay
          %td= sf.input_field :can_bank_card_pay
      %tr
        %td 团购
        = f.fields_for :groupon_pay_method_setting do |sf|
          %td= sf.input_field :can_credits_deduction
          %td= sf.input_field :can_card_deduction
          %td= sf.input_field :can_alipay
          %td= sf.input_field :can_wechatpay
          %td= sf.input_field :can_baidupay
          %td
          %td
          %td
          %td= sf.input_field :can_vip_card_pay
          %td
      %tr
        %td 充值
        = f.fields_for :recharge_pay_method_setting do |sf|
          %td= sf.input_field :can_credits_deduction
          %td
          %td= sf.input_field :can_alipay
          %td= sf.input_field :can_wechatpay
          %td
          %td
          %td
          %td
          %td
      %tr
        %td 买单
        = f.fields_for :payment_pay_method_setting do |sf|
          %td
          %td
          %td= sf.input_field :can_alipay
          %td= sf.input_field :can_wechatpay
          %td= sf.input_field :can_baidupay
          %td
          %td
          %td
          %td= sf.input_field :can_vip_card_pay
          %td


  = f.submit "更新", class: 'btn btn-primary'
