:scss
  .metro-modal{
    .modal-body {
      padding: 0;
    }
    .modal-body-table {
      display: table;
      width: 100%;
      height: 100%;
    }
    .modal-body-row {
      display: table-row;
      .feature-block {
        display: table-cell !important;
        width: 1%;
      }
    }

    .feature-icon {
      min-height: 120px;
    }
  }
  #dashboard-panel {
    height: 500px;
    background-color: white;
    color: white !important;
    padding: 0px;
    margin: 5%;
  }
  #dashboard-panel, .metro-modal {
    .metro-orange {
      background-color: #f7630c;
    }
    .metro-yellow {
      background-color: #ffb900;
    }
    .metro-blue {
      background-color: #00b7c3;
    }
    .metro-green {
      background-color: #60a917;
    }
    .metro-gray {
      background-color: #647687 !important;
      opacity: 0.5;
    }
    .feature-block:hover {
      opacity: 0.5;
    }

    a.feature-block {
      display: block;
      text-decoration: none;
      color: white;
    }
    .feature-block {
      box-sizing: border-box;
      border: 4px solid white;
      padding: 20px 0 40px 0;
      height: 100%;
      padding-bottom: 40px;
      .feature-icon {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100%;
        i {
          font-size: 4em;
        }
      }
      .feature-text {
        float: right;
        width: 100%;
        line-height: 25px;
        font-size: 16px;
        padding: 5px 10px 10px 10px;
        margin-bottom: -40px;
      }
    }
    #left-panel, #center-panel, #right-panel {
      width: 33.3333%;
      float: left;
      height: 100%;
    }

    .top, .middle, .bottom {
      height: 33.33%;
    }

    .recharge-hint {
      padding: 0px 10px;
      line-height: 20px;
      padding: 0px 10px;
      font-size: 14px;
      margin-top: -20px;
    }

    .left, .right {
      float: left;
      width: 50%;
      height: 100%;
    }
    .clear {
      clear: both;
    }
  }
