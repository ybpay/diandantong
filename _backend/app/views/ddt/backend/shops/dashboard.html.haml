#wechat-modal.metro-modal.modal.fade{:tabindex=>"-1", :role=>"dialog", :"aria-labelledby"=>"微信餐厅"}
  .modal-dialog{:role=>"document"}
    .modal-content
      .modal-body
        .modal-body-table
          - dashboard_wechat_menus.each do |menus|
            .modal-body-row
              %a.feature-block{href: has_module?(menus[0][:feature_module]) ? home_backend_shop_path(@current_shop, menu_group: menus[0][:feature_module]) : '#', class: has_module?(menus[0][:feature_module]) ? "metro-#{menus[0][:color]}" : 'metro-gray'}
                .feature-icon
                  %i{:class => "fa fa-#{menus[0][:icon]}"}
                .feature-text= menus[0][:name]
                .clear
              -if menus[1].present?
                %a.feature-block{href: has_module?(menus[1][:feature_module]) ? home_backend_shop_path(@current_shop, menu_group: menus[1][:feature_module]) : '#', class: has_module?(menus[1][:feature_module]) ? "metro-#{menus[1][:color]}": 'metro-gray'}
                  .feature-icon
                    %i{:class => "fa fa-#{menus[1][:icon]}"}
                  .feature-text= menus[1][:name]
                  .clear

