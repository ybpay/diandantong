.header
  %h3= "编辑#{Ddt::Shop.human_attribute_name(:search_words)}"


= simple_form_for([:update_search_word, :backend, @shop], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@shop)
    .form-inputs
      = f.input :search_words, placeholder: '例如： 肯德基 海底捞', hint: '多个搜索关键词请用空格符号分开'
      = f.button :submit, :class => "btn btn-primary btn-sm"
= link_to t('Show'), [:show_search_word, :backend, @shop], :class => "btn btn-default btn-sm"
