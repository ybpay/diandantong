.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/shop')} 列表"
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        = search_form_for @q, url: backend_shops_path, html: {role: 'form'}, builder: SimpleForm::FormBuilder do |f|
          .form-group.form-inline
            = f.input_field :city_code_start, style: "display: none;"
            .city-group
              %select.city-select.form-control
                %option{value: ""}
                  %span -- 省份 --
                = options_for_select(ChinaCity.list)
              %select.city-select.form-control
                %option{value: ""}
                  %span -- 城市 --
              %select.city-select.form-control
                %option{value: ""}
                  %span -- 地区 --
          .form-inline.form-group
            = f.input_field :is_suspicious_eq, collection: [['可疑商户', true], ['正常商户', false]], allow_blank: true, class: 'form-control'
            = f.input_field :name_cont,    placeholder: Ddt::Shop.human_attribute_name(:name), class: 'form-control'
            = f.input_field :slug_cont,    placeholder: Ddt::Shop.human_attribute_name(:slug), class: 'form-control'
            = f.input_field :service_email_or_accounts_email_cont,    placeholder: Ddt::Shop.human_attribute_name(:service_email), class: 'form-control'
            = f.input_field :is_open_cont, placeholder: Ddt::Shop.human_attribute_name(:is_open), class: 'form-control'
            = f.input_field :telephone_eq, placeholder: Ddt::Shop.human_attribute_name(:telephone), class: 'form-control'
          .form-inline.form-group
            = f.input_field :created_at_gteq, as: :date, placeholder: Ddt::Shop.human_attribute_name(:created_at), class: 'form-control'
            %label{style: 'font-size: 20px'} ~
            = f.input_field :created_at_lteq, as: :date, placeholder: Ddt::Shop.human_attribute_name(:created_at), class: 'form-control'
            = f.submit "搜索", class: 'btn btn-sm btn-success'

  .row
    .col-lg-12
      .ibox
        .ibox-content
          %table.table.table-striped
            %thead
              %tr
                %th.col-sm-1= sort_link(@q, :id, Ddt::Shop.human_attribute_name(:id))
                %th.col-sm-1= sort_link(@q, :slug, Ddt::Shop.human_attribute_name(:slug))
                %th.col-sm-1= sort_link(@q, :is_open, Ddt::Shop.human_attribute_name(:is_open))
                %th.col-sm-1= sort_link(@q, :expiration_time, Ddt::Shop.human_attribute_name(:expiration_time))
                %th.col-sm-1= sort_link(@q, :max_branches_limit, Ddt::Shop.human_attribute_name(:max_branches_limit))
                %th.col-sm-1= sort_link(@q, :telephone, Ddt::Shop.human_attribute_name(:telephone))
                %th.col-sm-1= sort_link(@q, :agent_no, Ddt::Shop.human_attribute_name(:agent_no))
                %th.col-sm-1= sort_link(@q, :created_at, Ddt::Shop.human_attribute_name(:created_at))
                %th.col-sm-1= sort_link(@q, :track_from, Ddt::Shop.human_attribute_name(:track_from))
                %th.col-sm-2= sort_link(@q, :address, Ddt::Shop.human_attribute_name(:address))
                %th

            %tbody
              - @shops.each do |shop|
                %tr
                  %td= shop.id
                  %td= "#{shop.slug}(#{shop.name})"
                  %td= shop.is_open_name
                  %td= shop.expiration_time.strftime("%F")
                  %td= shop.max_branches_limit
                  %td= shop.telephone
                  %td= shop.agent_no
                  %td= shop.created_at.strftime("%F %T")
                  %td= shop.track_from_name
                  %td
                    = shop.address
                    %br
                    = "#{shop.creator.try(:phone_address)}[手]"
                  %td
                    = link_to '详情', [:backend, shop]
                    = link_to '编辑', edit_backend_shop_path(shop)
              = no_record_hint(@shops)
          %br
          .pull-right= will_paginate @shops , renderer: BootstrapPagination::Rails, bootstrap: 3
          %br
          %button.btn.btn-primary{:data=>{:toggle=>"modal", :target=>"#export_accounts_modal"}}
            导出账户信息

          .modal.fade#export_accounts_modal
            .modal-dialog
              .modal-content
                .modal-header
                  %button.close{:type=>"button", :data => {:dismiss=>"modal"}, :"aria-hidden"=>true} &times;
                  %h4.modal-title 选择导出账户的时间
                .modal-body
                  = form_for :shop_create_time, url: export_accounts_backend_shops_path(format: :csv), method: :get, :class=>"form-vertical", builder: SimpleForm::FormBuilder  do |f|
                    = f.label "账户创建时间"
                    = f.input_field :start, as: :datetime, value: 1.day.ago.beginning_of_day
                    = f.input_field :end, as: :datetime, value: 1.day.ago.end_of_day
                    = f.input_field :is_paid_shop, as: :boolean
                    = f.submit '提交', class: 'btn btn-primary'
                .modal-footer
                  %button.btn.btn-default{:type=>"button", :data => {:dismiss=>"modal"}} 关闭

:javascript
  $(function () {
    $(".city-select").change(function() {
      var locations = $(".city-select option:selected").map(function(i, elem) {
        return $(elem).val().substr(i*2, 2);
      }).filter(function (i, elem) {
        return !(elem == null || elem == "");
      }).toArray();
      $('#q_city_code_start').val(locations.join(''));
    });
  });
