.ibox
  .ibox-title
    %h2 批量创建预订时间点

    .alert.alert-info
      %strong 温馨提示：
      %p
        系统会根据您填写的起始时间点，和创建间隔, 批量创建预订时间点。
        %br
        例如： 想要在 18:00 开始预订， 每隔30分钟创建一个预订时间点， 创建4个预订时间点。
        %br
        系统会创建: 18:00, 18:30, 19:00, 19:30 共4个时间点
  .ibox-content
    = simple_form_for(@batch_create_reservation_time_point_form, url: [:post_batch_create, :backend, @current_shop, @current_branch, :reservation_time_points], method: :post , html: { class: 'form-horizontal'}) do |f|
      .form-inputs.col-sm-7
        = f.input :table_zone_id, collection: @current_branch.table_zones, :include_blank => false, label: "桌台区域或类型"
        = f.input :start_time_point, as: :time, label: "起始时间点"
        = f.input :interval, as: :integer, label: "创建间隔(单位： 分钟)", hint: "例如每30分钟设立一个预订时间点： 30", default: 20
        = f.input :count, as: :integer, label: "创建数量", hint: "一次最多创建15个预订时间点"
      .clearfix
      .form-actions.col-xs-offset-2
        = f.submit "创建", :class => "btn btn-primary btn-sm"
