= simple_form_for([:backend, @current_shop, @current_branch, @reservation_time_point], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |g|
    = g.error_notification :message => error_message_in_html(@reservation_time_point)

    .form-inputs
      = g.input :time_point, input_html: {:value => (f.object.time_point.strftime('%H:%M') rescue nil)}
      = g.association :table_zone, collection: @current_branch.table_zones, include_blank: false

    .form-actions.col-xs-offset-2
      = g.button :submit, :class => 'btn btn-primary btn-sm'
