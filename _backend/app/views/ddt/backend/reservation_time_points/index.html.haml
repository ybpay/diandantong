
.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/reservation_time_point')} 列表"

    .form-group
      = link_to "新建 #{t('activerecord.models.ddt/reservation_time_point')}", new_backend_shop_branch_reservation_time_point_path(@current_shop, @current_branch), :class=>"btn btn-primary btn-sm"
      = link_to "批量新建", [:get_batch_create, :backend, @current_shop, @current_branch, :reservation_time_points], :class=>"btn btn-success btn-sm"

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      .ibox
        .ibox-content
          %table.table.table-striped
            %thead
              %tr

                %th.col-sm-1= sort_link(@q, :table_zone, Ddt::ReservationTimePoint.human_attribute_name(:table_zone))
                %th.col-sm-1= sort_link(@q, :time_point, Ddt::ReservationTimePoint.human_attribute_name(:time_point))
                %th.col-sm-1

            %tbody
              - @reservation_time_points.each do |reservation_time_point|
                %tr
                  %td= reservation_time_point.table_zone.try(:name)
                  %td= reservation_time_point.time_point.strftime("%H:%M")
                  %td
                    = link_to '详情', [:backend, @current_shop, @current_branch, reservation_time_point]
                    = link_to '编辑', edit_backend_shop_branch_reservation_time_point_path(@current_shop, @current_branch, reservation_time_point)
                    = link_to '删除', [:backend, @current_shop, @current_branch, reservation_time_point], :method => :delete, :data => { :confirm => '确定删除?' }
              = no_record_hint(@reservation_time_points)
          %br
          .pull-right= will_paginate @reservation_time_points , renderer: BootstrapPagination::Rails, bootstrap: 3
          %br
