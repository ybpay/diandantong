= simple_form_for([:backend, @current_shop, @current_branch, @guest_queue.queue_setting, @guest_queue], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@guest_queue)

    .form-inputs
      = f.input :guest_no
      = f.input :phone
      = f.input :guest_num

    .form-actions.col-xs-offset-2
      = f.button :submit, :class => "btn btn-primary btn-sm"
