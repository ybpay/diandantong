.header
  %h3= "#{t('activerecord.models.ddt/guest_queue')} 详情"
.model-show
  %p
    %b
      = Ddt::GuestQueue.human_attribute_name(:guest_no)
      \:
    = @guest_queue.guest_no
  %p
    %b
      = Ddt::GuestQueue.human_attribute_name(:branch)
      \:
    = @guest_queue.branch.name
  %p
    %b
      = Ddt::GuestQueue.human_attribute_name(:workflow_state)
      \:
    = guest_queue_state_label(@guest_queue)
  %p
    %b
      = Ddt::GuestQueue.human_attribute_name(:is_notified)
      \:
    = guest_queue_notify_label(@guest_queue)
  - if @guest_queue.base_user.present?
    %p
      %b
        = Ddt::GuestQueue.human_attribute_name(:base_user)
        \:
      = link_to @guest_queue.base_user.name||@guest_queue.base_user.id, [:backend, @current_shop, @guest_queue.base_user]
  %p
    %b
      = Ddt::GuestQueue.human_attribute_name(:phone)
      \:
    = @guest_queue.phone
  %p
    %b
      = Ddt::GuestQueue.human_attribute_name(:guest_num)
      \:
    = @guest_queue.guest_num
  .space


= link_to t('Edit'), edit_backend_shop_branch_queue_setting_guest_queue_path(@current_shop, @current_branch,  @guest_queue.queue_setting, @guest_queue), :class => "btn btn-primary btn-sm"
\
= link_to t('Back'), backend_shop_branch_queue_setting_guest_queues_path(@current_shop, @current_branch, @guest_queue.queue_setting), :class => "btn btn-default btn-sm"