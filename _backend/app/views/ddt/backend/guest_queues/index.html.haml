.header
  %h3= "#{t('activerecord.models.ddt/guest_queue')} 列表"
.form-group
  - Ddt::GuestQueue.workflow_state_collection.each do |workflow_state_name, workflow_state_key|
    %a{href: backend_shop_branch_queue_setting_guest_queues_path(@current_shop, @current_branch, @queue_setting, q: {workflow_state_eq: workflow_state_key}), class: cycle('btn btn-sm btn-primary', 'btn btn-sm btn-success', 'btn btn-sm btn-danger', 'btn btn-sm btn-info')}
      = workflow_state_name


%table.table.table-striped.table-bordered
  %thead
    %tr
      %th.col-sm-1= sort_link(@q, :guest_no, Ddt::GuestQueue.human_attribute_name(:guest_no))
      %th.col-sm-1= sort_link(@q, :workflow_state, Ddt::GuestQueue.human_attribute_name(:workflow_state))
      %th.col-sm-1= sort_link(@q, :is_notified, Ddt::GuestQueue.human_attribute_name(:is_notified))
      %th.col-sm-1= sort_link(@q, :phone, Ddt::GuestQueue.human_attribute_name(:phone))
      %th.col-sm-1= sort_link(@q, :guest_num, Ddt::GuestQueue.human_attribute_name(:guest_num))
      %th.col-sm-1= sort_link(@q, :created_at, Ddt::GuestQueue.human_attribute_name(:created_at))
      %th.col-sm-1

  %tbody
    - @guest_queues.each do |guest_queue|
      %tr
        %td= guest_queue.guest_no
        %td= guest_queue_state_label(guest_queue)
        %td= guest_queue_notify_label(guest_queue)
        %td= guest_queue.phone
        %td= guest_queue.guest_num
        %td= guest_queue.created_at
        %td
          = link_to tag(:icon,:class=>"fa fa-bars"), [:backend, @current_shop, @current_branch, guest_queue.queue_setting, guest_queue], :class => "btn btn-xs btn-info"
          = link_to tag(:icon,:class=>"fa fa-edit"), edit_backend_shop_branch_queue_setting_guest_queue_path(@current_shop, @current_branch, guest_queue.queue_setting, guest_queue), :class => "btn btn-xs btn-success"
          - actions = { queueing: [:accept, :pass, :cancel], accepted: [], past: [:accept], canceled: [] }[guest_queue.workflow_state.to_sym]
          - if actions.present?
            .btn-group
              %button.btn.btn-primary.btn-xs.dropdown-toggle{type: 'button', title: "状态", data: {:toggle=>"dropdown"}}
                状态
                %icon.fa.fa-caret-down
              %ul.dropdown-menu{:role=>"menu"}
                - actions.each do |action|
                  %li= guest_queue_action(guest_queue, action)
          = link_to tag(:icon,:class=>"fa fa-bell-o"), [:notify, :backend, @current_shop, @current_branch, guest_queue.queue_setting, guest_queue], :class => "btn btn-xs btn-warning", title: '通知', method: :put

    = no_record_hint(@guest_queues)
%br
.pull-right= will_paginate @guest_queues , renderer: BootstrapPagination::Rails, bootstrap: 3
%br