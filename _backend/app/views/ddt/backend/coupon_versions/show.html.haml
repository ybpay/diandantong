.ibox
  .ibox-title
    %h3= "#{t('activerecord.models.ddt/coupon_version')} 详情"
  .ibox-content
    .col-md-6
      .model-show
        %p
          %b
            = Ddt::CouponVersion.human_attribute_name(:name)
            \:
          = @coupon_version.name
        %p
          %b
            = Ddt::CouponVersion.human_attribute_name(:coupon_type)
            \:
          = @coupon_version.coupon_type_name
        %p
          %b
            = Ddt::CouponVersion.human_attribute_name(:norminal_value)
            \:
          = @coupon_version.value_desc
        %p
          %b
            = Ddt::CouponVersion.human_attribute_name(:expired_type)
            \:
          = @coupon_version.expired_type_name
        - if @coupon_version.is_fixed_expired_time?
          %p
            %b
              = Ddt::CouponVersion.human_attribute_name(:usable_starts_at)
              \:
            = @coupon_version.usable_starts_at
          %p
            %b
              = Ddt::CouponVersion.human_attribute_name(:usable_expires_at)
              \:
            = @coupon_version.usable_expires_at
        - else
          %p
            %b
              = Ddt::CouponVersion.human_attribute_name(:usable_days_after_send)
              \:
            = @coupon_version.usable_days_after_send
        %p
          %b
            = Ddt::CouponVersion.human_attribute_name(:max_grant_limit)
            \:
          = @coupon_version.max_grant_limit
        %p
          %b
            = Ddt::CouponVersion.human_attribute_name(:max_count_each_user)
            \:
          = @coupon_version.max_count_each_user
        %p
          %b
            = Ddt::CouponVersion.human_attribute_name(:can_exchange)
            \:
          = @coupon_version.can_exchange ? '是': '否'
        %p
          %b
            = Ddt::CouponVersion.human_attribute_name(:credit_count)
            \:
          = @coupon_version.credit_count
        %p
          %b
            = Ddt::CouponVersion.human_attribute_name(:coupon_appliable_branch_scope_policy)
            \:
          = @coupon_version.coupon_appliable_branch_scope_policy_name
        %p
          %b
            = Ddt::CouponVersion.human_attribute_name(:base_coupons_count)
            \:
          = @coupon_version.base_coupons_count
        %p
          %b
            = Ddt::CouponVersion.human_attribute_name(:refund_coupons_count)
            \:
          = @coupon_version.refund_coupons_count
        %p
          %b
            = Ddt::CouponVersion.human_attribute_name(:used_coupons_count)
            \:
          = @coupon_version.used_coupons_count
        %p
          %b
            = Ddt::CouponVersion.human_attribute_name(:coupon_min_usable_amount)
            \:
          = @coupon_version.coupon_min_usable_amount
        %p
          %b
            = Ddt::CouponVersion.human_attribute_name(:description)
            \:
          = @coupon_version.description
        .space

      = link_to t('Edit'), edit_backend_shop_coupon_version_path(@current_shop, @coupon_version), :class => "btn btn-primary btn-sm"
      \
      = link_to t('Back'), backend_shop_coupon_versions_path(@current_shop), :class => "btn btn-default btn-sm"

    .clearfix
