.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h3= "#{t('activerecord.models.ddt/coupon_version')} 列表"
    = link_to "新建 #{t('activerecord.models.ddt/coupon_version')}", new_backend_shop_coupon_version_path(@current_shop), :class=>"btn btn-primary btn-sm"

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .m-b-sm.border-bottom
    .row
      .col-lg-12
        %table.table.table-striped
          %thead
            %tr
              %th.col-sm-1= sort_link(@q, :name, Ddt::CouponVersion.human_attribute_name(:name))
              %th.col-sm-1= sort_link(@q, :expired_type, Ddt::CouponVersion.human_attribute_name(:expired_type))
              %th.col-sm-1= "有效时间"
              %th.col-sm-1= sort_link(@q, :max_grant_limit, Ddt::CouponVersion.human_attribute_name(:max_grant_limit))
              %th.col-sm-1= sort_link(@q, :coupon_appliable_branch_scope_policy, Ddt::CouponVersion.human_attribute_name(:coupon_appliable_branch_scope_policy))
              %th.col-sm-1= sort_link(@q, :coupon_type, Ddt::CouponVersion.human_attribute_name(:coupon_type))
              %th.col-sm-1= sort_link(@q, :norminal_value, Ddt::CouponVersion.human_attribute_name(:norminal_value))
              %th.col-sm-1

          %tbody
            - @coupon_versions.each do |coupon_version|
              %tr
                %td= coupon_version.name
                %td= coupon_version.expired_type_name
                - if coupon_version.is_fixed_expired_time?
                  %td= "#{coupon_version.usable_starts_at} ~ #{coupon_version.usable_expires_at}"
                - else
                  %td= "发放后#{coupon_version.usable_days_after_send}天内"
                %td= coupon_version.max_grant_limit
                %td= coupon_version.coupon_appliable_branch_scope_policy_name
                %td= coupon_version.coupon_type_name
                %td= coupon_version.value_desc
                %td
                  = link_to '详情', [:backend, @current_shop, coupon_version]
                  = link_to '编辑', edit_backend_shop_coupon_version_path(@current_shop, coupon_version)
                  = link_to '删除', [:backend, @current_shop, coupon_version], :method => :delete, :data => { :confirm => '确定删除?' }

            = no_record_hint(@coupon_versions)
        %br
        .pull-right= will_paginate @coupon_versions , renderer: BootstrapPagination::Rails, bootstrap: 3
        %br
