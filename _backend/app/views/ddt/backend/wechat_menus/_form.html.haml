
= simple_form_for([:backend, @current_shop, @wechat_account, @wechat_menu], html: { class: 'form-horizontal'}, wrapper: :horizontal_form_long , remote: true) do |f|
  = f.error_notification :message => error_message_in_html(@wechat_menu)

  .form-inputs
    = f.input :parent_id, as: :hidden
    = f.input :event_type, as: :hidden
    = f.input :name
    = f.input :menu_type, collection: Ddt::WechatMenu::menu_type_collection
    - if @wechat_menu.is_view?
      .select.col-xs-offset-2
        = raw("#{render '/ddt/backend/branch_sliders/auto_insert_url', {input_field_id: 'wechat_menu_url', version: 'whole_url'}}")
      = f.input :url, required: true
    - if @wechat_menu.is_click?
      = f.input :reply_type, collection: Ddt::WechatMenu::REPLY_TYPES, required: true
      = f.input :material_id, collection: Ddt::WechatMenu.material_options(@current_shop)
      = f.input :keyword, collection: Ddt::WechatMenu.system_keyword_options(@wechat_account)
      :javascript
        $(function(){
          function reply_type_change(replytype){
            if(replytype == 'system_keyword'){
              $('.wechat_menu_keyword').show();
              $('.wechat_menu_material_id').hide();
            }else if(replytype == 'material'){
              $('.wechat_menu_keyword').hide();
              $('.wechat_menu_material_id').show();
            }
          }

          function new_init(){
            $('.wechat_menu_keyword').hide();
            $('.wechat_menu_material_id').hide();

          }

          function edit_init(is_material){
            if(is_material == "true"){
              $('.wechat_menu_material_id').show();
              $('.wechat_menu_keyword').hide();
              $('#wechat_menu_reply_type').val('material')
            }else{
              $('.wechat_menu_material_id').hide();
              $('.wechat_menu_keyword').show();
              $('#wechat_menu_reply_type').val('system_keyword')
            }
          }

          $('#wechat_menu_reply_type').change(function(e){
            reply_type_change(e.target.value);
          })

          if("#{ @wechat_menu && @wechat_menu.id.present? }"=='true'){
            edit_init("#{ @wechat_menu.material_id.present? }");
          }else{
            new_init();
          }
        })

  .form-actions.col-xs-offset-2
    = f.button :submit, :class=>"btn btn-primary"
