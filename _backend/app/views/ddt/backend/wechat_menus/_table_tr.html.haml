%tbody.parent
  %tr.wechat-menu-table-tr{data: {id: wechat_menu.id }}
    %td
      %icon.fa.fa-minus-square.bigger-120.blue{onclick: "$('.subs[data-parent=#{wechat_menu.id}]').toggle();$(this).toggleClass('fa-minus-square').toggleClass('fa-plus-square');", style: "cursor: pointer;"}
      = wechat_menu.name
    %td
      = action_of_menu(wechat_menu)
    %td
      .actions
        - url = change_position_backend_shop_wechat_account_wechat_menu_path(@current_shop, @wechat_account, wechat_menu)
        = change_position_form(url, wechat_menu.siblings, wechat_menu)

        - unless wechat_menu.parent.present?
          = link_to '添加', new_backend_shop_wechat_account_wechat_menu_path(@current_shop, @wechat_account ,parent_id: wechat_menu.id), remote: true, title: "添加子菜单"
        = link_to '编辑', edit_backend_shop_wechat_account_wechat_menu_path(@current_shop, @wechat_account, wechat_menu), remote: true, title: "编辑"

        = link_to '删除', backend_shop_wechat_account_wechat_menu_path(@current_shop, @wechat_account, wechat_menu), :method => :delete, :data => { :confirm => '确定要删除自定义菜单吗?' }, remote: true, title: "删除"

%tbody.subs{data: { parent: wechat_menu.id }}
  - wechat_menu.subs.each do |sub_menu|
    %tr.wechat-menu-table-tr{data: {id: sub_menu.id }}
      %td
        %i.fa.fa-fw
        %i.fa.fa-circle.smaller-50.orange
        = sub_menu.name
      %td
        = action_of_menu(sub_menu)
      %td
        .actions
          %i.fa.fa-fw
          - url = change_position_backend_shop_wechat_account_wechat_menu_path(@current_shop, @wechat_account, sub_menu)
          = change_position_form(url, sub_menu.siblings, sub_menu)

          = link_to "编辑", edit_backend_shop_wechat_account_wechat_menu_path(@current_shop, @wechat_account, sub_menu), remote: true

          = link_to "删除", backend_shop_wechat_account_wechat_menu_path(@current_shop, @wechat_account, sub_menu), :method => :delete, :data => { :confirm => '确定要删除自定义菜单吗?' }, remote: true, title: "删除"
