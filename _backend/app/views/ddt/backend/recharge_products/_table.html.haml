%table.table.table-striped.table-bordered.recharge-products-table
  %thead
    %tr
      %th.col-sm-1= Ddt::RechargeProduct.human_attribute_name(:name)
      %th.col-sm-1= Ddt::RechargeProduct.human_attribute_name(:price)
      %th.col-sm-1= Ddt::RechargeProduct.human_attribute_name(:recharge_amount)
      %th.col-sm-1= Ddt::RechargeProduct.human_attribute_name(:sales_count)
      %th.col-sm-1= Ddt::RechargeProduct.human_attribute_name(:extra_credits)
      %th.col-sm-1= Ddt::RechargeProduct.human_attribute_name(:first_recharge_available_amount)
      %th.col-sm-2
  %tbody
    - recharge_products.each do |recharge_product|
      %tr
        %td= recharge_product.name
        %td= recharge_product.price_in_currency
        %td= recharge_product.recharge_amount_in_currency
        %td= recharge_product.sales_count
        %td= recharge_product.extra_credits
        %td= recharge_product.first_recharge_available_amount
        %td
          = change_position_form([:change_position, :backend, @current_shop, recharge_product], @current_shop.recharge_products, recharge_product)
          = edit_btn(recharge_product, remote: true)
          = delete_btn(recharge_product, remote: true)
    = no_record_hint(recharge_products)