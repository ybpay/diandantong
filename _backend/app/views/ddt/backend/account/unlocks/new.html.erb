<div class="passwordBox animated fadeInDown">
    <div class="row">

        <div class="col-md-12">
            <div class="ibox-content">

                <h2 class="font-bold">激活账户</h2>

                <p>
                    输入邮箱地址，系统将发送账户解锁邮件到您的邮箱。之后请进入按照收到的邮件提示进行帐户激活。
                </p>
                <% if resource.errors.any? %>
                  <div class="error-messages">
                    <p>您提交的表单有如下错误：</p>
                    <ul>
                      <% resource.errors.full_messages.each do |msg| %>
                        <li><%= msg %></li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>

                <div class="row">
                    <div class="col-lg-12">
                      <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: 'm-t'}) do |f| %>
                        <div class="form-group">
                            <%= f.text_field :email, required: true, autofocus: true, :class=>"form-control", :placeholder=>'邮箱' %>
                        </div>

                        <button type="button" class="btn btn-primary block full-width m-b" onclick="this.form.submit()">
                          发送解锁邮件
                        </button>
                      <% end %>
                      <div class="text-center">
                        <a href="<%= new_account_session_path(agent_no: params[:agent_no]) %>">
                              返回登录界面
                          </a>
                      </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



