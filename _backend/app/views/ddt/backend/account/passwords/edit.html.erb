

<div class="passwordBox animated fadeInDown">
    <div class="row">

        <div class="col-md-12">
          <div class="ibox-content">
            <h2 class="font-bold">修改密码</h2>
            <% if resource.errors.any? %>
              <div class="error-messages">
                <p>您提交的表单有如下错误：</p>
                <ul>
                  <% resource.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

          <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: 'm-t'}) do |f| %>
            <div class="form-group">
              <%= f.hidden_field :reset_password_token %>
              <%= f.password_field :password, required: true, autofocus: true, :class=>"form-control", :placeholder=>'密码' %>
            </div>
            <div class="form-group">
              <%= f.password_field :password_confirmation, required: true, :placeholder=> "重复输入密码", :class=>"form-control" %>
            </div>

            <button type="button" class="btn btn-primary block full-width m-b" onclick="this.form.submit()">
              重置密码
            </button>
          <% end %>
          <div class="text-center">
            <a href="<%= new_account_session_path(agent_no: params[:agent_no]) %>">
                  返回登录界面
              </a>
          </div>
      </div>
    </div>
  </div>
</div>
