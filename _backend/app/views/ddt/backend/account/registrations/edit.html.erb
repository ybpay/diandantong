<div class="ibox">
  <div class="ibox-title">
    <h2>修改密码</h2>
  </div>

  <div class="ibox-content">
    <%= simple_form_for(resource, as: resource_name, url: account_registration_path, html: { method: :put, class: 'form-horizontal'}) do |f| %>
      <%= f.error_notification %>
      <div class="form-inputs">
        <div class="col-md-6">
         <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p>当前正在等待点击激活邮件进行账户激活: <%= resource.unconfirmed_email %></p>
         <% end %>
        <%= f.input :login_id, required: true, disabled: true %>
        <%= f.input :email, required: true, disabled: true %>
        <%= f.input :current_password, hint: "输入当前密码来授权此操作", required: true %>
       
        <%= f.input :password, autocomplete: "off", hint: "若不需要修改请留空", required: false %>
        <%= f.input :password_confirmation, required: false %>
        </div>     
      </div>
      <div class="clearfix"></div>
      <div class="form-actions col-sm-6">
        <div class="col-sm-offset-4">
          <%= f.button :submit, "修改" %>
        </div>
      </div>
      <div class="clearfix"></div>
   
  <% end %>
  </div>
</div>

