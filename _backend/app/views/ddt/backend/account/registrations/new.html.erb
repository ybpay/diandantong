<% content_for :head do %>
  <%= javascript_include_tag "ddt/login", "data-turbolinks-track" => true %>
  <%= stylesheet_link_tag "ddt/login", media: "all", "data-turbolinks-track" => true %>
<%  end %>
<% last_step = (params[:step].to_i == 3)%>
<div class="wrapper wrapper-content animated fadeInRight">
  <div class="row">
    <div class="col-lg-12">
      <h2>新用户注册</h2>
    </div>
  </div>
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox"> 
        <div class="ibox-title">
          <div class="reg-nav-item col-xs-4 active">
              <span class="reg-nav-num">1</span>
              <span>验证手机号</span>
          </div>
          <div class="reg-nav-item col-xs-4 step-2 <%= 'active' if last_step %>">
              <span class="reg-nav-num">2</span>
              <span>填写帐号信息</span>
          </div>
          <div class="reg-nav-item col-xs-4 step-3 <%= 'active' if last_step %>">
              <span class="reg-nav-num">3</span>
              <span>注册成功</span>
          </div>
        </div>

        <div class="ibox-content">
          <div id="ddb-loading" class="hidden" style="left: 30%;width:40%;">
              <div class="sk-spinner sk-spinner-cube-grid">
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
                  <div class="sk-cube"></div>
              </div>
          </div>


          <% if resource.errors.present? %>
            <% resource.errors.full_messages.each do |msg| %>
              <%= javascript_tag("toastr.error('#{msg}')") %>
            <% end %>
          <% end %>

          <% @agent_no = params[:agent_no] if params[:agent_no].present? %>
          <%= form_for resource, as: resource_name, url: account_registration_path(agent_no: @agent_no) , html: { class: "reg-form form-horizontal" } do |f| %>
            <div class="col-sm-6">
              <div class="reg-step-1 <%= 'hide' if last_step %>">
                <div class="form-group">
                  <label class="col-sm-4 control-label">手机</label>
                  <div class="col-sm-8">
                    <%= f.text_field :phone,  placeholder: "手机号", class: "form-control", emptyhint: "请填写手机号"%>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-4 control-label">验证码</label>
                  <div class="col-sm-5">
                    <%= f.text_field :captcha, placeholder: "验证码", class: "form-control", emptyhint: "请填写验证码"%>
                  </div>
                  <div class="hint col-sm-3">
                    <%= link_to('获取短信验证码', send_sms_captcha_path, :id => 'send_sms_captcha_link', :text => '发送短信验证码', :remote => true, class: "btn captcha-btn btn-w-m btn-default")%>
                  </div>
                </div>


                <div class="form-group">
                  <label class="control-label col-sm-offset-4">
                    <%= check_box_tag 'account[accept_term]', 1, resource.accept_term %>
                    我已阅读并接受
                    <% query_str = @agent_no ? "?agent_no=#{@agent_no}" : "" %>
                    <a href="/protocol<%= query_str %>" target="_blank">&lt;&lt;使用协议&gt;&gt;</a>
                  </label>
                </div>

                <div class="form-group">
                  <div class="col-sm-offset-4">
                    <div class="btn btn-primary reg-next-btn step-1-btn">下一步</div>
                  </div>
                </div>
              </div>
              <div class="reg-step-2 hide">
                <div class="form-group">
                  <label class="col-sm-4 control-label">企业账号</label>
                  <div class="col-sm-8">
                    <%= f.text_field :login_id, placeholder: "企业账号", class: "form-control", emptyhint: "请填写企业账号"%>
                    <p class="help-block">字母数字下划线, 最少3个字符, 不能纯数字</p>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-4 control-label">邮箱</label>
                  <div class="col-sm-8">
                  <%= f.text_field :email, placeholder: "邮箱", class: "form-control", emptyhint: "请填写邮箱"%>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-4 control-label">密码</label>
                  <div class="col-sm-8">
                    <%= f.password_field :password, placeholder: "密码", class: "form-control", emptyhint: "请输入密码"%>
                    <p class="help-block">长度最少8位</p>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-4 control-label">确认密码</label>
                  <div class="col-sm-8">
                    <%= f.password_field :password_confirmation, placeholder: "重复输入密码" , class: "form-control", emptyhint: "请确认密码"%>
                  </div>
                </div>


                <% resource.build_shop(agent_no: @agent_no, address: "") if resource.shop.nil?%>
                <%= f.fields_for :shop do |shop_form| %>
                  <%= shop_form.hidden_field :address %>
                  <% if @agent_no.present? %>
                    <%= shop_form.hidden_field :agent_no %>
                  <% end%>
                <% end %>
                <!-- buttons -->
                <div class="form-group">
                  <div class="col-sm-offset-4">
                    <%= f.submit "下一步", id: 'submit-registration', class: 'btn reg-next-btn btn-primary' %>
                  </div>
                </div>
              </div>
              <div class="reg-step-3 <%= 'hide' unless last_step %>">
                <div class="col-sm-offset-3 col-sm-6 reg-success">
                  <span class="reg-sc-icon"><i class="fa fa-check"></i></span>
                  <span>恭喜！您已注册成功。</span>
                </div>
                <div class="form-group">
                  <div class="col-sm-offset-3 col-sm-6">
                    <%= link_to "进入系统", after_sign_up_path_for(current_account), class: "btn btn-primary reg-next-btn step-3-btn" %>
                  </div>
                </div>
              </div>
            </div>
            <div class="clearfix"></div>
          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>


<script>
  $(document).ready(function(){
    var supportPlaceholder = ('placeholder' in document.createElement('input'));
    function setPlaceholder(input){
      var text = input.attr('placeholder')
      if(input.val() == ""){
        input.val(text).addClass("phcolor")
      }
      input.focus(function(){
        if(input.val() == text){
          $(this).val("")
        }
      })
      input.blur(function(){
        if(input.val() == ""){
          $(this).val(text).addClass("phcolor")
        }
      })
      input.keydown(function(key){
        $(this).removeClass("phcolor")
      })
    }

    if(!supportPlaceholder){
      $('input').each(function(){
        var text = $(this).attr("placeholder");
        if(text && $(this).attr("type") == "text"){
          setPlaceholder($(this));
        }
      });
    }

    var validate = function(obj){
      var except = ["account_shop_attributes_agent_no", "account_captcha"];
      var value = obj.val();
      var placeholder = obj.attr("placeholder");
      var id = obj.attr("id");
      if(except.indexOf(id) < 0){
        set_hint(obj, "");
        if(value == "" || value == placeholder){ set_hint(obj, obj.attr("emptyhint"))}else{set_ok(obj);}
      }
      try{validations[id](obj);}catch(e){}
    }

    var validate_all = function(){
      $("input.form-control").each(function(){
        validate($(this))
      })
    }

    var remove_hint = function(obj){
      obj.closest('.form-group').removeClass('has-error');
      obj.closest('.form-group').removeClass('has-success');
      obj.parent().children(".input-help").remove();
    }
    var set_hint = function(obj, hint){
      remove_hint(obj);
      if(hint!=""){
        obj.closest('.form-group').addClass('has-error');
        obj.parent().append('<div class="help-block m-b-none input-help">'+hint+'</div>');
      }
    }
    var set_ok = function(obj){
      remove_hint(obj);
      obj.closest('.form-group').addClass('has-success');
    }

    var unique_validate = function(obj, key, invalid_hint){
      var val = obj.val();
      if(val=="" || val == obj.attr('placeholder')){return;}
      var url = "<%=check_unique_path%>";
      url += "?key="+key+"&value="+val;
      $.ajax({url: url}).done(function(result){
        if(result==0){
          set_hint(obj,invalid_hint);
        }else{
          set_ok(obj);
        }
      })
    }

    var login_id_validate = function(obj){
      var r = /^[a-zA-Z0-9_]{3,30}$/
      var no_digit = /[a-zA-Z_]+/
      if(obj.val().match(r)==null || obj.val().match(no_digit)==null){set_hint(obj,"用户名格式不正确"); return;}

      unique_validate(obj,"login_id", "该用户名已被使用")
    }
    var email_validate = function(obj){ unique_validate(obj,"email", "该邮箱已被使用");}
    var phone_validate = function(obj){ unique_validate(obj,"phone", "该手机号已被使用")}

    var password_validate = function(obj){
      var val = obj.val();
      if(val==""){return;}
      if(val.length < 8){
        set_hint(obj, "密码长度最小为8位");
      }else{
        set_ok(obj);
      }
    }
    var password_confirmation_validate = function(obj){
      var val = obj.val();
      if(val==""){return;}
      if(val.length < 8){
        set_hint(obj, "密码长度最小为8位");
        return;
      }
      var pwd_val = $("#account_password").val();
      if(val!=pwd_val){
        set_hint(obj, "两次密码输入不一致");
      }else{
        set_ok(obj);
      }
    }
    var captcha_validate = function(obj){
      var val = obj.val();
      var html = "";
      var hint_obj = obj.parents(".input-wrap").children(".hint")
      if (val.length != 6) {
        hint_obj.children(".invalid").remove();
        hint_obj.append("<span class='invalid'>验证码长度不对</span>")
      }else{
        hint_obj.children(".invalid").remove();
      }
    }

    var address_selected = true;
    var address_validate = function(){
      address_selected = true;
      $(".city-select option:selected").map(function(i, elem) {
        var select = $(elem).parent();
        if($(elem).text().match(/--/)){
          select.addClass("no-selected")
          address_selected = false
        }else{
          select.removeClass("no-selected")
        }
      });
    }

    var validations = {
      account_login_id: login_id_validate,
      account_email: email_validate,
      account_phone: phone_validate,
      account_password: password_validate,
      account_password_confirmation: password_confirmation_validate,
      account_captcha: captcha_validate,
    }

    $("#account_captcha").val("");
    $("input.form-control").each(function(){
      $(this).on("blur", function(){validate($(this));})
    })

    $(".city-select").change(function() {
      var locations = $(".city-select option:selected").map(function(i, elem) {
        return $(elem).text();
      }).filter(function (i, elem) {
        return !elem.match(/--/);
      }).toArray();
      address_validate();
      $('#account_shop_attributes_address').val(locations.join('-'));
    });



    var accept_term = true;
    $('#account_accept_term').on('click', function(){
      accept_term = !accept_term;
      if (accept_term){
        $(".step-1-btn").removeAttr('disabled');
      }else{
        $(".step-1-btn").attr("disabled", "disabled");
      }
    })

    var can_submit = function(){
      validate_all();
      address_validate();
      return $(".invalid").length == 0 && accept_term && address_selected
    }
    var ladda_btn = $('#submit-registration').ladda()
    $('#submit-registration').on('click', function(){
        if(can_submit()){
          ladda_btn.ladda('start');
          this.form.submit();
        }else{
          return false;
        }
    });

    var countdown = function(seconds){
      var obj = $('#send_sms_captcha_link')
      if(t){clearTimeout(t);}
      if(seconds < 0){
        obj.html("发送短信验证码");
        obj.removeAttr('disabled');
        return;
      }
      obj.attr('disabled', 'true')
      obj.html("剩余 "+seconds+" 秒");
      var t = setTimeout(function(){
        countdown(--seconds)
      }, 1000)
    };

      var request_sms_captcha = function(image_captcha){
          var url = $('#send_sms_captcha_link').attr('href') + '?phone=' + $('#account_phone').val();
          if (image_captcha){
              url += "&image_captcha=" + image_captcha;
          }
          $.ajax({
              url: url,
              method: 'post',
              headers: {"SmsCaptchaToken": "ddt"},
              success: function(result){
                  if(result.ok){
                      countdown(60);
                      toastr.info(result.msg);
                  }else{
                      // 如果有 image_captcha，则请求用户输入之
                      if (result.image_captcha){
                          request_image_captcha(result)
                      }else{
                          toastr.info(result.msg);
                      }
                  }
              }
          })
      }

    var request_image_captcha = function(result){
        var title = "<p>" + result.msg + "</p>";
        var img = $("<image></image>");
        img.attr("src", "data:image/png;base64," + result.image_captcha);
        title += img.wrap('<div>').parent().html()
        bootbox.prompt(title, function(captcha) {
            if (captcha) {
               request_sms_captcha(captcha);
            }
        });
    }

      $('#send_sms_captcha_link').on('click', function(){
          if($(this).attr("disabled")){return false;}
          request_sms_captcha()
          return false;
      });

    $('.step-1-btn').on('click', function(){
      check_sms_captcha(function(){
        // go step 2
        $(".reg-nav-item.step-2").addClass("active")
        $(".reg-step-1").addClass("hide")
        $(".reg-step-2").removeClass("hide")
      })
    })

    function check_sms_captcha(callback){
      var phone = $("#account_phone").val()
      var captcha = $("#account_captcha").val()
      var url = "<%=check_sms_captcha_path%>";
      url += "?phone="+phone+"&captcha="+captcha;
      $.ajax({url: url}).done(function(result){
        if(result==0){
          set_hint($("#account_captcha"),"验证码不正确");
          // if(callback){ callback()}
        }else{
          set_ok($("#account_captcha"));
          if(callback){ callback()}
        }
      })
    }

    var _hmt = _hmt || [];
    (function() {

    })();
  });
</script>
