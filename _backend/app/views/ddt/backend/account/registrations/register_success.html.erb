<div class="register-box">
  <div class="reg-nav row">
    <div class="reg-nav-item col-xs-4 step-1 active">
      <div class="row">
        <div class="col-md-2 col-xs-12 col-md-offset-2"><span class="reg-nav-num">1</span></div>
        <span class="col-md-6 col-xs-12">验证手机号</span>
      </div>
    </div>
    <div class="reg-nav-item col-xs-4 step-2 active">
      <div class="row">
        <div class="col-md-2 col-xs-12 col-md-offset-2"><span class="reg-nav-num">2</span></div>
        <span class="col-md-6 col-xs-12">填写帐号信息</span>
      </div>
    </div>
    <div class="reg-nav-item col-xs-4 step-3 active">
      <div class="row">
        <div class="col-md-2 col-xs-12 col-md-offset-2"><span class="reg-nav-num">3</span></div>
        <span class="col-md-6 col-xs-12">注册成功</span>
      </div>
    </div>
  </div>
  <div class="reg-form row">
    <div class="reg-step-3">
      <div class="row">
        <div class="col-md-6 col-md-offset-3 reg-success">
          <span class="reg-sc-icon"><i class="fa fa-check"></i></span>
          <span>恭喜！您已注册成功。</span>
        </div>
      </div>
      <div class="form-group">
        <div class="col-xs-10 col-md-4 col-xs-offset-1 col-md-offset-4">
          <%= link_to "进入系统", after_sign_up_path_for(current_account), class: "btn btn-block reg-next-btn step-3-btn" %>
        </div>
      </div>
    </div>
  </div>
</div>
