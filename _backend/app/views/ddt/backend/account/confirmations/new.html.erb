  <div id="forgot-box" class="forgot-box widget-box no-border visible">
  <div class="widget-body">
    <div class="widget-main">
      <h4 class="header red lighter bigger">
        <i class="fa fa-key icon-key"></i>
        激活账户
      </h4>

      <div class="space-6"></div>
      <p>
        发送激活账户邮件到我的邮箱
      </p>
      <% if resource.errors.any? %>
        <div class="error-messages">
          <p>您提交的表单有如下错误：</p>
          <ul>
            <% resource.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post}) do |f| %>
        <fieldset>
          <label class="block clearfix">
            <span class="block input-icon input-icon-right">
              <%= f.text_field :email, required: true, autofocus: true, :class=>"form-control", :placeholder=>'邮箱' %>
              <i class="fa fa-envelope icon-envelope"></i>
            </span>
          </label>

          <div class="clearfix">
            <button type="button" class="width-50 pull-right btn btn-sm btn-danger" onclick="this.form.submit()">
              <i class="fa fa-lightbulb icon-lightbulb"></i>
              重发激活邮件
            </button>
          </div>
        </fieldset>
      <% end %>
    </div><!-- /widget-main -->

    <div class="toolbar center">
      <a href="<%= new_account_session_path(agent_no: params[:agent_no]) %>" class="back-to-login-link">
        <i class="fa fa-arrow-left icon-arrow-left"></i>
          返回登录界面
      </a>
    </div>
  </div><!-- /widget-body -->
</div><!-- /forgot-box -->