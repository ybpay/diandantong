-if @statistic.class.info[:warning].present?
  .alert.alert-warning
    = @statistic.class.info[:warning]

.alert.alert-info
  %strong 统计周期
  = @statistic.start_time
  %strong ~
  = @statistic.end_time
  - if @statistic.is_async and @pr_type == 'result'
    = link_to '刷新', [:backend, @current_shop, @statistic.cache_record, :refresh], :method => :post, :data => {:confirm => '确定删除以前的结果并提交新的查询?' }
