.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/statistics_cache')} 列表"

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
  .row
    .col-lg-12
      .form-group
        = search_form_for @q, url: backend_shop_statistics_caches_path(@current_shop), html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
          = f.input_field :label_eq, placeholder: Ddt::StatisticsCache.human_attribute_name(:label), class: 'form-control'
          = f.input_field :state_eq, collection: Ddt::StatisticsCache.state_collection, prompt: '状态', include_blank: true, class: 'form-control'
          = f.input_field :query_cont, placeholder: '查询条件包含', class: 'form-control'
          = f.submit "搜索", class: 'btn btn-default'

          = link_to '清空所有', clear_backend_shop_statistics_caches_path(@current_shop), class: 'btn btn-danger', method: :delete, data: {confirm: '确定清空所有查询日志'}
  .row
    .col-lg-12
      .ibox
        .ibox-content
          %table.table.table-striped
            %thead
              %tr
                %th.col-sm-1= Ddt::StatisticsCache.human_attribute_name(:name)
                %th.col-sm-1= sort_link(@q, :label, Ddt::StatisticsCache.human_attribute_name(:name))
                %th.col-sm-1= sort_link(@q, :state, Ddt::StatisticsCache.human_attribute_name(:state))
                %th.col-sm-1= Ddt::StatisticsCache.human_attribute_name(:progress)
                %th.col-sm-1= Ddt::StatisticsCache.human_attribute_name(:cost_time)
                %th.col-sm-2= Ddt::StatisticsCache.human_attribute_name(:query)
                %th.col-sm-1= Ddt::StatisticsCache.human_attribute_name(:operator)
                %th.col-sm-1= sort_link(@q, :created_at, Ddt::StatisticsCache.human_attribute_name(:created_at))
                %th.col-sm-1= sort_link(@q, :updated_at, Ddt::StatisticsCache.human_attribute_name(:updated_at))
                %th.col-sm-2

            %tbody
              - @statistics_caches.each do |c|
                %tr
                  %td= t("activerecord.models.ddt/#{c.name}")
                  %td= c.label
                  %td= c.state_name
                  %td= c.progress_text
                  %td= c.cost_time_text
                  %td
                    - if c.query.present?
                      %pre{style: "background:none;border:0"}= format_statistics_query(c.query)
                  %td= c.operator_name
                  %td= c.created_at
                  %td= c.updated_at
                  %td
                    - if c.is_completed?
                      = link_to '查看', c.url
                      &nbsp&nbsp
                      = link_to 'CSV', c.url.sub('.html', '.csv')
                      &nbsp&nbsp
                      = link_to 'XLS', c.url.sub('.html', '.xls')
                      &nbsp&nbsp
                    = link_to '刷新', [:backend, @current_shop, c, :refresh], :method => :post, :data => {:confirm => '确定删除以前的结果并提交新的查询?' }
                    = link_to '删除', [:backend, @current_shop, c], :method => :delete, :data => { :confirm => '确定删除?' }
              = no_record_hint(@statistics_caches)


          %br
          .pull-right= will_paginate @statistics_caches , renderer: BootstrapPagination::Rails, bootstrap: 3
          %br
