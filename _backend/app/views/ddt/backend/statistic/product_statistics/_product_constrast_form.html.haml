.query-form
  = form_for :product_statistic, url: [:product_contrast, :backend, @current_shop, :product_statistics], method: :get, html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|

    = f.input_field :start_time, as: :datetime, placeholder: '开始时间', value: @statistic.start_time
    %span &nbsp;
    = f.input_field :end_time, as: :datetime, placeholder: '结束时间', value: @statistic.end_time
    %span &nbsp;
    = f.input_field :sku_in, data: {useras: 'select', url: backend_shop_shop_variants_path(@current_shop),single: false, placeholder: '选择菜品', column: 'cache_name_cont'}, class: 'ddb-select2 col-lg-2', title: '选择菜品'
    %span &nbsp;&nbsp;&nbsp;
    = f.submit "搜索", class: 'btn btn-sm btn-success', onClick: "$(this).closest('form').attr('action', '#{ product_contrast_backend_shop_product_statistics_path(@current_shop, format: :html) }')"
    = f.submit "导出csv表格", class: 'btn btn-sm btn-info', onClick: "$(this).closest('form').attr('action', '#{ product_contrast_backend_shop_product_statistics_path(@current_shop, format: :csv) }')"
    = f.submit "导出xls表格", class: 'btn btn-sm btn-info', onClick: "$(this).closest('form').attr('action', '#{ product_contrast_backend_shop_product_statistics_path(@current_shop, format: :xls) }')"

%br/
