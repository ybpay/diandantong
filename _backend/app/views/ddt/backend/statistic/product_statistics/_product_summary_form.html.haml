.query-form
  = form_for :product_statistic, url: [:product_summary, :backend, @current_shop, :product_statistics], method: :get, html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|


    = f.input_field :branch_id, data: {"local-datas" =>  [{id: Ddt::StatisticBase::ALL_BRANCH, name: '所有门店'}] + (current_account.is_boss? ? @current_shop.branches : current_account.manage_branches), useas: "local_select", single: true}, class: 'ddb-select2 col-lg-2', value: @statistic.branch_id
    %span &nbsp;&nbsp;&nbsp;
    = f.input_field :start_time, as: :datetime, placeholder: '开始时间', value: @statistic.start_time
    %span &nbsp;
    = f.input_field :end_time, as: :datetime, placeholder: '结束时间', value: @statistic.end_time
    %span &nbsp;
    = f.input_field :time_interval_id, data: {useas: 'local_select', single: true, "local_datas" => @current_shop.time_intervals.map(&:select_json).unshift({id: 0, name: '所有时段'})}, class: 'ddb-select2 col-lg-2', value: @statistic.time_interval_id, placeholder: '选择时段'

    %br
    %br
    = f.input_field :category_id_in, data: {useas: 'select', url: backend_shop_branch_categories_path(@current_shop, (@statistic.branch_id.blank? ? Ddt::StatisticBase::ALL_BRANCH : @statistic.branch_id) ), single: false, placeholder: '选择分类'}, class: 'ddb-select2 col-lg-2', title: '选择分类'
    = f.input_field :sku_in, data: {useras: 'select', url: backend_shop_shop_variants_path(@current_shop), single: false, placeholder: '选择菜品', column: 'cache_name_cont'}, class: 'ddb-select2 col-lg-2', title: '选择菜品'
    %span &nbsp;&nbsp;&nbsp;
    = f.submit "搜索", class: 'btn btn-sm btn-success', onClick: "$(this).closest('form').attr('action', '#{ product_summary_backend_shop_product_statistics_path(@current_shop, format: :html) }')"
    = f.submit "导出csv表格", class: 'btn btn-sm btn-info', onClick: "$(this).closest('form').attr('action', '#{ product_summary_backend_shop_product_statistics_path(@current_shop, format: :csv) }')"
    = f.submit "导出xls表格", class: 'btn btn-sm btn-info', onClick: "$(this).closest('form').attr('action', '#{ product_summary_backend_shop_product_statistics_path(@current_shop, format: :xls) }')"

%br/

:javascript
  $('#product_statistic_branch_id').on('change', function(e){
    if(e.val != '0'){
      var catetory_url = $('#product_statistic_category_id_in').data('url').replace(/branches\/\d+/, 'branches/'+e.val);
      $('#product_statistic_category_id_in').data('url', catetory_url)
      init_ddb_select2();
    }
  })