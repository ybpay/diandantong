- if @result.length > 5000
  查询结果太大，请下载 csv 或 xls 格式文件查看
- else
  %table.statistic-table.sortable-table.tablesorter
    %thead
      %tr
        %th{rowspan: 2} 分类
        %th{rowspan: 2} 名称
        %th{colspan: 3} 单点
        %th{colspan: 3} 称重
        %th{colspan: 3} 套餐
        %th{colspan: 8} 销售

      %tr
        %th 均价
        %th 数量
        %th 金额

        %th 均价
        %th 重量
        %th 金额

        %th 均价
        %th 数量
        %th 金额

        %th 均价
        %th 数量
        %th 折前
        %th 折扣
        %th 折后
        %th 非实收
        %th 实收
        %th 占比
    %tbody
      - @statistic.body.each do |row|
        %tr
          - row.each do |value|
            %td= value

    %tfoot{class: 'alert alert-warning'}
      - @statistic.foot.each do |foot_row|
        %tr
          - foot_row.each do |value|
            %td= value


