- logs = order.order_change_logs
- if logs.present?
  .ibox
    .ibox-title 
      %h3 订单状态变更
    .ibox-content
      %table.table.table-striped
        %thead
          %tr
            %th.col-sm-1 时间
            %th.col-sm-1 类型
            %th.col-sm-1 操作人
            %th.col-sm-1
        %tbody
          - logs.each do |log|
            %tr
              %td= log.created_at.strftime("%F %T")
              %td= log.type_name
              %td= log.operator_name
              %td= log.info
              