.header
  %h3= "小票补打"
= form_tag([:reprint, :backend, @current_shop, @order.branch, @order], class: 'form-horizontal', remote: true, method: :post) do
  .field.form-group
    .col-xs-3.control-label
      = label_tag "选择打印机"
    .col-xs-9
      = text_field_tag :target_ids, "", data: { url: url_for([:chooseable_printers, :backend, @current_shop, @order.branch, @order])}, class: 'ddb-select2 col-xs-6'
  .field.form-group
    .col-xs-3.control-label
      = label_tag "备注"
    .col-xs-9
      = text_area_tag :note

  .form-actions.col-xs-offset-2{style: "margin-top: 100px;"}
    = submit_tag "确认", :class => "btn btn-primary btn-sm"
:javascript
  $(function(){init_ddb_select2();});