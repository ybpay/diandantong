.ibox
  .ibox-title
    %h3 预订信息
    .ibox-content
      %table.table.table-striped
        %thead
          %tr
            %td
              %b
                预付款方式:
            %td= order.prepayment_type_name
          - if order.is_prepay_for_order?
            %tr
              %td
                %b
                  预付款比例:
              %td= "#{order.reservation_table_zone.try(:reservation_price_percent)}%"
          %tr
            %td
              %b
                预订人信息:
            %td= order.reservation_customer_info
          %tr
            %td
              %b
                预订时间:
            %td= order.reservation_time_info