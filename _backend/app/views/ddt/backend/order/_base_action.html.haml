.ibox-footer
  = order_actions(order, remote: false, size: :normal)
  = link_to "小票补打",[:get_reprint, :backend, @current_shop, order.branch, order], remote: true
  - if order.can_append_pay_item? && (current_account.is_boss? || current_account.is_admin?)
    = link_to "追加支付条目",[:get_append_pay_item, :backend, @current_shop, order.branch, order], remote: true

  - if order.pay_items.any?{|p| p.is_append? }
    = link_to '清除调账', [:clear_appended, :backend, @current_shop, order.branch, order], method: :put, data: {confirm: '清除所有追加条目？'}


- if order.can_cancel?
  = render partial: '/ddt/backend/order/cancel_reason'
