- branch = @order.branch

= simple_form_for(:append_pay_item, url: [:append_pay_item, :backend, @current_shop, branch, @order], html: { class: 'form-horizontal'}, wrapper: :horizontal_form_long, method: :put) do |f|
  .form-inputs
    = f.input :pay_method_id, input_html: { data: {"local-datas" => @current_shop.pay_methods.appendable.to_a, useas: "local_select", single: true,placeholder: "支付方式"}, class: 'ddb-select2 input-large' },  label: "支付方式"
    = f.input :amount, as: :decimal, label: '支付金额', input_html: { value: 0.0 }, required: true, hint: raw("例如减少付款金额请填写负数, 增加请填写正数")
    = f.input :description, as: :text, label: '说明', required: false

  .form-actions.col-xs-offset-2
    = f.submit "确认", :class => "btn btn-primary btn-sm", data: { disable_with: "正在提交.." }

:javascript
  $(function(){
    init_ddb_select2()
  })
