.ibox
  .ibox-title 
    %h3= "订单详情#{order.number}"

    - if order.errors.full_messages.any?
      .alert.alert-danger
        = raw error_message_in_html(order)
  .ibox-content
    %table.table.table-striped
      %thead
        %tr
          %th.col-sm-1= "名称"
          %th.col-sm-1= "单价"
          %th.col-sm-1= "数量"
          %th.col-sm-1= "小计"
      %tbody
        - if order.line_items.any?
          - order.line_items.active.each do |line_item|
            %tr
              %td
                = line_item.name_with_note
                - if line_item.gift
                  %span.red (赠)
              %td
                = line_item.price_in_currency
                - if line_item.original_price != line_item.price
                  - if line_item.is_change_price
                    %span.change-price
                      = line_item.original_price_in_currency
                  - else
                    %span.original-price
                      = line_item.original_price_in_currency

              %td= line_item.active_quantity
              %td
                = line_item.total_in_currency
                - if line_item.total != line_item.amount
                  %span.original-amount
                    = line_item.amount
          %tr.warning
            %td{ colspan: 3}
              = "菜品合计："
            %td
              = order.consume_amount_in_currency
          %tr.warning
            %td{ colspan: 3}
              = "抹零金额："
            %td
              = order.moling_amount_in_currency
        - else
          %tr
            %td{ colspan: 4 } 无
        - order.adjustments.active.each do |adjustment|
          %tr
            %td{ colspan: 4 }
              = "#{adjustment.label} ： #{adjustment.amount} "
        - if order.is_delivery?
          %tr
            %td{ colspan: 4 }
              = "外送费： #{order.shipment_total}"
              - if order.shipment.cost != order.shipment_total
                %span.original-amount
                  = order.shipment.cost

    - if @order.form_contents.present?
      .model-show
        - @order.form_contents.each do|form_content|
          %p
            %b
              = form_content.label
              \:
            = form_content.content
        .space

= render partial: '/ddt/backend/order/base_order_trace_points', locals: {order: order}
= render partial: '/ddt/backend/order/base_order_change_logs', locals: {order: order}
