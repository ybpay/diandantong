
:css
  .modal-dialog { width: 90%; margin-left: 5%;}
  .get-assign { height: 600px;  margin-top: 40px;}
  .get-assign .map{ width: 70%; height: 600px; float: left;}
  .get-assign .man{ width: 30%; height: 600px; float: left; overflow: scroll;
    padding: 20px;
  }

.get-assign
  .map{id: 'map-container'}
  .man

    %table.table.table-striped.table-bordered
      %thead
        %tr
          %th.col-sm-1 配送员
          %th.col-sm-1 配送中
          %th.col-sm-1
      %tbody
        - @deliverymans.each do |man|
          %tr
            %td= man.name
            %td= man.shipping_order_count
            %td= link_to '指派给他', assign_backend_shop_branch_delivery_order_path(@current_shop, @order.branch_id, @order, delivery_man_id: man.id), class: 'btn btn-sm btn-success', remote: true, method: :put
    = link_to "取消指派", assign_backend_shop_branch_delivery_order_path(@current_shop, @order.branch_id, @order, delivery_man_id: nil), method: :put, remote: true, class: 'btn btn-sm btn-danger pull-right'
    %br
:javascript
  (function(){

    function init_map(){
      var map_data = JSON.parse('#{@map_json}')
      var center = new qq.maps.LatLng(map_data.start.lat, map_data.start.lng);
      var map = new qq.maps.Map(document.getElementById("map-container"), {
        center: center,
        zoom: 13
      });

      var branch_marker = new qq.maps.Marker({
        position: center,
        map: map
      })
      branch_marker.label = new qq.maps.Label({
        position: center,
        content: map_data.start.label,
        visible: true,
        map: map,
      })

      var toggle_label = function(e){
        var mk = e.target;
        mk.label.setMap(map)
        mk.label.setVisible(!mk.label.getVisible())
      }
      var toggle_info = function(e){
        var mk = e.target;
        if(mk.info.visible){
          mk.info.close()
        }else{
          mk.info.open()
        }
      }

      qq.maps.event.addListener(branch_marker, 'click', toggle_label)

      if(map_data.desti){
        var user = new qq.maps.LatLng(map_data.desti.lat, map_data.desti.lng)
        var user_marker = new qq.maps.Marker({
          position: user,
          map: map
        })
        user_marker.label = new qq.maps.Label({
          position: user,
          content: map_data.desti.label,
          visible: true,
          map: map
        })
        qq.maps.event.addListener(user_marker, 'click', toggle_label)
      }

      map_data.mans.forEach(function(man){
        var marker = new qq.maps.Marker({
          position: new qq.maps.LatLng(man.lat, man.lng),
          map: map,
          title: man.label
        })
        marker.info = new qq.maps.InfoWindow({
          position: new qq.maps.LatLng(man.lat, man.lng),
          content: man.label,
          visible: false,
          map: map
        })
        qq.maps.event.addListener(marker, 'mouseover', function(e){ e.target.info.open()})
        qq.maps.event.addListener(marker, 'mouseout', function(e){ e.target.info.close()})
        qq.maps.event.addListener(marker, 'click', function(e){
          var mk = e.target;
        })
      })
    }

    setTimeout(init_map, 0)


  })();
