- trace_points = order.line_item_trace_points
- if trace_points.present?
  .ibox
    .ibox-title 
      %h3 订单变更记录
    .ibox-content
      %table.table.table-striped
        %thead
          %tr
            %th.col-sm-1 商品名称
            %th.col-sm-1 批次
            %th.col-sm-1 操作类型
            %th.col-sm-1 操作者
            %th.col-sm-1 操作时间
            %th.col-sm-1 备注
            %th.col-sm-1 当前状态
            %th.col-sm-1
        %tbody
          - trace_points.group_by{|point| point.order_change_log_id }.each_with_index do |keys, index|
            - order_change_log_id = keys[0]
            - traces = keys[1]
            = render partial: '/ddt/backend/order/trace_points_table_tr', collection: traces, as: :trace, locals: { index: index, order_change_log: order.order_change_logs.find(order_change_log_id) }