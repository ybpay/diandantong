%h2 提款流水
%table.table.table-striped
  %thead
    %tr
      - show_for nil, Ddt::Withdraw do
        - attr_tab_head :id
        - attr_tab_head :state, sort_link: true
        - attr_tab_head :alipay_account_id, :alipay_account_name, :residual, :amount, :note
        - attr_tab_head :created_at, sort_link: true
  %tbody
    - @withdraws.each do |withdraw|
      %tr
        - show_for withdraw do
          - attr_tab_column :id
          %td
            - label_class = case withdraw.state
            - when 'frozen'
              - 'label-info'
            - when 'completed'
              - 'label-success'
            - when 'canceled'
              - 'label-warning'
            %div{:class=> "label #{label_class} withdraw-state"}
              = withdraw.state_name
          - attr_tab_column :alipay_account_id, :alipay_account_name, :residual, :amount, :note, :created_at
    = no_record_hint(@withdraws)

%br
.pull-right= will_paginate @withdraws , renderer: BootstrapPagination::Rails, bootstrap: 3
%br
