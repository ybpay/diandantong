- of_card = wallet_logs.first.try(:of_card?)
%table.table.table-striped
  %thead
    %tr
      %th.col-sm-1= sort_link(q, :created_at, Ddt::WalletLog.human_attribute_name(:created_at))
      %th.col-sm-1
      %th.col-sm-1= sort_link(q, :reason, Ddt::WalletLog.human_attribute_name(:reason))
      %th.col-sm-1= sort_link(q, :amount, Ddt::WalletLog.human_attribute_name(:amount))
      - if of_card
        %th.col-sm-1= sort_link(q, :cash_amount, Ddt::WalletLog.human_attribute_name(:cash_amount))
        %th.col-sm-1= sort_link(q, :extra_amount, Ddt::WalletLog.human_attribute_name(:extra_amount))
      %th.col-sm-1= Ddt::WalletLog.human_attribute_name(:note)
      %th.col-sm-1

  %tbody
    - wallet_logs.each do |wallet_log|
      %tr
        %td= wallet_log.created_at.strftime("%F %T")
        %td= wallet_log.owner_name
        %td= wallet_log.reason_name
        %td= wallet_log.display_amount
        - if of_card
          %td= wallet_log.cash_amount
          %td= wallet_log.extra_amount
        %td= wallet_log.note
        %td
          - if wallet_log.order.present?
            - order = wallet_log.order
            = link_to order.number, [:backend, @current_shop, order.branch, order]
%br
.pull-right= will_paginate wallet_logs , renderer: BootstrapPagination::Rails, bootstrap: 3
%br