.header
  %h3 余额日志

%p
  %b
    = Ddt::ShopCardWallet.human_attribute_name(:amount)
    \:
  = @wallet.display_amount

= search_form_for @q, url: [:wallet_logs, :backend, @current_shop, :shop_card_wallet], html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
  = f.input_field :created_at_gteq, as: :date, placeholder: Ddt::WalletLog.human_attribute_name(:created_at)
  %label{style: 'font-size:20px;'} ~
  = f.input_field :created_at_lteq, as: :date, placeholder: Ddt::WalletLog.human_attribute_name(:created_at)
  = f.input_field :wallet_type_eq, collection: [['门店余额','Ddt::BranchCardWallet'],['用户余额', 'Ddt::UserCardWallet']] , prompt: "类型", class: 'form-control'
  = f.input_field :reason_eq, collection: Ddt::WalletLog.all_reason_collection, placeholder: Ddt::WalletLog.human_attribute_name(:reason), class: 'form-control'
  = f.input_field :amount_gteq, placeholder: "数额范围", class: 'form-control'
  %label{style: 'font-size:20px;'} ~
  = f.input_field :amount_lteq, placeholder: "数额范围", class: 'form-control'
  = f.submit "搜索", class: "btn btn-success"
%br

= render partial: 'ddt/backend/wallet/wallet_logs_table', locals: { q: @q, wallet_logs: @wallet_logs }