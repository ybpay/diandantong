.header
  %h3 积分日志

%p
  %b
    = Ddt::ShopCreditsWallet.human_attribute_name(:amount)
    \:
  = @wallet.display_amount

= search_form_for @q, url: [:wallet_logs, :backend, @current_shop, :shop_credits_wallet], html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
  = f.input_field :created_at_gteq, as: :date, placeholder: Ddt::WalletLog.human_attribute_name(:created_at)
  %label{style: 'font-size:20px;'} ~
  = f.input_field :created_at_lteq, as: :date, placeholder: Ddt::WalletLog.human_attribute_name(:created_at)
  = f.input_field :wallet_type_eq, collection: [['门店积分','Ddt::BranchCreditsWallet'],['用户积分', 'Ddt::UserCreditsWallet']]
  = f.input_field :reason_eq, collection: Ddt::WalletLog.credits_reason_collection, placeholder: Ddt::WalletLog.human_attribute_name(:reason)
  = f.submit "搜索", class: "btn btn-sm  btn-success"
%br

= render partial: 'ddt/backend/wallet/wallet_logs_table', locals: { q: @q, wallet_logs: @wallet_logs }