.header
  %h3 用户积分管理

%p
  %b
    = Ddt::ShopCreditsWallet.human_attribute_name(:amount)
    \:
  = @wallet.display_amount

= search_form_for @q, url: [:base_users, :backend, @current_shop, :shop_credits_wallet], html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
  = f.input_field :type_eq, collection: Ddt::BaseUser.type_collection, include_blank: true
  = f.input_field :phone_cont, placeholder: Ddt::BaseUser.human_attribute_name(:phone)
  = f.submit "搜索", class: "btn btn-sm  btn-success"
%br

%table.table.table-striped.table-bordered
  %thead
    %tr
      %th.col-sm-3= Ddt::BaseUser.human_attribute_name(:name)
      %th.col-sm-3= Ddt::UserCreditsWallet.human_attribute_name(:amount)
      %th

  %tbody
    = render partial: '/ddt/backend/wallet/shop_credits_wallets/base_user_tr', collection: @base_users, as: :base_user
%br
.pull-right= will_paginate @base_users , renderer: BootstrapPagination::Rails, bootstrap: 3
%br
