.header
  %h3 门店积分管理

%p
  %b
    = Ddt::ShopCreditsWallet.human_attribute_name(:amount)
    \:
  = @wallet.display_amount

= search_form_for @q, url: [:branches, :backend, @current_shop, :shop_credits_wallet], html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
  = f.input_field :name_cont, placeholder: '门店名称'
  = f.submit "搜索", class: "btn btn-sm  btn-success"
%br

%table.table.table-striped.table-bordered
  %thead
    %tr
      %th.col-sm-3= sort_link(@q, :name, Ddt::Branch.human_attribute_name(:name))
      %th.col-sm-3= sort_link(@q, :amount, Ddt::BranchCreditsWallet.human_attribute_name(:amount))
      %th

  %tbody
    = render partial: '/ddt/backend/wallet/shop_credits_wallets/branch_tr', collection: @branches, as: :branch
%br
.pull-right= will_paginate @branches , renderer: BootstrapPagination::Rails, bootstrap: 3
%br