%table.table.table-striped.table-bordered
  %thead
    %tr
      - show_for nil, Ddt::User do
        - attr_tab_head :id, :name, :nickname, :headimgurl
        %td 系统 OPEN_ID
      %th
  %tbody
    - @valid_wechat_users.try(:each) do |user|
      %tr
        - show_for user do
          - attr_tab_column :id, :name, :nickname
          %td
            %img{src: user.headimgurl, width: '200px', alt: user.headimgurl}
          %td
            = link_to user.unique_user.user_open_id, weixin_shop_path(@current_shop, open_id: user.unique_user.user_open_id)
%br
.pull-right= will_paginate @valid_wechat_users , renderer: BootstrapPagination::Rails, bootstrap: 3
%br

