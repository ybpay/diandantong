.header
  %h3= "#{t('activerecord.models.ddt/vip_info')} 列表"

.alert.alert-warning
  %strong 警告
  %p
    在导入会员信息之前，请确保系统已经建立了相应的会员等级
    %br
    当您使用导入功能的时候, 请认真填写会员编号, 若系统中已经存在会员编号对应的会员， 将覆盖掉系统中的会员信息，请谨慎操作

.form-group
  .btn-group
    = link_to '发送绑定提醒', get_bindable_backend_shop_vip_infos_path(@current_shop), class: 'btn btn-primary btn-sm'
  .btn-group
    %button.btn.btn-sm.dropdown-toggle{type: "button", data: {toggle: "dropdown"}}
      导入导出
      %i.fa.fa-caret-down
    %ul.dropdown-menu
      %li
        = link_to "格式要求", '', id: 'upload_vip_info_file_requirement'
      %li
        = link_to "导出会员csv", backend_shop_vip_infos_path(@current_shop, format: "csv")
      %li
        = link_to "导出会员xls", backend_shop_vip_infos_path(@current_shop, format: "xls")
      %li
        = link_to "导入会员", "", id: "upload_vip_info_file"


.tabbable
  - search_unbind_vip_info = params[:q].present? && params[:q][:base_users_count_eq].present?
  - search_binded_vip_info = params[:q].present? && params[:q][:base_users_count_gt].present?
  - level_search_empty = params[:q].blank? || params[:q][:vip_level_id_eq].blank? && !search_binded_vip_info && !search_unbind_vip_info

  %ul.nav.nav-tabs
    %li{class: (level_search_empty) ? 'active' : nil}
      = link_to "所有会员", backend_shop_vip_infos_path(@current_shop)
    %li{class: ( search_binded_vip_info ? 'active' : nil)}
      = link_to "已绑定", backend_shop_vip_infos_path(@current_shop, {q: {base_users_count_gt: 0}})
    %li{class: ( search_unbind_vip_info  ? 'active' : nil)}
      = link_to "未绑定", backend_shop_vip_infos_path(@current_shop, {q: {base_users_count_eq: 0}})

    - @vip_levels.each do |vip_level|
      %li{class: ( params[:q].present? && params[:q][:vip_level_id_eq] == vip_level.id.to_s ? 'active' : nil)}
        = link_to "#{vip_level.name}", backend_shop_vip_infos_path(@current_shop, {q: {vip_level_id_eq: vip_level.id}})


  .tab-content
    .tab-pane.in.active

      #upload_vip_infos{title: "上传会员文件"}
        = form_tag import_vip_infos_backend_shop_vip_infos_path(@current_shop), method: "post", multipart: true do
          .form-group
            %label{for: "file"} 选择文件(csv xls)
            = file_field_tag "file"
          = submit_tag "上传文件"
      #upload_vip_info_requirment_modal{title: "导入会员文件格式要求"}
        %span
          %p
            %strong 注意：
          - Ddt::VipInfoImportExport::IMPORT_NOTICES.each_with_index do |notice, index|
            %p="#{index+1}.  #{notice}"

    .form-group
      = search_form_for @q, url: backend_shop_vip_infos_path(@current_shop), html: {class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
        = f.input_field :vip_no_cont, placeholder: Ddt::VipInfo.human_attribute_name(:vip_no)
        = f.input_field :name_cont, placeholder: Ddt::VipInfo.human_attribute_name(:name)
        = f.input_field :phone_eq, placeholder: Ddt::VipInfo.human_attribute_name(:phone)
        - if level_search_empty
          = f.input_field :vip_level_id_eq, collection: @current_shop.vip_levels, include_blank: true, prompt: '会员级别'
        = f.submit "搜索", class: 'btn btn-sm btn-success'
      - if params[:q].present? && params[:q][:base_users_count_eq].present?
        = link_to "删除所有未绑定的会员", destroy_all_backend_shop_vip_infos_path(@current_shop), method: 'post', class: 'btn btn-sm btn-danger', data: {confirm: '确认删除所有未绑定的会员?'}
    %table.table.table-striped.table-bordered
      %thead
        %tr
          %th.col-sm-1= sort_link(@q, :vip_no, Ddt::VipInfo.human_attribute_name(:vip_no))
          %th.col-sm-1= sort_link(@q, :name, Ddt::VipInfo.human_attribute_name(:name))
          %th.col-sm-1= sort_link(@q, :phone, Ddt::VipInfo.human_attribute_name(:phone))
          %th.col-sm-1= sort_link(@q, :sex, Ddt::VipInfo.human_attribute_name(:sex))
          %th.col-sm-1= sort_link(@q, :vip_level_name, Ddt::VipLevel.human_attribute_name(:name))
          %th.col-sm-1= sort_link(@q, :total_amount, Ddt::VipInfo.human_attribute_name(:total_amount))
          %th.col-sm-1= sort_link(@q, :is_verified, Ddt::VipInfo.human_attribute_name(:is_verified))
          %th.col-sm-1= sort_link(@q, :last_placed_at, Ddt::VipInfo.human_attribute_name(:last_placed_at))
          %th.col-sm-1

      %tbody
        - @vip_infos.each do |vip_info|
          %tr{id: "vip_info_#{vip_info.id}"}
            %td= vip_info.vip_no
            %td= vip_info.name
            %td= vip_info.phone
            %td= vip_info.sex_name
            %td= vip_info.vip_level.name
            %td= vip_info.total_amount_in_currency
            %td= verify_label(vip_info)
            %td= vip_info.last_placed_at.try(:strftime, "%F %T")
            %td
              = info_btn(vip_info)
              = edit_btn(vip_info)
              - if search_unbind_vip_info
                = delete_btn(vip_info, remote: true)
        = no_record_hint(@vip_infos)
    %br
    .pull-right= will_paginate @vip_infos , renderer: BootstrapPagination::Rails, bootstrap: 3
    %br
