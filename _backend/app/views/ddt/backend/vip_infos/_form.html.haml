= simple_form_for([:backend, @current_shop, @vip_info], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@vip_info)

    .form-inputs
      = f.input :vip_no, hint: '可以根据您店内已颁发的会员编号规则来为该用户设置会员编号'
      = f.input :name
      = f.input :phone
      = f.input :sex, collection: Ddt::VipInfo.sex_collection
      = f.input :id_number
      = f.input :birthday
      = f.input :address
      = f.input :email
      = f.input :avatar, as: :image_preview
      = f.input :note
      = f.input :is_verified
      = f.association :vip_level, collection: @current_shop.vip_levels, hint: raw("如果没有会员级别，请点击#{link_to '创建会员级别', new_backend_shop_vip_level_path(@current_shop), class: 'label label-info', target: '_blank'}")
      - if @vip_info.new_record?
        = f.input :pay_password, as: :password, hint: '只允许英文字母、数字以及下划线\'_\''

    .form-actions.col-xs-offset-2
      = f.button :submit, :class => "btn btn-primary btn-sm"
