.header
  %h3= "#{t('activerecord.models.ddt/vip_info')} 详情"

.model-show
  %p
    %b
      = Ddt::VipInfo.human_attribute_name(:vip_no)
      \:
    = @vip_info.vip_no
  %p
    %b
      = Ddt::VipInfo.human_attribute_name(:name)
      \:
    = @vip_info.name
  %p
    %b
      = Ddt::VipInfo.human_attribute_name(:phone)
      \:
    = @vip_info.phone
  %p
    %b
      = Ddt::VipInfo.human_attribute_name(:vip_level)
      \:
    = @vip_info.vip_level.name
  %p
    %b
      = Ddt::UserCardWallet.human_attribute_name(:amount)
      \:
    = @vip_info.base_user.card_wallet.display_amount rescue nil
  %p
    %b
      = Ddt::UserCreditsWallet.human_attribute_name(:amount)
      \:
    = @vip_info.base_user.credits_wallet.display_amount rescue nil
  %p
    %b
      = Ddt::VipInfo.human_attribute_name(:total_amount)
      \:
    = @vip_info.total_amount
  %p
    %b
      = Ddt::VipInfo.human_attribute_name(:is_verified)
      \:
    = verify_label(@vip_info)
  %p
    %b
      = Ddt::VipInfo.human_attribute_name(:sex)
      \:
    = @vip_info.sex_name
  %p
    %b
      = Ddt::VipInfo.human_attribute_name(:birthday)
      \:
    = @vip_info.birthday.try(:strftime, "%Y-%m-%d")

    
  - [ :id_number, :birthday, :address, :email, :note].each do |column|
    %p
      %b
        = Ddt::VipInfo.human_attribute_name(column)
        \:
      = @vip_info.send(column)
  %p
    %b
      = Ddt::VipInfo.human_attribute_name(:avatar)
      \:
    = image_tag @vip_info.avatar
  .space

= link_to t('Edit'), edit_backend_shop_vip_info_path(@current_shop, @vip_info), :class => "btn btn-primary btn-sm"
\
= link_to t('Back'), backend_shop_vip_infos_path(@current_shop), :class => "btn btn-default btn-sm"