= simple_form_for([:update_pay_password, :backend, @current_shop, @vip_info], html: { class: 'form-horizontal'}) do |f|
  -  f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@vip_info)

    .form_inputs     
      = f.input :pay_password, required: false

    .form-actions.col-xs-offset-2
      = f.button :submit, :class => "btn btn-primary btn-sm"
