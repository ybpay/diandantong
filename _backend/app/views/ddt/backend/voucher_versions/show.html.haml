.ibox
  .ibox-title
    %h3= "#{t('activerecord.models.ddt/voucher_version')} 详情"
  .ibox-content
    .col-md-10
      .model-show
        %p
          %b
            = Ddt::VoucherVersion.human_attribute_name(:name)
            \:
          = @voucher_version.name
        %p
          %b
            = Ddt::VoucherVersion.human_attribute_name(:branches)
            \:
          = @voucher_version.branch_names
        %p
          %b
            = Ddt::VoucherVersion.human_attribute_name(:sellable_starts_at)
            \:
          = @voucher_version.sellable_starts_at
        %p
          %b
            = Ddt::VoucherVersion.human_attribute_name(:sellable_expires_at)
            \:
          = @voucher_version.sellable_expires_at
        %p
          %b
            = Ddt::VoucherVersion.human_attribute_name(:usable_starts_at)
            \:
          = @voucher_version.usable_starts_at
        %p
          %b
            = Ddt::VoucherVersion.human_attribute_name(:usable_expires_at)
            \:
          = @voucher_version.usable_expires_at
        %p
          %b
            = Ddt::VoucherVersion.human_attribute_name(:max_grant_limit)
            \:
          = @voucher_version.max_grant_limit
        %p
          %b
            = Ddt::VoucherVersion.human_attribute_name(:max_count_each_user)
            \:
          = @voucher_version.max_count_each_user
        %p
          %b
            = Ddt::VoucherVersion.human_attribute_name(:description)
            \:
          = @voucher_version.description
        %p
          %b
            = Ddt::VoucherVersion.human_attribute_name(:support_refund)
            \:
          = @voucher_version.support_refund ? '是' : '否'
        %p
          %b
            = Ddt::VoucherVersion.human_attribute_name(:refundable_days_after_send)
            \:
          = @voucher_version.refundable_days_after_send
        %p
          %b
            = Ddt::VoucherVersion.human_attribute_name(:applicaple_product_scope)
            \:
          = @voucher_version.applicaple_product_scope
        .space

      = link_to t('Edit'), edit_backend_shop_voucher_version_path(@current_shop, @voucher_version), :class => "btn btn-primary btn-sm"
      \
      = link_to t('Back'), backend_shop_voucher_versions_path(@current_shop), :class => "btn btn-default btn-sm"
    .clearfix

