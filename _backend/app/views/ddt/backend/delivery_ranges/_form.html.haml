
.tip.alert.alert-info
  %strong
    温馨提示：
  %p
    您可以为不同的配送范围设置不同的配送费
    %br
      %strong 例如：
    0km - 3km 配送费为 5元
    %br
    3km - 5km 配送费为 8元

= simple_form_for([:backend, @current_shop, @current_branch, @delivery_range], html: { class: 'form-horizontal', remote: true}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@delivery_range)
    .form-inputs
      = f.input :start_at, as: :integer, hint: "单位： km(千米),只能是整数, 范围包含该端点值"
      = f.input :end_at, as: :integer, hint: "单位： km(千米),只能是整数, 范围不包含该端点值"
      = f.input :cost

    .form-actions.col-xs-offset-2
      = f.button :submit, :class => "btn btn-primary btn-sm"
