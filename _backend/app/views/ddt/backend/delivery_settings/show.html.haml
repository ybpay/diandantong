.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox
    .ibox-title
      %h2= "#{t('activerecord.models.ddt/delivery_setting')} 详情"
      .alert.alert-success 如需设置满多少钱免外送费的功能，请使用“满减优惠”进行设置。
    .ibox-content.header
      .row
        .col-md-6.form-group
          %b
            = Ddt::DeliverySetting.human_attribute_name(:support_delivery_if_amount_gt)
            \:
          = @delivery_setting.support_delivery_if_amount_gt
        .col-md-6.form-group
          %b
            = Ddt::DeliverySetting.human_attribute_name(:receive_delivery_order_within_days)
            \:
          = @delivery_setting.receive_delivery_order_within_days
        .col-md-6.form-group
          %b
            = Ddt::DeliverySetting.human_attribute_name(:enable_auto_ship)
            \:
          = @delivery_setting.enable_auto_ship? ? "已开启" : "未开启"
        .col-md-6.form-group
          %b
            = Ddt::DeliverySetting.human_attribute_name(:enable_auto_complete)
            \:
          = @delivery_setting.enable_auto_complete? ? "已开启" : "未开启"
        .col-md-6.form-group
          %b
            = Ddt::DeliverySetting.human_attribute_name(:use_fixed_delivery_time)
            \:
          - if @delivery_setting.use_fixed_delivery_time?
            - @delivery_setting.delivery_times.each do|delivery_time|
              %br
              = delivery_time.start_time.strftime('%H:%M')
              \~
              = delivery_time.end_time.strftime('%H:%M')
              - if delivery_time.enable_limit?
                截单时间
                = delivery_time.cut_off_time.strftime("%H:%M")
          - else
            = '不使用'
        .col-md-6.form-group
          %b
            = Ddt::DeliverySetting.human_attribute_name(:delivery_radius)
            \:
          = number_to_human(@delivery_setting.delivery_radius, unit: 'distance')
          公里
        .col-md-6.form-group
          %b
            = Ddt::DeliverySetting.human_attribute_name(:support_order_if_not_in_delivery_radius)
            \:
          = @delivery_setting.support_order_if_not_in_delivery_radius? ? '允许' : '不允许'

        .col-md-6.form-group
          %b
            = Ddt::DeliverySetting.human_attribute_name(:delivery_need_minutes)
            \:
          = @delivery_setting.delivery_need_minutes
          分钟
        .col-md-6.form-group
          %b
            = Ddt::DeliverySetting.human_attribute_name(:charge_by)
            \:
          = Ddt::DeliverySetting.charge_by_name(@delivery_setting.charge_by.to_sym)
        - if @delivery_setting.charge_by == "per_unit"
          .col-md-6.form-group
            %b
              = Ddt::DeliverySetting.human_attribute_name(:unit)
              \:
            = @delivery_setting.unit
          .col-md-6.form-group
            %b
              = Ddt::DeliverySetting.human_attribute_name(:per_unit_cost)
              \:
            = number_to_currency(@delivery_setting.per_unit_cost, unit: @current_shop.currency)
        .col-md-6.form-group
          %b
            = Ddt::DeliverySetting.human_attribute_name(:assign_mode)
            \:
          = @delivery_setting.assign_mode_name

        .space
      .edit-area
        - if ["range", "per_unit"].include? @delivery_setting.charge_by
          .alert.alert-warning
            %strong
              警告:
            .col-md-6.form-group
              该种收费方式下，只在微信端起作用，在其他地方下的外送单请商家自行收取配送费
        - if @delivery_setting.charge_by == "zone"
          = render '/ddt/backend/delivery_zones/index'
        - if @delivery_setting.charge_by == "range"
          = render '/ddt/backend/delivery_ranges/index'


      .space
      .space
      = link_to t('Edit'), edit_backend_shop_branch_delivery_setting_path(@current_shop, @current_branch), :class => "btn btn-primary btn-sm"

