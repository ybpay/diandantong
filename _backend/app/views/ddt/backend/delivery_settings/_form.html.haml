= simple_nested_form_for([:backend, @current_shop, @current_branch, @delivery_setting], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@delivery_setting)

    .form-inputs
      .col-md-6.form-group
        = f.input :support_delivery_if_amount_gt, hint: '低于该金额用户无法下单，商家拒绝配送'
      .col-md-6.form-group
        = f.input :receive_delivery_order_within_days, hint: '单位：天，如果只接受当天订单，请填写0'
      .col-md-6.form-group
        = f.input :delivery_radius, hint: '单位：公里'
      .col-md-6.form-group
        = f.input :support_order_if_not_in_delivery_radius, hint: raw('距离大于配送半径时是否允许下单，注意：手机定位精确性受天气、用户终端设备是否开启GPS以及硬件配置等影响很大，若此项设置为不允许下单，可能会导致部分用户无法成功下单')
      .clearfix
      .col-md-6.form-group
        = f.input :delivery_need_minutes, hint: '单位： 分钟'
      .col-md-6.form-group
        = f.input :charge_by, collection: Ddt::DeliverySetting.charge_by_collection, hint: raw('<span class="label label-info">保存此项后可以进行配送费设置</span>')
      .col-md-6.form-group
        = f.input :enable_auto_ship, hint: "开启后， 一旦订单进入配送流程(被配送员改为标记为配送中)， 3小时后自动把订单标记为已送达"
      .col-md-6.form-group
        = f.input :enable_auto_complete, hint: "开启后，一旦订单已支付并配送完成, 系统自动标记该订单为已完成"
      .clearfix
      .col-md-6.form-group
        = f.input :assign_mode, collection: Ddt::DeliverySetting.assign_mode_collection
        .charge_by_per_unit
          = f.input :unit, hint: "单位： km(千米), 例如：按每2公里收费，则填: 2"
          = f.input :per_unit_cost, hint: "例如： 每2公里收费1元， 则填: 1"
      .col-md-6.form-group
        = f.input :use_fixed_delivery_time, hint: '固定配送时间可以让用户自主选择那个时间段进行配送，有助于提高经营者的配送效率。'
      #delivery-times-section
        = f.simple_fields_for :delivery_times do |delivery_time|
          - delivery_time.input Ddt::DeliverySetting.human_attribute_name(:delivery_times), wrapper: :horizontal_form_long do
            .col-sm-5.row
              .col-md-6.form-group
                %label= Ddt::DeliveryTime.human_attribute_name(:start_time)
                = delivery_time.input_field :start_time
              .col-md-6.form-group
                %label= Ddt::DeliveryTime.human_attribute_name(:end_time)
                = delivery_time.input_field :end_time
              .clearfix
              %br
              .col-md-6.form-group
                %label= Ddt::DeliveryTime.human_attribute_name(:cost)
                = delivery_time.input_field :cost
              .col-md-6.form-group
                %label= Ddt::DeliveryTime.human_attribute_name(:cut_off_time)
                = delivery_time.input_field :cut_off_time
                = delivery_time.input_field :enable_limit
                %label= Ddt::DeliveryTime.human_attribute_name(:enable_limit)
              %br
              = delivery_time.link_to_remove t('Destroy'), class: 'btn btn-danger btn-xs'

      .col-sm-offset-2.control-group
        = f.link_to_add t('new delivery time'), :delivery_times, :class=>'btn btn-success btn-xs', :data => { :target => "#delivery-times-section" }

    .form-actions.col-xs-offset-2
      = f.button :submit, :class => "btn btn-primary btn-sm"
:javascript
  $(function(){
    function change_config(key){
      var help_block = $('.help-block', '.form-group.delivery_setting_charge_by');
      if(key == "per_unit"){
        $(".charge_by_per_unit").show();
        help_block.hide();
      }else{
        $(".charge_by_per_unit").hide();
        help_block.show();
      }
    }
    $("#delivery_setting_charge_by").change(function(e){
      change_config($(this).val());
    })
    change_config($("#delivery_setting_charge_by").val());
  });
