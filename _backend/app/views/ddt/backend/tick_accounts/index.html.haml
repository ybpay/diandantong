.ibox
  .ibox-title
    .block
      %h2= "#{t('activerecord.models.ddt/tick_account')} 列表"

    = new_btn(:tick_account)
  .ibox-content
    %table.table.table-striped
      %thead
        %tr
          %th.col-sm-2= Ddt::TickAccount.human_attribute_name(:name)
          %th.col-sm-4= Ddt::TickAccount.human_attribute_name(:note)
          %th.col-sm-1= Ddt::TickAccount.human_attribute_name(:enable)
          %th.col-sm-4
      %tbody
        - @tick_accounts.each do |tick_account|
          %tr
            %td= tick_account.name
            %td= tick_account.note
            %td= tick_account.enable? ? "启用" : "禁用"
            %td
              = edit_btn(tick_account)
              = link_to "挂账条目", [:backend, @current_shop, @current_branch, tick_account, :tick_account_items]
              = delete_btn(tick_account)
        = no_record_hint(@tick_accounts)
    %br
    .pull-right= will_paginate @tick_accounts , renderer: BootstrapPagination::Rails, bootstrap: 3
    %br
