.ibox
  .ibox-title
    %h2= "#{t('activerecord.models.ddt/recharge_refund')} 列表"
  .ibox-content.m-b-sm.border-bottom

    .order-query-form
      = form_for @q, url: [:backend, @current_shop, :recharge_refunds], method: :get, html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
        = f.input_field :order_number_eq, placeholder: '订单号', class: "form-control"
        = f.input_field :branch_id_eq, data: {"local-datas" => @current_shop.branches, useas: "local_select", single: true,placeholder: "选择门店"},class: 'ddb-select2 input-medium'
        = f.input_field :state_eq, collection: Ddt::RechargeRefund.state_collection, include_blank: true, prompt: "状态", class: "form-control"
        = f.input_field :created_at_gteq, as: :date, placeholder: "退款时间", class: "form-control"
        %label{style: 'font-size:20px;'} ~
        = f.input_field :created_at_lteq, as: :date, placeholder: "退款时间", class: "form-control"
        = f.submit '搜索', class: 'btn btn-sm btn-success'
    %br/
    %table.table.table-striped
      %thead
        %tr
          %th.col-sm-1= sort_link(@q, :order_number, "订单号")
          %th.col-sm-1= sort_link(@q, :branch_id, "门店")
          %th.col-sm-1= sort_link(@q, :state, "状态")
          %th.col-sm-1= sort_link(@q, :cash_amount, "充值额")
          %th.col-sm-1= sort_link(@q, :credits, "赠送积分")
          %th.col-sm-1= sort_link(@q, :operator_id, "操作者")
          %th.col-sm-2= sort_link(@q, :created_at, "退款时间")
          %th.col-sm-1= sort_link(@q, :reviewer_id, "审核人")
          %th.col-sm-2= sort_link(@q, :review_time, "审核时间")
          %th.col-sm-1

      %tbody
        = render partial: 'table_tr', collection: @recharge_refunds, as: :recharge_refund

    = will_paginate @recharge_refunds , renderer: BootstrapPagination::Rails, bootstrap: 3