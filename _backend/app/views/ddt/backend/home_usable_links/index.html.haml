.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h3= "#{t('activerecord.models.ddt/home_usable_link')} 列表"

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        = new_btn([:custom_weixin_info, :home_usable_link], label: '首页实用链接')

  .row
    .col-lg-12
      .ibox
        .ibox-content
          = render partial: 'table', locals: { home_usable_links: @home_usable_links }
