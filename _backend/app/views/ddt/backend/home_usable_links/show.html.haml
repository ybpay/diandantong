
.ibox
  .ibox-title
    %h3= "#{t('activerecord.models.ddt/home_usable_link')} 详情"
  .ibox-content
    .col-md-6
      .model-show
        - [:title, :keywords, :link].each do |column|
          %p
            %b
              = Ddt::HomeUsableLink.human_attribute_name(column)
              \:
            = @home_usable_link.send(column)
        %p
          %b
            = Ddt::HomeUsableLink.human_attribute_name(:image)
            \:
          = image_tag(@home_usable_link.image.thumb.url) if @home_usable_link.image.url.present?
        .space


      = link_to t('Edit'), [:edit, :backend, @current_shop, :custom_weixin_info, @home_usable_link], :class => "btn btn-primary btn-sm"
      \
      = link_to t('Back'), [:backend, @current_shop, :custom_weixin_info, :home_usable_links], :class => "btn btn-default btn-sm"
    .clearfix
