.header
  %h3= "#{t('activerecord.models.ddt/coupon')} 详情"
.model-show
  %p
    %b
      = Ddt::Coupon.human_attribute_name(:id)
      \:
    = @coupon.id
  %p
    %b
      = Ddt::Coupon.human_attribute_name(:base_user)
      \:
    = link_to base_user_label(@coupon.base_user)
  %p
    %b
      = Ddt::Coupon.human_attribute_name(:coupon_version)
      \:
    = link_to @coupon.coupon_version.name, [:backend, @current_shop, @coupon.coupon_version]
  %p
    %b
      = Ddt::Coupon.human_attribute_name(:coupon_no)
      \:
    = @coupon.coupon_no
  %p
    %b
      = Ddt::Coupon.human_attribute_name(:created_at)
      \:
    = @coupon.created_at
  %p
    %b
      = Ddt::Coupon.human_attribute_name(:expires_at)
      \:
    = @coupon.expires_at
  %p
    %b
      = Ddt::Coupon.human_attribute_name(:applied_at)
      \:
    = @coupon.applied_at
  - if @coupon.applied_to_order.present?
    %p
      %b
        = Ddt::Coupon.human_attribute_name(:applied_to_order)
        \:
      = link_to @coupon.applied_to_order, [:backend, @current_shop, @coupon.applied_to_order.branch, @coupon.applied_to_order]
  .space

= link_to t('Back'), backend_shop_coupons_path(@current_shop), :class => "btn btn-default btn-sm"
