- user_count = @current_shop.base_users.joins(:vip_info).count
%div(id='send_to_all_confirm_msg' data="您使用的批量发放功能要将优惠券发送给#{user_count}人，发送过程预计#{3*user_count/3600.0}小时，您是否确认继续？")

= simple_form_for([:backend, @current_shop, @current_branch, @coupon], html: { class: 'form-horizontal'}) do |f|

  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@coupon)
    .form-inputs
      = f.association :coupon_version, collection: @current_shop.coupon_versions.map{|coupon| [coupon.name, coupon.id]}, required: true
      .form-group
        %label.col-sm-4.col-xs-offset-2
          = check_box_tag :send_to_all
          %span 是否发送给所有人
      = f.input :base_user, input_html: { data: { column: 'phone_or_email_or_unique_user_nickname_cont', url: backend_shop_base_users_path(@current_shop), placeholder: "请选择用户" }, class: 'ddb-select2'}, hint: '输入用户名,电话,邮箱搜索'

    .form-actions.col-xs-offset-2
      = f.button :submit, t('new coupon'), :class => "btn btn-primary btn-sm", disable_with: "发放中...", id: 'new_coupon_button'
:javascript
  $(function(){
    $("#send_to_all").on("click", function(){
      if($(this).is(':checked')){
        $(".coupon_base_user").hide();
      }else{
        $(".coupon_base_user").show();
      }
    });

    $("#new_coupon_button").on("click", function(){
      if ($("#send_to_all").prop("checked") == true){
        return confirm($('#send_to_all_confirm_msg').attr("data"));
      }else{
        return true;
      }
    });
  });

