.header
  %h3= '修改时段'
= simple_form_for([:backend, @current_shop, @time_interval], html: { class: 'form-horizontal'}, remote: true) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@time_interval)

    .form-inputs
      = f.input :name, placeholder: '例如：午市'
      = f.input :start, as: :time, hint: '开始时间'
      = f.input :interval_in_hour, hint: '时间长度,以小时为单位'

    .form-actions.col-xs-offset-2
      = f.button :submit, '保存', :class => 'btn btn-primary btn-sm'
