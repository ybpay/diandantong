.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/time_interval')} 列表"
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        = link_to "新建 #{t('activerecord.models.ddt/time_interval')}", { :remote=>true }, { :class=>'btn btn-primary', href: new_backend_shop_time_interval_path(@current_shop)}
  .row
    .col-lg-12
      .ibox
        .ibox-content
          %table.table.table-striped#time-intervals-table
            = render partial: 'th'
            = render partial: 'tr', collection: @time_intervals, as: :time_interval
            = no_record_hint(@time_intervals)

          %br
          .pull-right= will_paginate @time_intervals , renderer: BootstrapPagination::Rails, bootstrap: 3
          %br
