.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{@tick_account.name} #{t('activerecord.models.ddt/tick_account_item')} 列表"
    %p= "未结总计 #{@amount_not_complete}"

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-sm-12
        = link_to "批量结算", [:batch_complete, :backend, @current_shop, @current_branch, @tick_account, :tick_account_items], class: "btn btn-success btn-sm", data: { method: :put, confirm: "确认将所有未结条目改为已结?" }
  .row
    .col-lg-12
      .ibox
        .ibox-content
          %table.table.table-striped
            %thead
              %tr
                %th.col-sm-2= Ddt::TickAccountItem.human_attribute_name(:order_number)
                %th.col-sm-2= Ddt::TickAccountItem.human_attribute_name(:amount)
                %th.col-sm-1= Ddt::TickAccountItem.human_attribute_name(:state)
                %th.col-sm-2
            %tbody
              = render partial: "item", collection: @items, as: :item
              = no_record_hint(@items)
%br
.pull-right= will_paginate @items , renderer: BootstrapPagination::Rails, bootstrap: 3
%br
