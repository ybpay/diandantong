.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/essential_product')}列表"
    %p
      在这里设置微信下单必选品
    %p 如果用户提交订单时选择该类产品不足，系统下单时，会自动为其补足。
    %p 堂点勾选按人数选项，订单至少需要 客户人数 * 数量 个产品


.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        = new_btn(:essential_product, label: t('activerecord.models.ddt/essential_product'))

  .row
    .col-lg-12
      .ibox
        .ibox-content
          %table.table.table-striped
            %thead
              %tr
                %th.col-sm-2= "产品统一编号"
                %th.col-sm-2= sort_link(@q , :variant_id , Ddt::EssentialProduct.human_attribute_name(:variant_id))
                %th.col-sm-1= sort_link(@q , :quantity , Ddt::EssentialProduct.human_attribute_name(:quantity))
                %th.col-sm-1= sort_link(@q , :order_type , Ddt::EssentialProduct.human_attribute_name(:order_type))
                %th.col-sm-1= sort_link(@q , :per_guest   , Ddt::EssentialProduct.human_attribute_name(:per_guest))
                %th.col-sm-2

            %tbody
              - @essential_products.each do |essential_product|
                %tr
                  %td= essential_product.variant.sku
                  %td= link_to essential_product.variant.name, [:backend, @current_shop, @current_branch, essential_product.product]
                  %td= essential_product.quantity
                  %td= essential_product.order_type_name
                  %td
                    - if essential_product.is_eat_in_hall?
                      = essential_product.per_guest ? '是' : '否'
                  %td
                    = edit_btn(essential_product)
                    = delete_btn(essential_product)
              = no_record_hint(@essential_products)
          %br
          .pull-right= will_paginate @essential_products , renderer: BootstrapPagination::Rails, bootstrap: 3
          %br


