.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox
    .ibox-title
      %h2= "#{t('activerecord.models.ddt/eat_in_hall_setting')} 详情"
    .ibox-content.header
      .row
        .col-md-6.form-group
          %b
            = Ddt::EatInHallSetting.human_attribute_name(:auto_clear_table)
            \:
          = @eat_in_hall_setting.auto_clear_table? ? '是' : '否'
        .col-md-6.form-group
          %b
            = Ddt::EatInHallSetting.human_attribute_name(:disable_service)
            \:
          = @eat_in_hall_setting.disable_service? ? '是' : '否'
        .col-md-6.form-group
          %b
            = Ddt::EatInHallSetting.human_attribute_name(:mode)
            \:
          = @eat_in_hall_setting.mode_name
        .col-md-6.form-group
          %b
            = Ddt::EatInHallSetting.human_attribute_name(:can_place_when_zero)
            \:
          = @eat_in_hall_setting.can_place_when_zero? ? '是' : '否'
        .col-md-6.form-group
          %b
            = Ddt::EatInHallSetting.human_attribute_name(:auto_pay_when_zero)
            \:
          = @eat_in_hall_setting.auto_pay_when_zero? ? '是' : '否'
        .col-md-6.form-group
          %b
            = Ddt::EatInHallSetting.human_attribute_name(:accessable_ssid_for_app)
            \:
          = @eat_in_hall_setting.accessable_ssid_for_app
        .col-md-6.form-group
          %b
            = Ddt::EatInHallSetting.human_attribute_name(:confirm_type)
            \:
          = @eat_in_hall_setting.confirm_type_name
        .space

      = link_to t('Edit'), edit_backend_shop_branch_eat_in_hall_setting_path(@current_shop, @current_branch), :class => "btn btn-primary btn-sm"
