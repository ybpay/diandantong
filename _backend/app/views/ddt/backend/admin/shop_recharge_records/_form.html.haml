.alert.alert-info
  当前充值账号为
  %strong
    = @current_shop.name
  (id:
  %strong
    = @current_shop.id
  ),
  当前系统的版本为
  %strong
    = @current_shop.shop_type_name
  ,
  最大可以创建
  %strong
    = @current_shop.max_branches_limit
  家门店。
= simple_form_for([:backend, @current_shop, @shop_recharge_record], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@shop_recharge_record)
    - old_feature_module_group = Ddt::FeatureModuleGroup.send(@current_shop.shop_type)
    - feature_module_group = Ddt::FeatureModuleGroup.send(@shop_recharge_record.recharge_type)
    .form-inputs
      .col-sm-6
        .form-group
          %label.control-label.col-sm-4 当前模块
          .col-sm-8
            %p.form-control-static= "#{old_feature_module_group[:label]}，允许#{@current_shop.max_branches_limit}门店"

        .form-group
          %label.control-label.col-sm-4 当前模块剩余时间
          .col-sm-8
            %p.form-control-static= "#{((@current_shop.expiration_time - DateTime.now).to_i/3600/24).round}天，折价#{number_to_currency(Ddt::FeatureModuleGroup.amount_of(@current_shop.shop_type, ((@current_shop.expiration_time - DateTime.now).to_i/3600/24).round, @current_shop.max_branches_limit), unit: '¥')}"
        = f.input :recharge_type, as: :hidden
        .form-group
          = f.label :recharge_type, class: 'control-label col-sm-4'
          .col-sm-8
            %p.form-control-static= feature_module_group[:label]
            %p.help-block= "价格:#{number_to_currency(feature_module_group[:price], unit: '¥')}#{('/店' if feature_module_group[:charge_by_branch])}/年，包含如下功能服务模块：#{Ddt::FeatureModuleGroup.module_names(@shop_recharge_record.recharge_type)}"
        = f.input :increment_days
        = f.input :branch_num, collection: 1.upto(500).map{|i| [i,i]}, include_blank: false
        = f.input :price
        = f.input :note
      .clearfix
    .form-actions
      .col-sm-6
        .col-sm-offset-4
          = f.button :submit, :class => "btn btn-primary btn-sm"
      .clearfix

:javascript
    $(function(){
      var get_branch_num = function(){
        return parseInt($('#shop_recharge_record_branch_num').val());
      }
      var price_changed = function(e){
         $.ajax({
            url: "#{price_of_charge_version_backend_shop_feature_modules_configs_path(@current_shop)}",
            type: "GET",
            data: {
              "branch_num" : get_branch_num(), 
              "increment_days": $('#shop_recharge_record_increment_days').val(), 
              "feature_module_group": $('#shop_recharge_record_recharge_type').val()},
            dataType: "json",
            success: function(resp) {
              if(resp.price) $('#shop_recharge_record_price').val(resp.price)
            }
          });
      }
      $('#shop_recharge_record_increment_days').on('change', price_changed)
      $('#shop_recharge_record_recharge_type').on('change', price_changed)
      $('#shop_recharge_record_branch_num').on('change', price_changed)
    });























      

