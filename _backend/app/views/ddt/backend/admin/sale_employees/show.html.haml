.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox
    .ibox-title
      %h2= @sale_employee.info
  .ibox-content.header
    %table.table.table-striped
      %thead
        %tr
          %th.col-sm-2= sort_link(@q , :name, Ddt::Shop.human_attribute_name(:name))
          %th.col-sm-2= sort_link(@q , :updated_sale_employee_at, Ddt::Shop.human_attribute_name(:updated_sale_employee_at))
          %th.col-sm-2= Ddt::Shop.human_attribute_name(:agent)
          %th.col-sm-2
      %tbody
        - @sale_employee.all_shops.each do |shop|
          %tr
            %td= link_to shop.name, dashboard_backend_shop_path(shop), target: '_blank'
            %td= shop.updated_sale_employee_at
            %td= shop.agent.try(:name)
            %td
    %br
    .pull-right= will_paginate @shops , renderer: BootstrapPagination::Rails, bootstrap: 3
    %br
