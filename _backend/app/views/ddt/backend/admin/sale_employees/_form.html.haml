= simple_nested_form_for([:backend, @sale_employee], html: { class: 'form-horizontal'}) do |f|
  = f.error_notification :message => error_message_in_html(@sale_employee)

  .form-inputs
    .col-sm-6
      = f.input :name
    .col-sm-6
      = f.input :phone
    .col-sm-6
      = f.input :qq
    .col-sm-6
      = f.input :email
    .col-sm-6
      = f.input :shop_ids_string, input_html: { data: { useas: 'select', column: "slug_cont", url: backend_shops_path(format: :json), saved: @sale_employee.shops.map(&:select_json), placeholder: '点账号' }, class: 'ddb-select2'}, hint: '可以管理的商户', label: "维护售后的客户"
    .col-sm-6
      = f.input :agent_ids_string, input_html: { data: { useas: 'select', column: "name_cont", url: backend_agents_path(format: :json), saved: @sale_employee.agents.map(&:select_json), placeholder: '代理商' }, class: 'ddb-select2'}, hint: '维护售后的代理商', label: "维护售后的代理商"
  .form-actions.col-xs-offset-2
    = f.button :submit, :class => "btn btn-primary btn-sm"
