- query_date = Date.parse(query_date) if query_date.present? and !query_date.is_a?(Date)
- query_params = {}
- if shop.present?
  - query_params[:shop_id] = shop.id
- else
  - query_params[:sale_employee_id] = @sale_employee.id

- if query_date.present?
  - start_date = query_date.beginning_of_month
  - end_date = query_date.end_of_month
  - query_params.merge!(start_date: start_date, end_date: end_date)
- else
  - query_params[:time_filter] = time_filter
- statistic = Ddt::Statistic::Order::Quantity.new(query_params)
- statistic_total = Ddt::Statistic::Order::Quantity.new(query_params.merge(interval: :total))
- total = statistic_total.query
- unless query_date.present?
  - average = (total * (1.0 / statistic.time_filter_labels.size)).round(2)
- else
  - average = (total * (1.0 / Time.days_in_month(query_date.month, query_date.year))).round(2)

.widget-box.shop-orders-count-chart-wrapper
  .widget-header.widget-header-flat.widget-header-small
    %h5
      %i.fa.fa-line-chart
      订单数统计
    .widget-toolbar.no-border
      %span.dropdown
        %button.btn.btn-minier.btn-primary.dropdown-toggle{:'data-toggle' => :dropdown }
          - if shop.present?
            = shop.name
          - else
            = "所有shop"
          %i.fa.fa-angle-down.bigger-110
        %ul.dropdown-menu.pull-right.dropdown-125.dropdown-lighter.dropdown-caret
          %li{ :class => ('active' unless shop.present? )}
            %a{:href => statistic_backend_sale_employee_path(@sale_employee, time_filter: params[:time_filter], query_date: params[:query_date]), :'data-remote' => true}
              %i.fa.fa-caret-right.bigger-110{:class => ('invisible' if shop.present?)}
                &nbsp;
              = "所有shop"
          - @sale_employee.all_shops.each do |s|
            %li{ :class => ('active' if s == shop )}
              %a{:href => statistic_backend_sale_employee_path(@sale_employee, time_filter: params[:time_filter], query_date: params[:query_date], shop_filter_id: s.id ), :'data-remote' => true}
                %i.fa.fa-caret-right.bigger-110{:class => ('invisible' unless s == shop)}
                  &nbsp;
                = s.name
      %span.dropdown
        %button.btn.btn-minier.btn-primary.dropdown-toggle{:'data-toggle' => :dropdown }
          = query_date.present? ? 'N/A' : Ddt::Statistic::Base.time_filter_collection[time_filter]
          %i.fa.fa-angle-down.bigger-110
        %ul.dropdown-menu.pull-right.dropdown-125.dropdown-lighter.dropdown-caret
          - Ddt::Statistic::Base.time_filter_collection.each do |key, value|
            %li{ :class => ('active' if time_filter == key )}
              - if shop.present?
                %a{:href => statistic_backend_sale_employee_path(@sale_employee, time_filter: key, shop_filter_id: shop.id ), :'data-remote' => true}
                  %i.fa.fa-caret-right.bigger-110{:class => ('invisible' unless time_filter == key)}
                    &nbsp;
                  = value
              - else
                %a{:href => statistic_backend_sale_employee_path(@sale_employee, time_filter: key), :'data-remote' => true}
                  %i.fa.fa-caret-right.bigger-110{:class => ('invisible' unless time_filter == key)}
                    &nbsp;
                  = value
      -#%span.dropdown
      -#  %button.btn.btn-minier.btn-primary.dropdown-toggle{:'data-toggle' => :dropdown}
      -#    = query_date.present? ? query_date.strftime('%Y%m%d') : 'N/A'
      -#  %ul.dropdown-menu.pull-right.dropdown-125.dropdown-lighter.dropdown-caret
      %a.hide.query-url-info{params: query_params.to_json, :'base-url'=>statistic_backend_sale_employee_path(@sale_employee), href: '#', :'data-remote' => true}
      = date_field_tag :query_date, query_date.try(:strftime,'%Y-%m-%d'), id: 'query-date-picker'

  .widget-body
    .widget-main
      .shop-orders-count-chart

  :javascript
    $(document).ready(function(){

      $('#query-date-picker').on('change', function(){
        var link = $('.query-url-info')
        var data = JSON.parse(link.attr("params"))
        data.query_date = $('#query-date-picker').val()
        delete data.time_filter
        delete data.sale_employee_id
        var query_part = jQuery.param(data)
        var base_url = link.attr('base-url')
        link.attr("href", base_url + '?' + query_part)
        link.click();
      });

      $('.shop-orders-count-chart').highcharts({
        chart:{
          height: 600
        },
        title: {
          text: "#{shop.present? ? shop.name : '所有shop'}"
        },
        subtitle: {
          text: "总计 #{total} 单, 平均 #{average} 单"
        },
        xAxis: {
          tickInterval: #{query_date.present? ? 5 : statistic.time_filter_tick_interval},
          categories: #{raw(query_date.present? ? Ddt::Statistic::Base.month_labels(query_date) : statistic.time_filter_labels)}
        },
        yAxis: {
          title: {
            text: null
          },
          plotLines: [{
            value: 0,
            width: 1,
            color: '#808080'
          }],
          min: 0,
          minTickInterval: 1
        },
        tooltip: {
          valueSuffix: '单'
        },
        legend: {
          enabled:false
        },
        series: [{
          name: "#{shop.present? ? shop.name : '所有shop'}",
          data: #{statistic.query.to_a.map{|_, quantity| quantity }.to_json}
        }]
      });

    });
