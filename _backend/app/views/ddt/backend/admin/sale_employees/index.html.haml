.ibox
  .ibox-title
    %h2= "#{t('activerecord.models.ddt/sale_employee')} 列表"

    = link_to tag(:icon,:class=>"fa fa-plus"), new_backend_sale_employee_path(), :class => "btn btn-xs btn-primary"
  .ibox-content
    %table.table.table-striped
      %thead
        %tr
          %th.col-sm-1= Ddt::SaleEmployee.human_attribute_name(:name)
          %th.col-sm-1= Ddt::SaleEmployee.human_attribute_name(:phone)
          %th.col-sm-1= Ddt::SaleEmployee.human_attribute_name(:shops_count)
          %th.col-sm-1= Ddt::SaleEmployee.human_attribute_name(:agents_count)
          %th.col-sm-1= Ddt::SaleEmployee.human_attribute_name(:qq)
          %th.col-sm-1= Ddt::SaleEmployee.human_attribute_name(:email)
          %th.col-sm-2
      %tbody
        - @sale_employees.each do |sale_employee|
          %tr
            %td= sale_employee.name
            %td= sale_employee.phone
            %td= sale_employee.shops.count
            %td= sale_employee.agents.count
            %td= sale_employee.qq
            %td= sale_employee.email
            %td
              = link_to tag(:icon,:class=>"fa fa-list"), backend_sale_employee_path(sale_employee), :class => "btn btn-xs btn-info"
              = link_to tag(:icon,:class=>"fa fa-line-chart"), statistic_backend_sale_employee_path(sale_employee), :class => "btn btn-xs btn-info"
              = link_to tag(:icon,:class=>"fa fa-edit"), edit_backend_sale_employee_path(sale_employee), :class => "btn btn-xs btn-success"
              = link_to tag(:icon,:class=>"fa fa-trash-o"), [:backend, sale_employee], :method => :delete, :data => { :confirm => '确定删除?' }, :class => "btn btn-xs btn-danger"

        = no_record_hint(@sale_employees)
    %br
    .pull-right= will_paginate @sale_employees , renderer: BootstrapPagination::Rails, bootstrap: 3
    %br
