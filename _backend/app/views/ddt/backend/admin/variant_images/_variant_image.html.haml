%tr.variant-image-tr{ :"data-id" => variant_image.id }
  %td= check_box_tag "variant_image[id][]", variant_image.id, false, id: "variant_image_id_#{variant_image.id}"
  %td= image_tag(variant_image.attachment.small.url)
  %td= variant_image.created_at.strftime("%F %T")
  %td= variant_image.is_global? ? "是" : '否'
  %td= variant_image.variants.first.try(:name)
  %td= variant_image.asset_tag_names
  %td
    = link_to '编辑', edit_backend_variant_image_path(variant_image), remote: true
    - unless variant_image.is_global?
      = link_to "设为全局",  batch_set_backend_variant_images_path(variant_image: { variant_image_ids: [variant_image.id] }), method: :put, remote: true