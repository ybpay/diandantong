= simple_form_for([:backend, @current_shop, @variant_image], html: { class: 'form-horizontal'}, remote: true) do |f|
  = f.error_notification :message => error_message_in_html(@variant_image)

  .form-inputs
    = f.input :attachment, as: :image_preview, input_html: { preview_version: :small }, wrapper: :horizontal_form_long
    = f.input :asset_tag_names, input_html: { data: { useas: 'tag', url: backend_asset_tags_path(mode: :tag, format: :json), saved: @variant_image.asset_tags.map(&:tag_json), placeholder: '标签' }, class: 'ddb-select2'}, hint: '您可以输入新的标签， 使用逗号","或空格" "来分隔标签, 每个标签最多十个字符', label: "标签", wrapper: :horizontal_form_long
    = f.input :is_global, label: "全局"

  .form-actions.col-xs-offset-2
    = f.button :submit, :class => "btn btn-primary btn-sm"
