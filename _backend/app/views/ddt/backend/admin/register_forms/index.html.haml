.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/register_form')} 列表"

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .ibox
      .ibox-content
        %table.table.table-striped
          %thead
            %tr
              %th.col-sm-1= Ddt::RegisterForm.human_attribute_name(:id)
              %th.col-sm-1= Ddt::RegisterForm.human_attribute_name(:phone)
              %th.col-sm-1= Ddt::RegisterForm.human_attribute_name(:login_id)
              %th.col-sm-1= Ddt::RegisterForm.human_attribute_name(:email)
              %th.col-sm-1 是否注册成功
              %th.col-sm-2= Ddt::RegisterForm.human_attribute_name(:access_token)
              %th.col-sm-1= Ddt::RegisterForm.human_attribute_name(:created_at)
              %th.col-sm-1= Ddt::RegisterForm.human_attribute_name(:track_from)
          %tbody
            - @register_forms.each do |register_form|
              %tr
                %td= register_form.id
                %td= register_form.phone
                %td= register_form.login_id
                %td= register_form.email
                %td
                  - if register_form.shop_id.present?
                    成功
                  - else 
                    %span.label.label-danger 失败
                %td= register_form.access_token
                %td= register_form.created_at
                %td= register_form.track_from_name
                  

            = no_record_hint(@register_forms)
        %br
        .pull-right= will_paginate @register_forms , renderer: BootstrapPagination::Rails, bootstrap: 3
        %br
