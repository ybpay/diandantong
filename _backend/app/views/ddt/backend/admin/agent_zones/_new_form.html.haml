= form_for [:backend, @agent_zone], html: {class: "form-horizontal", role: "form"} do |f|
  - if @agent_zone.errors.any?
    #error_explanation
      %h2= "#{pluralize(@agent_zone.errors.count, "error")} prohibited this agent_zone from being saved:"
      %ul
        - @agent_zone.errors.full_messages.each do |msg|
          %li= msg

  .field.form-group
    = f.label :name, class: "col-sm-3 control-label"
    .col-sm-9.form-inline
      .city-group
        %select.city-select.form-control
          %option{value: ""}
            %span -- 省份 --
          = options_for_select(ChinaCity.list)
        %select.city-select.form-control
          %option{value: ""}
            %span -- 城市 --
        %select.city-select.form-control
          %option{value: ""}
            %span -- 地区 --

  .field.form-group
    = f.label :full_name, class: "col-sm-3 control-label"
    .col-sm-9
      = f.text_field :full_name, class: "col-xs-10 col-sm-5 zone-name form-control"

  .actions.form-actions.col-sm-offset-3
    = f.submit t('Save'), :class=>"btn btn-primary"
%br

:javascript
  $(function () {
    $(".city-select").change(function() {
      var locations = $(".city-select option:selected").map(function(i, elem) {
        return $(elem).text();
      }).filter(function (i, elem) {
        return !elem.match(/--/);
      }).toArray();

      $('.zone-name').val(locations.join('-'));
    });
  });
