.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/js_error')} 列表"
    = search_form_for @q, url: backend_js_errors_path, method: :get, html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
      = f.input_field :url_cont, as: :string, placeholder: "Url", class: 'form-control'
      = f.input_field :agent_cont, as: :string, placeholder: "Agent", class: 'form-control'
      = f.input_field :error_message_cont, as: :string, placeholder: "error_message", class: 'form-control'
      = f.submit "搜索", class: 'btn btn-success'
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12.form-group
        %table.table.table-striped
          %thead
            %tr
              %th.col-sm-2= Ddt::JsError.human_attribute_name(:url)
              %th.col-sm-1= sort_link(@q, :count, Ddt::JsError.human_attribute_name(:count))
              %th.col-sm-2= Ddt::JsError.human_attribute_name(:agent)
              %th.col-sm-3= Ddt::JsError.human_attribute_name(:error_message)
              %th.col-sm-1= Ddt::JsError.human_attribute_name(:cause)
              %th.col-sm-1= sort_link(@q, Ddt::JsError.human_attribute_name(:created_at))
              %th.col-sm-1= sort_link(@q, Ddt::JsError.human_attribute_name(:updated_at))
              %th.col-sm-1

          %tbody
            - @js_errors.each do |js_error|
              %tr.js-error-data-row
                %td
                  %div= js_error.url
                %td
                  %div= js_error.count
                %td
                  %div= js_error.agent
                %td
                  %div= js_error.error_message
                %td
                  %div= js_error.cause
                %td
                  %div= js_error.created_at.strftime("%Y-%m-%d %H:%M:%S")
                %td
                  %div= js_error.updated_at.strftime("%Y-%m-%d %H:%M:%S")
                %td
                  %div
                    = link_to '详情', [:backend,  js_error]
                    = link_to '删除', [:backend, js_error], :method => :delete, :data => { :confirm => '确定删除?' }
            = no_record_hint(@js_errors)
        %br
        .pull-right= will_paginate @js_errors , renderer: BootstrapPagination::Rails, bootstrap: 3
        %br

:css
  .js-error-data-row div{
    max-height: 100px;
    overflow: auto;
  }