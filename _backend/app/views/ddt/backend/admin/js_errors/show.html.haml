.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox
    .ibox-content.header
      .row
        .col-md-6.form-group
          %b
            = Ddt::JsError.human_attribute_name(:url)
            \:
          = @js_error.url
        .col-md-6.form-group
          %b
            = Ddt::JsError.human_attribute_name(:count)
            \:
          = @js_error.count
        .col-md-6.form-group
          %b
            = Ddt::JsError.human_attribute_name(:agent)
            \:
          = @js_error.agent
        .col-md-6.form-group
          %b
            = Ddt::JsError.human_attribute_name(:error_message)
            \:
          = @js_error.error_message
        .col-md-6.form-group
          %b
            = Ddt::JsError.human_attribute_name(:stack_trace)
            \:
          %pre= @js_error.stack_trace
        .col-md-6.form-group
          %b
            = Ddt::JsError.human_attribute_name(:cause)
            \:
          

  .ibox-content
    = @js_error.cause
    = render 'js_error_count_index'

    = link_to t('Back'), backend_js_errors_path, :class => "btn btn-primary"