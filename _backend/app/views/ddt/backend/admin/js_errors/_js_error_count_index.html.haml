.header
  %h2= "#{t('activerecord.models.ddt/js_error_count')} 列表"

%table.table.table-striped.table-bordered
  %thead
    %tr
      %th.col-sm-2= Ddt::JsErrorCount.human_attribute_name(:ip)
      %th.col-sm-1= Ddt::JsErrorCount.human_attribute_name(:count)
      %th.col-sm-1= Ddt::JsErrorCount.human_attribute_name(:created_at)
      %th.col-sm-1= Ddt::JsErrorCount.human_attribute_name(:updated_at)
      %th

  %tbody
    - @js_error_counts.each do |js_error_count|
      %tr
        %td= js_error_count.ip
        %td= js_error_count.count
        %td= js_error_count.created_at.strftime("%Y-%m-%d %H:%M:%S")
        %td= js_error_count.updated_at.strftime("%Y-%m-%d %H:%M:%S")
%br
.pull-right= will_paginate @js_error_counts , renderer: BootstrapPagination::Rails, bootstrap: 3
%br