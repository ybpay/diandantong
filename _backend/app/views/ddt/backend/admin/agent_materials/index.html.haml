.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2 代理资料列表
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      .ibox
        .ibox-content
          %table.table.table-striped
            %tr
              %th= Ddt::AgentMaterial.human_attribute_name(:title)
              %th= Ddt::AgentMaterial.human_attribute_name(:content)
              %th

            - @agent_materials.each do |agent_material|
              %tr
                %td= agent_material.title
                %td= agent_material.content
                %td
                  = link_to '详情', backend_agent_material_path(agent_material)
                  = link_to '编辑', edit_backend_agent_material_path(agent_material)
                  = link_to '删除', backend_agent_material_path(agent_material), :method => :delete, :data => { :confirm => 'Are you sure?' }
            
            = no_record_hint(@agent_materials)

          %br

          = link_to "新建上传文件", new_backend_agent_material_path, :class=>"btn btn-primary btn-sm"
