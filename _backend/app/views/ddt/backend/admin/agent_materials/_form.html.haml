= nested_form_for [:backend, @agent_material], :html => { :multipart => true, :class => "form-horizontal", :role=>"form" } do |f|
  - if @agent_material.errors.any?
    #error_explanation.col-sm-offset-3
      %h2= "#{pluralize(@agent_material.errors.count, "error")}个错误导致无法保存:"
      %ul
        - @agent_material.errors.full_messages.each do |msg|
          %li= msg

  .field.form-group
    = f.label :title, :class=>"col-xs-3 control-label"
    .col-xs-9
      = f.text_field :title, class: "col-xs-10 col-sm-5"
  .field.form-group
    = f.label :content, :class=>"col-xs-3 control-label"
    .col-xs-9
      = f.cktext_area :content, :ckeditor => {:language => "zh-cn"}, :class=>"form-control"
  .field.form-group
    = f.label :d_files, class: "col-xs-3 control-label"
    .col-xs-9
      %table.table.table-bordered.table-striped
        %tbody#d_files
          = f.fields_for :d_files do |task_form|
            %tr
              %td= task_form.label :file_name, "要上传的文件"
              %td= task_form.text_field :file_name, placeholder: "文件名"
              %td= task_form.file_field :file_path
              %td= task_form.link_to_remove "删除", :class=>"btn btn-danger btn-xs"
      = f.link_to_add "添加文件", :d_files, :class=>"btn btn-info btn-sm", data: {target: '#d_files'}
  .actions.form-actions.col-sm-offset-3
    = f.submit t('Save'), :class=>"btn btn-primary btn-sm"
