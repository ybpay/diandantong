.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/sales_email')} 列表"

    = new_btn(:sales_email)
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      .ibox
        .ibox-content
          %table.table.table-striped
            %thead
              %tr
                %th.col-sm-4= Ddt::SalesEmail.human_attribute_name(:email)
                %th.col-sm-4= Ddt::SalesEmail.human_attribute_name(:ticket)
                %th.col-sm-4= Ddt::SalesEmail.human_attribute_name(:created_at)
                %th.col-sm-1 操作

            %tbody
              - @sales_emails.each do |record|
                %tr
                  %td= record.email
                  %td= record.ticket
                  %td= record.created_at
                  %td
                    = delete_btn(record)

              = no_record_hint(@sales_emails)
          %br
          .pull-right= will_paginate @sales_emails , renderer: BootstrapPagination::Rails, bootstrap: 3
          %br
