%p#notice= notice
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox
    .ibox-content.header
      .row
        .col-md-6.form-group
          %b
            = Ddt::ServiceProduct.human_attribute_name(:subject)
            \:
          = @service_product.subject
        .col-md-6.form-group
          %b
            = Ddt::ServiceProduct.human_attribute_name(:type)
            \:
          = @service_product.type_name
        .col-md-6.form-group
          %b
            = Ddt::ServiceProduct.human_attribute_name(:price)
            \:
          = number_to_currency(@service_product.price, :unit=>"¥")
        .clearfix
        
        = render 'preferences', preferences: @service_product.preferences

        .col-md-6.form-group
          %b
            = Ddt::ServiceProduct.human_attribute_name(:description)
            \:
          = @service_product.description

        = link_to t('Edit'), edit_backend_service_product_path(@service_product), :class=>"btn btn-sm"
        \|
        = link_to t('Back'), backend_service_products_path, :class=>"btn btn-sm"
