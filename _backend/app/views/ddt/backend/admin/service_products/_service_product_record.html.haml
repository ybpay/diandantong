%h3.header.smaller.red 可选套餐

- @service_products.each_slice(4) do |service_product_array|
  .row
    .col-xs-4.col-sm-3.pricing-span-header
      .widget-box.transparent
        .widget-header
          %h5.bigger.lighter= Ddt::ServiceProduct.human_attribute_name(:subject)
        .widget-body
          .widget-main.no-padding
            %ul.list-unstyled.list-striped.pricing-table-header
              %li= Ddt::ServiceProduct.human_attribute_name(:price)
              %li= Ddt::ServiceProduct.human_attribute_name(:type)
              %li= Ddt::ServiceProduct.human_attribute_name(:description)
              - if @current_shop.present?
                %li 当前账户是否可购买
    .col-xs-8.col-sm-9.pricing-span-body
      - service_product_array.each_with_index do |service_product, index|
        .pricing-span
          .widget-box.pricing-box-small
            %div{:class=>"#{['widget-header header-color-red3', 'widget-header header-color-orange', 'widget-header header-color-blue', 'widget-header header-color-green', 'widget-header header-color-grey'][index % 4]}"}
              .bigger.lighter= service_product.subject
            .widget-body
              .widget-main.no-padding
                %ul.list-unstyled.list-striped.pricing-table
                  %li= number_to_currency(service_product.price, :unit=>"¥")
                  %li= service_product.type_name
                  %li= raw service_product.description
                  - if @current_shop.present?
                    %li
                      %span.label.label-success 可以购买

              - if @current_shop.present?
                %div
                  %a{:class => ["btn btn-block btn-sm",  ['btn-danger', 'btn-warning', 'btn-primary', 'btn-success', 'btn-grey'][index]].join(" ")  , :href => backend_shop_service_product_orders_path(@current_shop, {service_product_id: service_product.id}), :data=>{:method=>"POST"}}
                    %span 购买
