= simple_form_for([:backend, @service_product], url: service_product_form_url(@service_product), as: :service_product, html: {class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification message: error_message_in_html(@service_product)

    .form-inputs
      = f.input :subject
      = f.input :type, collection: Ddt::ServiceProduct.type_collection
      = f.input :price, hint: "该价格是服务套餐的总价"
      = render 'preferences_fields', preferences: @service_product.preferences
      = f.input :description
      = f.input :is_offline

    .form-actions.col-xs-offset-2
      = f.button :submit, class: "btn btn-primary btn-sm"

= link_to "", change_preferences_backend_service_products_path, remote: true, id: 'change_preferences_link'

:javascript
  $(document).ready(function() {
    var product_type = $("#service_product_type");
    product_type.on("change", function() {
      var type_value = product_type.val();
      if (type_value) {
        var link = $('#change_preferences_link');
        var href = link.attr('href').split("?")[0];
        link.attr('href', href + '?type=' + type_value);

        link.click();
      }
    });
  });
