- unless @current_shop.present?
  .row.wrapper.border-bottom.white-bg.page-heading
    .col-lg-10
      %h2= "#{t('activerecord.models.ddt/service_product')} 列表"
  .wrapper.wrapper-content.animated.fadeInRight.ecommerce
    .row
      .col-lg-12
        .ibox
          .ibox-content
            %table.table.table-striped
              %tr
                %th= Ddt::ServiceProduct.human_attribute_name(:subject)
                %th= Ddt::ServiceProduct.human_attribute_name(:type)
                %th= Ddt::ServiceProduct.human_attribute_name(:price)
                %th.col-sm-4= Ddt::ServiceProduct.human_attribute_name(:description)
                %th

              - @service_products.each_with_index do |service_product, index|
                %tr
                  %td= service_product.subject
                  %td= service_product.type_name
                  %td= number_to_currency(service_product.price, :unit=>"¥")

                  %td= service_product.description
                  %td
                    - if @service_products.size > 1
                      .btn-group
                        %button.btn.btn-sm.dropdown-toggle{:type=>"button", :"data-toggle"=>"dropdown"}
                          排序
                          %span.caret
                        %ul.dropdown-menu{:role=>"menu"}
                          - unless index == 0
                            %li
                              %a{:href=>"#{change_position_backend_service_products_path(service_product_ids:[@service_products[index-1].id, service_product.id])}", :data=>{:method=>"put"}}
                                %i.glyphicon.glyphicon-arrow-up
                                向上移一位
                          - unless index == @service_products.size - 1
                            %li
                              %a{:href=>"#{change_position_backend_service_products_path(service_product_ids:[service_product.id, @service_products[index+1].id])}", :data=>{:method=>"put"}}
                                %i.glyphicon.glyphicon-arrow-down
                                向下移一位
                    = link_to '详情', backend_service_product_path(service_product)
                    = link_to '编辑', edit_backend_service_product_path(service_product)
                    = link_to '删除', backend_service_product_path(service_product), :method => :delete, :data => { :confirm => 'Are you sure?' }
              = no_record_hint(@service_products)

            %br
            = link_to '添加服务套餐', new_backend_service_product_path, :class=>"btn btn-sm"
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      .ibox
        .ibox-content
          = render 'service_product_record'
