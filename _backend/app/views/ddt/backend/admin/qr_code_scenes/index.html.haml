.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/qr_code_scene')} 列表"


.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        .form-group
          = search_form_for @q, url: backend_qr_code_scenes_path, html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
            = f.input_field :id_eq, placeholder: '编号', class: "form-control"
            = f.input_field :slug_eq, placeholder: '代码', class: "form-control"
            = f.input_field :shop_id_eq, placeholder: '点账号ID', class: "form-control"
            = f.input_field :branch_id_eq, placeholder: '门店ID', class: "form-control"
            = f.input_field :qr_code_assign_log_id_eq, placeholder: '二维码分配ID'

            = f.submit "搜索", class: 'btn btn-default'
    .row
      .col-sm-12
        = link_to "批量新建", batch_new_backend_qr_code_scenes_path, :class=>"btn btn-primary"
  .row
    .col-lg-12
      .ibox
        .ibox-content
          %table.table.table-striped
            %thead
              %tr
                %th.col-sm-1= Ddt::QrCodeScene.human_attribute_name(:id)
                %th.col-sm-1= Ddt::QrCodeScene.human_attribute_name(:slug)
                %th.col-sm-1= Ddt::QrCodeScene.human_attribute_name(:shop)
                %th.col-sm-5= Ddt::QrCodeScene.human_attribute_name(:url)
                %th.col-sm-1= Ddt::QrCodeScene.human_attribute_name(:qr_code_assign_log_id)
                %th.col-sm-1= Ddt::QrCodeScene.human_attribute_name(:updated_at)
                %th.col-sm-2
            %tbody
              - @qr_code_scenes.each do |qr_code_scene|
                %tr
                  %td= qr_code_scene.id
                  %td= qr_code_scene.slug
                  %td= qr_code_scene.shop.try(:name)
                  %td= qr_code_scene.url
                  %td
                    -if qr_code_scene.qr_code_assign_log_id.present?
                      = link_to qr_code_scene.qr_code_assign_log_id, [:backend, qr_code_scene.qr_code_assign_log]
                  %td= qr_code_scene.updated_at
                  %td
                    = link_to '详情', backend_qr_code_scene_path(qr_code_scene)
                    = link_to '编辑', edit_backend_qr_code_scene_path(qr_code_scene)

              = no_record_hint(@qr_code_scenes)
          %br
          .pull-right= will_paginate @qr_code_scenes , renderer: BootstrapPagination::Rails, bootstrap: 3
          %br
