.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox
    .ibox-title
      %h5= "#{t('activerecord.models.ddt/qr_code_scene')} 详情"
    .ibox-content.header
      .row
        .col-md-6.form-group
          %b
            = Ddt::QrCodeScene.human_attribute_name(:id)
            \:
          = @qr_code_scene.id
        .col-md-6.form-group
          %b
            = Ddt::QrCodeScene.human_attribute_name(:slug)
            \:
          = @qr_code_scene.slug
        .col-md-6.form-group
          %b
            = Ddt::QrCodeScene.human_attribute_name(:is_enable)
            \:
          = @qr_code_scene.is_enable? ? '已启用' : '未启用'
        .col-md-6.form-group
          %b
            = Ddt::QrCodeScene.human_attribute_name(:qr_code_assign_log_id)
            \:
          - if @qr_code_scene.qr_code_assign_log_id.present?
            = link_to @qr_code_scene.qr_code_assign_log_id, [:backend, @qr_code_scene.qr_code_assign_log]
        .col-md-6.form-group
          %b
            = Ddt::QrCodeScene.human_attribute_name(:shop)
            \:
          = @qr_code_scene.shop.try(:name)
        .clearfix
        .hr-line-dashed
        .col-md-6.form-group
          %b
            = Ddt::QrCodeScene.human_attribute_name(:url)
            \:
          = @qr_code_scene.url
        .col-md-6.form-group
          %b
            = Ddt::QrCodeScene.human_attribute_name(:preferred_redirect_url)
            \:
          = @qr_code_scene.preferred_redirect_url
      .row
        .col-sm-12
          = link_to t('Edit'), edit_backend_qr_code_scene_path(@qr_code_scene), class: 'btn btn-primary'