.ibox
  .ibox-title
    %h2= "新建#{t('activerecord.models.ddt/qr_code_assign_log')}"
  .ibox-content
    = simple_form_for([:backend, @qr_code_assign_log], html: { class: 'form-horizontal'}) do |f|
      = f.error_notification :message => error_message_in_html(@qr_code_assign_log)

      .col-sm-6
        .form-inputs
          = f.input :count
          = f.input :shop_id, input_html: { data: { single: true, useas: 'select', column: "slug_cont", url: backend_shops_path(format: :json), saved: @qr_code_assign_log.shop_id, placeholder: '点账号' }, id: 'shop_id_select', class: 'ddb-select2', onchange: 'changeShopId()'}, hint: '选择品牌商户'

          = f.input :branch_id, collection: (@qr_code_assign_log.shop.try(:branches)||[]).map{|branch| [branch.name, branch.id]}, include_blank: false

        .form-actions
          .col-xs-offset-4
            = f.button :submit, :class => "btn btn-primary"
      .clearfix


:javascript
  function changeShopId(){
    var shop_id = $('#shop_id_select').val()
    var branches = []
    if(shop_id){
      $.ajax({
        url: '/backend/shops/'+shop_id + '/branches.json',
        dataType: 'json',
        success: function(branches){
          var html = '';
          $.each(branches, function(index, branch){

            html += "<option value="+branch.id+">"+branch.name+"</div>"
          })
          $('#qr_code_assign_log_branch_id').html(html)
        }
      })
    }else{
      $('#qr_code_assign_log_branch_id').html('')
    }
  }