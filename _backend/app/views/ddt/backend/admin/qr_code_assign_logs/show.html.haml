.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox
    .ibox-title
      %h5= "#{t('activerecord.models.ddt/qr_code_assign_log')} 详情"
    .ibox-content.header
      .row
        .col-md-6.form-group
          %b
            = Ddt::QrCodeAssignLog.human_attribute_name(:id)
            \:
          = @qr_code_assign_log.id
        .col-md-6.form-group
          %b
            = Ddt::QrCodeAssignLog.human_attribute_name(:count)
            \:
          = @qr_code_assign_log.count
        .col-md-6.form-group
          %b
            = Ddt::QrCodeAssignLog.human_attribute_name(:shop_id)
            \:
          = link_to @qr_code_assign_log.shop.try(:name)||@qr_code_assign_log.shop_id, [:backend, @qr_code_assign_log.shop]
        .col-md-6.form-group
          %b
            = Ddt::QrCodeAssignLog.human_attribute_name(:updated_at)
            \:
          = @qr_code_assign_log.updated_at
        .col-md-6.form-group
          %b
            = Ddt::QrCodeAssignLog.human_attribute_name(:created_at)
            \:
          = @qr_code_assign_log.created_at

        .col-md-6.form-group
          %b
            = Ddt::QrCodeAssignLog.human_attribute_name(:branch_id)
            \:
          = link_to @qr_code_assign_log.branch.try(:name)||@qr_code_assign_log.branch_id, [:backend, @qr_code_assign_log.shop, @qr_code_assign_log.branch]

        .col-md-6.form-group
          %b
            = Ddt::QrCodeAssignLog.human_attribute_name(:note)
            \:
          %br
          = raw @qr_code_assign_log.note
      .row
        %table.table.table-striped
          %thead
            %tr
              %th.col-sm-1= Ddt::QrCodeScene.human_attribute_name(:id)
              %th.col-sm-1= Ddt::QrCodeScene.human_attribute_name(:slug)
              %th.col-sm-1= Ddt::QrCodeScene.human_attribute_name(:shop)
              %th.col-sm-1= Ddt::QrCodeScene.human_attribute_name(:branch)
              %th.col-sm-4= Ddt::QrCodeScene.human_attribute_name(:qr_url)
              %th.col-sm-2= Ddt::QrCodeScene.human_attribute_name(:url)
              %th
          %tbody
            - @qr_code_assign_log.branch.tables.where(qr_code_scene_id: nil)
            - @qr_code_assign_log.qr_code_scenes.each_with_index do |qr_code_scene|
              %tr
                %td= qr_code_scene.id
                %td= qr_code_scene.slug
                %td= link_to qr_code_scene.shop.try(:name)||qr_code_scene.shop_id, [:backend, qr_code_scene.shop]
                %td= link_to qr_code_scene.branch_id, backend_shop_branch_path(qr_code_scene.shop_id, qr_code_scene.branch_id)
                %td= qr_code_scene.qr_url
                %td= image_tag(qr_code_scene.url, width: 150)
                %td
                  - if qr_code_scene.owner_id.blank?
                    = link_to '绑定至桌台', edit_bind_backend_shop_qr_code_scene_path(qr_code_scene.shop_id, qr_code_scene.id, branch_id: qr_code_scene.branch_id), remote:true
        
      .row
        .col-sm-12
          = link_to t('Back'), backend_qr_code_assign_logs_path, class: 'btn btn-primary'