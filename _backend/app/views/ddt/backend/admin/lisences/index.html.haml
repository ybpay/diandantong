.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2 授权许可列表
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      .ibox
        .ibox-content
          %table.table.table-striped
            %tr
              %th= Ddt::Lisence.human_attribute_name(:lisence_no)
              %th= Ddt::Lisence.human_attribute_name(:price)
              %th= Ddt::Lisence.human_attribute_name(:is_used)
              %th= Ddt::Lisence.human_attribute_name(:increment_days)
              %th= Ddt::Lisence.human_attribute_name(:lisence_type)
              %th= Ddt::Lisence.human_attribute_name(:agent)
              %th= Ddt::Lisence.human_attribute_name(:note)
              %th

            - @lisences.each do |lisence|
              %tr
                %td= lisence.lisence_no
                %td= "#{number_to_currency(lisence.price, :unit=>'¥')}元"
                %td
                  - if lisence.is_used
                    %span.label.label-danger 已使用
                  - else
                    %span.label.label-success 未使用
                %td= lisence.increment_days
                %td= lisence.lisence_type_name
                %td
                  = link_to lisence.agent.name, [:backend, lisence.agent] if lisence.agent.present?
                %td= lisence.note
                %td
                  = link_to '详情', [:backend, lisence]
                  = link_to '编辑', edit_backend_lisence_path(lisence)
                  = link_to '删除', [:backend, lisence], :method => :delete, :data => { :confirm => '确定要删除授权许可?' }

            = no_record_hint(@lisences)

          %br
          = link_to t('Back'), :back, :class=>"btn btn-default btn-sm"
