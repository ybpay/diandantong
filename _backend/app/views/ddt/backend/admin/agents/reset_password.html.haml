.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox
    .ibox-title
      %h2 重置密码
    .ibox-content
      .col-sm-6
        = simple_form_for [:backend, @agent], html: {class: "form-horizontal", role: "form"} do |f|
          - if @agent.errors.any?
            #error_explanation
              %h2= "#{pluralize(@agent.errors.count, "error")} prohibited this agent from being saved:"
              %ul
                - @agent.errors.full_messages.each do |msg|
                  %li= msg
          .form-inputs
            = f.input :agent_no, disabled: true
            = f.input :email, disabled: true
            = f.input :name, disabled: true
            = f.input :password
            = f.input :password_confirmation
          .form-actions
            .col-sm-offset-4
              = f.submit '保存', class: 'btn btn-primary'

      .clearfix