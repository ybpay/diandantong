= simple_form_for([:backend, @api_key], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@api_key)

    .form-inputs
      = f.input :name

    .form-actions.col-xs-offset-2
      = f.button :submit, :class => "btn btn-primary btn-sm"
