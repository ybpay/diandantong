.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/api_key')} 列表"

    .form-group
      = link_to "新建 #{t('activerecord.models.ddt/api_key')}", new_backend_api_key_path, :class=>"btn btn-primary btn-sm"
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      .ibox
        .ibox-content
          %table.table.table-striped.table-bordered
            %thead
              %tr
                %th.col-sm-1= sort_link(@q, :id, Ddt::ApiKey.human_attribute_name(:id))
                %th.col-sm-2= sort_link(@q, :name, Ddt::ApiKey.human_attribute_name(:name))
                %th.col-sm-7= sort_link(@q, :access_token, Ddt::ApiKey.human_attribute_name(:access_token))
                %th.col-sm-2

            %tbody
              - @api_keys.each do |api_key|
                %tr
                  %td= api_key.id
                  %td= api_key.name
                  %td= api_key.access_token
                  %td
                    = link_to tag(:icon,:class=>"fa fa-bars"), [:backend, api_key], :class => "btn btn-xs btn-info"
                    = link_to tag(:icon,:class=>"fa fa-edit"), edit_backend_api_key_path(api_key), :class => "btn btn-xs btn-success"
                    = link_to tag(:icon,:class=>"fa fa-trash-o"), [:backend, api_key], :method => :delete, :data => { :confirm => '确定删除?' }, :class => "btn btn-xs btn-danger"
          %br
          .pull-right= will_paginate @api_keys , renderer: BootstrapPagination::Rails, bootstrap: 3
          %br