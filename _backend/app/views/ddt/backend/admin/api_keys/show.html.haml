.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox
    .ibox-title
      %h2= "#{t('activerecord.models.ddt/api_key')} 详情"
    .ibox-content
      %p
        %b
          = Ddt::ApiKey.human_attribute_name(:name)
          \:
        = @api_key.name
      %p
        %b
          = Ddt::ApiKey.human_attribute_name(:access_token)
          \:
        = @api_key.access_token

      = link_to t('Edit'), edit_backend_api_key_path(@api_key), :class => "btn btn-primary btn-sm"
      \
      = link_to t('Back'), backend_api_keys_path(), :class => "btn btn-default btn-sm"