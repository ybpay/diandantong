= simple_form_for([:backend, @app_version], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@app_version)

    .form-inputs
      = f.input :os_type, collection: Ddt::AppVersion.os_type_collection
      = f.input :terminal, collection: Ddt::AppVersion.terminal_collection
      = f.input :version_name, placeholder: '例如：点单通卖家版', hint: '版本名称'
      = f.input :version_code, placeholder: '例如：1.0.0', hint: '版本号'
      = f.input :url, placeholder: 'http://www.diandantong.com/download/ddt-seller-release-1.0.0.apk', hint: '下载地址'
      = f.input :note, placeholder: '例如：添加角色访问控制', hint: '更新备注'

    .form-actions.col-xs-offset-2
      = f.button :submit, :class => "btn btn-primary btn-sm"
