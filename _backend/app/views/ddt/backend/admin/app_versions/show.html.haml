.header
  %h3= "#{t('activerecord.models.ddt/app_version')} 详情"

.model-show
  %p
    %b
      = Ddt::AppVersion.human_attribute_name(:os_type)
      \:
    = @app_version.os_type

  %p
    %b
      = Ddt::AppVersion.human_attribute_name(:terminal)
      \:
    = @app_version.terminal

  %p
    %b
      = Ddt::AppVersion.human_attribute_name(:version_name)
      \:
    = @app_version.version_name
  %p
    %b
      = Ddt::AppVersion.human_attribute_name(:version_code)
      \:
    = @app_version.version_code
  %p
    %b
      = Ddt::AppVersion.human_attribute_name(:url)
      \:
    = @app_version.url

  %p
    %b
      = Ddt::AppVersion.human_attribute_name(:note)
      \:
    = @app_version.note

  .space
= link_to t('Edit'), edit_backend_app_version_path(@app_version), :class => "btn btn-primary btn-sm"
\
= link_to t('Back'), backend_app_versions_path, :class => "btn btn-default btn-sm"