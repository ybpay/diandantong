.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/app_version')} 列表"

    .form-group
      = new_btn(:app_version)
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      .ibox
        .ibox-content
          %table.table.table-striped
            %thead
              %tr
                %th.col-sm-1= sort_link(@q, :os_type, Ddt::AppVersion.human_attribute_name(:os_type))
                %th.col-sm-1= sort_link(@q, :os_type, Ddt::AppVersion.human_attribute_name(:terminal))
                %th.col-sm-1= sort_link(@q, :version_name, Ddt::AppVersion.human_attribute_name(:version_name))
                %th.col-sm-1= sort_link(@q, :version_code, Ddt::AppVersion.human_attribute_name(:version_code))
                %th.col-sm-1= sort_link(@q, :url, Ddt::AppVersion.human_attribute_name(:url))
                %th.col-sm-1= sort_link(@q, :note, Ddt::AppVersion.human_attribute_name(:note))
                %th.col-sm-1

            %tbody
              - @app_versions.each do |app_version|
                %tr
                  %td= app_version.os_type
                  %td= app_version.terminal
                  %td= app_version.version_name
                  %td= app_version.version_code
                  %td= app_version.url
                  %td= app_version.note
                  %td
                    = info_btn(app_version)
                    = edit_btn(app_version)
                    = delete_btn(app_version)
              = no_record_hint(@app_versions)
          %br
          .pull-right= will_paginate @app_versions , renderer: BootstrapPagination::Rails, bootstrap: 3
          %br