.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      .ibox
        .ibox-content
          %table.table.table-striped
            %thead
              %tr
                %th 区域
                %th 代理
                %th 是否独家
                %th 权重
                %th
            %tbody
              - @agent_rels.each do |rel|
                - is_exclusive_agent = rel.agent && rel.agent.exclusive?
                %tr
                  %td= @agent_zone.name
                  %td= rel.agent.name rescue nil
                  %td= ( is_exclusive_agent ? '是' : '否')
                  %td= ( is_exclusive_agent ? rel.weight : '无')
                  %td
                    - if is_exclusive_agent
                      = link_to '编辑', edit_backend_agent_zone_agent_rel_path(@agent_zone, rel)
