.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/joke')} 列表"

    = link_to tag(:icon,:class=>"fa fa-plus"), new_backend_joke_path(), :class => "btn btn-xs btn-primary"
  .ibox
    .ibox-content
      %table.table.table-striped
        %thead
          %tr
            %th.col-sm-8= Ddt::Joke.human_attribute_name(:content)
            %th.col-sm-4
        %tbody
          - @jokes.each do |joke|
            %tr
              %td
                %div= joke.content
              %td
                %div
                  = link_to '编辑', edit_backend_joke_path(joke)
                  = link_to '删除', [:backend, joke], :method => :delete, :data => { :confirm => '确定删除?' }
          = no_record_hint(@jokes)
      %br
      .pull-right= will_paginate @jokes , renderer: BootstrapPagination::Rails, bootstrap: 3
      %br