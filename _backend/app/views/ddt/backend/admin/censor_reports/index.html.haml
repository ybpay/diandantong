.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox
    .ibox-title
      %h2= "#{t('activerecord.models.ddt/censor_report')} 列表"
    .ibox-content.m-b-sm.border-bottom
      .row
        %table.table.table-striped
          %thead
            %tr
              %th.col-sm-1= sort_link(@q, :shop_id, Ddt::CensorReport.human_attribute_name(:shop_id))
              %th.col-sm-1= sort_link(@q, :title, Ddt::CensorReport.human_attribute_name(:title))
              %th.col-sm-1= sort_link(@q, :desc, Ddt::CensorReport.human_attribute_name(:desc))
              %th.col-sm-1= sort_link(@q, :user_id, Ddt::CensorReport.human_attribute_name(:user_id))
              %th.col-sm-1= sort_link(@q, :state, Ddt::CensorReport.human_attribute_name(:state))
              %th.col-sm-1= sort_link(@q, :auditor_id, Ddt::CensorReport.human_attribute_name(:auditor_id))
              %th.col-sm-1= sort_link(@q, :audited_at, Ddt::CensorReport.human_attribute_name(:audited_at))
              %th.col-sm-1= sort_link(@q, :created_at, Ddt::CensorReport.human_attribute_name(:created_at))
              %th.col-sm-1

          %tbody
            = render partial: 'tr', collection: @censor_reports, as: :censor_report
            = no_record_hint(@censor_reports)
        %br
        .pull-right= will_paginate @censor_reports , renderer: BootstrapPagination::Rails, bootstrap: 3
        %br
