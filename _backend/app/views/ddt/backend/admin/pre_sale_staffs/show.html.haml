.ibox
  .ibox-title
    %h2= @pre_sale_staff.info
  .ibox-content
    %table.table.table-striped
      %thead
        %tr
          %th.col-sm-2= Ddt::Shop.human_attribute_name(:name)
          %th.col-sm-2= Ddt::Shop.human_attribute_name(:updated_pre_sale_staff_at)
          %th.col-sm-2
      %tbody
        - @pre_sale_staff.shops.each do |shop|
          %tr
            %td= link_to shop.name, dashboard_backend_shop_path(shop), target: '_blank'
            %td= shop.updated_pre_sale_staff_at
            %td