= simple_form_for([:backend, @pre_sale_staff], html: { class: 'form-horizontal'}) do |f|
  = f.error_notification :message => error_message_in_html(@pre_sale_staff)

  .form-inputs
    .col-sm-6
      = f.input :name
    .col-sm-6
      = f.input :phone
    .col-sm-6
      = f.input :qq
    .col-sm-6
      = f.input :email
    .col-sm-6
      = f.input :shop_ids_string, input_html: { data: { useas: 'select', column: "slug_cont", url: backend_shops_path(format: :json), saved: @pre_sale_staff.shops.map(&:select_json), placeholder: '点账号' }, class: 'ddb-select2'}, hint: '商户', label: "维护售前的客户"

  .form-actions.col-xs-offset-2
    = f.button :submit, :class => "btn btn-primary btn-sm"
