= simple_form_for([:backend, @current_shop, @weixin_page], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@weixin_page)

    .form-inputs
      = f.input :template_type, collection: Ddt::WeixinPage.template_type_collection
      = f.input :url

    .form-actions
      .col-sm-offset-4
        = f.button :submit, :class => "btn btn-primary"
