.material{ id: material.id}
  .header
    = material_type_fa(material.msg_type)
    %span.material_name{id: material.id}
      = avoid_nil_material_name(material.material_name)
      - if check_valid? && material.invalid?
        %span.badge.badge-transparent{:title=>material.errors.full_messages.join(','), :'data-rel'=> 'tooltip'}
          %i.fa.fa-question.red.tip

  .content
    = render 'ddt/backend/articles/material_body', { material: material}
  -unless is_edit_material? || @mask_pub
    .bottom
      .op.edit
        %a{href: edit_backend_shop_material_path(@current_shop, material)}
          %i.fa.fa-pencil
      .op.del
        %a{href:backend_shop_material_path(@current_shop, material), 'data-method' => 'delete', 'data-confirm' => '确定要删除该素材吗?', 'data-remote' => 'true' }
          %i.fa.fa-trash
  - if @mask_pub
    .material-mask{ id: "mask_#{material.id}"}
      .mark
        %i.fa.fa-check
-if @mask_pub
  :javascript
    $(function(){

      function update_material_name(name,material_id){
        $('#material_name_show').html(name)
        $('#show_material_link').attr('href',"/backend/shops/#{@current_shop.slug}/materials/"+material_id)
        $('#show_material_link').show();
      }
      var oid = '-';
      $('.material-mask').on('click',function(e){
        var id = e.target.id;
        try{ $('#'+oid).attr('class', 'material-mask'); }catch(e){}
        try{ $(e.target).attr('class', 'material-mask lock'); }catch(e){}
        oid = id;
        $("input[id$=material_id]").val(id.split('_')[1]);

        material_name = $(e.target).parent('.material').children('.header').children('.material_name').html();
        update_material_name(material_name, id.split('_')[1])
      })
    })
