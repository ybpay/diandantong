- material ||= @material
- if material.is_text?
  = render 'ddt/backend/materials/form_text', {material: material}
- elsif material.is_music?
  = render 'ddt/backend/materials/form_music', {material: material}
- elsif material.is_news?
  = render 'ddt/backend/materials/form_news', {material: material}
