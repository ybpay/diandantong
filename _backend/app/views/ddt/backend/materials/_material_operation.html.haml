- material ||= @material
.material-operation
  .area-up
    .article
  .area-down
    .material-left
      = render 'ddt/backend/materials/material', {material: material}
    .form-right
      = render 'ddt/backend/materials/form', {material: material}
  :javascript
    
    $(function(){
      var cover_height = 140;
      var item_height = 98;
      var material_title = 46;
      var current_position = parseInt("#{@article==nil ? 0 : @article.relative_position}");
      var margin_top = 0;
      if(current_position>1){
        margin_top = cover_height + item_height * (current_position-1);
      }else{
        margin_top = material_title;
      }
      console.log(current_position)
      console.log(margin_top);
      $('.form-right').css('margin-top',''+margin_top+'px');
    });

