- if material.id == nil
  = simple_form_for([:backend, @current_shop, material], html: { class: 'form-horizontal'}, wrapper: :vertical_form) do |f|
    = f.error_notification :message => error_message_in_html(material)
    .form-inputs
      = f.input :msg_type, as: :hidden
      = f.input :material_name
    .form-actions
      = f.button :submit, "下一步", class: "btn btn-primary"
- else
  = simple_form_for([:backend, @current_shop, material, @article], html: { class: 'form-horizontal'},wrapper: :vertical_form) do |f|
    = f.error_notification :message => error_message_in_html(@article)
    .form-inputs
      = f.input :title
      = f.input :image, as: :image_preview, input_html: { preview_version: :thumb }, hint: '推荐图片尺寸为900*500'
      = f.input :position, collection: get_article_position_select_option(material.articles)
      = f.input :introduction, as: :string
      = f.input :link_type, collection: Ddt::Article.link_type_collection, include_blank: false
      = f.input :url, as: :string, hint: raw("#{render '/ddt/backend/branch_sliders/auto_insert_url', {input_field_id: 'article_url', version: 'path_and_ng'}}"), placeholder: '例如：http://mp.weixin.qq.com'
      = f.label :description
      = f.input :description, as: :text, input_html: { rows: 5 }, label: false, wrapper: :vertical_form
    .form-actions
      = f.button :submit, class: "btn btn-primary"
  :javascript
    //as: :ckeditor, input_html: { ckeditor: { toolbar: 'mini'} }, wrapper: :vertical_form
    // .article_expiration_time
    // .article_link_type
    // .article_url
    // .article_description
    function hideInput(){
      $('.article_url').hide();
      $('#insert_url_button').hide();
      $('.article_link_type').show();
      $('.article_expiration_time').hide();
    }

    function changeEvent(eventType){
      hideInput();
      if(eventType === 'article'){
        $('.article_description').show();
      }else if(eventType === 'shop_or_branch'){
        $('.article_url').show();
        $('#insert_url_button').show();
        $('.article_description').hide();
      }else if(eventType === 'other_web_link'){
        $('.article_url').show();
        $('.article_description').hide();
      }
    }


    $(document).ready(function(){
      $('#article_link_type').change(function(e) {
        changeEvent(e.target.value);
      });
       $('#article_link_type').trigger('change');
      // changeEvent("<%= article.link_type%>");
    })
