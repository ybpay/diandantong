<% if @current_account.present? && !@current_account.is_admin? %>
  <div id="clear_all_msgs_btn" style="display:none;"><a>清空消息</a></div>
  <div id="msgs"></div>
  <div id="template" style="display:none;">
    <div  class="alert alert-success msg" style="width:980px;margin:auto;">
       <button type="button" class="close" aria-hidden="true">&times;</button>
       <div>
        <strong>@msg_title</strong>: <span>@msg_content</span>
        详情请点击<a href="@msg_link" target="_blank" class="label label-success">这里</a>
       </div>
      </div>
  </div>
  <div id="sound" class="hide"></div>
<% end %>
