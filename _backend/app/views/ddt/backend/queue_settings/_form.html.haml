= simple_form_for([:backend, @current_shop, @current_branch, @queue_setting], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@queue_setting)

    .form-inputs
      = f.input :name, placeholder: '例如：1-2人桌'
      = f.input :guest_num_le, placeholder: '例如：2'
      = f.input :start_at
      = f.input :end_at
      = f.input :queue_no_prefix, placeholder:'例如：C-', hint: '方便区分不同的队列'
      = f.input :notify_number_in_advance, hint: '队列有状态变更时, 提前通知的人数'
      = f.input :enabled

    .form-actions.col-xs-offset-2
      = f.button :submit, :class => "btn btn-primary btn-sm"
