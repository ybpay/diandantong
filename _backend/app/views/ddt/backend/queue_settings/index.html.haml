
.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h3= "#{t('activerecord.models.ddt/queue_setting')} 列表"

    .form-group
      = link_to "新建 #{t('activerecord.models.ddt/queue_setting')}", new_backend_shop_branch_queue_setting_path(@current_shop, @current_branch), :class=>"btn btn-primary btn-sm"

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  #queue-setting-index-body
    - @queue_settings.each do |queue_setting|
      %a.queue_setting{class: cycle('block-gray', 'block-red', 'block-primary', 'block-success', 'block-orange'), href: backend_shop_branch_queue_setting_path(@current_shop, @current_branch, queue_setting)}
        .table-display
          .name= queue_setting.name
        .table-display
          .queue-enabled= queue_setting.enabled_name
    .clearfix
  %br
  .pull-right= will_paginate @queue_settings , renderer: BootstrapPagination::Rails, bootstrap: 3
  %br
