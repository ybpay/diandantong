.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2 新建会员魔方过滤器

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      .ibox
        .ibox-content
          .col-lg-9.col-md-12
            = simple_form_for @vip_search, url: backend_shop_vip_searches_path(@current_shop), html: {class: 'form-horizontal', role: 'form'} do |f|
              .form-inputs
                = f.input :name, label: '过滤器名称'

              .form-actions
                .col-sm-offset-4
                  .btn-group
                    %a.clearfix{href: "#", "data-toggle"=>"dropdown"} 增加过滤条件
                    %ul.dropdown-menu
                      %li
                        = link_to '性别', 'javascript:add_filter_condition(conditions[0])'    
                      %li
                        = link_to '累计消费', 'javascript:add_filter_condition(conditions[1])'
                      %li
                        = link_to '累计下单数', 'javascript:add_filter_condition(conditions[2])'
                      %li
                        = link_to '会员级别', 'javascript:add_filter_condition(conditions[3])'
                      %li
                        = link_to '办卡门店', 'javascript:add_filter_condition(conditions[4])'
                      %li
                        = link_to '最近几天内下过单', 'javascript:add_filter_condition(conditions[5])' 
                      %li
                        = link_to '累计消费次数', 'javascript:add_filter_condition(conditions[6])'
                      %li
                        = link_to '最近几天内新增的会员', 'javascript:add_filter_condition(conditions[7])'
                      %li
                        = link_to '最后使用记录 时间', 'javascript:add_filter_condition(conditions[8])'   
                      %li
                        = link_to '生日 时间', 'javascript:add_filter_condition(conditions[9])' 
                      %li
                        = link_to '总充值金额', 'javascript:add_filter_condition(conditions[10])' 
                      %li
                        = link_to '会员卡消费金额', 'javascript:add_filter_condition(conditions[11])' 
                      %li
                        = link_to '充值次数', 'javascript:add_filter_condition(conditions[12])'
                .col-sm-offset-4
                  .wrapper-content
                    = f.submit "保存", class: 'btn btn-success'
                    = link_to t('Back'), backend_shop_vip_searches_path(@current_shop), :class => "btn btn-default"


          .clearfix

