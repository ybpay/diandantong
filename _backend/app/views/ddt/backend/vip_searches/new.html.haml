  var add_filter_condition = function(condition){
    var stamp = new Date().getTime();
    var operator_options_html = '';
    var value_html = '';
    var column_label = condition.column+"_"+stamp;
    if(condition.type == 'collection'){
      value_html += '<select class="form-control" name='+condition.column+ '>';
      $.each(condition.collection, function(index, item){
        value_html += '<option value='+item.value+'>'+item.label+'</option>';
      })
      value_html +='</select>';
    }else if(condition.type == 'integer'){
      value_html += '<input type="number" name="'+condition.column+'" class="form-control"/>'
    }else if(condition.type == 'boolean'){
      value_html += '<input type="checkbox" name="'+condition.column+'" class="form-control"/>'
    }else if(condition.type == 'date'){
      value_html += '<input type="date" name="'+condition.column+'" class="form-control"/>'
    }else{
      value_html += '<input type="text" name="'+condition.column+'" class="form-control"/>'
    }
    operator_options_html += '<option></option>'
    $.each(condition.operators, function(index, operator){
      operator_options_html += '<option value='+operator.value+'>'+operator.label+'</option>';
    });
    var form_group_html = "<div class='form-group'>" +
    "<label class='col-sm-4 control-label' for='"+column_label+"'>" 
      + condition.label
      + " </label>" 
      + "<div class='col-sm-3'>" 
      + "<select class='form-control operator_option' >" 
      + operator_options_html
      + "</select>" 
      + "</div>" 
      + "<div class='col-sm-4'>"+value_html+"</div>" 
      + "<div class='col-sm-1 form-control-static'><a href='javascript:void(0)' onclick='delete_this($(this))'>删除</a></div>"
      + "</div>";
    $('#new_vip_search .form-inputs').append(form_group_html);

    // set attr(name) for every item
    $('#new_vip_search .form-inputs').find('.operator_option').last().change(function(){
      $(this).parent().next().children().attr({'name': "vip_search["+condition.column+$(this).val()+"]" })
    })

  }

  var delete_this = function(self){
    self.parent().parent().remove()
  }




