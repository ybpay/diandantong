:javascript
  $(function(){
    $('ul.submenu').each(function(){
      if($('li', this).length === 0) {
        $(this).html('<li><a href="javascript:void(0)">等待平台管理员授权</a></li>')
      }
    })
    var sm = JSON.parse($('.permission-data-cache').attr("data"));
    var sm2 = JSON.parse($('.permission-data-dym').attr("data"));
    for(var k in sm2){
      sm[k] = sm2[k]
    }

    $("li.sm-li").each(function(){
      var permitted = $(this).attr("sm_permitted")
      var controllers = $(this).attr("sm_controllers")
      var actions = $(this).attr("sm_actions")
      var no_actions = $(this).attr("sm_no_actions")
      if(!permitted || sm.permission[permitted]){
        // check active
        var active = false
        if(controllers){
          var strs = controllers.split(" ")
          strs.forEach(function(str){
            var reg = new RegExp("/"+str+"$");
            if(reg.test(sm.controller_path)){
              active = true
            }
          })
        }
        if(actions){ active = active && (actions.split(" ").indexOf(sm.action_name) != -1) }
        if(no_actions){ active = active && (no_actions.split(" ").indexOf(sm.action_name) == -1) }
        if(active){
          $(this).addClass("active")
          $(this).parents("li.sm-parent-li").addClass("active")
        }
      }else{
        $(this).remove();
      }
    })

    $("li[sm_role]").each(function(){
      var roles = $(this).attr("sm_role").split(" ")
      var result = false
      roles.forEach(function(role){
        if(sm[role]){ result = true }
      })
      if(!result){
        $(this).remove()
      }
    })

    $("li.sm-parent-li").each(function(){
      if ($('li', $(this)).size() <= 0){
        $(this).remove();
      }
    });
  });
