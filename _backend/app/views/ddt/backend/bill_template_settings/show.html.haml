.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/bill_template_setting')} 详情"

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      .ibox
        .ibox-content  
          - if @setting.enable?
            .row.tabbable
              .col-md-2
                %ul.nav.nav-pills.nav-stacked{role: "tablist"}
                  - Ddt::BillTemplateSetting.all_templates.each do |template_name|
                    %li{role: "presentation", class: ('active' if template_name == @template_name)}
                      = link_to Ddt::BillTemplateSetting.human_attribute_name(template_name), "##{template_name}", role: "tab", :"data-toggle" => "tab"
              .tab-content.col-md-10
                - Ddt::BillTemplateSetting.all_templates.each do |template_name|
                  .tab-pane.in{ role: "tabpanel", id: template_name, class: ('active' if template_name == @template_name)}
                    .row
                      .col-md-5.col.template-body
                        %pre
                          = @setting.send(template_name)
                      .col-md-5.col
                        = link_to "预览", preview_backend_shop_branch_bill_template_setting_path(@current_shop, @current_branch, template_name: template_name), class: "btn btn-success", remote: true
                        .template-preview{ :class => template_name }
                    .space
                    = link_to t('Edit'), edit_backend_shop_branch_bill_template_setting_path(@current_shop, @current_branch, template_name: template_name), :class => "btn btn-primary"
                    = link_to "重置", reset_backend_shop_branch_bill_template_setting_path(@current_shop, @current_branch, template_name: template_name), :'data-confirm' => "确认重置?", method: :put, class: "btn btn-warning"

              .space
          - else
            = link_to "启用模版", set_enable_backend_shop_branch_bill_template_setting_path(@current_shop, @current_branch), method: :put, class: "btn btn-success"

