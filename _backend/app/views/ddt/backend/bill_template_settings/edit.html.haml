.header
  %h3= "#{t('activerecord.models.ddt/bill_template_setting')} 编辑"
.model-show
  .row
    .col-md-2
      %ul.nav.nav-pills.nav-stacked{role: "tablist"}
        - Ddt::BillTemplateSetting.all_templates.each do |template_name, index|
          %li{role: "presentation", class: ('active' if template_name == @template_name)}
            = link_to Ddt::BillTemplateSetting.human_attribute_name(template_name), "##{template_name}", role: "tab", :"data-toggle" => "tab"
    .tab-content.col-md-10
      - Ddt::BillTemplateSetting.all_templates.each do |template_name|
        .tab-pane.in{ role: "tabpanel", id: template_name, class: ('active' if template_name == @template_name)}
          = form_for @setting, url: backend_shop_branch_bill_template_setting_path(@current_shop, @current_branch, template_name: template_name) do |f|
            %h4= Ddt::BillTemplateSetting.human_attribute_name(template_name)
            .row
              .col-md-5
                = f.text_area template_name, rows: "20", class: "text form-control"
              .col-md-5.col-md-offset-1
                %div.template-preview{ :class => template_name }
            .space
            = f.submit "更新", class: "btn btn-primary btn-sm"
            = link_to "返回", backend_shop_branch_bill_template_setting_path(@current_shop, @current_branch, template_name: template_name), class: "btn btn-sm"
  .space
