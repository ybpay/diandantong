.alert.alert-success
  将如下桌台二维码打印并分别贴在对应桌台上，即可实现扫码下单的功能。微信用户到店后只需拿起微信轻轻一扫，即可实现全自动点菜下单。
.qr-code-table
  .col-xs-9
    - has_eat_in_hall_on_wechat_feature = has_feature?(:eat_in_hall_on_wechat)
    - tables.each do |table|
      .col-md-3.col-lg-2.col-sm-4
        .contact-box
          - if !has_eat_in_hall_on_wechat_feature
            .fake-qr-code
              扫码未开通
          - elsif table.qr_code_scene.is_enable?
            = image_tag table.qr_code_scene.url, width: '100%'
          - else
            .fake-qr-code
              已关闭
          %h3.m-b-xs.text-center= "#{table.table_zone.name} - #{table.name}"
          .m-t-md
            = "#{Ddt::BaseQrCodeScene.human_attribute_name(:scan_times)}: #{table.scan_times}"

          .qr-code-op
            = table.workflow_state_name
            - if table.active?
              = link_to '订单详情', get_order_backend_shop_branch_table_path(@current_shop, @current_branch, table), :'data-remote' => true, title: "#{'点击查看订单详情'}"
          %div
            = link_to "详情", backend_shop_branch_table_path(@current_shop, @current_branch, table), data: {:rel=>'tooltip'}
            - if table.qr_code_scene.is_enable?
              = link_to "关闭", disable_qr_code_backend_shop_branch_table_path(@current_shop, @current_branch, table), :title => '关闭该二维码', :data => {:confirm => '确定关闭?', :rel => 'tooltip'}, method: :put
            - else
              = link_to "开启", enable_qr_code_backend_shop_branch_table_path(@current_shop, @current_branch, table), :title => '开启该二维码', :data => {:rel => 'tooltip'}, method: :put


            = link_to "编辑", edit_backend_shop_branch_table_path(@current_shop, @current_branch, table), :title => '编辑', data: {:rel=>'tooltip'}
            = link_to "删除", [:backend, @current_shop, @current_branch, table], :method => :delete, :data => { :confirm => '确定删除?', :rel=>'tooltip' }, :title => '删除'

  .col-xs-3
    .table-order
  .clearfix

    .space

