.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/table')} 列表"

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        .form-group
          = new_btn(:table, label: '桌台')
          / = link_to "新建 #{t('activerecord.models.ddt/table')}", new_backend_shop_branch_table_path(@current_shop, @current_branch), :class=>"btn btn-primary"
          = link_to "批量新建", get_batch_create_backend_shop_branch_tables_path(@current_shop, @current_branch), :class=>"btn btn-primary"
          - if has_feature?(:eat_in_hall_on_wechat)
            .btn-group
              %button.btn.btn-danger.dropdown-toggle{type: "button", data: {toggle: "dropdown"}}
                批量导出
                %i.fa.fa-caret-down
              %ul.dropdown-menu
                - if @record_num <= 10
                  %li= link_to "批量导出桌子二维码供打印(横版)", "#{@export_all_path}&version=h"
                  %li= link_to "批量导出桌子二维码供打印(竖版)", "#{@export_all_path}&version=v"
                  %li= link_to "批量导出原始二维码供打印", "#{@export_all_path}&version=original"
                - else
                  %li= link_to "批量导出桌子二维码供打印(横版)",get_export_list_backend_shop_branch_tables_path(@current_shop, @current_branch, params: params.merge(version: :h)), remote: true
                  %li= link_to "批量导出桌子二维码供打印(竖版)", get_export_list_backend_shop_branch_tables_path(@current_shop, @current_branch, params: params.merge(version: :v)), remote: true
                  %li= link_to "批量导出原始二维码供打印", get_export_list_backend_shop_branch_tables_path(@current_shop, @current_branch, params: params.merge(version: :original)), remote: true
            = link_to '申请批量代为印刷', 'javascript:bootbox.alert("桌台二维码价格为1元/每个，快递邮费12元，如有需要，请联系售后进行购买。<br>注意：<strong>如需总部印刷，现有桌台二维码将会自动失效，由总部发货并绑定新的二维码</strong>。<br>卓台二维码效果如下图所示:")', class: 'btn btn-primary'
        = search_form_for @q, url: backend_shop_branch_tables_path(@current_shop, @current_branch, style: params[:style]), html: { class: 'form-inline', role: 'form'} do |f|
          = hidden_field_tag :style, params[:style]
          .form-group
            = f.label :name, class: 'sr-only'
            = f.search_field :name_cont, placeholder: Ddt::Table.human_attribute_name(:name), class: 'form-control'
          .form-group
            = f.label :table_zone_id_eq, class: 'sr-only'
            = f.select :table_zone_id_eq, options_for_select(@current_branch.table_zones.map{|table_zone| [table_zone.name, table_zone.id]}), {include_blank: I18n.t("activerecord.models.ddt/table_zone")}, {class: 'form-control'}
          = f.submit "搜索", class: 'btn btn-success'

  .row
    .col-lg-12
      .ibox
        .ibox-content
          = render 'ddt/backend/tables/tables', {tables: @tables}

          %br
          - if @paginate
            .pull-left= will_paginate @tables , renderer: BootstrapPagination::Rails, bootstrap: 3
          %br
