.ibox
  .ibox-title
    %h2= "#{t('activerecord.models.ddt/table')} 详情"
  .ibox-content.header
    .row
      .col-md-6.form-group
        %b
          = Ddt::Table.human_attribute_name(:name)
          \:
        = @table.name
      .col-md-6.form-group
        %b
          = Ddt::Table.human_attribute_name(:table_zone)
          \:
        = @table.table_zone.name
      .col-md-6.form-group
        %b
          = Ddt::Table.human_attribute_name(:capacity)
          \:
        = @table.capacity
      .col-md-6.form-group
        %b
          = Ddt::Table.human_attribute_name(:workflow_state)
          \:
        = @table.workflow_state_name
      .col-md-6.form-group
        %b
          = Ddt::BaseQrCodeScene.human_attribute_name(:qrcode_scaners_count)
          \:
        = @table.qr_code_scene.qrcode_scaners_count
      .col-md-6.form-group
        %b
          = Ddt::Table.human_attribute_name(:branch)
          \:
        = @table.branch.name
      .col-md-6.form-group
        %b
          = Ddt::BaseQrCodeScene.human_attribute_name(:scan_times)
          \:
        = @table.scan_times
      .col-md-6.form-group
        %b
          = Ddt::Table.human_attribute_name(:position)
          \:
        = @table.position
      .col-md-6.form-group
        %b
          = Ddt::BaseQrCodeScene.human_attribute_name(:url)
          \:
        = image_tag @table.qr_code_scene.url
      .col-md-6.form-group
        %b
          = link_to t('更换二维码'), regenerate_qr_code_backend_shop_branch_table_path(@current_shop, @current_branch,@table), :class => "btn btn-default btn-sm", method: :put, 'data-confirm' => '您确定要更换该桌台二维码？'
  .ibox-content
    .row
      = render partial: '/ddt/backend/qrcode/qrcode_scan_relations/index', locals: {qrcode_scan_relations: @table.qr_code_scene.qrcode_scan_relations.paginate(page: params[:page], per_page: 15)}

    = link_to t('Edit'), edit_backend_shop_branch_table_path(@current_shop, @current_branch, @table), :class => "btn btn-primary btn-sm"
    \
    = link_to t('Back'), backend_shop_branch_tables_path(@current_shop, @current_branch), :class => "btn btn-default btn-sm"
