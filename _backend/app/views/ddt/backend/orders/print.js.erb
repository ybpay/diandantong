var order_info = "<%= raw @order.order_detail_in_html %>"
console.log(order_info)
var myWindow = window.open();
myWindow.printed = false;
if (myWindow) {
    myWindow.document.write('<html><head><style type="text/css" media="all"> body { background: white; font-family: "SimHei",monospace,tahoma,arial,"Hiragino Sans GB",宋体,sans-serif; font-size: 8pt; } .template-b{display:inline-block;font-size: 22px;transform: translate(2px, 4px);} .template-m{display:inline-block;transform: scale(1,2);margin: 5px 0;} .template-c{text-align:center;width:210px;display:inline-block;} .template-cm{text-align:center;width:210px;display:inline-block;transform: scale(1,2);margin: 5px 0;} .template-cb{text-align:center;width:210px;display:inline-block;font-size: 22px;margin: 5px 0;} .template-qrcode{width: 200px;height: 200px;}</style></head><body>');
    myWindow.document.write(order_info + "<br/>");
    myWindow.document.write('</body></html>');
    myWindow.document.close();
    myWindow.focus();

    setTimeout(function(){
        if (!myWindow.printed) {
            myWindow.printed = true;
            myWindow.print();
            myWindow.close();
        }
    }, 1000);
} else {
    alert('弹窗被拦截，请允许弹出打印窗口。')
}
