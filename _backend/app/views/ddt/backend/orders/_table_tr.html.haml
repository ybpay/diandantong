%tr.order-table-tr{ :'data-id' => order.id }
  %td= check_box_tag "order[id][]", order.id, false, id: "order_id_#{order.id}"
  %td= "#{order.number}/#{order.placed_at}"
  - if @current_shop.multi_branch?
    %td
      - if order.branch.present?
        - if order.branch.is_abstract?
          = @current_shop.name
        - else
          = link_to order.branch.name, [:backend, @current_shop, order.branch]
  - if is_search_eatinhall_order?
    %td= [order.table_zone_name, order.table_name].join("-")
  %td= number_to_currency(order.total, unit: @current_shop.currency)
  %td= order_type_label(order)
  %td= order_state_label(order) + order_user_cancel_info(order)
  %td
    = raw pay_item_state_label(order)
  %td= order.paid_at
  - if can_show_delivery_man?
    %td= order.delivery_man_name
    %td= shipment_state_label(order)
  - if is_search_reservation_order?
    %td= order.reservation_time_info
    %td= order.reservation_table_zone_name
  %td
    - if @current_branch.present? || order.branch.present?
      = info_btn(@current_branch.present? ? [order] : [order.branch, order])
      = link_to "打印", print_backend_shop_order_path(@current_shop, order, format: 'js'), remote: true, :'data-rel' => "tooltip", :title => '打印'
      -if can_change_state?
        = order_actions(order, remote: true)
      - if can_assign_delivery_man?(order)
        - if @current_shop.enable_foreign
          .btn-group
            %button.dropdown-toggle{type: 'button', title: "指派配送员", data: {:toggle=>"dropdown"}}
              指派
              %icon.fa.fa-caret-down
            %ul.dropdown-menu{:role=>"menu"}
              %li= link_to "取消指派", assign_backend_shop_branch_delivery_order_path(@current_shop, order.branch_id, order, delivery_man_id: nil), method: :put, remote: true
              - order.branch.deliverymans.each do |d|
                %li= link_to d.name, assign_backend_shop_branch_delivery_order_path(@current_shop, order.branch_id, order, delivery_man_id: d.id),method: :put, remote: true
        - else
          = link_to "指派", get_assign_backend_shop_branch_delivery_order_path(@current_shop.id, order.branch_id, order.id), remote: true
      - if can_change_shipment_state?(order)
        = shipment_actions(order)
      - if order.type == "Ddt::DeliveryOrder"
        = link_to "查看",other_msg_backend_shop_branch_delivery_order_path(@current_shop.id, order.branch_id, order.id), remote: true
