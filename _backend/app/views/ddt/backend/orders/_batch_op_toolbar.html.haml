- @tpc = 0 unless @tpc.present?
- @tpc += 1
.row-fluid
  .col-xs-1.vcenter
    = check_box_tag "select_all_dummy_#{@tpc}", '1', false, title: '全选'
    = label_tag "select_all_dummy_#{@tpc}", class: 'blue', style:'margin: 0' do
      全选
  / .col-xs-1.vcenter
  /   = link_to batch_change_pay_item_state_backend_shop_orders_path(@current_shop, params), id: 'set_all_to_paid',
  /       class: 'btn btn-xs btn-danger batch_op_action', confirmtxt: '确认设置该订单为以现金结账方式完成支付吗？', data: {method: :post} do
  /     %icon.fa.fa-rmb
  /     已付款
.clearfix

:javascript

  $(function(){

    function update_set_to_paid_button(){
        if ($(".order-table-tr input[type='checkbox']").filter(function(i, e){
          return e.checked == true;
        }).length > 0){
          $("#set_all_to_paid").attr("disabled", null);
        }else{
          $("#set_all_to_paid").attr("disabled", '');
        }
    }

    setInterval(update_set_to_paid_button, 1000);

    function bind_dummy_to_real(dummy, real){
      dummy.on("change", function(){
        real.click();
      });
      real.on("change", function(){
        dummy.prop("checked", real.prop("checked"));
      });
    }

    bind_dummy_to_real($("#select_all_dummy_#{@tpc}"), $('#batch_op_select_all'));

  });

:css
  .vcenter {
    display: inline-block;
    vertical-align: middle;
    float: none;
  }

