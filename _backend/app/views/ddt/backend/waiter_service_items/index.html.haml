.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h3= "#{t('activerecord.models.ddt/waiter_service_item')} 列表"
    .tip.alert.alert-info
      %strong
        温馨提示：
      %p
        服务项为客户呼叫服务员时候可以选择的一些选项（比如： 需要茶水， 纸巾之类的）。 设置服务项可以提高服务质量和效率
    .form-group
      = link_to "新建 #{t('activerecord.models.ddt/waiter_service_item')}", new_backend_shop_branch_waiter_service_item_path(@current_shop, @current_branch), remote: true, :class=>"btn btn-primary btn-sm"

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        %table.table.table-striped.table-bordered
          %thead
            %tr

              %th.col-sm-1= Ddt::WaiterServiceItem.human_attribute_name(:name)
              %th
          = render 'tbody', {waiter_service_items: @waiter_service_items}
          %br
          .pull-right= will_paginate @table_zones , renderer: BootstrapPagination::Rails, bootstrap: 3
          %br
