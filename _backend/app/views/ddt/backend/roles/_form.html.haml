= simple_form_for([:backend, @current_shop, @role], html: { class: 'form-horizontal'}) do |f|
  = f.error_notification :message => error_message_in_html(@role)

  .form-inputs
    .col-sm-6
      = f.input :display_name
    .col-sm-6
      = f.input :description
    .col-xs-offset-2
      %label 权限设置
    - Ddt::Permission.all_group_by_target.each do |scope, hash|
      %div.col-sm-offset-2
        - if scope == :shop
          %h2 系统级权限
        - else
          %h2 门店级权限
      - hash.each do |target, permissions|
        .row
          %label.col-sm-2.control-label.permission-target-label{data: {scope: scope, target: target, value: 1}}
            = Ddt::Permission.target_name(target)
          .col-xs-10.permission-actions
            - permissions.each do |permission|
              = f.input_field permission.method_name, as: :boolean, class: "permission-action-input"
              = f.label permission.method_name, permission.action_name, class: "permission-action-label"

  .form-actions.col-xs-offset-2
    = f.button :submit, :class => "btn btn-primary btn-sm"

:javascript
  $(function(){
    $(".permission-target-label").click(function(){
      var scope = $(this).data("scope")
      var target = $(this).data("target")
      var value = $(this).data("value")
      $("input[id^='role_permission__"+scope+"__"+target+ "__']").prop("checked", value == 1)
      $(this).data("value", value == 1 ? 0 : 1)
    })
  })
