= simple_form_for([:backend, @current_shop, @short_message_setting], html: { :class =>"form-horizontal"}) do |f|
  .form-inputs
    .col-sm-6
      = f.input :use_sms
      .start_use_sms
        - if current_account.is_admin?
          = f.input :max_count, hint: "已用#{@short_message_setting.used_count}条"
        = f.input :use_validation_sms, hint: "启用短信后该项才有效"
        = f.input :use_order_sms, hint: "启用短信后该项才有效"
        = f.input :use_birthday_sms, hint: "系统自动在会员生日那天发送祝福短信, 启用短信后该项才有效"
        = f.input :birthday_message, hint: "生日短信内容， 最终短信效果为（生日快乐， [您配置的短信内容]）"
        = f.input :enable_vip_info_phone_validation
      .form-actions
        .col-xs-offset-4
          = f.button :submit, :class => "btn btn-primary"
  .clearfix 

:javascript
  (function(){
    var check_box = $("#short_message_setting_use_sms")
    var check_box_handler = function(){
      var This = $("#short_message_setting_use_sms")
      if(This[0].checked){
        $(".start_use_sms").css('display','block');
      }
      else{
        $(".start_use_sms").css('display','none');
      };
    }

    check_box.on('click', check_box_handler)
    check_box_handler();
  })();