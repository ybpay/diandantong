%h2= "#{t('activerecord.models.ddt/short_message_setting')} 详情"

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      .ibox
        .ibox-content
          %p
            %b
              = Ddt::ShortMessageSetting.human_attribute_name(:use_sms)
              \:
            = t(@short_message_setting.use_sms?.to_s)
          - if @short_message_setting.use_sms?
            %p
              %b
                = Ddt::ShortMessageSetting.human_attribute_name(:use_validation_sms)
                \:
              = t(@short_message_setting.use_validation_sms?.to_s)
            %p
              %b
                = Ddt::ShortMessageSetting.human_attribute_name(:use_order_sms)
                \:
              = t(@short_message_setting.use_order_sms?.to_s)
            %p
              %b
                = Ddt::ShortMessageSetting.human_attribute_name(:use_birthday_sms)
                \:
              = t(@short_message_setting.use_birthday_sms?.to_s)
          %p
            %b
              = Ddt::ShortMessageSetting.human_attribute_name(:used_count)
              \:
            = @short_message_setting.used_count
          %p
            %b
              = Ddt::ShortMessageSetting.human_attribute_name(:remaining_count)
              \:
            = @short_message_setting.remaining_count
          %p
            %b
              = Ddt::ShortMessageSetting.human_attribute_name(:enable_vip_info_phone_validation)
              \:
            = t(@short_message_setting.enable_vip_info_phone_validation?.to_s)
          %table.table.table-striped
            %thead
              %tr
                %th 充值前数量
                %th 充值时间
            %tbody
              - @short_message_setting.versions.each do |version|
                %tr
                  %td= version.reify.try(:max_count)
                  %td= version.created_at

          = link_to t('Edit'), edit_backend_shop_short_message_setting_path(@current_shop), :class => "btn btn-primary"
