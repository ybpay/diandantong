%tr
  - if @mode && controller_name == "devices"
    %th.col-sm-1
      = check_box_tag "all_pages", "", false, {id: 'batch_op_select_all', data:{model:'page', token: form_authenticity_token}}
      %label{for: "all_devices"} 全选
  %th= Ddt::ShakeAround::Page.human_attribute_name(:page_id)
  %th= Ddt::ShakeAround::Page.human_attribute_name(:icon_url)
  %th= Ddt::ShakeAround::Page.human_attribute_name(:title)
  %th= Ddt::ShakeAround::Page.human_attribute_name(:description)
  %th= Ddt::ShakeAround::Page.human_attribute_name(:count)
  %th= Ddt::ShakeAround::Page.human_attribute_name(:comment)
  - if @mode.blank?
    %th
