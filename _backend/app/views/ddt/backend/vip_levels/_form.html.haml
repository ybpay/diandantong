= simple_form_for([:backend, @current_shop, @vip_level], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@vip_level)

    .form-inputs
      = f.input :name, placeholder: '例如：金牌会员，银牌会员等'
      = f.input :discount, hint: '优惠折扣，1.0代表全价，0.5代表5折优惠，依次类推0.0代表免费'
      = f.input :auto_upgrade, input_html: {onchange: 'change_auto_upgrade_callback()'}
      .upgrade-columns
        = f.input :upgrade_recharge_money  , hint: '当低级别会员总充值金额满该数值时系统将自动升级该会员至当前级别, 可不填'
        = f.input :upgrade_total_amount     , hint: '当低级别会员总消费额满该数值时系统将自动升级该会员至当前级别, 可不填'
        = f.input :upgrade_get_credits     , hint: '当低级别会员总获得积分满该数值时系统将自动升级该会员至当前级别, 可不填'

    .form-actions.col-xs-offset-2
      = f.button :submit, :class => "btn btn-primary btn-sm"

:javascript
  function change_auto_upgrade_callback(){
    var auto_upgrade = $('#vip_level_auto_upgrade').is(':checked');
    if(auto_upgrade){
      $('.upgrade-columns').show();
    }else{
      $('.upgrade-columns').hide();
    }
  }

  $(document).ready(function(){
    change_auto_upgrade_callback();
  });
