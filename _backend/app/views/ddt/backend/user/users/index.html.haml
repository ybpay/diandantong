.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/user')} 列表"

%table.table.table-striped.table-bordered
  %thead
    %tr
      %th.col-sm-1= sort_link(@q, :nickname, Ddt::UniqueUser.human_attribute_name(:nickname))
      %th.col-sm-1= sort_link(@q, :phone, Ddt::User.human_attribute_name(:phone))
      %th.col-sm-1= sort_link(@q, :placed_orders_count, Ddt::User.human_attribute_name(:placed_orders_count))
      %th.col-sm-1= sort_link(@q, :type, Ddt::User.human_attribute_name(:type))
      %th.col-sm-1= sort_link(@q, :vip_info_id, Ddt::User.human_attribute_name(:vip_info))

      %th.col-sm-1

  %tbody
    - @users.each do |user|
      %tr
        %td= user.nickname
        %td= user.phone
        %td= user.placed_orders_count
        %td= I18n.t("activerecord.models.#{user.type.underscore}")
        %td= user.vip_info.to_label
        %td
          = link_to tag(:icon,:class=>"fa fa-bars"), [:backend, @current_shop, user], :class => "btn btn-xs btn-info"
          = link_to tag(:icon,:class=>"fa fa-edit"), edit_backend_shop_base_user_path(@current_shop, user), :class => "btn btn-xs btn-success"
    = no_record_hint(@users)
%br
.pull-right= will_paginate @users , renderer: BootstrapPagination::Rails, bootstrap: 3
%br