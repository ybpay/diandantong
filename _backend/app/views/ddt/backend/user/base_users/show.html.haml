.header
  %h3= "#{t('activerecord.models.ddt/base_user')} 详情"
.model-show
  %p
    %b
      = Ddt::BaseUser.human_attribute_name(:id)
      \:
    = @base_user.id
  %p
    %b
      = Ddt::BaseUser.human_attribute_name(:phone)
      \:
    = @base_user.phone
  %p
    %b
      = Ddt::BaseUser.human_attribute_name(:placed_orders_count)
      \:
    = @base_user.placed_orders_count
  %p
    %b
      = Ddt::BaseUser.human_attribute_name(:is_blocked)
      \:
    = @base_user.is_blocked? ? '是' : '否'
  %p
    %b
      = Ddt::BaseUser.human_attribute_name(:type)
      \:
    = I18n.t("activerecord.models.#{@base_user.type.underscore}")
  %p
    %b
      = Ddt::BaseUser.human_attribute_name(:vip_info)
      \:
    = link_to @base_user.vip_info.try(:name)||@base_user.id, [:backend, @current_shop, @base_user.vip_info] if @base_user.vip_info
    = link_to tag(:icon,:class=>"fa fa-pencil"), edit_backend_shop_vip_info_path(@current_shop, @base_user.vip_info), :class => "btn btn-xs btn-success"

  %p
    %b
      = Ddt::BaseUser.human_attribute_name(:last_latitude)
      \:
    = @base_user.last_latitude
  %p
    %b
      = Ddt::BaseUser.human_attribute_name(:last_longitude)
      \:
    = @base_user.last_longitude
  %p
    %b
      = Ddt::BaseUser.human_attribute_name(:last_location_label)
      \:
    = @base_user.last_location_label
  %p
    %b
      = Ddt::BaseUser.human_attribute_name(:last_location_time)
      \:
    = @base_user.last_location_time
  %p
    %b
      = Ddt::BaseUser.human_attribute_name(:following_branches_count)
      \:
    = @base_user.following_branches_count
  %p
    %b
      = Ddt::UserCardWallet.human_attribute_name(:amount)
      \:
    %label.card_wallet_amount
      = @base_user.card_wallet.amount
    - if @base_user.vip?
      = get_recharge_btn(@base_user.card_wallet, v: :base_user)
      = get_exchange_btn(@base_user.card_wallet, v: :base_user)
  %p
    %b
      = Ddt::UserCreditsWallet.human_attribute_name(:amount)
      \:
    %label.credits_wallet_amount
    = @base_user.credits_wallet.amount
    = get_exchange_btn(@base_user.credits_wallet, v: :base_user)

  %p
    %b
      = Ddt::VipInfo.human_attribute_name(:total_amount)
      \:
    = @base_user.vip_info.total_amount

  %p
    %b
      = Ddt::BaseUser.human_attribute_name(:vip_info)
      \:
    = link_to @base_user.vip_info.to_label, [:backend, @current_shop, @base_user.vip_info]
    = link_to tag(:icon,:class=>"fa fa-pencil"), edit_backend_shop_vip_info_path(@current_shop, @base_user.vip_info), :class => "btn btn-xs btn-success"

  %p
    %b
      = Ddt::VipInfo.human_attribute_name(:last_placed_at)
    = @base_user.vip_info.last_placed_at.try(:strftime, "%F %T")

  - if @base_user.type == "Ddt::User"
    %p
      %b
        = Ddt::UniqueUser.human_attribute_name(:nickname)
        \:
      = @base_user.unique_user.nickname
    %p
      %b
        = Ddt::UniqueUser.human_attribute_name(:headimgurl)
        \:
      = image_tag(@base_user.unique_user.headimgurl, size: "200x200")
    %p
      %b
        = Ddt::UniqueUser.human_attribute_name(:sex)
        \:
      = @base_user.unique_user.sex_name
    %p
      %b
        = Ddt::UniqueUser.human_attribute_name(:region)
        \:
      = @base_user.unique_user.region



  .space

= link_to t('Edit'), edit_backend_shop_base_user_path(@current_shop, @base_user), :class => "btn btn-primary btn-sm"
\
= link_to t('Back'), backend_shop_base_users_path(@current_shop), :class => "btn btn-default btn-sm"
