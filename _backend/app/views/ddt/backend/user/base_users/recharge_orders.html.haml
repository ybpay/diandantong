%table.table.table-striped.table-bordered
  %thead
    %tr
      %th.col-sm-1= sort_link(@q.ransack_model, :number, "订单号")
      %th.col-sm-1= sort_link(@q.ransack_model, :total, "订单总额")
      %th.col-sm-1= Ddt::RechargeProduct.human_attribute_name(:recharge_amount)
      %th.col-sm-1= Ddt::RechargeProduct.human_attribute_name(:name)
      %th.col-sm-1= sort_link(@q.ransack_model, :state, "订单状态")
      %th.col-sm-1= sort_link(@q.ransack_model, :pay_item_state, "支付状态")
      %th.col-sm-1= sort_link(@q.ransack_model, :placed_at, "下单时间")
      %th.col-sm-2
  %tbody
    - @recharge_orders.each do |order|
      %tr
        %td= order.number
        %td= order.total_in_currency
        - rechange_product = order.line_items.first.try(:itemable)
        %td= number_to_currency(rechange_product.recharge_amount * order.line_items.first.quantity, unit: @current_shop.currency) if rechange_product.present?
        %td= rechange_product.try(:name)
        %td= order_state_label(order)
        %td= raw pay_item_state_label(order)
        %td= order.placed_at
        %td
          = info_btn(@current_branch.present? ? [order] : [order.branch, order])

%br
.pull-right= will_paginate @recharge_orders , renderer: BootstrapPagination::Rails, bootstrap: 3
%br
