.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox
    .ibox-title
      %h3= "#{t('activerecord.models.ddt/cs_branch_binding')} 详情"
    .ibox-content.header
      - unless @cs_branch_binding.present?
        .form-group
          = link_to tag(:icon, :class => 'fa fa-plus') + ' 开启CS模式',
          backend_shop_branch_cs_branch_binding_path(@current_shop, @current_branch),
          class: 'btn btn-primary',
          method: :post
      - else
        .model-show
          = render partial: 'attr', locals: { name: :force_online }
          = render partial: 'attr', locals: { name: :http_proxy_url }
          = render partial: 'attr', locals: { name: :online }
          = render partial: 'attr', locals: { name: :token }
          = render partial: 'attr', locals: { name: :local_ip }
          - if @cs_branch_binding.local_ip.present? && @cs_branch_binding.http_proxy_url.present? && !@cs_branch_binding.http_proxy_url.include?(@cs_branch_binding.local_ip)
            .label.label-danger 本地IP和代理服务器不一致，本地代理服务器配置可能有异常
          = render partial: 'attr', locals: { name: :local_mac }
          = render partial: 'attr', locals: { name: :remote_ip }
          = render partial: 'attr', locals: { name: :version }
          = render partial: 'attr', locals: { name: :last_sync_at }
          = render partial: 'attr', locals: { name: :upgraded_at }
          .space

        .form-group
          = link_to t('Edit'), edit_backend_shop_branch_cs_branch_binding_path(@current_shop, @current_branch), :class => "btn btn-primary"

        %table.table.table-striped.table-bordered
          %thead
            %tr
              %th.col-sm-1= Ddt::CsOnlineLog.human_attribute_name(:online)
              %th.col-sm-1= Ddt::CsOnlineLog.human_attribute_name(:local_ip)
              %th.col-sm-1= Ddt::CsOnlineLog.human_attribute_name(:local_mac)
              %th.col-sm-1= Ddt::CsOnlineLog.human_attribute_name(:remote_ip)
              %th.col-sm-1= Ddt::CsOnlineLog.human_attribute_name(:version)
              %th.col-sm-1= Ddt::CsOnlineLog.human_attribute_name(:last_sync_at)
              %th.col-sm-1= Ddt::CsOnlineLog.human_attribute_name(:upgraded_at)
              %th.col-sm-1= Ddt::CsOnlineLog.human_attribute_name(:created_at)

          %tbody
            - @cs_online_logs.each do |log|
              %tr
                %td= log.online ? '在线' : '离线'
                %td= log.local_ip
                %td= log.local_mac
                %td= log.remote_ip
                %td= log.version
                %td= log.last_sync_at.try(:strftime, '%F %T')
                %td= log.upgraded_at.try(:strftime, '%F %T')
                %td= log.created_at.try(:strftime, '%F %T')
            = no_record_hint(@cs_online_logs)
        %br
        .pull-right= will_paginate @cs_online_logs , renderer: BootstrapPagination::Rails, bootstrap: 3
        %br
