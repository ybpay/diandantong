= simple_nested_form_for([:backend, @current_shop, @current_branch, @cs_branch_binding], html: { class: 'form-horizontal'}) do |f|
  = f.error_notification :message => error_message_in_html(@cs_branch_binding)

  .form-inputs
    - if current_account.is_admin?
      = f.input :force_online, hint: '强制允许在线点餐,当网络状态良好,但门店的服务器瘫痪,可以暂时打开此选项'
    = f.input :http_proxy_url, hint: '必须http://协议开始，端口正常为8080', placeholder: 'http://xxx.xxx.xxx.xxx'

    .form-actions
      .col-sm-offset-4
        = f.button :submit, :class => "btn btn-primary"
