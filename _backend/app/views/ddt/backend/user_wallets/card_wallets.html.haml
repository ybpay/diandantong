.header
  %h3= "#{t('activerecord.models.ddt/user_card_wallet')} 列表"

%table.table.table-striped.table-bordered
  %thead
    %tr
      %th.col-sm-1 会员编号
      %th.col-sm-1 姓名
      %th.col-sm-1 性别
      %th.col-sm-1 电话
      %th.col-sm-1 会员等级
      %th.col-sm-1= Ddt::UserCardWallet.human_attribute_name(:amount)
      %th.col-sm-1= Ddt::UserCardWallet.human_attribute_name(:cash_amount)
      %th.col-sm-1= Ddt::UserCardWallet.human_attribute_name(:extra_amount)
      %th.col-sm-1= Ddt::UserCardWallet.human_attribute_name(:total_recharge_money)

  %tbody
    - @wallets.each do |wallet|
      - vip = wallet.owner
      - if vip.present?
        %tr
          %td= vip.vip_no
          %td= vip.name
          %td= vip.sex_name
          %td= vip.phone
          %td= vip.vip_level.name
          %td= number_to_currency(wallet.amount, unit: @current_shop.currency)
          %td= number_to_currency(wallet.cash_amount, unit: @current_shop.currency)
          %td= number_to_currency(wallet.extra_amount, unit: @current_shop.currency)
          %td= number_to_currency(wallet.total_recharge_money, unit: @current_shop.currency)

    = no_record_hint(@wallets)
%br
.pull-right= will_paginate @wallets , renderer: BootstrapPagination::Rails, bootstrap: 3
%br
