= simple_form_for([:backend, @current_shop, @current_branch, @item_note], html: { class: 'form-horizontal'}, remote: true, wrapper: :horizontal_form_long) do |f|
  = f.error_notification :message => error_message_in_html(@item_note)

  .form-inputs
    = f.input :name
    = f.input :tag_names, input_html: { data: { useas: 'tag', url: backend_shop_branch_tags_path(@current_shop, @current_branch), :"search-conditions" => {type_eq: 'Ddt::ItemNoteTag'} ,saved: @item_note.saved_tags, placeholder: '为您的品注打上标签' }, class: 'ddb-select2'}, hint: '您可以输入新的标签， 使用逗号","或空格" "来分隔标签, 每个标签最多十个字符'
    = f.input :product_ids_string, input_html: {data: {url: search_backend_shop_branch_products_path(@current_shop, @current_branch), saved: @item_note.products, placeholder: '可选择该品注的产品', single: false}, class: 'ddb-select2'}, hint: '输入产品名字搜索更多'

  .form-actions.col-xs-offset-2
    = f.button :submit, :class => "btn btn-primary btn-sm"
