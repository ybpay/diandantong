.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/item_note')} 列表"
    %p 品注是指在对某个产品增加顾客的个性化要求，比如您可以设置“加辣","少放盐"等品注，以便于厨师在烹饪时进行灵活的调整

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        = new_btn(:item_note, label: '品注', title: '新建', remote: true)

  .row
    .col-lg-12
      .ibox 
        .ibox-content
          .row
            %div.dd.col-sm-6.reasons{ data: { base_url: backend_shop_branch_item_notes_path(@current_shop, @current_branch)}}
              %ol.dd-list
                = render :partial => "item", :collection => @item_notes, :as => :item_note
                = no_record_hint(@item_notes)

