.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox
    .ibox-title
      %h2= "#{t('activerecord.models.ddt/print_setting')} 详情"
    .ibox-content.header
      .col-md-6
        %p
          %b
            = Ddt::PrintSetting.human_attribute_name(:is_auto_confirm)
            \:
          = @print_setting.is_auto_confirm ? '是' : '否'
        %p
          %b
            = Ddt::PrintSetting.human_attribute_name(:is_webpos_print_eatinhall_order_when_place)
            \:
          = @print_setting.is_webpos_print_eatinhall_order_when_place ? '是' : '否'
        %p
          %b
            = Ddt::PrintSetting.human_attribute_name(:is_current_print_when_place)
            \:
          = @print_setting.is_current_print_when_place ? '是' : '否'
        %p
          %b
            = Ddt::PrintSetting.human_attribute_name(:merge_same_item)
            \:
          = @print_setting.merge_same_item ? '是' : '否'


        = link_to t('Edit'), edit_backend_shop_branch_print_setting_path(@current_shop, @current_branch), :class => "btn btn-primary btn-sm"
      .clearfix
