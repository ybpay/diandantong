.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/print_record')} 列表"

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      .ibox 
        .ibox-content
          %table.table.table-striped
            %thead
              %tr
                %th.col-sm-1= Ddt::PrintRecord.human_attribute_name(:id)
                %th.col-sm-1= Ddt::PrintRecord.human_attribute_name(:times)
                %th.col-sm-6= Ddt::PrintRecord.human_attribute_name(:content)
                %th.col-sm-2= Ddt::PrintRecord.human_attribute_name(:created_at)
                %th.col-sm-2= Ddt::PrintRecord.human_attribute_name(:updated_at)

            %tbody
              - @print_records.each do |print_record|
                %tr
                  %td= print_record.id
                  %td= print_record.times
                  %td= print_record.content
                  %td= print_record.created_at.strftime("%F %T")
                  %td= print_record.updated_at.strftime("%F %T")

              = no_record_hint(@print_records)  
                
          %br
          .pull-right= will_paginate @print_records , renderer: BootstrapPagination::Rails, bootstrap: 3
