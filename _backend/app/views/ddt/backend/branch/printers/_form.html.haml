
.alert.alert-warning
  %strong 温馨提示
  %p
    如果您在下拉框中找不到您要的条目，可以输入名字进行搜索更多.
.alert.alert-info.use-in-webpos
  %strong
    关于使用场景:&nbsp;&nbsp;
  客户下单后,收银台打印机会自动打印已支付的订单或现金支付的订单
.alert.alert-info.use-in-kitchen
  %strong
    关于使用场景:&nbsp;&nbsp;
  厨房打印机会在订单确认后打印外送订单和堂点订单（注：预定和团购订单不会自动在厨房打印机中打印，需手动指定打印）
.alert.alert-info.use-in-queue
  %strong
    关于使用场景:&nbsp;&nbsp;
  排号打印机会在取号之后，自动打印牌号小票
.alert.alert-info.use-in-label
  %strong
    关于使用场景:&nbsp;&nbsp;
  标签打印机会在订单确认后, 逐个打印产品, 一个产品一个标签, 适用于热敏标签打印机, 例如奶茶标签
.alert.alert-info.use-in-guest
  %strong
    关于使用场景:&nbsp;&nbsp;
  客看单打印机  客户下单后, 打印客看单，与收银台打单时间不同，收银台会在买单后出结账单
.ibox
  .ibox-title
    .block
      = simple_form_for([:backend, @current_shop, @current_branch, @printer], html: { class: 'form-horizontal'}) do |f|
        = f.error_notification :message => error_message_in_html(@printer)

        .form-inputs
          .col-sm-6
            .form-group 
              .col-sm-offset-1
                = f.input :type, collection: Ddt::Printer.type_collection, disabled: !@printer.new_record?
                = f.input :number, hint: raw("如果没有授权码，请点击<a href='javascript:generate_printer_code()'>立即生成</a>")
                = f.input :name
                = f.input :times
                = f.input :print_spec, collection: Ddt::Printer.print_spec_collection, include_blank: false
                = f.input :enable
                .printer-feiyin-inputs{ style: ('display:none;' unless @printer.is_feiyin?)}
                  = f.input :api_key
                  = f.input :member_code
                  = f.input :phone
                
                = f.input :table_ids_string, input_html: { data: { url: backend_shop_branch_tables_path(@current_shop, @current_branch), saved: @printer.tables.map(&:select_json), placeholder: "请选择桌台" }, class: 'ddb-select2'}, hint: '当您设置了桌台后，该打印机就只关心来自这些桌台的订单。'
          .col-sm-6
            .form-group 
              .print-config
                = f.input :is_print_all, hint: '全品打印机为： 打印订单的全部产品条目信息'
                .set_product{ style: ('display:none;' if @printer.is_print_all)}
                  = f.input :product_ids_string, input_html: { data: { url: search_backend_shop_branch_products_path(@current_shop, @current_branch), saved: @printer.products.map(&:select_json), placeholder: "请选择产品" }, class: 'ddb-select2'}, hint: '当您设置了产品后，该打印机就只会打印它关心的产品，而不是整个订单。适用场景：例如不同厨师专职负责不同菜品的烹饪'
                  = f.input :category_ids_string, input_html: { data: { url: backend_shop_branch_categories_path(@current_shop, @current_branch), saved: @printer.categories.map(&:select_json), placeholder: "请选择产品分类" }, class: 'ddb-select2'}, hint: '当您设置了产品分类后，该打印机就只会打印它关心的产品分类，而不是整个订单。适用场景：例如不同厨师专职负责不同菜品分类的烹饪'
                  = f.input :ban_product_ids_string, input_html: { data: { url: search_backend_shop_branch_products_path(@current_shop, @current_branch), saved: @printer.ban_products.map(&:select_json), placeholder: "请选择产品" }, class: 'ddb-select2'}, hint: '当您设置了产品后，该打印机不会打印该产品'
                = f.input :print_one_by_one, hint: '是否一张小票只打印一份产品， 开启后， 打印机会把它关心的产品，一个一张小票打印出来, 该类小票只包含简要的信息如： 桌台信息， 配送信息等'
                = f.input :print_per_product, hint: '与上一个选项类似，但同款产品只会打印一张小票并进行数量合并，勾选本选项会覆盖上一个选项'
                = f.input :use_scene, collection: Ddt::Printer.use_scene_collection, include_blank: false, hint: "注：客看单会在用户有效订单（如：外卖的货到付款、堂吃订单）落单时出单，收银台会在用户涉及到买单时出单，如需在落单时出单也在买单时出单，请使用同一授权码配置两台不同场景的打印机"
          .clearfix
        
        .form-actions.col-sm-offset-2
          = f.button :submit

:javascript
  function generate_printer_code() {
    $.ajax({
      url: "#{backend_shop_printer_codes_path(@current_shop, format: :json)}",
      type: "json",
      method: "post",
      success: function(result){
        $('#printer_number').val(result.code)
      },
      failure: function(resp){
        alert(resp.errors)
      }
    })
  }
  $(document).ready(function() {

    var change_type = function(type){
      if(type === 'Ddt::Printer::Feiyin'){
        $('.printer-feiyin-inputs').show()
        $('.printer-feie-inputs').hide()
      }else{
        $('.printer-feiyin-inputs').hide()
        $('.printer-feie-inputs').show()
      }
      if(type === 'Ddt::Printer::Normal'){
        $('.printer_print_spec').show()
      }else{
        $('.printer_print_spec').hide()
      }
    }
    var change_scene = function(scene){
      $('.use-in-webpos').hide();
      $('.use-in-kitchen').hide();
      $('.use-in-queue').hide();
      $('.use-in-label').hide();
      $('.use-in-guest').hide();
      $(".use-in-"+scene).show();
      if(scene === "queue"){
        $(".print-config").hide();
      }else{
        $(".print-config").show();
      }
    }
    $('#printer_type').change(function(){
      var type = $('#printer_type').val()
      change_type(type);
    })
    $('#printer_is_print_all').click(function(){
      if($(this).is(":checked")){
        $('.set_product').hide();
      }else{
        $('.set_product').show();
      }
    })
    $('#printer_use_scene').change(function(){
      var use_scene = $('#printer_use_scene').val();
      change_scene(use_scene);
    })
    change_type($('#printer_type').val());
    change_scene($('#printer_use_scene').val());
  });
