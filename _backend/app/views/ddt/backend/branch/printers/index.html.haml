.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/printer')} 列表"

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        = new_btn(:printer, label: t('activerecord.models.ddt/printer'))

  .row
    .col-lg-12
      .ibox 
        .ibox-content
          %table.table.table-striped
            %thead
              %tr
                %th.col-sm-2= Ddt::Printer.human_attribute_name(:name)
                %th.col-sm-2= Ddt::Printer.human_attribute_name(:type)
                %th.col-sm-1= Ddt::Printer.human_attribute_name(:use_scene)
                %th.col-sm-1= Ddt::Printer.human_attribute_name(:number)
                %th.col-sm-1= Ddt::Printer.human_attribute_name(:times)
                %th.col-sm-1= Ddt::Printer.human_attribute_name(:is_print_all)
                %th.col-sm-1= Ddt::Printer.human_attribute_name(:enable)
                %th.col-sm-3

            %tbody
              = render partial: 'tr', collection: @printers, as: :printer

              = no_record_hint(@printers)

