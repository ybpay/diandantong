%tr{id: "printer_#{printer.id}"}
  %td= printer.name
  %td= printer.type_name
  %td= printer.use_scene_name
  %td= printer.number
  %td= printer.times
  %td
    = printer.is_print_all_label
    - if printer.print_per_product?
      (一个产品只打印一张小票)
    - elsif printer.print_one_by_one?
      (一张小票只打一个产品)
  %td
    = link_to [:toggle, :backend, @current_shop, @current_branch, printer], remote: true, method: :post do
      = enable_label(printer.enable)
  %td
    = edit_btn(printer)
    = delete_btn(printer)
    = link_to "打印记录", [:backend, @current_shop, @current_branch, printer, :print_records], :'data-rel' => "tooltip"
    = link_to "打印测试", [:test_print, :backend, @current_shop, @current_branch, printer],  :'data-rel' => "tooltip", remote: true, method: :post
    - if printer.is_managed?
      = link_to "查询状态", [:get_state, :backend, @current_shop, @current_branch, printer], :'data-rel' => "tooltip", remote: true, method: :get
      = link_to "清理打印任务", [:clear_records, :backend, @current_shop, @current_branch, printer], :'data-rel' => "tooltip", remote: true, method: :post
