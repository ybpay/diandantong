.header
  %h3= "#{t('activerecord.models.ddt/email_setting')} 详情"
.model-show
  %p
    %b
      = Ddt::EmailSetting.human_attribute_name(:address)
      \:
    = @email_setting.address
  %p
    %b
      = Ddt::EmailSetting.human_attribute_name(:user_name)
      \:
    = @email_setting.user_name
  %p
    %b
      = Ddt::EmailSetting.human_attribute_name(:password)
      \:
    = '*' * (@email_setting.password.try(:length) || 0)
  .space

= simple_form_for :test, :url => test_backend_shop_email_setting_path(@current_shop), html: {class: 'form-inline' }  do |f|
  = f.submit '发送测试邮件', class: 'btn btn-xs btn-primary'
  = f.input :email, as: :string, placeholder: '接收邮箱', label: false
.space
= link_to t('Edit'), edit_backend_shop_email_setting_path(@current_shop), :class => "btn btn-primary btn-sm"
