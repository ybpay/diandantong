.col-md-offset-2.col-md-8
  .row
    .col-md-5
      .contact-box
        %h3.text-center= t('activerecord.models.ddt/qr_code_scene')
        %div{style: "margin: 20px 10px; text-align:center; font-size: 80px;"}
          %i.fa.fa-qrcode
        %div{style: "margin: 20px 10px; text-align:center;"}= link_to t('activerecord.models.ddt/qr_code_scene'), [:backend, @current_shop, :qr_code_scenes], class: 'btn btn-primary btn-lg'
        %p= I18n.t('activerecord.description.ddt/qr_code_scene')
    .col-md-5.col-md-offset-2
      .contact-box
        %h3.text-center= t('activerecord.models.ddt/wechat_qr_code_scene')
        %div{style: "margin: 20px 10px; text-align:center; font-size: 80px;"}
          %i.fa.fa-wechat
        %div{style: "margin: 20px 10px; text-align:center;"}= link_to t('activerecord.models.ddt/wechat_qr_code_scene'), [:backend, @current_shop, :wechat_qr_code_scenes], class: 'btn btn-primary btn-lg'
        %p= I18n.t('activerecord.description.ddt/wechat_qr_code_scene')