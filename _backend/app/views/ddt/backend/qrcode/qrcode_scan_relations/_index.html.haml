.ibox-content
  .row
    - qrcode_scan_relations.each do |qrcode_scan_relation|
      .col-lg-2.col-md-3.col-sm-4.col-xs-6
        .contact-box
          .col-sm-12
            .text-center
              - if qrcode_scan_relation.scaner.try(:headimgurl).present?
                = image_tag qrcode_scan_relation.scaner.headimgurl, width: '100%', class: 'img-circle'
              - else
                = image_tag @current_shop.image.thumb.url, width: '100%', class: 'img-circle'
              .m-t-xs.font-bold
                - if qrcode_scan_relation.scaner.is_a? Ddt::WechatUser
                  = link_to qrcode_scan_relation.scaner.to_label, [:backend, @current_shop, qrcode_scan_relation.scaner.user]
                - elsif qrcode_scan_relation.scaner.is_a? Ddt::User
                  = link_to qrcode_scan_relation.scaner.to_label, [:backend, @current_shop, qrcode_scan_relation.scaner]
                - else
                  = qrcode_scan_relation.scaner
              .p
                \ 扫描时间
                = qrcode_scan_relation.created_at
          .clearfix
    = no_record_hint(qrcode_scan_relations)
