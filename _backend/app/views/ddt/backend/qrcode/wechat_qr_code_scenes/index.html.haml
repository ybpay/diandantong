- unless (@current_shop.wechat_accounts.of_primary.first.account_verified_service? rescue nil)
  .alert.alert-danger 对不起，您的主公众账号不是认证的服务号，未能获得微信公众号的二维码接口。请联系腾讯微信进行解决。
- else
  %h3= "#{t('activerecord.models.ddt/wechat_qr_code_scene')} 列表"
  %p= "#{t('activerecord.description.ddt/wechat_qr_code_scene')}"
  .form-group
    = search_form_for @q, url: [:backend, @current_shop, :wechat_qr_code_scenes], html: {class: 'form-inline  pull-right', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
      = f.input_field :name_cont, placeholder: Ddt::WechatQrCodeScene.human_attribute_name(:name), class: 'form-control'
      = f.submit "搜索", class: 'btn btn-sm btn-success'

    = link_to content_tag('i', "", class: "fa fa-plus") + " #{t('activerecord.models.ddt/wechat_qr_code_scene')}", new_backend_shop_wechat_qr_code_scene_path(@current_shop), :class=>"btn btn-primary btn-sm"

.ibox-content
  .row
    - @wechat_qr_code_scenes.each do |wechat_qr_code_scene|
      .col-lg-3.col-md-4.col-sm-6.col-xs-12
        .contact-box
          .col-sm-12
            .text-center
              %a{href: backend_shop_wechat_qr_code_scene_path(@current_shop, wechat_qr_code_scene)}
                = image_tag wechat_qr_code_scene.url, width: '100%'
              .m-t-xs.font-bold= wechat_qr_code_scene.name
              .p
                \ 扫描次数
                = wechat_qr_code_scene.scan_times
          .clearfix
          = link_to "修改", edit_backend_shop_wechat_qr_code_scene_path(@current_shop, wechat_qr_code_scene), :title => '修改二维码信息', data: {:rel=>'tooltip'}, class: 'btn btn-w-m btn-primary btn-block'
          = link_to "删除", [:backend, @current_shop, wechat_qr_code_scene], :method => :delete, :data => { :confirm => '确定删除?', :rel=>'tooltip' }, :title => '删除', class: 'btn btn-w-m btn-white btn-block'

  %br
  .pull-right= will_paginate @wechat_qr_code_scenes , renderer: BootstrapPagination::Rails, bootstrap: 3
  %br
