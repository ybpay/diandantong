%h3= "#{t('activerecord.models.ddt/wechat_qr_code_scene')} 详情"
.ibox-content
  .col-md-6.form-group
    %b
      = Ddt::BaseQrCodeScene.human_attribute_name(:owner)
      \:
    = @wechat_qr_code_scene.owner
  .col-md-6.form-group
    %b
      = Ddt::BaseQrCodeScene.human_attribute_name(:name)
      \:
    = @wechat_qr_code_scene.name
  .col-md-6.form-group
    %b
      = Ddt::BaseQrCodeScene.human_attribute_name(:gonghao_open_id)
      \:
    = @wechat_qr_code_scene.gonghao_open_id
  .col-md-6.form-group
    %b
      = Ddt::BaseQrCodeScene.human_attribute_name(:scan_times)
      \:
    = @wechat_qr_code_scene.scan_times
  .col-md-6.form-group
    %b
      = Ddt::BaseQrCodeScene.human_attribute_name(:qrcode_scaners_count)
      \:
    = @wechat_qr_code_scene.qrcode_scaners_count
  .col-md-6.form-group
    %b
      = Ddt::BaseQrCodeScene.human_attribute_name(:scene_id)
      \:
    = @wechat_qr_code_scene.scene_id
  .col-md-6.form-group
    %b
      = Ddt::BaseQrCodeScene.human_attribute_name(:limit_scene_type)
      \:
    = @wechat_qr_code_scene.limit_scene_type_name
  - if @wechat_qr_code_scene.is_branch_message?
    .col-md-6.form-group
      %b
        = Ddt::BaseQrCodeScene.human_attribute_name(:branch_id)
        \:
      = @wechat_qr_code_scene.branch.try(:name)
  .col-md-6.form-group
    %b
      = Ddt::BaseQrCodeScene.human_attribute_name(:builtin)
      \:
    = @wechat_qr_code_scene.builtin
  .col-md-6.form-group
    %b
      = Ddt::BaseQrCodeScene.human_attribute_name(:url)
      \:
    = image_tag @wechat_qr_code_scene.url, width: '100'
  .clearfix
  .col-md-6.form-group
    = link_to t('Edit'), edit_backend_shop_wechat_qr_code_scene_path(@current_shop, @wechat_qr_code_scene), :class => "btn btn-primary"
  .clearfix

= render partial: '/ddt/backend/qrcode/qrcode_scan_relations/index', locals: {qrcode_scan_relations: @wechat_qr_code_scene.qrcode_scan_relations.paginate(page: params[:page], per_page: 15)}