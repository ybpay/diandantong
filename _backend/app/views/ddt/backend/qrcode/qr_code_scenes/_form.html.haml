= simple_form_for([:backend, @current_shop, @qr_code_scene], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@qr_code_scene)

    .form-inputs
      .col-sm-6
        = f.input :name
        = f.input :preferred_redirect_url, hint: raw("#{render '/ddt/backend/branch_sliders/auto_insert_url', {input_field_id: 'qr_code_scene_preferred_redirect_url', version: 'whole_url'}}")
      .clearfix
    .form-actions
      .col-sm-6
        .col-sm-offset-4= f.button :submit
