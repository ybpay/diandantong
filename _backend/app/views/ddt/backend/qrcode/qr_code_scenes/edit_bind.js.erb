bootbox.hideAll();
<%- @table_array = [{text: '请选择桌台', value: ''}] %>
<%- @table_array += @branch.tables.select{|t| t.qr_code_scene == nil}.map{|table| {text: table.name, value: table.id}} %>
bootbox.prompt({
    title: "选择二维码要绑定的桌台",
    inputType: 'select',
    value: '',
    inputOptions: <%= raw @table_array.to_json %>,
    callback: function (result) {
      if(result){
        $('<form action="<%= update_bind_backend_shop_qr_code_scene_path(@current_shop, @qr_code_scene)%>" method="post"><input name="_method" type="hidden" value="patch"><input type="hidden" name="qr_code_scene[owner_id]" value='+result+'><input type="hidden" name="qr_code_scene[owner_type]" value="Ddt::Table"/></form>').appendTo('body').submit();
      }
    }
});