.header
  %h2= "#{t('activerecord.models.ddt/keywords_third_party_interface')} 列表"

= link_to tag(:icon,:class=>"fa fa-plus"), [:new, :backend, @current_shop, @wechat_account, :keywords_third_party_interface], :class => "btn btn-xs btn-primary"

%table.table.table-striped.table-bordered
  %thead
    %tr
      %th.col-sm-1= Ddt::KeywordsThirdPartyInterface.human_attribute_name(:keywords)
      %th.col-sm-1= Ddt::KeywordsThirdPartyInterface.human_attribute_name(:match_type)
      %th.col-sm-1= Ddt::KeywordsThirdPartyInterface.human_attribute_name(:api)
      %th.col-sm-1= Ddt::KeywordsThirdPartyInterface.human_attribute_name(:opened)
      %th.col-sm-1
  %tbody
    - @keywords_third_party_interfaces.each do |keywords_third_party_interface|
      %tr
        %td= keywords_third_party_interface.keywords
        %td= keywords_third_party_interface.match_type_name
        %td= keywords_third_party_interface.api
        %td= keywords_third_party_interface.opened? ? '启用' : '禁用'
        %td
          = link_to tag(:icon,:class=>"fa fa-edit"), [:edit, :backend, @current_shop, @wechat_account, keywords_third_party_interface], :class => "btn btn-xs btn-success"
          = link_to tag(:icon,:class=>"fa fa-trash-o"), [:backend, @current_shop, @wechat_account, keywords_third_party_interface], :method => :delete, :data => { :confirm => '确定删除?' }, :class => "btn btn-xs btn-danger"

    = no_record_hint(@keywords_third_party_interfaces)
