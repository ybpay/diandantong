= simple_form_for([:backend, @current_shop, @wechat_account, @keywords_third_party_interface], html: { class: 'form-horizontal'}) do |f|
  = f.error_notification :message => error_message_in_html(@keywords_third_party_interface)

  .form-inputs
    = f.input :keywords
    = f.input :match_type, collection: Ddt::KeywordsThirdPartyInterface.match_type_collection
    = f.input :api
    = f.input :token
    = f.input :opened

  .form-actions.col-xs-offset-2
    = f.button :submit, :class => "btn btn-primary btn-sm"
