.tabbable
  .tab-content
    .tab-pane.in.active
      .order-query-form
        = form_for :revenue_statistic, url: [:promotion, :backend, @current_shop, :revenue_statistics], method: :get, html: { class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
          = f.input_field :branch_id, data: {"local-datas" => current_account.is_boss? ? @current_shop.branches : current_account.manage_branches, useas: "local_select", single: true,placeholder: "选择门店"},class: 'ddb-select2 col-lg-2'
          = f.input_field :start_time, as: :datetime, placeholder: "开始时间", class: 'input-medium'
          %label{style: 'font-size:20px;'} ~
          = f.input_field :end_time, as: :datetime, placeholder: "结束时间", class: 'input-medium'
          = f.submit "搜索", class: 'btn btn-sm btn-success', onClick: "$(this).closest('form').attr('action', '#{ promotion_backend_shop_revenue_statistics_path(@current_shop, format: :html) }')"
          = f.submit "导出csv表格", class: 'btn btn-sm btn-info', onClick: "$(this).closest('form').attr('action', '#{ promotion_backend_shop_revenue_statistics_path(@current_shop, format: :csv) }')"
      %br/
      %table.table.table-striped.table-bordered
        %thead
          %tr
            %th 门店
            %th 权限折扣
            %th 权限减免
            %th 权限免单
            %th 优惠券优惠
            %th 代金券优惠
            %th 满减优惠
            %th 合计
        %tbody
          - @result.each do |item|
            %tr
              %td= item[:branch_name]
              %td= number_to_currency item[:privilege_discount_amount], unit: @current_shop.currency
              %td= number_to_currency item[:privilege_reduction_amount], unit: @current_shop.currency
              %td= number_to_currency item[:privilege_free_amount], unit: @current_shop.currency
              %td= number_to_currency item[:coupon_amount], unit: @current_shop.currency
              %td= number_to_currency item[:voucher_amount], unit: @current_shop.currency
              %td= number_to_currency item[:order_promotion_amount], unit: @current_shop.currency
              %td= number_to_currency item[:total], unit: @current_shop.currency
          %tr
            %td 合计
            %td= number_to_currency @result.map{|h| h[:privilege_discount_amount] }.sum, unit: @current_shop.currency
            %td= number_to_currency @result.map{|h| h[:privilege_reduction_amount] }.sum, unit: @current_shop.currency
            %td= number_to_currency @result.map{|h| h[:privilege_free_amount] }.sum, unit: @current_shop.currency
            %td= number_to_currency @result.map{|h| h[:coupon_amount] }.sum, unit: @current_shop.currency
            %td= number_to_currency @result.map{|h| h[:voucher_amount] }.sum, unit: @current_shop.currency
            %td= number_to_currency @result.map{|h| h[:order_promotion_amount] }.sum, unit: @current_shop.currency
            %td= number_to_currency @result.map{|h| h[:total] }.sum, unit: @current_shop.currency
