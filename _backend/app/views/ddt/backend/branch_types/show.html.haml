.ibox
  .ibox-title
    %h2= "#{t('activerecord.models.ddt/branch_type')} 详情"
    .alert.alert-success= raw "您可以点击#{link_to '自定义门店图标', index_branch_nav_backend_shop_branch_types_path(@current_shop), class: 'label label-danger'}为该类型的门店设置导航链接"
  .ibox-content
    .col-md-12
      .model-show
        %p
          %b
            = Ddt::BranchType.human_attribute_name(:name)
            \:
          = @branch_type.name
        %p
          %b
            = Ddt::BranchType.human_attribute_name(:branches_count)
            \:
          = @branch_type.branches_count
        %p
          %b
            = Ddt::BranchType.human_attribute_name(:icon)
            \:
          = @branch_type.icon
        %p
          %b
            = Ddt::BranchType.human_attribute_name(:bg_color)
            \:
          = @branch_type.bg_color
        - if @branch_type.image
          %p
            %b
              = Ddt::BranchType.human_attribute_name(:image)
              \:
            = image_tag @branch_type.image.thumb.url
        %p
          %b
            = Ddt::BranchType.human_attribute_name(:show_wifi)
            \:
          = @branch_type.show_wifi? ? '显示' : '不显示'
        %p
          %b
            = Ddt::BranchType.human_attribute_name(:show_parking)
            \:
          = @branch_type.show_parking? ? '显示' : '不显示'
        .content
          - if @branch_type.image
            %div{style: "border-radius: 1000px; width: 100px; height: 100px; background-image: url(#{@branch_type.image.thumb.url})"}
          - else
            %div{style: "border-radius: 1000px; width: 100px; height: 100px; background-color: #{@branch_type.bg_color}; text-align:center; font-size: 50px; color: white;"}
              %i.fa{:style => "display: block;  line-height: 100px;", :class=>"#{@branch_type.icon}"}
        .content
          = link_to '删除此门店类型', [:backend, @current_shop, @branch_type], :method => :delete, :data => { :confirm => '确定删除?' }, :class => "btn btn-xs btn-danger"
        .space

      .branches
        %table.table.table-bordered.table-striped
          %thead
            %tr
              %th= Ddt::BranchType.human_attribute_name(:branch)
              %th= Ddt::Branch.human_attribute_name(:open_days)
              %th= Ddt::Branch.human_attribute_name(:expiration_time)

          %tbody
            - @branches.each_slice(2) do |bs|
              %tr
                - bs.each do |branch|
                  %td
                    = link_to branch.name, [:backend, @current_shop, branch]
                  %td= branch.open_days
                  %td= branch.expiration_time.try(:strftime, '%F')
        %br
        .pull-right= will_paginate @branches , renderer: BootstrapPagination::Rails, bootstrap: 3
        %br


      = link_to t('Edit'), edit_backend_shop_branch_type_path(@current_shop, @branch_type), :class => "btn btn-primary btn-sm"
      \
      = link_to t('Back'), backend_shop_branch_types_path(@current_shop), :class => "btn btn-default btn-sm"
