= simple_form_for([:backend, @current_shop, @branch_type], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@branch_type)

    .form-inputs
      = f.input :show_wifi
      = f.input :show_parking
      = f.input :name
      = f.input :image, as: :image_preview, hint: '仅用于web下单, 推荐图片尺寸为200×200'
      -if @branch_type.image
        = f.input :remove_image, as: :boolean, label: '删除图片'
      = f.input :icon, hint: raw("仅用于web下单, 若上传图片，此项可忽略。可输入内容可参考<a href='http://fontawesome.io/icons' target='_blank' class='label label-info'>FontAwesome官方网站</a>")
      = f.input :bg_color, hint: '仅用于web下单, 若上传图片，此项可忽略', as: :minicolors

    .form-actions.col-xs-offset-2
      = f.button :submit, :class => "btn btn-primary btn-sm"
