.header
  %h3= "#{t('activerecord.models.ddt/short_message')} 详情"
.model-show
  %p
    %b
      = Ddt::ShortMessage.human_attribute_name(:to)
      \:
    = @short_message.to
  %p
    %b
      = Ddt::ShortMessage.human_attribute_name(:body)
      \:
    = @short_message.body
  %p
    %b
      = Ddt::ShortMessage.human_attribute_name(:created_at)
      \:
    = @short_message.created_at
  %p
    %b
      = Ddt::ShortMessage.human_attribute_name(:type)
      \:
    = @short_message.sms_type_name
  %p
    %b
      = Ddt::ShortMessage.human_attribute_name(:branch)
      \:
    = @short_message.branch.name rescue nil
  %p
    %b
      = Ddt::ShortMessage.human_attribute_name(:size)
      \:
    = @short_message.size
  .space

= link_to t('Back'), backend_shop_short_messages_path(@current_shop), :class => "btn btn-default"
