.header
  %h3= "#{@account.name} 的#{t('activerecord.models.ddt/location')} 列表"

.alert.alert-info
  %p
    %strong 温馨提示:
    %br
      列表里的位置信息，是按时间倒序的

%table.table.table-striped.table-bordered
  %thead
    %tr
      %th.col-sm-1= Ddt::Location.human_attribute_name(:longitude)
      %th.col-sm-1= Ddt::Location.human_attribute_name(:latitude)
      %th.col-sm-2= Ddt::Location.human_attribute_name(:created_at)
      %th 操作

  %tbody
    - @locations.each do |location|
      %tr
        %td= location.longitude
        %td= location.latitude
        %td= location.created_at
        %td
          = link_to "查看位置", "http://apis.map.qq.com/uri/v1/marker?marker=coord:#{location.latitude},#{location.longitude};title:#{@account.name}所在位置;addr: 上报时间#{location.created_at}", target: :_blank
%br
.pull-right= will_paginate @locations , renderer: BootstrapPagination::Rails, bootstrap: 3
%br