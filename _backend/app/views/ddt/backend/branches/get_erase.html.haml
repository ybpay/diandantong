.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2 订单数据抹除与恢复（危险）
    .p 注意：当您选择一段时间区间进行操作的时候，系统认为在该时间区间内下的单子或者结算的单子，都是测试的单子。请谨慎操作
      

.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      .ibox
        .ibox-content
          .col-sm-6
            %h4 订单数据抹除
            = simple_form_for [:erase_data, :backend, @current_shop, @branch], method: :post, html: {class: 'form-horizontal'} do |f|
              .form-inputs
                = f.input :start_time, as: :datetime, require: true, label: '开始时间', input_html: {id: 'erase_start_time'}
                = f.input :end_time, as: :datetime, require: true, label: '结束时间', input_html: {id: 'erase_end_time'}
              .form-actions
                .col-sm-offset-4
                  = f.submit '确认', class: "btn btn-primary", data: {confirm: '确定要抹除这些数据？'}, id: 'erase_submit'
          .clearfix

  .row
    .col-lg-12
      .ibox
        .ibox-content
          .col-sm-6
            %h4 恢复抹除的订单
            = simple_form_for [:rollback_data, :backend, @current_shop, @branch], method: :post, html: {class: 'form-horizontal'} do |f|
              .form-inputs
                = f.input :start_time, as: :datetime, require: true, label: '开始时间', input_html: {id: 'rollback_start_time'}
                = f.input :end_time, as: :datetime, require: true, label: '结束时间', input_html: {id: 'rollback_end_time'}
              .form-actions
                .col-sm-offset-4
                  = f.submit '确认', class: "btn btn-primary", data: {confirm: '确定要回退这些数据？'}, id: 'rollback_submit'
          .clearfix

:javascript
  (function(){

    $('#erase_submit').on('click', function(){
      var from = $('#erase_start_time').val();
      var to = $('#erase_end_time').val();
      var hint = '系统会抹除在 ('+from+' ~ '+to+') 期间内下的单子或者结算的单子, ' + $(this).attr('data-confirm')
      $(this).attr('data-confirm', hint);
    })

    $('#rollback_submit').on('click', function(){
      var from = $('#rollback_start_time').val();
      var to = $('#rollback_end_time').val();
      var hint = '系统会撤销在 ('+from+' ~ '+to+') 期间内抹除过的单子, ' + $(this).attr('data-confirm')
      $(this).attr('data-confirm', hint);
    })

  })();
