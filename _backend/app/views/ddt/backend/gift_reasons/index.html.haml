.ibox 
  .ibox-title
    %h2= "#{t('activerecord.models.ddt/gift_reason')}列表"

    .form-group
      = new_btn(:gift_reason, title: '新建', remote: true)
  .ibox-content
    .reasons-wrapper
      .ibox-content
        .row
          %div.dd.col-sm-6.reasons{ data: { base_url: backend_shop_gift_reasons_path(@current_shop)}}
            %ol.dd-list
              = render :partial => "item", :collection => @gift_reasons, :as => :gift_reason
              = no_record_hint(@gift_reasons)

