
.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-6
    .form-group
      = new_btn(:article, label: "添加文章", btn_size: 'btn-md')


.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        %table.table.table-striped.table-bordered
          %thead
            %tr
              %th.col-sm-1= Ddt::Article.human_attribute_name(:id)
              %th.col-sm-1= Ddt::Article.human_attribute_name(:title)
              %th.col-sm-1= Ddt::Article.human_attribute_name(:created_at)
              %th.col-sm-1 操作

          %tbody
            - @articles.each do |article|
              %tr
                %td= article.id
                %td= article.title
                %td= article.created_at
                %td
                  = info_btn(article)
                  = edit_btn(article)
                  = delete_btn(article)
            = no_record_hint(@articles)
        %br
        .pull-right= will_paginate @articles , renderer: BootstrapPagination::Rails, bootstrap: 3
        %br
