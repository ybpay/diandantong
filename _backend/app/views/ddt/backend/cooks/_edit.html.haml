.ibox
  .ibox-title
    %h2= "编辑#{t('role.display_name.cook')}"
  .ibox-content
    .col-md-12
      = form_for(@cook, url: backend_shop_branch_cook_path(@current_shop, @current_branch, @cook), html: {method: 'put', remote: true, :class=>"form-horizontal"}) do |f|
        .field.form-group
          = f.label :name, class: "col-sm-3 control-label"
          .col-sm-9
            = f.text_field :name, disabled: true, class: "col-xs-10 col-sm-5"

        .field.form-group
          = f.label :product_ids_string, class: "col-sm-3 control-label"
          .col-sm-9
            = f.text_area :product_ids_string, class: "col-xs-10 col-sm-5 ddb-select2", data: {url: search_backend_shop_branch_products_path(@current_shop, @current_branch), saved: @cook.products.map(&:select_json), placeholder: "请选择菜品"}
        .field.form-group
          = f.label :category_ids_string, class: "col-sm-3 control-label"
          .col-sm-9
            = f.text_area :category_ids_string, class: "col-xs-10 col-sm-5 ddb-select2", data: {url: backend_shop_branch_categories_path(@current_shop, @current_branch), saved: @cook.categories.map(&:select_json), placeholder: "请选择菜品分类"}

        .actions.form-actions.col-sm-offset-3
          = f.submit t('Save'), :class=>"btn btn-primary btn-sm"
    .clearfix
:javascript
  $(function(){init_ddb_select2();});
