= simple_form_for([:backend, @current_shop, @table_color], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@table_color)

    .form-inputs
      = f.input :idle_color, as: :minicolors, hint: '默认为:#b3b4b6'
      = f.input :opened_color, as: :minicolors, hint: '默认为:#fa7072'
      = f.input :ordered_color, as: :minicolors, hint: '默认为:#71d1fd'
      = f.input :check_outing_color, as: :minicolors, hint: '默认为:#4c5d65'
      = f.input :paid_color, as: :minicolors, hint: '默认为:#7dd400'
      = f.input :active_color, as: :minicolors, hint: '默认为:#f34b3f'

    .form-actions.col-xs-offset-2
      = f.button :submit, :class => "btn btn-primary btn-sm"
