= simple_form_for([:backend, @current_shop, :custom_weixin_info, @home_hot_link], html: { class: 'form-horizontal'}) do |f|
  = f.error_notification :message => error_message_in_html(@home_hot_link)

  .form-inputs
    = f.input :label
    = f.input :icon
    = f.input :icon_background_color, as: :minicolors
    = f.input :image, as: :image_preview
    -if @home_hot_link.image.url.present?
      = f.input :remove_image, as: :boolean, label: '删除图片', input_html: { onchange: "$('#home_hot_link_image_preview').fadeToggle();"}, hint: '推荐图片尺寸为200*200'
    = f.input :link, hint: raw("#{render '/ddt/backend/branch_sliders/auto_insert_url', {input_field_id: 'home_hot_link_link', version: 'only_ng'}}")

  .form-actions.col-xs-offset-2
    = f.button :submit, :class => "btn btn-primary btn-sm"

- content_for(:modal) do
  = render "ddt/layouts/backend/font_awesome_icons"

:javascript
  $(function(){
    $('.fa-hover').on('click',function(e){
      $('#home_hot_link_icon').val(e.target.text.trim());
      $("#icon-select-modal").modal('hide');
      return false;
    });
    $('#home_hot_link_icon').focus(function(){
      console.log("focus")
      $("#icon-select-modal").modal('show');
    });
  })

