.ibox
  .ibox-title
    %h3= "#{t('activerecord.models.ddt/home_hot_link')} 详情"

  .ibox-content
    .col-md-6
      .model-show
        - [:label, :link].each do |column|
          %p
            %b
              = Ddt::HomeHotLink.human_attribute_name(column)
              \:
            = @home_hot_link.send(column)
        %p
          %b
            = Ddt::HomeHotLink.human_attribute_name(:image)
            \:
          = home_hot_link_image(@home_hot_link)
        %p
          %b
            = Ddt::HomeHotLink.human_attribute_name(:icon)
            \:
          = home_hot_link_icon(@home_hot_link)
        .space

      = link_to t('Edit'), [:edit, :backend, @current_shop, :custom_weixin_info, @home_hot_link], :class => "btn btn-primary btn-sm"
      \
      = link_to t('Back'), [:backend, @current_shop, :custom_weixin_info, :home_hot_links], :class => "btn btn-default btn-sm"
    .clearfix
