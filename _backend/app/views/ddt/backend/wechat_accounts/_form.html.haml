= simple_form_for([:backend, @current_shop, @wechat_account], html: { class: 'form-horizontal'}) do |f|
  = f.error_notification :message => error_message_in_html(@wechat_account)

  .form-inputs
    = f.input :weixin_hao, hint: '公众号对应的微信号，非汉字名称，一般为英文字母', required: true
    - unless @wechat_account.is_authorized?
      = f.input :public_account_name, required: true
      = f.input :gonghao_open_id, required: true
      = f.input :token, required: true
      = f.input :gonghao_type, collection: Ddt::WechatAccount::TYPES.map{|type| [type[:name], type[:value]]}, required: true
      = f.input :be_verified, required: true
      = f.input :app_id, required: true
      = f.input :app_secret, required: true
    - if @current_shop.multi_branch?
      = f.association :default_branch, collection: @current_shop.branches, hint: '该选项一般请勿设置，一旦设置后，该公众帐号主要将只为单个门店进行服务。主帐号建议不要设置此选项'
    = f.input :is_primary

  .form-actions.col-xs-offset-2
    = f.button :submit, :class => "btn btn-primary btn-sm"



