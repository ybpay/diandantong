.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h3= "#{t('activerecord.models.ddt/wechat_account')} 列表"
    
    %p 
      1、绑定公众帐号授权是微信官方为了更好的方便商家在保证不泄漏自己公众账户敏感信息的前提下，安全地委托第三方平台为自己的公众号提供服务而开放的功能，无需对您的公众帐号进行配置即可使用本系统的服务，相关信息请参考
      = link_to '开放公众号授权', 'https://open.weixin.qq.com/cgi-bin/announce?action=getannouncement&key=1414994244&version=4&lang=zh_CN&token=859241370a57737d655c84933a6f7ab0834037d2'
      \。

    %p
      2、由于微信的access_token会三个月变更一次， 我们强烈建议您使用一键授权来添加公众帐号。 以避免因 access_token 过期而造成的服务不正常。

    %p
      3、
      %strong 温馨提示：
      %br
      如果您的主公众帐号是认证的服务号, 对于那些可以用模板消息来发送的消息， 系统会优先使用模板消息来发送 , 来提高消息的到达率。
      %br
      如果您的主公众帐号是认证的服务号。可以在微信后台添加模板消息功能，并选择您的行业为餐饮(系统选用的都是餐饮里的模板)。从而使用该功能
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12
        - if is_ddt_domain
          = link_to " 一键授权对接公众帐号", [:component_auth, :backend, @current_shop, :wechat_accounts], class: 'btn btn-primary'
        = new_btn(:wechat_account, label: "手动对接公众号")

  .row
    .col-lg-12
      .ibox
        .ibox-content
          %table.table.table-striped
            %thead
              %tr
                %th.col-sm-1= Ddt::WechatAccount.human_attribute_name(:public_account_name)
                %th.col-sm-2= Ddt::WechatAccount.human_attribute_name(:is_primary)
                %th.col-sm-1= Ddt::WechatAccount.human_attribute_name(:gonghao_open_id)
                %th.col-sm-2= Ddt::WechatAccount.human_attribute_name(:gonghao_type)
                %th.col-sm-2= Ddt::WechatAccount.human_attribute_name(:created_at)
                %th.col-sm-3

            %tbody
              - @wechat_accounts.each do |wechat_account|
                %tr
                  %td= link_to wechat_account.account_name, [:backend, @current_shop, wechat_account]
                  %td
                    %span.label{class: ('label-success' if wechat_account.is_primary?)}= wechat_account.is_primary_name
                  %td= wechat_account.gonghao_open_id
                  %td
                    = wechat_account.account_service_name
                    %span.label{class: ('label-success' if wechat_account.account_verified?)}
                      = wechat_account.account_verified_name
                    %span.label{class: ('label-success' if wechat_account.is_authorized?)}
                      = wechat_account.is_authorized_name
                  %td= wechat_account.created_at
                  %td
                    = edit_btn(wechat_account)
                    = edit_wechat_menu(wechat_account)
                    - if !wechat_account.is_authorized? && is_ddt_domain
                      = link_to "一键授权对接", [:component_auth, :backend, @current_shop, :wechat_accounts]
                    - if !wechat_account.is_authorized?
                      = link_to "第三方关键词转发", [:backend, @current_shop, wechat_account, :keywords_third_party_interfaces]
                    = link_to '上传认证文件', 'javascript:void(0)', class: 'btn_upload_server_auth_file'
                    = form_tag upload_server_auth_file_backend_shop_wechat_account_path(@current_shop, wechat_account),
                    method: :post, multipart: true, class: 'hidden form_upload_server_auth_file' do
                      = file_field_tag 'file', class: 'file_input_upload_server_auth_file'
              = no_record_hint(@wechat_accounts)
          %br
          .pull-right= will_paginate @wechat_accounts , renderer: BootstrapPagination::Rails, bootstrap: 3
          %br

:javascript

  $(function(){
    $('.btn_upload_server_auth_file').on("click", function(){
      var parent = $(this).parent();
      $('.file_input_upload_server_auth_file', parent).click();
    });

    $('.file_input_upload_server_auth_file').on("change", function(){
      $(this).parent().submit();
    });
  });