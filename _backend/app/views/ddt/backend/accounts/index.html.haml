.row.wrapper.border-bottom.white-bg.page-heading
  .col-lg-10
    %h2= "#{t('activerecord.models.ddt/account')} 列表"

    .form-group
      - if can?(:shop, :account, :create)
        = new_btn(:account)
.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox-content.m-b-sm.border-bottom
    .row
      .col-lg-12.form-group
    - if @current_branch.blank?
      .form-group
        = search_form_for @q, url: [:backend, @current_shop, :accounts], html: {class: 'form-inline', role: 'form'}, builder: SimpleForm::FormBuilder do |f|
          = f.input_field :name_cont, placeholder: Ddt::Account.human_attribute_name(:name),class: 'form-control'
          = f.input_field :phone_cont, placeholder: Ddt::Account.human_attribute_name(:phone),class: 'form-control'
          = f.input_field :manage_branches_id_eq, collection: @current_shop.branches.map{|b| [b.name, b.id]}, prompt: Ddt::Account.human_attribute_name(:manage_branches), include_blank: true,class: 'form-control'
          = f.submit "搜索", class: 'btn btn-sm btn-success'

  .row
    .col-lg-12
      .ibox 
        .ibox-content
          %table.table.table-striped
            %thead
              %tr
                %th.col-sm-1= Ddt::Account.human_attribute_name(:login_main_id)
                %th.col-sm-1= sort_link(@q, :login_id, Ddt::Account.human_attribute_name(:login_sub_id))
                %th.col-sm-2= sort_link(@q, :email, Ddt::Account.human_attribute_name(:email))
                %th.col-sm-1= sort_link(@q, :name, Ddt::Account.human_attribute_name(:name))
                %th.col-sm-1= sort_link(@q, :phone, Ddt::Account.human_attribute_name(:phone))
                %th.col-sm-3= Ddt::Account.human_attribute_name(:manage_branches)
                %th.col-sm-1= Ddt::Account.human_attribute_name(:roles)
                %th.col-sm-2

            %tbody
              - @accounts.each do |account|
                %tr
                  %td= account.login_main_id
                  %td= account.login_sub_id
                  %td= account.email
                  %td= account.name
                  %td= account.phone
                  %td= account.is_boss? ? '所有门店' : account.manage_branches.map(&:name).join(',')
                  %td= account.roles.map(&:display_name).join(',')
                  %td
                    = info_btn(account)
                    = edit_btn(account)
                    = link_to '定位', backend_shop_account_locations_path(@current_shop, account), title: "查看历史位置"
                    = link_to '消息接收', backend_shop_account_notification_receive_setting_path(@current_shop, account), title: "消息接收设置"
                    - unless account.built_in? or account.id == current_account.id
                      = delete_btn(account)
                    - if (current_account.is_admin? || current_account.is_boss?) && account.access_locked? 
                      = link_to '解锁', unlock_backend_shop_account_path(@current_shop, account)

              = no_record_hint(@accounts)
          %br
          .pull-right= will_paginate @accounts , renderer: BootstrapPagination::Rails, bootstrap: 3
          %br
