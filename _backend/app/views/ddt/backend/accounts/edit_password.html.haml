= simple_form_for([:update_password, :backend, @current_shop, @account], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@account)

    .form-inputs
      = f.input :login_id, disabled: true
      = f.input :name, disabled: true
      = f.input :email, disabled: true
      = f.input :phone, disabled: true
      = f.input :password, as: :password, hint: '只允许英文字母、数字以及下划线\'_\'', required: true
      = f.input :password_confirmation, as: :password, hint: '重复输入登录密码', required: true

    .form-actions.col-xs-offset-2
      = f.button :submit, :class => "btn btn-primary btn-sm"