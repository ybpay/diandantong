
= simple_nested_form_for([:backend, @current_shop, @account], wrapper: :horizontal_form_long, html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@account)

    .form-inputs
      .col-sm-6
        = f.input :login_id, label: '用户名后缀', as: :hidden
        - login_id_main, login_id_sub = @account.login_id.split(':') if @account.login_id.present?
        = f.input :login_id_main, as: :fake, label: '企业账号', readonly: true, input_html:{value: login_id_main}
      .col-sm-6
        - unless @account.built_in?
          = f.input :login_id_sub, as: :fake, value: login_id_sub, label: '员工账号', hint: raw("只允许英文字母、数字以及下划线'_'"), input_html:{value: login_id_sub}, required: true
      .col-sm-6
        = f.input :name, required: true
      .col-sm-6
        = f.input :email, required: true, disabled: (@account == @current_account),hint: raw(@account == @current_account ? '不能改变自己的邮箱' : '')
      .col-sm-6
        = f.input :notification_email
      .col-sm-6
        = f.input :receive_email
      .clearfix
      .col-sm-6
        - if @account.new_record?
          = f.input :password, as: :password, hint: '只允许英文字母、数字以及下划线\'_\'', required: true
      .col-sm-6
        - if @account.new_record?
          = f.input :password_confirmation, as: :password, hint: '重复输入登录密码', required: true
      .col-sm-6
        = f.input :phone, required: true ,disabled: (@account == @current_account),hint: raw(@account == @current_account ? '不能改变自己的手机号' : '')
      .col-sm-6
        = f.input :ban_login_app_when_no_open, as: :boolean
      .clearfix
      - if @current_shop.is_custom_system_weixin_notification
        .col-sm-6
          = f.input :user_id, input_html: { data: { column: 'id_eq phone_eq unique_user_nickname_cont', single: true, url: wechat_users_backend_shop_wechat_accounts_path(@current_shop), saved: @account.user.try(:select_json), placeholder: "请先关注主公众账号" }, class: 'ddb-select2'}, hint: raw("请先关注公众号服务号(微信号#{@current_shop.primary_wechat_account.public_account_name})，或扫描如下二维码，然后输入用户名,电话或昵称搜索，用于获取微信通知。如果仍然找不到您自己的微信昵称，请发送@并点击返回的消息绑定你的微信。<br/><img src='#{qrcode_image_url @current_shop.primary_wechat_account.gonghao_open_id}' width='150'/><br/><div class='btn btn-xs btn-warning' onclick='reset_select_user()'>清除对应微信用户</div>")
      .col-sm-6
        = f.input :manage_branch_ids_string, input_html: { data: { url: backend_shop_branches_path(@current_shop, multiple: true), saved: @account.manage_branches.map(&:select_json), placeholder: "请选择所属门店" }, class: 'ddb-select2'}, hint: '管理员可以管理所有门店'
      .col-sm-6
        = f.input :role_ids_string, input_html: { data: { url: backend_shop_roles_path(@current_shop), column: 'display_name_cont', saved: @account.roles.map{|role| {id: role.id, name: role.display_name}}, placeholder: "请选择所属角色" }, class: 'ddb-select2'}, disabled: (@account == @current_account), hint: raw((@account == @current_account ? '不能改变自己的角色' : '') + link_to("关于角色说明", backend_shop_roles_path(@current_shop), target: :_blank))
      .clearfix
    .form-actions
      .col-sm-6
        .col-xs-offset-2
          = f.button :submit, :id => 'submit-button'
    .clearfix
:javascript
  function reset_select_user(){
    $("#account_user_id").select2("val", "");
  }
  $(function(){
    function change_login_id_listener(){
      $("#account_login_id").on("keyup paste blur", function() {
          $("#login_id_suffix").text($(this).val());
      });
    }

    $(document).ready(function(){
      change_login_id_listener();
    });
    $("#submit-button").on("click", function(){
      var login_id_main = $("#login_id_main").val();
      var login_id_sub = $("#login_id_sub").val();
      var login_id = login_id_main + (login_id_sub.length > 0 ? ":" + login_id_sub : "");
      $("#account_login_id").val(login_id);
    });
  });
