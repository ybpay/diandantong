.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .ibox
    .ibox-title
      %h3= "编辑#{t('activerecord.models.ddt/notification_receive_setting')}"
    .ibox-content.header
      .col-sm-12.col-md-8.col-lg-6
        = simple_form_for([:backend, @current_shop, @account, @notification_receive_setting], html: { class: 'form-horizontal'}) do |f|
          = f.error_notification :message => error_message_in_html(@notification_receive_setting)

          - Ddt::NotificationReceiveSetting.all_settings_hash.each do |event, actions|
            .row
              %label.col-sm-4.control-label.notification-event-label{data: {event: event, value: 1}}
                = Ddt::NotificationReceiveSetting.event_name(event)
              .col-sm-8.notification-actions
                - actions.each do |action|
                  = f.input_field "#{event}__#{action}", as: :boolean, class: "notification-action-input"
                  = f.label "#{event}__#{action}", Ddt::NotificationReceiveSetting.action_name(action), class: "notification-action-label"

          .form-actions
            .row
              .col-sm-offset-4
                = f.button :submit, :class => "btn btn-primary"


        = link_to t('Show'), backend_shop_account_notification_receive_setting_path(@current_shop, @account, @notification_receive_setting), :class => "btn btn-default"
      .clearfix

:javascript
  $(function(){
    $(".notification-event-label").click(function(){
      var event = $(this).data("event")
      var value = $(this).data("value")
      $("input[id^='notification_receive_setting_"+event+"__']").prop("checked", value == 1)
      $(this).data("value", value == 1 ? 0 : 1)
    })
  })
