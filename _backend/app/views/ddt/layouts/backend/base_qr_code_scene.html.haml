- content_for(:content) do
  .wrapper.wrapper-content.animated.fadeInRight.ecommerce
    .row
      .col-lg-12
        .tabs-container
          %ul.nav.nav-tabs
            %li{class: ('active' if %W[base_qr_code_scenes].include? controller_name)}
              = link_to t('activerecord.models.ddt/base_qr_code_scene'), backend_shop_base_qr_code_scenes_path(@current_shop)
            %li{class: ('active' if controller_name == 'qr_code_scenes')}
              = link_to t('activerecord.models.ddt/qr_code_scene'), backend_shop_qr_code_scenes_path(@current_shop)
            %li{class: ('active' if controller_name == 'wechat_qr_code_scenes')}
              = link_to t('activerecord.models.ddt/wechat_qr_code_scene'), backend_shop_wechat_qr_code_scenes_path(@current_shop)
          .tab-content
            .tab-pane.active
              .panel-body
                = yield
= render template: "ddt/layouts/backend"