- content_for(:content) do
  .tabbable
    %ul.nav.nav-tabs
      %li{class: ('active' if controller_name == "short_messages" && action_name == "index")}
        = link_to '短信记录', [ :backend, @current_shop, :short_messages]

      %li{class: ('active' if controller_name == "order_calls" && action_name == "index")}
        = link_to '电话呼叫记录', [:backend, @current_shop, :order_calls]

    .tab-content
      .tab-pane.in.active
        = yield
= render template: "ddt/layouts/backend"
