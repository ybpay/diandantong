- content_for(:content) do
  .wrapper.wrapper-content.animated.fadeInRight.ecommerce
    .row
      .col-lg-12
        .tabs-container
          %ul.nav.nav-tabs#events

            %li{class: ('active' if params[:flag]=='subscribe')}
              = link_to '关注自动回复', events_index_path_with_flag('subscribe')
            %li{class: ('active' if params[:flag]=='keyword')}
              = link_to '关键词自动回复', events_index_path_with_flag('keyword')

          .tab-content
            .tab-pane.active
              .panel-body
                = yield
= render template: "ddt/layouts/backend"
