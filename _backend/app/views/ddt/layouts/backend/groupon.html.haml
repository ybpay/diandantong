- content_for(:content) do
  .wrapper.wrapper-content.animated.fadeInRight.ecommerce
    .row
      .col-lg-12
        .tabs-container
          %ul.nav.nav-tabs#groupon-tabs
            %li{class: ('active' if controller_name == 'groupons')}
              = link_to t('activerecord.models.ddt/groupon'), backend_shop_groupons_path(@current_shop)
            %li{class: ('active' if controller_name == 'vouchers')}
              = link_to t('activerecord.models.ddt/voucher'), backend_shop_vouchers_path(@current_shop)
            %li{class: ('active' if controller_name == 'groupon_versions')}
              = link_to t('activerecord.models.ddt/groupon_version'), backend_shop_groupon_versions_path(@current_shop)
            %li{class: ('active' if controller_name == 'voucher_versions')}
              = link_to t('activerecord.models.ddt/voucher_version'), backend_shop_voucher_versions_path(@current_shop)
          .tab-content
            .tab-pane.active
              .panel-body
                = yield
= render template: "ddt/layouts/backend"
