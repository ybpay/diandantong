- content_for(:content) do
  .wrapper.wrapper-content.animated.fadeInRight.ecommerce
    .row
      .col-lg-12
        .tabs-container
          %ul.nav.nav-tabs#tables
            %li{class: ('active' if controller_name == 'shop_card_wallets' && action_name == 'branches')}
              = link_to '门店余额管理', [:branches, :backend, @current_shop, :shop_card_wallet]
            %li{class: ('active' if controller_name == 'shop_card_wallets' && action_name == 'base_users')}
              = link_to '用户余额管理', [:base_users, :backend, @current_shop, :shop_card_wallet]
            %li{class: ('active' if controller_name == 'shop_card_wallets' && action_name == 'wallet_logs')}
              = link_to '余额日志', [:wallet_logs, :backend, @current_shop, :shop_card_wallet]
          .tab-content
            .tab-pane.active
              .panel-body
                = yield
= render template: "ddt/layouts/backend"
