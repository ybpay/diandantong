
- content_for(:content) do
  .wrapper.wrapper-content.animated.fadeInRight.ecommerce
    .row
      .col-lg-12
        .tabs-container
          %ul.nav.nav-tabs
            %li{class: ('active' if %W[alipay_methods].include?(controller_name) && action_name == 'show')}
              = link_to '支付宝', [:backend, @current_shop, :alipay_methods]
            %li{class: ('active' if %W[collection_logs].include?(controller_name) && action_name == 'index')}
              = link_to '代收记录', [:backend, @current_shop, :collection_logs]
            %li{class: ('active' if %W[withdraws].include?(controller_name) && action_name == 'index')}
              = link_to '提款记录', [:backend, @current_shop, :withdraws]
          .tab-content
            .tab-pane.active
              .panel-body
                = yield
= render template: "ddt/layouts/backend"