- content_for(:content) do
  .wrapper.wrapper-content.animated.fadeInRight.ecommerce
    .row
      .col-lg-12
        .tabs-container
          %ul.nav.nav-tabs#accounts
            %li{class: ('active' if action_name.include? 'visit_data')}
              = link_to '访问量统计', visit_data_backend_admin_statistics_path()
            %li{class: ('active' if action_name.include? 'order_data')}
              = link_to '订单量统计', order_data_backend_admin_statistics_path()
            %li{class: ('active' if action_name.include? 'order_types')}
              = link_to '订单类型统计', order_types_backend_admin_statistics_path()
            %li{class: ('active' if action_name.include? 'order_origins')}
              = link_to '订单来源统计', order_origins_backend_admin_statistics_path()
            %li{class: ('active' if action_name.include? 'pay_types')}
              = link_to '支付类型统计', pay_types_backend_admin_statistics_path()
            %li{class: ('active' if action_name.include? 'notification_data')}
              = link_to '消息量统计', notification_data_backend_admin_statistics_path()
            %li{class: ('active' if action_name.include? 'queue_origins')}
              = link_to '排号来源统计', queue_origins_backend_admin_statistics_path()
            %li{class: ('active' if action_name.include? 'shop_data')}
              = link_to '门店统计', shop_data_backend_admin_statistics_path()
          .tab-content
            .tab-pane.active
              .panel-body
                = yield
= render template: "ddt/layouts/backend"
