- content_for(:content) do
  .tabbable
    %ul.nav.nav-tabs#accounts

      %li{class: ('active' if action_name.include? 'access')}
        = link_to '访问量统计', access_by_month_backend_shop_statistics_path(@current_shop)
      %li{class: ('active' if ['wechat_user_by_month', 'wechat_user_by_year'].include? action_name)}
        = link_to '微信用户', wechat_user_by_month_backend_shop_statistics_path(@current_shop)
      %li{class: ('active' if action_name.include? 'gonghao')}
        = link_to '公号引入', wechat_user_by_gonghao_backend_shop_statistics_path(@current_shop)
      %li{class: ('active' if action_name.include? 'new_user')}
        = link_to '其他用户', new_user_by_month_backend_shop_statistics_path(@current_shop)
      %li{class: ('active' if action_name.include? 'sale_value')}
        = link_to '销量统计', sale_value_by_month_backend_shop_statistics_path(@current_shop)
      %li{class: ('active' if ['order_by_month','order_by_year'].include? action_name)}
        = link_to '下单统计', order_by_month_backend_shop_statistics_path(@current_shop)
      %li{class: ('active' if action_name.include? 'sale_amount')}
        = link_to '销售额统计', sale_amount_by_month_backend_shop_statistics_path(@current_shop)
      %li{class: ('active' if action_name.include? 'consume_sort')}
        = link_to '消费排行', consume_sort_by_month_backend_shop_statistics_path(@current_shop)
    .tab-content
      .tab-pane.in.active
        = yield
= render template: "ddt/layouts/backend"