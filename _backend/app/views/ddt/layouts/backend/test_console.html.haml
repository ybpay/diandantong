- content_for(:content) do
  .tabbable
    %ul.nav.nav-tabs#tables
      - %w(valid_wechat_users data_maker_panel).each do |it|
        %li{class: ('active' if action_name == it)}
          = link_to t("test_console.#{it}"), [it, :backend, @current_shop, :test_console]
    .tab-content
      .tab-pane.in.active
        = yield
= render template: "ddt/layouts/backend"