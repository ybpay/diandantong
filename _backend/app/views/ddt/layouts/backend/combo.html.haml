-content_for(:branch_body) do
  .wrapper.wrapper-content.animated.fadeInRight.ecommerce
    .row
      .col-lg-12
        .tabs-container
          %ul.nav.nav-tabs
            %li{class: ('active' if %W[combos].include?(controller_name) && action_name == 'index')}
              = link_to '全部套餐', backend_shop_branch_combos_path(@current_shop, @current_branch)
            - if @combo.present? && @combo.persisted?
              %li{class: ('active' if %W[combos].include?(controller_name) && action_name != 'index')}
                = link_to '当前套餐', backend_shop_branch_combo_path(@current_shop, @current_branch, @combo)
              %li{class: ('active' if %W[combo_items].include? controller_name)}
                = link_to t('activerecord.models.ddt/combo_item'), backend_shop_branch_combo_combo_items_path(@current_shop, @current_branch, @combo)
              %li{class: ('active' if %W[combo_images].include? controller_name)}
                = link_to t('activerecord.models.ddt/combo_image'), backend_shop_branch_combo_combo_images_path(@current_shop, @current_branch, @combo)
          .tab-content
            .tab-pane.active
              .panel-body
                = yield
= render template: "ddt/layouts/backend/branch"
