- content_for(:content) do
  .wrapper.wrapper-content.animated.fadeInRight.ecommerce
    .row
      .col-lg-12
        .tabs-container
          %ul.nav.nav-tabs
            %li{class: ('active' if %W[short_message_settings].include? controller_name)}
              = link_to t('activerecord.models.ddt/short_message_setting'), backend_shop_short_message_setting_path(@current_shop)
            %li{class: ('active' if controller_name == 'short_messages')}
              = link_to t('activerecord.models.ddt/short_message'), backend_shop_short_messages_path(@current_shop)
          .tab-content
            .tab-pane.active
              .panel-body
                = yield
= render template: "ddt/layouts/backend"