<!DOCTYPE html>
<html>
<head>
  <title><% if is_ddt_domain %><%= @current_shop.try(:support_brand_name).presence || '点单通' %> - <%= slogan_word %><% end %></title>
  <%= stylesheet_link_tag "ddt/weui-1.0.2", media: "all", "data-turbolinks-track" => true %>
  <%= stylesheet_link_tag "ddt/backend_weixin", media: "all", "data-turbolinks-track" => true %>
  <%= javascript_include_tag "ddt/backend_weixin", "data-turbolinks-track" => true %>
  <meta http-equiv="X-UA-Compatible" content="IE=EmulateIE9" ></meta>
  <meta content="width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=no" name="viewport" ></meta>
  <!--[if IE 7]>
    <link rel="stylesheet" href="/assets/css/font-awesome-ie7.min.css" />
  <![endif]-->

  <!-- page specific plugin styles -->

  <!-- fonts -->
  <!-- ace settings handler -->

  <!-- HTML5 shim and Respond.js IE8 support of HTML5 elements and media queries -->

  <!--[if lt IE 9]>
  <script src="/assets/js/html5shiv.js"></script>
  <script src="/assets/js/respond.min.js"></script>
  <![endif]-->
  <%= yield :head %>
  <%= csrf_meta_tags %>
</head>
<body>
  <%= content_for?(:content) ? yield(:content) : yield %>
  <div id="toast" style="display: none;">
      <div class="weui-mask_transparent"></div>
      <div class="weui-toast">
          <i class="weui-icon-success-no-circle weui-icon_toast"></i>
          <p class="weui-toast__content" id="toast_text"></p>
      </div>
  </div>

  <div class="js_dialog" id="iosDialog2" style="display: none;">
      <div class="weui-mask"></div>
      <div class="weui-dialog">
          <div class="weui-dialog__bd"></div>
          <div class="weui-dialog__ft">
              <a href="javascript:;" class="weui-dialog__btn weui-dialog__btn_primary">知道了</a>
          </div>
      </div>
  </div>

  <script type="text/javascript">
      
      function showToast(text, timeout){
        $toast = $('#toast');
        if(!timeout){
          timeout = 3000;
        }
        if($toast.css('display') != 'none') return;
        $('#toast_text').text(text);
        $toast.fadeIn(20);
        setTimeout(function(){
          $toast.fadeOut(20);  
        }, timeout)
      }

      function hideToast(){
        $toast = $('#toast');
        $toast.fadeOut(20);
      }

       $('.js_dialog').on('click', '.weui-dialog__btn', function(){
            $(this).parents('.js_dialog').fadeOut(20);
        });

      function showAlert(text){
        $('#iosDialog2 .weui-dialog__bd').html(text);
        $('#iosDialog2').fadeIn(20);

      }
      function hideAlert(){
        $('#iosDialog2').fadeOut(20);
      }
  </script>
</body>
</html>