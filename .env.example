# Diandantong Docker Environment Configuration
# Copy this file to .env and customize values

# App
RAILS_ENV=development
APP_PORT=9000
SECRET_KEY_BASE=0b818b2119fcb1328992197b9507dc9edd2d409f674dbcf962bbb21420edde30b4db7d1b5832cb0d0931f9a56139f4f8e5f99a11ce4bde2696c918306535ad66
RAILS_LOG_FORMAT=text

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=ddt_dev
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=11

# Docker behavior
WAIT_FOR_POSTGRES=true
WAIT_FOR_REDIS=true
RUN_MIGRATIONS=false

# Prometheus Exporter (monitoring)
PROMETHEUS_EXPORTER_ENABLED=false
PROMETHEUS_EXPORTER_HOST=127.0.0.1
PROMETHEUS_EXPORTER_PORT=9394

# Grafana (monitoring)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Backup
BACKUP_DIR=/var/backups/diandantong
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
