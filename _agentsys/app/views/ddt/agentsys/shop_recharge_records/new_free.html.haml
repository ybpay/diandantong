.wrapper.wrapper-content.animated.fadeInRight.ecommerce
  .row
    .col-lg-12
      .ibox
        .ibox-title
          %h5= "延长免费试用"
        .ibox-content
          = simple_form_for(@shop_recharge_record, url: [:create_free, :agentsys, @shop_recharge_record, {shop_id: @shop_recharge_record.shop.id}], html: { class: 'form-horizontal'}) do |f|
            = f.input :increment_days, hint: "该账户已试用#{(@current_shop.expiration_time - @current_shop.created_at+1.minutes).to_i/3600/24}天，最多仍可延长试用#{@shop_recharge_record.increment_days}天"
            .col-sm-offset-4
              = f.submit '确认延长免费试用', :class => "btn btn-primary", data: { confirm: '确认给客户延长免费试用' }
            .clearfix
