.alert.alert-info
  当前充值账号为
  (id:
  %strong
    = @shop_recharge_record.shop.id
  ),
  当前系统的版本为
  %strong
    = @shop_recharge_record.shop.shop_type_name
  ,
  最大可以创建
  %strong
    = @shop_recharge_record.shop.max_branches_limit
  家门店。
= simple_form_for(@shop_recharge_record, url: [:agentsys, @shop_recharge_record, {shop_id: @shop_recharge_record.shop.id}], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@shop_recharge_record)
    - old_feature_module_group = Ddt::FeatureModuleGroup.send(@shop_recharge_record.shop.shop_type)
    - feature_module_group = Ddt::FeatureModuleGroup.send(@shop_recharge_record.recharge_type)
    .form-inputs
      .col-sm-12.col-md-9.col-lg-6
        .form-group
          %label.control-label.col-sm-4 当前模块
          .col-sm-8
            %p.form-control-static= "#{old_feature_module_group[:label]}，允许#{@shop_recharge_record.shop.max_branches_limit}门店"

        .form-group
          %label.control-label.col-sm-4 当前模块剩余时间
          .col-sm-8
            %p.form-control-static= "#{((@shop_recharge_record.shop.expiration_time - DateTime.now).to_i/3600/24).round}天，折价#{number_to_currency(Ddt::FeatureModuleGroup.amount_of(@shop_recharge_record.shop.shop_type, ((@shop_recharge_record.shop.expiration_time - DateTime.now).to_i/3600/24).round, @shop_recharge_record.shop.max_branches_limit), unit: '¥')}"
        = f.input :recharge_type, as: :hidden
        .form-group
          = f.label :recharge_type, class: 'control-label col-sm-4'
          .col-sm-8
            %p.form-control-static= feature_module_group[:label]
            %p.help-block= "价格:#{number_to_currency(feature_module_group[:price], unit: '¥')}#{('/店' if feature_module_group[:charge_by_branch])}/年，包含如下功能服务模块：#{Ddt::FeatureModuleGroup.module_names(@shop_recharge_record.recharge_type)}"
        / = f.input :increment_days, collection: [['0天', 0], ['一年', 365], ['两年', 730], ['三年变永久', 1095]]
        = f.input :increment_days, collection: [['0天', 0], ['一年', 365]], hint: raw('<span class="text-danger">严重提醒：如果是升级请选 0天，如果是续费增加服务时间请选择 一年</span>'), disabled: !@shop_recharge_record.new_record?
        = f.input :branch_num, collection: 1.upto(500).map{|i| [i,i]}, include_blank: false, disabled: !@shop_recharge_record.new_record?
        .form-group
          %label.control-label.col-sm-4 原价
          .col-sm-8
            %p.form-control-static#shop_recharge_record_original_price= @shop_recharge_record.original_price
            %p.help-block#shop_recharge_record_price_instruction= "其中，#{[@current_shop.expiration_time, DateTime.now].max}前升级费用为#{@left_days_price}，#{[@current_shop.expiration_time, DateTime.now].max}之后续费为#{@append_days_price}"
        .form-group
          %label.control-label.col-sm-4 代理商折扣
          .col-sm-8
            %p.form-control-static= "#{current_agentsys_agent.discount*100}/%"
        .form-group
          %label.control-label.col-sm-4 代理商价格
          .col-sm-8
            %p.form-control-static#shop_recharge_record_price= @shop_recharge_record.price
        = f.input :note
      .clearfix
    .form-actions
      .col-sm-12.col-md-9.col-lg-6
        .col-sm-offset-4
          = f.submit '确认续费充值', :class => "btn btn-primary", data: { confirm: '确认给客户进行续费充值吗？一旦提交，该费用将会从您的帐户上扣除，不可撤销' }
      .clearfix

:javascript
    $(function(){
      var get_branch_num = function(){
        return parseInt($('#shop_recharge_record_branch_num').val());
      }
      var price_changed = function(e){
          var increment_days = $('#shop_recharge_record_increment_days').val()
         $.ajax({
            url: "#{price_of_charge_version_agentsys_feature_modules_configs_path(shop_id: @shop_recharge_record.shop)}",
            type: "GET",
            data: {
              "branch_num" : get_branch_num(), 
              "increment_days": increment_days, 
              "feature_module_group": $('#shop_recharge_record_recharge_type').val(),
              "shop_id": #{@shop_recharge_record.shop.id}
              },
            dataType: "json",
            success: function(resp) {
              if(resp.original_price) $('#shop_recharge_record_original_price').text(resp.original_price);
              var price_instruction = "其中，#{[@current_shop.expiration_time, DateTime.now].max}前升级费用为"+resp.left_days_price ;
              if(resp.append_days_price > 0){
                price_instruction += "，#{[@current_shop.expiration_time, DateTime.now].max}之后续费为"+increment_days+"天时间升级费用" + resp.append_days_price
              }
              $('#shop_recharge_record_price_instruction').text(price_instruction);
              if(resp.price) $('#shop_recharge_record_price').text(resp.price)
            }
          });
      }
      $('#shop_recharge_record_increment_days').on('change', price_changed)
      $('#shop_recharge_record_recharge_type').on('change', price_changed)
      $('#shop_recharge_record_branch_num').on('change', price_changed)
    });























      

