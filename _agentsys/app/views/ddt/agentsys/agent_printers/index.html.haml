.header
  %h1 打印机授权码列表

%table.table.table-bordered.table-striped
  %thead
    %tr
      %th.col-sm-1 序号
      %th.col-sm-2= Ddt::AgentPrinter.human_attribute_name(:printer_code)
      %th.col-sm-2= Ddt::AgentPrinter.human_attribute_name(:secret)
      %th.col-sm-2= Ddt::AgentPrinter.human_attribute_name(:token)
      %th.col-sm-2= Ddt::AgentPrinter.human_attribute_name(:discount_price)
      %th.col-sm-2= Ddt::AgentPrinter.human_attribute_name(:note)
      %th.col-sm-2
  %tbody
    - @agent_printers.each_with_index do |agent_printer, index|
      %tr
        %td= index+1
        %td= agent_printer.printer_code
        %td= agent_printer.secret
        %td= agent_printer.token
        %td= agent_printer.discount_price
        %td= agent_printer.note
        %td
          =link_to "编辑", edit_agentsys_agent_printer_path(agent_printer), class: "btn btn-primary btn-sm"

.pull-right= will_paginate @agent_printers , renderer: BootstrapPagination::Rails, bootstrap: 3
