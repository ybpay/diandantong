
<div class="login-box">
  <%= bootstrap_flash %>
  <div class="box">
    <div class="box-form">
      <h4 class="header red">代理商登陆入口</h4>
      <hr/>
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html:{method: :post}) do |f| %>
        <div class="inputs">
          <div class="input">
            <%= f.text_field :email, :placeholder=>"邮箱", class: 'input-field', data: { :rel=> 'tooltip', :placement => 'right'}, :title=> '请输入您的登录邮箱'  %>
          </div>
          <div class="input">
            <%= f.password_field :password, :placeholder=>"密码", class: 'input-field', data: { :rel=> 'tooltip', :placement => 'right'}, :title=> '请输入密码' %>
          </div>
        </div>
        <div class="remember-me">
          <label>
          <%= f.check_box :remember_me, as: :boolean if devise_mapping.rememberable? %><%= f.label :remember_me%>
          </label>
        </div>
        <div class="submit-action">
          <%= f.submit '登录', :class=> "submit-btn" %>
        </div>
      <% end %>
      <%= render "ddt/agentsys/agents/shared/links" %>
    </div>
  </div>
</div>
