<h2>修改密码</h2>

<%= simple_form_for(resource, as: resource_name, url: agentsys_agent_registration_path, html: { method: :put, class: "form-horizontal", role: "form" }) do |f| %>
  <% if resource.errors.any? %>
    <div id="error_explanation">
      <h2><%= "#{resource.errors.count}个错误导致无法正确保存:"%></h2>
      <ul>
        <% resource.errors.full_messages.each do |msg| %>
          <li><%= msg %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.input :email, required: true, autofocus: true, disabled: true %>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <p>Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
  <% end %>
  <%= f.input :current_password, hint: "需要您的当前密码来进一步确认您的身份", required: true %>

  <%= f.input :password, autocomplete: "off", hint: "如果不想修改请留空", required: false %>
  <%= f.input :password_confirmation, required: false %>

  <div class="form-actions col-sm-offset-2">
    <%= f.button :submit, "更新", :class=>"btn btn-primary" %>
  </div>
<% end %>

