.header
  %h1 代理资料列表

%table.table.table-bordered.table-striped
  %thead
    %tr
      %th.col-sm-1 序号
      %th= Ddt::AgentMaterial.human_attribute_name(:title)
      %th.col-sm-2= Ddt::AgentMaterial.human_attribute_name(:created_at)
  %tbody
    - @agent_materials.each_with_index do |agent_material, index|
      %tr
        %td= index+1
        %td= link_to agent_material.title, [:agentsys, agent_material]
        %td= agent_material.created_at.strftime("%Y-%m-%d")
