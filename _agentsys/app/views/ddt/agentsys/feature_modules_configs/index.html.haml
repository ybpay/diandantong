
%header
  %h3 当前已开通功能模块
.alert.alert-info
  当前充值账号为
  %strong
    = @current_shop.name
  (id:
  %strong
    = @current_shop.id
  ),
  当前系统的版本为
  %strong
    = @current_shop.shop_type_name
  ,
  最大可以创建
  %strong
    = @current_shop.max_branches_limit
  家门店。
.form-group
  = link_to "续费", index_group_agentsys_feature_modules_configs_path(shop_id: @current_shop.id), class: 'btn btn-primary'
  = link_to "充值", new_agentsys_shop_recharge_record_path(shop_id: @current_shop.id), class: 'btn btn-primary'
%table.table.table-striped
  %thead
    %tr
      %th.col-sm-2 模块名
      %th.col-sm-7 到期时间
      %th.col-sm-2 状态
  %tbody
    - @feature_modules_configs.each do |fmc|
      %tr
        %td= fmc.feature_modules_name
        %td= fmc.expired_at
        %td= fmc.enabled? ? '正常使用' : '用户暂停使用'
