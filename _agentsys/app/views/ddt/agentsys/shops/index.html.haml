.header
  %h2 我的客户


.col-lg-12
  = search_form_for @q, url: agentsys_shops_path(@current_agentsys_agent, style: params[:style]), html: { class: 'form-inline', role: 'form'} do |f|
    = hidden_field_tag :style, params[:style]
    .form-group
      = f.label :slug, class: 'sr-only'
      = f.search_field :slug_cont, placeholder: Ddt::Shop.human_attribute_name(:slug), class: 'form-control'
    .form-group
      = f.label :telephone, class: 'sr-only'
      = f.search_field :telephone_cont, placeholder: Ddt::Shop.human_attribute_name(:telephone), class: 'form-control'   
    = f.submit "搜索", class: 'btn btn-success'

%table.table.table-striped.table-bordered
  %thead
    %th.col-sm-2= Ddt::Shop.human_attribute_name(:slug)
    %th.col-sm-2= Ddt::Shop.human_attribute_name(:address)
    %th.col-sm-1= Ddt::Shop.human_attribute_name(:shop_type)
    %th.col-sm-1= Ddt::Shop.human_attribute_name(:created_at)
    %th.col-sm-2 剩余配额
    %th.col-sm-2= Ddt::Shop.human_attribute_name(:is_give_up)
    %th.col-sm-2
  %tbody
    = render partial: 'tr', collection: @shops, as: :shop

.pull-right= will_paginate @shops , renderer: BootstrapPagination::Rails, bootstrap: 3


