.panel.panel-default
  .panel-heading= @shop.name
  .panel-body
    %p
      %strong= Ddt::Shop.human_attribute_name(:name)
      \:
      = @shop.support_brand_name
    %p
      %strong= Ddt::Shop.human_attribute_name(:name)
      \:
      - if @shop.is_ban? 
        %span.label.label-danger 已全面禁止
      - else
        正常访问

    %p
      %strong= Ddt::Shop.human_attribute_name(:slug)
      \:
      = @shop.slug
    %p
      %strong= Ddt::Shop.human_attribute_name(:shop_type)
      \:
      = @shop.shop_type_name
      %strong= Ddt::Shop.human_attribute_name(:is_open)
      \:
      = @shop.shop_type_name
    %p
      %strong= Ddt::Shop.human_attribute_name(:is_open)
      - if @shop.is_open?
        %span.label.label-success= @shop.is_open_name
      - else
        %span.label.label-danger= @shop.is_open_name

    %p
      %strong 是否已购买
      \:
      - if @shop.shop_recharge_records.any?
        %span.label.label-success 付费用户
        (
        - @shop.shop_recharge_records.each do |record|
          = record.created_at.strftime("%F %T")
          续费了
          = record.increment_days
          天；
        )
      - else
        %span.label.label-danger 试用用户
    %p
      %strong= Ddt::Shop.human_attribute_name(:address)
      \:
      = @shop.address
    %p
      %strong= Ddt::Shop.human_attribute_name(:telephone)
      \:
      = @shop.telephone
    %p
      %strong= Ddt::Account.human_attribute_name(:email)
      \:
      = @shop.boss.map(&:email).join(", ")
    - if @shop.agent_no.present?
      %p
        %strong 开发代理商
        \:
        = @shop.agent.name rescue ""
        = "(代理邀请码: #{@shop.agent_no})"
    %p
      %strong= Ddt::Shop.human_attribute_name(:created_at)
      \:
      = @shop.created_at.strftime("%F %T")
    %p
      %strong 到期时间
      \:
      = @shop.expiration_time.strftime("%F %T")
    %p
      %strong= Ddt::Shop.human_attribute_name(:max_branches_limit)
      \:
      = @shop.max_branches_limit
    %p
      %strong= Ddt::Shop.human_attribute_name(:introduction)
      \:
      = raw @shop.introduction
    %p
      %strong= Ddt::Shop.human_attribute_name(:image)
      \:
      = image_tag @shop.image_url, width: 200
    %p
      %strong= Ddt::Shop.human_attribute_name(:qrcode)
      \:
      = image_tag @shop.qrcode, width: 140 if @shop.qrcode
= link_to t('Back'), :back, :class=>"btn btn-default"
= link_to t('编辑'), edit_agentsys_shop_path(@shop), :class=>"btn btn-primary"
