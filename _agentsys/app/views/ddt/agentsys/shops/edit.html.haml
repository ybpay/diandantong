.panel.panel-default
  .panel-heading
    %b 管理商户
  .panel-body
    .col-sm-offset-2
      品牌:
      = @shop.support_brand_name
      %br
      店铺名:
      = "#{@shop.name} (#{@shop.slug})"

    = simple_form_for [:agentsys, @shop], html: {class: 'form-horizontal'} do |f|
      = f.error_notification :message => error_message_in_html(@shop)
      .form-inputs
        = f.input :name, as: :boolean
        = f.input :is_ban, as: :boolean
      .form-actions.col-sm-offset-2
        = f.submit '修改', :class => "btn btn-primary"



