= simple_form_for([:backend, @current_shop, @<%= singular_table_name %>], html: { class: 'form-horizontal'}) do |f|
  - f.with_options disabled: (disabled rescue nil) do |f|
    = f.error_notification :message => error_message_in_html(@<%= singular_table_name %>)

    .form-inputs
    <%- attributes.each do |attribute| -%>
      = f.<%= attribute.reference? ? :association : :input %> :<%= attribute.name %>
    <%- end -%>

    .form-actions.col-xs-offset-2
      = f.button :submit, :class => "btn btn-primary btn-sm"
