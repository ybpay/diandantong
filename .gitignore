# See https://help.github.com/articles/ignoring-files for more about ignoring files.

**/.DS_Store
**/*.swp

# Dependencies
/.bundle
/vendor/bundle

# Database
/db/*.sqlite3
/db/*.sqlite3-journal
/db/schema.rb

# PostgreSQL
/db/*.pg_dump

# Ignore all logfiles and tempfiles.
/log/*.log
/tmp
/dump.rdb

# IDE
.idea
/.byebug_history
/.sass-cache/*

# Environment
.env
.env.*

# Public uploads and assets
/public/uploads/**/*
/public/test/
/public/assets/

# Active Storage
/storage/*

# Config files with secrets
/config/database.yml
/config/secrets.yml
/config/cl2009.yml
/config/cloopen.yml
/config/system_alipay.yml
/config/baidu_push.yml
/config/weixin_config.yml
/config/newrelic.yml
/config/print_manager.yml
/config/sidekiq_monitor_config.yml
/config/wechatpay_sl.yml
/config/order_service_config.yml
/config/shards.yml
/config/j_push.yml
/config/sale_data_uploader_config.yml
/config/redis_client.yml
/config/inner_api_token.yml

# SSL certificates
/config/ssl/

# Backups
/backups/

# Coverage
/coverage/

# Node
/node_modules/

# Yarn
/yarn-error.log
/yarn-debug.log
.yarn-integrity

# Bootsnap
/tmp/bootsnap*

# Kamal
/.kamal/

/script/*.rb

# Docker artifacts
.env
.env.local
docker-compose.override.local.yml

# RuboCop report
rubocop-report.json

# Lock files
Gemfile.lock
